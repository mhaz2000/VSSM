@using VSSM.Presentation.Web.Models.User
@model ChangePasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "تغییر رمز عبور اجباری";
}

@section Styles {
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" />
    <link href="~/css/components/shared/grid-header.css" rel="stylesheet" />
}

<style>
    .btn-add{
        font-family: 'Vazirmatn', system-ui, sans-serif !important;
    }
</style>

<div class="uid-modal-overlay open">
    <div class="uid-modal" style="max-width:440px;">
        <div class="uid-modal-header">
            <h6>
                <i class="fa fa-key" style="color:#dc2626;"></i>
                تغییر رمز عبور
            </h6>
        </div>
        <div class="uid-modal-body">
            <p style="font-size:14px; line-height:1.6; margin:0 0 14px;">
                به دلایل امنیتی، باید رمز عبور خود را در اولین ورود تغییر دهید. تا زمان تغییر رمز،
                دسترسی به بخش‌های دیگر سیستم امکان‌پذیر نیست.
            </p>

            <form method="post" asp-action="ForceChangePassword" asp-controller="Account" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />

                <div class="form-group mb-2">
                    <label class="form-label">رمز عبور جدید</label>
                    <input type="password" asp-for="NewPassword" class="f-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">تکرار رمز عبور جدید</label>
                    <input type="password" asp-for="ConfirmPassword" class="f-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <ul class="text-muted" style="font-size:12px; padding-right:16px; margin-bottom:14px;">
                    <li>حداقل ۸ کاراکتر</li>
                    <li>شامل حرف بزرگ، حرف کوچک، عدد و یک نویسه ویژه</li>
                </ul>

                <button type="submit" class="btn-add w-100">تغییر رمز عبور</button>
            </form>
        </div>
    </div>
</div>
