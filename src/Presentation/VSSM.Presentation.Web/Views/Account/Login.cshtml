@using VSSM.Presentation.Web.Models.Account
@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "ورود";
    var hasError = ViewBag.Error != null;
}

@* عنوان بیرون کارت — bold و کمی عریض‌تر *@
<div class="app-header">
    <h1 class="app-title">سامانه مدیریت، نگهداری و توزیع واکسن</h1>
    <p class="app-subtitle">Vaccination Supplies Stock Management</p>
</div>

<div class="auth-card">

    @* لوگو *@
    <div class="logo-section">
        <img src="~/img/Logo.png" alt="لوگو معاونت بهداشت" width="120" height="140" />
    </div>

    @* هدر فرم *@
    <div class="form-header">
        <p class="form-title">ورود</p>
        <p class="form-subtitle">وارد حساب کاربری خود شوید.</p>
    </div>

    <form method="post" asp-action="Login" autocomplete="off" novalidate>
        @Html.AntiForgeryToken()

        @* نام کاربری *@
        <div class="field-group">
            <label class="field-label" for="UserName">نام کاربری</label>
            <div class="field-wrap">
                <svg class="field-icon" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
                <input type="text" id="UserName" asp-for="UserName"
                       class="field-input @(hasError ? "has-error" : "")"
                       placeholder="نام کاربری"
                       autocomplete="username"
                       spellcheck="false"
                       maxlength="100"
                       aria-required="true" />
            </div>
        </div>

        @* رمز عبور *@
        <div class="field-group">
            <label class="field-label" for="Password">رمز عبور</label>
            <div class="field-wrap">
                <svg class="field-icon" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
                <input type="password" id="Password" asp-for="Password"
                       class="field-input @(hasError ? "has-error" : "")"
                       placeholder="رمز عبور"
                       autocomplete="current-password"
                       maxlength="128"
                       aria-required="true" />
                <button type="button" class="toggle-password"
                        onclick="togglePassword()"
                        aria-label="نمایش رمز عبور"
                        tabindex="-1">
                    <svg id="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                </button>
            </div>
            @if (hasError)
            {
                <p class="error-text" role="alert" aria-live="assertive">@ViewBag.Error</p>
            }
        </div>

        @* کد امنیتی (captcha) *@
        <div class="field-group">
            <label class="field-label" for="Captcha">کد امنیتی</label>
            <div class="field-wrap" style="align-items:center; gap:10px;">
                <div id="captchaImage" style="border:1px solid #cfd8e3; border-radius:8px; overflow:hidden; line-height:0;">
                    @Html.Raw(Model.CaptchaSvg)
                </div>
                <button type="button" class="toggle-password" onclick="reloadCaptcha()"
                        aria-label="تغییر کد امنیتی" tabindex="-1" title="تغییر کد">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M23 4v6h-6" />
                        <path d="M1 20v-6h6" />
                        <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
                    </svg>
                </button>
                <input type="text" id="Captcha" asp-for="Captcha"
                       class="field-input" placeholder="کد را وارد کنید"
                       autocomplete="off" maxlength="5" style="flex:1;"
                       aria-required="true" />
            </div>
            @if (hasError)
            {
                <p class="error-text" role="alert" aria-live="assertive">@ViewBag.Error</p>
            }
        </div>

        <input type="hidden" asp-for="CaptchaToken" />

        <button type="submit" class="btn-login">ورود</button>
    </form>

    <script>
        function reloadCaptcha() {
            fetch('@Url.Action("Captcha", "Account")')
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    document.getElementById('captchaImage').innerHTML = d.svg;
                    document.getElementById('CaptchaToken').value = d.token;
                    document.getElementById('Captcha').value = '';
                });
        }
    </script>

    <p class="auth-footer">
        با ورود به <a asp-controller="Info" asp-action="About">سامانه</a>، شما شرایط استفاده و
        <a asp-controller="Info" asp-action="Privacy">قوانین حریم خصوصی</a> ما را می‌پذیرید.
    </p>
</div>