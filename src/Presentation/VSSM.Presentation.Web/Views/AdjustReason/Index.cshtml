@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PagingSearchOrderDto<VSSM.Application.DTOs.BaseEntities.AdjustReason.AdjustreasonDto>

@{
    ViewData["Title"] = "لیست دلایل تعدیل";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-block">
                <div class="col-lg-3">
                    <h5>دلایل تعدیل</h5>
                </div>
                <div class="col-lg-4">
                </div>
                <form method="get">
                    <div class="col-lg-4">
                        <div class="input-group">
                            <input type="text" name="search" value="@Model.SearchText" class="form-control" placeholder="جستجو...">
                            <div class="input-group-btn">
                                <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> جستجو</button>
                            </div>

                        </div>
                    </div>

                </form>

                <div class="col-lg-1 ms-auto">
                    <a class="btn btn-success" asp-controller="AdjustReason" asp-action="New"><i class="fa fa-plus-circle"></i> جدید</a>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body p-0">
                <table class="table table-bordered table-striped table-condensed text-center mb-0">
                    <thead>
                    <tr>
                        <th>
                            @Html.ActionLink("کد", "Index", new { search = Model.SearchText, page = Model.Paging.Page, pageSize = Model.Paging.PageSize, sortField = "Code", sortOrder = Model.SortOrder == "asc" ? "desc" : "asc" })
                        </th>
                        <th>
                            @Html.ActionLink("نام کامل", "Index", new { search = Model.SearchText, page = Model.Paging.Page, pageSize = Model.Paging.PageSize, sortField = "FullName", sortOrder = Model.SortOrder == "asc" ? "desc" : "asc" })
                        </th>
                        <th>
                            @Html.ActionLink("تاریخ ثبت", "Index", new { search = Model.SearchText, page = Model.Paging.Page, pageSize = Model.Paging.PageSize, sortField = "EntryDate", sortOrder = Model.SortOrder == "asc" ? "desc" : "asc" })
                        </th>
                        <th>فعال</th>
                        <th>عملیات</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Code</td>
                                <td>@item.FullName</td>
                                <td>@(item.EntryShamsiDate ?? "-")</td>
                                <td>@(item.IsActive ? "بله" : "خیر")</td>
                                <td>
                                    <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@item.AdjustReasonId">ویرایش</a>
                                    <form asp-action="Delete" asp-route-id="@item.AdjustReasonId" method="post" style="display:inline;" onsubmit="return confirm('آیا از حذف این مورد مطمئن هستید؟');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">حذف</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-danger">موردی یافت نشد</td>
                        </tr>
                    }
                    </tbody>
                </table>

                <!-- Pagination -->
                <nav class="mt-2">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.Paging.Page == 1 ? "disabled" : "")">
                            <a class="page-link" href="?search=@Model.SearchText&page=@(Model.Paging.Page - 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">قبلی</a>
                        </li>

                        @for (int i = 1; i <= Model.Paging.TotalPages; i++)
                        {
                            <li class="page-item @(Model.Paging.Page == i ? "active" : "")">
                                <a class="page-link" href="?search=@Model.SearchText&page=@i&sortField=@Model.SortField&sortOrder=@Model.SortOrder">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.Paging.Page == Model.Paging.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="?search=@Model.SearchText&page=@(Model.Paging.Page + 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">بعدی</a>
                        </li>
                    </ul>
                </nav>

            </div>
        </div>
    </div>
</div>