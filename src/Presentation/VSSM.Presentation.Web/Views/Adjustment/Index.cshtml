@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PagingSearchOrderDto<VSSM.Application.DTOs.BaseEntities.Adjustments.AdjustmentDto>

@{
ViewData["Title"] = "مدیریت تعدیلات";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <!-- Header: Title + Search + New Button -->
        <div class="row mb-3 align-items-center">
            <!-- عنوان صفحه -->
            <div class="col-md-4 col-12 mb-2 mb-md-0">
                <h5 class="mb-0">تعدیلات</h5>
            </div>

            <!-- جستجو -->
            <div class="col-md-5 col-12 mb-2 mb-md-0">
                <form method="get">
                    <div class="input-group">
                        <input type="text"
                               name="search"
                               value="@Model.SearchText"
                               class="form-control"
                               placeholder="جستجو...">
                        <button class="btn btn-primary" type="submit">
                            <i class="fa fa-search"></i> جستجو
                        </button>
                    </div>
                </form>
            </div>

            <!-- دکمه ایجاد جدید -->
            <div class="col-md-3 col-12 text-md-end">
                <a class="btn btn-success"
                   asp-controller="Adjustment"
                   asp-action="New">
                    <i class="fa fa-plus-circle"></i> جدید
                </a>
            </div>
        </div>

        <!-- Table -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body p-0">

                        <div class="table-responsive">
                            <table class="table table-bordered table-striped text-center mb-0">
                                <thead class="table-light">
                                <tr>
                                    <th>کالا</th>
                                    <th>گروه کالا</th>
                                    <th>مقدار جدید</th>
                                    <th>دلایل تعدیل</th>
                                    <th>عملیات</th>
                                </tr>
                                </thead>
                                <tbody>
                                @if (Model.Items != null && Model.Items.Any())
                                {
                                foreach (var item in Model.Items)
                                {
                                <tr>
                                    <td>@item.ItemFullName</td>
                                    <td>@item.ItemClassFullName</td>
                                    <td>@item.NewQuantity</td>
                                    <td>@item.AdjustreasonTitle</td>
                                    <td>
                                        <a class="btn btn-primary btn-sm"
                                           asp-controller="Adjustment"
                                           asp-action="Edit"
                                           asp-route-id="@item.AdjustmentId">
                                            ویرایش
                                        </a>

                                        <form asp-controller="Adjustment"
                                              asp-action="Delete"
                                              asp-route-id="@item.AdjustmentId"
                                              method="post"
                                              style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('آیا از حذف این رکورد مطمئن هستید؟');">
                                                حذف
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                }
                                }
                                else
                                {
                                <tr>
                                    <td colspan="5" class="text-center text-danger">
                                        داده‌ای یافت نشد
                                    </td>
                                </tr>
                                }
                                </tbody>
                            </table>
                        </div>

                        <!-- Paging -->
                        <nav class="mt-2">
                            <ul class="pagination justify-content-center mb-0">

                                <li class="page-item @(Model.Paging.Page <= 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?search=@Model.SearchText&page=@(Model.Paging.Page - 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">
                                        قبلی
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.Paging.TotalPages; i++)
                                {
                                <li class="page-item @(Model.Paging.Page == i ? "active" : "")">
                                    <a class="page-link"
                                       href="?search=@Model.SearchText&page=@i&sortField=@Model.SortField&sortOrder=@Model.SortOrder">
                                        @i
                                    </a>
                                </li>
                                }

                                <li class="page-item @(Model.Paging.Page >= Model.Paging.TotalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?search=@Model.SearchText&page=@(Model.Paging.Page + 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">
                                        بعدی
                                    </a>
                                </li>

                            </ul>
                        </nav>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    // جاوااسکریپت اضافی در صورت نیاز
</script>
}
