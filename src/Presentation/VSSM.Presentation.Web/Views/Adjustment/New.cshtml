@using Microsoft.AspNetCore.Mvc.TagHelpers
@model VSSM.Presentation.Web.Models.Adjustment.AdjustmentViewModel

@{
string formName = (Model != null && Model.AdjustmentId > 0) ? "ویرایش" : "ثبت";
}

<style>
    .required-star {
        color: red;
        margin-right: 3px;
    }
</style>

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-block">
                <div class="col-lg-4">
                    <h5>@formName تعدیل</h5>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-block">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <form asp-controller="Adjustment"
                      asp-action="Create"
                      method="post"
                      class="form-horizontal">

                    <input type="hidden" asp-for="AdjustmentId"/>

                    <div class="col-lg-6">

                        <!-- Item Class -->
                        <div class="form-group">
                            <span class="form-label">
                                <span class="required-star">*</span>
                                نوع کالا:
                            </span>
                            <select class="form-control"
                                    asp-for="ItemClassId"
                                    id="ItemClassId">
                                <option value="">-- انتخاب کنید --</option>
                                @foreach (var item in ViewBag.ItemClass)
                                {
                                <option value="@item.Id"
                                        selected="@(Model?.ItemClassId == item.Id)">
                                    @item.Name
                                </option>
                                }
                            </select>
                        </div>

                        <!-- Item Group -->
                        <div class="form-group">
                            <span class="form-label">
                                <span class="required-star">*</span>
                                گروه کالا:
                            </span>
                            <select class="form-control"
                                    asp-for="ItemId"
                                    id="ItemGroupId"
                                    disabled>
                                <option value="">-- انتخاب کنید --</option>
                                @foreach (var item in ViewBag.ItemGroups)
                                {
                                <option value="@item.Id"
                                        data-itemclassid="@item.ItemClassId"
                                        selected="@(Model?.ItemId == item.Id)">
                                    @item.FullName
                                </option>
                                }
                            </select>
                        </div>

                        <!-- Item Detail Store -->
                        <div class="form-group">
                            <span class="form-label">
                                <span class="required-star">*</span>
                                کالا:
                            </span>
                            <select class="form-control"
                                    asp-for="ItemDetailStoreId"
                                    id="ItemDetailStoreId"
                                    disabled>
                                <option value="">-- انتخاب کنید --</option>
                                @foreach (var item in ViewBag.ItemDetailStores)
                                {
                                <option value="@item.ItemDetailStoreId"
                                        data-itemid="@item.ItemId"
                                        selected="@(Model?.ItemDetailStoreId == item.ItemDetailStoreId)">
                                    @item.DropDownText
                                </option>
                                }
                            </select>
                        </div>

                        <hr/>

                        <!-- Old Quantity -->
                        <div class="form-group">
                            <label class="form-label">مقدار قبلی</label>
                            <input type="number"
                                   asp-for="OldQuantity"
                                   id="OldQuantity"
                                   class="form-control"
                                   readonly/>
                        </div>

                        <!-- New Quantity -->
                        <div class="form-group">
                            <span class="form-label">
                                <span class="required-star">*</span>
                                مقدار جدید:
                            </span>
                            <input type="number"
                                   asp-for="NewQuantity"
                                   id="NewQuantity"
                                   class="form-control"
                                   min="1"
                                   step="1"/>
                            <span asp-validation-for="NewQuantity" class="text-danger"></span>
                        </div>

                        <!-- Difference -->
                        <div class="form-group">
                            <label class="form-label">اختلاف</label>
                            <input type="number"
                                   id="QuantityDifference"
                                   class="form-control"
                                   readonly/>
                        </div>

                        <hr/>

                        <div class="form-group">
                            <label class="form-label">توجه:</label>
                            <label class="form-control">
                                عدد منفی موجودی فعلی را کاهش داده و عدد مثبت موجودی فعلی را افزایش می‌دهد.
                                افزودن موجودی را با دقت انجام دهید.
                            </label>
                        </div>

                        <hr/>

                        <!-- Adjust Reason -->
                        <div class="form-group">
                            <span class="form-label">
                                <span class="required-star">*</span>
                                دلیل تعدیل:
                            </span>
                            <select class="form-control"
                                    asp-for="AdjustmentreasonId"
                                    id="AdjustmentreasonId">
                                <option value="">-- انتخاب کنید --</option>
                                @foreach (var item in ViewBag.AdjustReasons)
                                {
                                <option value="@item.AdjustReasonId"
                                        selected="@(Model?.AdjustmentreasonId == item.AdjustReasonId)">
                                    @item.FullName
                                </option>
                                }
                            </select>
                        </div>

                        <!-- Note -->
                        <div class="form-group">
                            <label class="form-label">توضیحات</label>
                            <textarea asp-for="Note"
                                      class="form-control"
                                      rows="3"></textarea>
                        </div>

                        <hr/>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-success px-5">
                                @formName
                            </button>

                            <a class="btn btn-primary px-5" asp-action="Index">
                                لیست
                            </a>
                        </div>

                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    const itemClass = document.getElementById("ItemClassId");
    const itemGroup = document.getElementById("ItemGroupId");
    const itemDetailStore = document.getElementById("ItemDetailStoreId");

    const oldQty = document.getElementById("OldQuantity");
    const newQty = document.getElementById("NewQuantity");
    const diff = document.getElementById("QuantityDifference");

    function filterItemGroups(initialLoad = false) {
        const classId = itemClass.value;
        let hasItem = false;

        Array.from(itemGroup.options).forEach(opt => {
            const optClassId = opt.getAttribute("data-itemclassid");
            if (!optClassId) return;

            if (optClassId === classId) {
                opt.style.display = "block";
                hasItem = true;
            } else {
                opt.style.display = "none";
            }
        });

        itemGroup.disabled = !classId || !hasItem;

        if (!initialLoad) {
            itemGroup.value = "";
            itemDetailStore.value = "";
            itemDetailStore.disabled = true;
        }
    }

    function filterItemDetailStores(initialLoad = false) {
        const groupId = itemGroup.value;
        let hasItem = false;

        Array.from(itemDetailStore.options).forEach(opt => {
            const optItemId = opt.getAttribute("data-itemid");
            if (!optItemId) return;

            if (optItemId === groupId) {
                opt.style.display = "block";
                hasItem = true;
            } else {
                opt.style.display = "none";
            }
        });

        itemDetailStore.disabled = !groupId || !hasItem;

        if (!initialLoad) {
            itemDetailStore.value = "";
        }
    }

    function updateDifference() {
        const oldVal = parseInt(oldQty.value) || 0;
        const newVal = parseInt(newQty.value) || 0;
        diff.value = newVal - oldVal;
    }

    itemClass.addEventListener("change", () => filterItemGroups(false));
    itemGroup.addEventListener("change", () => filterItemDetailStores(false));
    newQty.addEventListener("input", updateDifference);

    document.addEventListener("DOMContentLoaded", function () {
        filterItemGroups(true);
        filterItemDetailStores(true);
        updateDifference();
    });
</script>
}
