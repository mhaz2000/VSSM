@using VSSM.Application.DTOs.BaseEntities.Arrival
@using VSSM.Application.Helpers
@model PagingSearchOrderDto<ArrivalListDto>

@{
    ViewData["Title"] = "مدیریت ورودها";
    var status = (int)(ViewBag.Status ?? 3);
    int currentStatus = ViewBag.Status is int ? (int)ViewBag.Status : 3;
}
<style>
    .w-full {
        width: 100%;
    }

    .pager-wrap {
        display: flex;
        justify-content: flex-start; /* ← راست‌چین */
        margin-top: 12px;
        direction: rtl;
    }


    .pager-modern {
        margin: 0;
        gap: 0;
    }

        .pager-modern .page-item .page-link {
            min-width: 44px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #e5e7eb;
            border-radius: 0;
            margin-left: -1px; /* چسبیدن مثل عکس */

            background: #fff;
            color: #1d4ed8; /* آبی متن */
            font-weight: 500;
        }

        .pager-modern .page-item.active .page-link {
            background: #0ea5e9; /* آبی/فیروزه‌ای مثل عکس */
            border-color: #0ea5e9;
            color: #fff;
        }

        .pager-modern .page-item.disabled .page-link {
            background: #f9fafb;
            color: #9ca3af;
            cursor: not-allowed;
        }

        .pager-modern .page-item.ellipsis .page-link {
            pointer-events: none;
        }

</style>
<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card mb-2">
            <div class="card-block">
                <form method="get">
                    <div class="row g-2 align-items-center">

                        <!-- سرچ -->
                        <div class="col-lg-5">
                            <input class="form-control"
                                   name="search"
                                   value="@Model.SearchText"
                                   placeholder="شماره گزارش..." />
                        </div>

                        <!-- وضعیت -->
                        <div class="col-lg-3">
                            <select name="status" class="form-select w-100">
                                <option value="1" selected="@(currentStatus == 1)">پیش‌نویس</option>
                                <option value="2" selected="@(currentStatus == 2)">تایید شده</option>
                                <option value="3" selected="@(currentStatus == 3)">همه</option>
                            </select>
                        </div>

                        <!-- دکمه‌ها -->
                        <div class="col-lg-4">
                            <div class="d-flex gap-2 justify-content-end">
                                <button type="submit" class="btn btn-primary px-5">جستجو</button>

                                <a class="btn btn-success px-5" asp-action="New">+ جدید</a>


                            </div>
                        </div>

                    </div>
                </form>
            </div>
        </div>


        <div class="card">
            <div class="card-block">

                <table class="table table-bordered table-striped table-condensed text-center">
                    <thead>
                        <tr>
                            <th>دوره فعالیت</th>
                            <th>تاریخ ورود</th>
                            <th>حجم کل (لیتر)</th>
                            <th>شماره گزارش</th>
                            <th>وضعیت</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                var statusText = item.IsCancelled == true ? "حذف شده"
                                : item.IsConfirmed == true ? "تایید شده"
                                : item.IsDrafted == true ? "پیش‌نویس" : "نامشخص";

                                <tr ondblclick="onRowDblClick(@item.ArrivalId, '@statusText')">
                                    <td>@item.FiscalPeriodName</td>
                                    <td>@item.Date.Value.ToShamsi()</td>
                                    <td>@item.TotalVolume</td>
                                    <td>@item.ReportNumber</td>
                                    <td>@statusText</td>
                                    <td class="text-nowrap">
                                        <div class="btn-group" role="group">

                                            @if (item.IsConfirmed == true)
                                            {
                                                <a class="btn btn-primary btn-sm"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.ArrivalId">
                                                    مشاهده
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="btn btn-primary btn-sm"
                                                   asp-action="New"
                                                   asp-route-id="@item.ArrivalId">
                                                    ویرایش
                                                </a>
                                            }

                                            <!-- ✅ Copy from this row -->
                                            <a class="btn btn-warning btn-sm"
                                               asp-action="CopyFromRow"
                                               asp-route-id="@item.ArrivalId"
                                               title="کپی از این ورود">
                                                کپی
                                            </a>

                                            <a class="btn btn-danger btn-sm"
                                               asp-action="Delete"
                                               asp-route-id="@item.ArrivalId">
                                                حذف
                                            </a>

                                        </div>
                                    </td>


                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-danger">رکوردی یافت نشد.</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @{
                    int page = Model.Paging.Page;
                    int totalPages = Model.Paging.TotalPages;

                    // چند صفحه اطراف صفحه فعلی
                    int window = 2;

                    // لیست صفحات منتخب: 1, ... , (page-window..page+window), ... , totalPages
                    var selected = new SortedSet<int>();

                    if (totalPages >= 1)
                        selected.Add(1);

                    for (int p = page - window; p <= page + window; p++)
                    {
                        if (p >= 1 && p <= totalPages)
                            selected.Add(p);
                    }

                    if (totalPages >= 2)
                        selected.Add(totalPages);

                    string PageUrl(int p) => $"?search={Model.SearchText}&status={status}&page={p}";
                }

                <nav class="pager-wrap" aria-label="Page navigation">
                    <ul class="pagination pager-modern">

                        <!-- قبلی -->
                        <li class="page-item @(page == 1 ? "disabled" : "")">
                            <a class="page-link" href="@(page == 1 ? "#" : PageUrl(page - 1))" tabindex="@(page == 1 ? "-1" : "0")">
                                قبلی
                            </a>
                        </li>

                        @{
                            int prev = 0;
                            foreach (var p in selected)
                            {
                                if (prev != 0 && p - prev > 1)
                                {
                                    <li class="page-item disabled ellipsis">
                                        <span class="page-link">…</span>
                                    </li>
                                }

                                <li class="page-item @(p == page ? "active" : "")">
                                    <a class="page-link" href="@PageUrl(p)">@p</a>
                                </li>

                                prev = p;
                            }
                        }

                        <!-- بعدی -->
                        <li class="page-item @(page == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@(page == totalPages ? "#" : PageUrl(page + 1))" tabindex="@(page == totalPages ? "-1" : "0")">
                                بعدی
                            </a>
                        </li>

                    </ul>
                </nav>




            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function onRowDblClick(id, statusText) {
            // اگر تایید شده است فقط حالت readonly (مثلاً یک Action دیگر مثل Details)
            if (statusText === "تایید شده") {
                window.location.href = '@Url.Action("Edit", "Arrival")' + '?id=' + id; // اگر Details داشتی، تغییر بده
            } else {
                window.location.href = '@Url.Action("Edit", "Arrival")' + '/' + id;
            }
        }


    </script>
}
