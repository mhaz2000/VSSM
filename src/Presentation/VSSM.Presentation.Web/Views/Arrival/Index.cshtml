@using VSSM.Application.DTOs.BaseEntities.Arrival
@using VSSM.Presentation.Web.Models.Base
@using Microsoft.AspNetCore.Mvc.Rendering
@model GridViewModel

@section Styles {
    <link href="~/css/components/shared/grid-wrapper.css" rel="stylesheet" />
}

@{
    ViewData["Title"] = "مدیریت ورودی";
    var currentStatus = Context.Request.Query["status"].ToString() is { Length: > 0 } s ? s : "3";
}

<div class="grid-wrapper">
    <div class="grid-header" style="direction:rtl;">

        <strong style="font-size:1.4rem; font-weight:600; color:#111827;">
            @ViewData["Title"]
        </strong>

        @await Component.InvokeAsync("SearchBar", new
        {
            searchTerm = Model.SearchTerm,
                pageSize = Model.Data.PageSize,
                sort = Model.CurrentSort,
                direction = Model.CurrentDirection,
                addController = "Arrival",
                addAction = "New",
                showAddButton = true,
                filterName = "status",
                filterValue = currentStatus,
                filterOptions = new List<SelectListItem>
                {
                new SelectListItem("همه",        "3", currentStatus == "3"),
                new SelectListItem("پیش‌نویس",   "1", currentStatus == "1"),
                new SelectListItem("تایید شده",  "2", currentStatus == "2"),
                }
                })

    </div>

    <div>
        @await Html.PartialAsync("_DynamicGrid", Model)
    </div>
</div>
