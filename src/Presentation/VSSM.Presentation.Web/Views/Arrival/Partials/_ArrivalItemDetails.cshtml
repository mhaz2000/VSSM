@using VSSM.Presentation.Web.Models.Arrival
@using Microsoft.AspNetCore.Mvc.Rendering
@model ArrivalViewModel
@{
    bool isHalal = false;
    if (ViewBag.IsHalal != null)
    {
        bool.TryParse(ViewBag.IsHalal.ToString(), out isHalal);
    }
}

<div class="a-card">
    <div class="a-card-header">
        <h6>
            <i class="fa fa-info-circle" style="color:#1d6fb8;"></i>
            جزئیات کالا
        </h6>
    </div>
    <div class="a-card-body">

        <div class="fg-3" style="margin-bottom:14px;">

            <div class="f-group">
                <label class="f-label">نوع کالا <span class="opt" id="itemClassLabel">(خودکار)</span></label>
                <input type="text" id="ItemClassDisplay" class="f-control"
                       value="@(isHalal ? "حلال" : "واکسن")" disabled placeholder="نوع کالا" />
            </div>

            <div class="f-group">
                <label class="f-label">
                    کالا
                    <span class="opt" id="itemAutoLabel">@(isHalal ? "(انتخاب)" : "(خودکار)")</span>
                    @if (isHalal)
                    {
                        <span class="req-tag">اجباری</span>
                    }
                </label>

                <input type="text" id="ItemDisplay" class="f-control" disabled
                       placeholder="بر اساس سری ساخت"
                       style="@(isHalal ? "display:none;" : "")" />

                <select id="HalalItemSelect"
                        name="NewLine.ItemId"
                        class="f-control halal-required"
                        style="@(!isHalal ? "display:none;" : "")"
                        @(!isHalal ? "disabled" : "")>
                    <option value="">انتخاب کنید...</option>
                    @if (isHalal && ViewBag.HalalItems != null)
                    {
                        foreach (SelectListItem item in (IEnumerable<SelectListItem>)ViewBag.HalalItems)
                        {
                            <option value="@item.Value"
                                    selected="@(item.Value == Model?.NewLine?.ItemId?.ToString() ? "selected" : null)">
                                @item.Text
                            </option>
                        }
                    }
                </select>

                <input type="hidden" id="ItemIdHidden" name="NewLine.ItemId" value="@Model?.NewLine?.ItemId" data-val="false" />
            </div>

            <div class="f-group" id="doseDisplayGroup"
                 style="@(isHalal ? "display:none;" : "")">
                <label class="f-label">دوز بر ویال <span class="opt" id="doseAutoLabel">(خودکار)</span></label>
                <input type="text" id="DoseDisplay" class="f-control" disabled
                       placeholder="بر اساس سری ساخت" />
            </div>

            <div class="f-group" id="halalDoseGroup"
                 style="@(!isHalal ? "display:none;" : "")">
                <label class="f-label">
                    دوز بر ویال
                    <span class="req-tag">اجباری</span>
                </label>
                <select id="HalalDoseSelect"
                        name="NewLine.DosePerVialId"
                        class="f-control halal-required"
                        @(!isHalal ? "disabled" : "")>
                    @if (isHalal && Model?.NewLine?.DosePerVialId != null && ViewBag.DosePerVials != null)
                    {
                        <option value="">انتخاب دوز...</option>
                        foreach (SelectListItem dose in (IEnumerable<SelectListItem>)ViewBag.DosePerVials)
                        {
                            <option value="@dose.Value"
                                    selected="@(dose.Value == Model.NewLine.DosePerVialId.ToString() ? "selected" : null)">
                                @dose.Text
                            </option>
                        }
                    }
                    else
                    {
                        <option value="">ابتدا کالا را انتخاب کنید</option>
                    }
                </select>

                <input type="hidden" id="HalalDoseValue" name="NewLine.DosePerVial"
                       value="@(isHalal? Model?.NewLine?.DosePerVial?.ToString() : null)" />
            </div>

        </div>

        <input type="hidden"
               name="NewLine.Quantity"
               id="QuantityHidden"
               value="@(!isHalal ? Model?.NewLine?.Quantity?.ToString() : null)"
               @(isHalal ? "disabled" : "") />

        <div class="fg-3" style="margin-bottom:14px;">

            <div class="f-group">
                <label class="f-label">انبار <span class="req-tag">اجباری</span></label>
                <select asp-for="NewLine.StoreId" asp-items="ViewBag.Stores" class="f-control required-select" id="NewLine_StoreId">
                    <option value="">انتخاب...</option>
                </select>
                <span asp-validation-for="NewLine.StoreId" class="text-danger" style="font-size:11px;"></span>
            </div>

            <div class="f-group">
                <label class="f-label">نوع VVM</label>
                <select asp-for="NewLine.VvmTypeId" asp-items="ViewBag.VvmTypes"
                        class="f-control" id="VvmTypeId">
                    <option value="">انتخاب...</option>
                </select>
            </div>

            <div class="f-group">
                <label class="f-label">مرحله VVM</label>
                <select asp-for="NewLine.VvmStageId" asp-items="ViewBag.VvmStages"
                        class="f-control" id="VvmStageId" disabled>
                    <option value="">ابتدا نوع VVM را انتخاب کنید</option>
                </select>
            </div>

        </div>

        <div class="fg-3" style="margin-bottom:14px;">

            <div class="f-group">
                <label class="f-label">نام تجاری</label>
                <select asp-for="NewLine.CommercialNameId" asp-items="ViewBag.BrandNames" class="f-control">
                    <option value="">انتخاب...</option>
                </select>
            </div>

            <div class="f-group">
                <label class="f-label">تولیدکننده</label>
                <select asp-for="NewLine.ManufacturerId" asp-items="ViewBag.Manufacturers" class="f-control">
                    <option value="">انتخاب...</option>
                </select>
            </div>

            <div class="f-group">
                <label class="f-label">مصرف</label>
                <select asp-for="NewLine.UseId" asp-items="ViewBag.Uses" class="f-control">
                    <option value="">انتخاب...</option>
                </select>
            </div>

        </div>

        @* ── تعداد دوز و ویال: فقط در تب حلال نمایش داده می‌شود ── *@
        <div class="fg-3" id="halalQtyFields" style="display:none; margin-bottom:14px;">

            <div class="f-group">
                <label class="f-label">تعداد (دوز) <span class="req-tag">اجباری</span></label>
                <input type="number" id="QuantityInput" name="NewLine.Quantity"
                       class="f-control halal-required" placeholder="تعداد دوز" min="1"
                       value="@(isHalal? Model?.NewLine?.Quantity?.ToString() : null)" />
            </div>

            <div class="f-group">
                <label class="f-label">تعداد ویال <span class="req-tag">اجباری</span></label>
                <input type="number" id="NumVialsInput" name="NewLine.NumVials"
                       class="f-control halal-required" placeholder="خودکار"
                       value="@Model?.NewLine?.NumVials" />
            </div>

        </div>

        <div class="section-divider"></div>

        <div id="vaccineDateSection" style="@(isHalal ? "display:none;" : "")">
            <div class="date-section">

                <div class="date-block">
                    <div class="date-block-header">
                        <div class="date-group-label">
                            تاریخ تولید
                            <span class="req-tag">اجباری</span>
                            <span class="opt">(خودکار)</span>
                        </div>
                        <button type="button" class="btn-date-toggle" data-target="prod"
                                style="display:none;" title="تغییر فرمت">
                            <i class="fa fa-exchange"></i>
                        </button>
                    </div>
                    <div class="date-inner" id="prod-shamsi-wrap">
                        <input type="text" id="ProdDay" class="f-control" placeholder="روز" disabled style="text-align:center;" />
                        <input type="text" id="ProdMonth" class="f-control" placeholder="ماه" disabled style="text-align:center;" />
                        <input type="text" id="ProdYear" class="f-control" placeholder="سال" disabled style="text-align:center;" />
                    </div>
                    <div class="date-inner" id="prod-miladi-wrap" style="display:none;">
                        <input type="text" id="ProdDayM" class="f-control" placeholder="Day" disabled style="text-align:center;" />
                        <input type="text" id="ProdMonthM" class="f-control" placeholder="Month" disabled style="text-align:center;" />
                        <input type="text" id="ProdYearM" class="f-control" placeholder="Year" disabled style="text-align:center;" />
                    </div>
                    <input type="hidden" id="ProductionDate" value="@Model?.NewLine?.ProductionDateShamsi" />
                    <input type="hidden" asp-for="NewLine.ProductionDate" />
                </div>

                <div class="date-block">
                    <div class="date-block-header">
                        <div class="date-group-label">
                            تاریخ انقضا
                            <span class="req-tag">اجباری</span>
                            <span class="opt">(خودکار)</span>
                        </div>
                        <button type="button" class="btn-date-toggle" data-target="exp"
                                style="display:none;" title="تغییر فرمت">
                            <i class="fa fa-exchange"></i>
                        </button>
                    </div>
                    <div class="date-inner" id="exp-shamsi-wrap">
                        <input type="text" id="ExpDay" class="f-control" placeholder="روز" disabled style="text-align:center;" />
                        <input type="text" id="ExpMonth" class="f-control" placeholder="ماه" disabled style="text-align:center;" />
                        <input type="text" id="ExpYear" class="f-control" placeholder="سال" disabled style="text-align:center;" />
                    </div>
                    <div class="date-inner" id="exp-miladi-wrap" style="display:none;">
                        <input type="text" id="ExpDayM" class="f-control" placeholder="Day" disabled style="text-align:center;" />
                        <input type="text" id="ExpMonthM" class="f-control" placeholder="Month" disabled style="text-align:center;" />
                        <input type="text" id="ExpYearM" class="f-control" placeholder="Year" disabled style="text-align:center;" />
                    </div>
                    <input type="hidden" id="ExpiryDate" value="@Model?.NewLine?.ExpiryDateShamsi" />
                    <input type="hidden" asp-for="NewLine.ExpiryDate" />
                </div>

            </div>
        </div>

        <div id="halalDateSection" style="@(!isHalal ? "display:none;" : "")">
            <div class="date-section">

                <div class="date-block">
                    <div class="date-block-header">
                        <div class="date-group-label">تاریخ تولید <span class="req-tag">اجباری</span></div>
                    </div>
                    <div class="datepicker-wrap">
                        <input type="text" id="HalalProdDate" name="NewLine.ProductionDateShamsi"
                               class="f-control datepicker-input halal-required"
                               placeholder="مثال: ۱۴۰۳/۰۱/۰۱" autocomplete="off"
                               value="@Model?.NewLine?.ProductionDateShamsi" />
                        <i class="fa fa-calendar datepicker-ico"></i>
                    </div>
                </div>

                <div class="date-block">
                    <div class="date-block-header">
                        <div class="date-group-label">تاریخ انقضا <span class="req-tag">اجباری</span></div>
                    </div>
                    <div class="datepicker-wrap">
                        <input type="text" id="HalalExpDate" name="NewLine.ExpiryDateShamsi"
                               class="f-control datepicker-input halal-required"
                               placeholder="مثال: ۱۴۰۵/۰۱/۰۱" autocomplete="off"
                               value="@Model?.NewLine?.ExpiryDateShamsi" />
                        <i class="fa fa-calendar datepicker-ico"></i>
                    </div>
                </div>

            </div>
        </div>

        <div class="f-group" style="margin-bottom:16px;">
            <label class="f-label">یادداشت</label>
            <textarea asp-for="NewLine.Note" class="f-control" placeholder="یادداشت اختیاری"></textarea>
        </div>

        <div style="display:flex; justify-content:flex-end;">
            <button type="submit" name="command" value="addLine" id="addLineBtn" class="btn-add-line js-submit-btn" disabled>
                <span class="js-btn-content">
                    <i class="fa fa-plus"></i>
                    افزودن ردیف
                </span>
                <span class="js-btn-spinner" hidden>
                    <span class="submit-spinner"></span>
                    در حال ثبت...
                </span>
            </button>
        </div>

    </div>
</div>