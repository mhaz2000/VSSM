@using VSSM.Presentation.Web.Models.Arrival
@model ArrivalViewModel

<partial name="_ValidationScriptsPartial" />

<script src="~/js/shared/datepicker.js"></script>
<script src="~/js/shared/toast.js"></script>
<script src="~/js/shared/shamsi-date.js"></script>
<script src="~/js/shared/vvm-cascade.js"></script>
<script src="~/js/shared/submit-btn.js"></script>

<script>
    // ── URL های API ──
    var arrivalGetBatchInfoUrl  = "@Url.Action("GetBatchInfo", "Arrival")";
    var arrivalGetHalalItemsUrl = "@Url.Action("GetHalalItems", "Arrival")";
    var arrivalGetHalalDosesUrl = "@Url.Action("GetHalalDoses", "Arrival")";

    // ── مقادیر اولیه برای حالت ویرایش ──
    var arrivalExistItemId   = @Html.Raw(Json.Serialize(Model?.NewLine?.ItemId?.ToString() ?? ""));
    var arrivalExistItemName = @Html.Raw(Json.Serialize(Model?.NewLine?.ItemName ?? ""));
    var arrivalExistDoseId   = @Html.Raw(Json.Serialize(Model?.NewLine?.DosePerVialId?.ToString() ?? ""));
    var arrivalExistDoseName = @Html.Raw(Json.Serialize(Model?.NewLine?.DoseName ?? ""));

    $(function () {
        DatePicker.attach($('#Date'));
    });
</script>

<script src="~/js/components/arrival/arrival-form-vaccine.js?v=3"></script>
<script src="~/js/components/arrival/arrival-form-halal.js?v=3"></script>
<script src="~/js/components/arrival/arrival-datepicker-halal.js?v=1"></script> 


<script>
    // ── مدیریت وضعیت دکمه‌ها ──
    $(function () {
        // تعریف توابع به‌روزرسانی در scope سراسری
        window.updateAddButtonState = function () {
            var isHalal = ($("#ArrivalTypeHidden").val() === "halal");
            var allFilled = true;

            if (isHalal) {
                // فیلدهای اجباری حلال
                var fields = [
                    "#HalalItemSelect",
                    "#HalalDoseSelect",
                    "#QuantityInput",
                    "#NumVialsInput",
                    "#HalalProdDate",
                    "#HalalExpDate"
                ];
                $.each(fields, function (idx, sel) {
                    var $field = $(sel);
                    if ($field.is("select")) {
                        if (!$field.val()) allFilled = false;
                    } else {
                        if (!$field.val().trim()) allFilled = false;
                    }
                });
            } else {
                // واکسن: سری ساخت + انبار (و تاریخ‌ها خودکار پر می‌شوند)
                var batch = $("#BatchNum").val().trim();
                var store = $("#NewLine_StoreId").val();
                var itemId = $("#ItemIdHidden").val();
                var doseId = $("#DosePerVialIdHidden").val();
                var prodDate = $("#ProductionDate").val();
                var expDate = $("#ExpiryDate").val();
                if (!batch || !store || !itemId || !doseId || !prodDate || !expDate) {
                    allFilled = false;
                }
            }

            $("#addLineBtn").prop("disabled", !allFilled);
        };

        window.updateFooterButtonsState = function () {
            var $rows = $(".lines-table tbody tr:not(.empty-row)");
            var hasRows = ($rows.length > 0);
            $(".js-submit-btn[data-command='confirm'], .js-submit-btn[data-command='draft']")
                .prop("disabled", !hasRows);
        };

        // رویدادهای تغییر برای به‌روزرسانی دکمه افزودن
        $(document).on("change input keyup",
            "#BatchNum, #HalalItemSelect, #HalalDoseSelect, #QuantityInput, #NumVialsInput, #HalalProdDate, #HalalExpDate, #NewLine_StoreId",
            function () {
                window.updateAddButtonState();
            }
        );

        $(document).ajaxSuccess(function (e, xhr, settings) {
            if (settings.url && settings.url.indexOf("GetBatchInfo") > -1) {
                window.updateAddButtonState();
            }
        });

        // به‌روزرسانی بعد از تغییر تب (تأخیر برای اعمال تغییرات DOM)
        $(document).on("click", ".arrival-tab", function () {
            setTimeout(function () {
                window.updateAddButtonState();
                window.updateFooterButtonsState();
            }, 100);
        });

        // به‌روزرسانی اولیه
        window.updateAddButtonState();
        window.updateFooterButtonsState();

        // رصد تغییرات جدول برای فعال/غیرفعال کردن دکمه‌های پایین
        var observer = new MutationObserver(function () {
            window.updateFooterButtonsState();
        });
        var tableBody = document.querySelector(".lines-table tbody");
        if (tableBody) {
            observer.observe(tableBody, { childList: true, subtree: true });
        }
    });
</script>