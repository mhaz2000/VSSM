@using VSSM.Presentation.Web.Models.Arrival
@model ArrivalViewModel
@{
    string formTitle = Model?.ArrivalId > 0 ? "ویرایش ورودی" : "ثبت ورودی جدید";
    string icon = Model?.ArrivalId > 0 ? "fa-edit" : "fa-plus-circle";

}

@* ── استایل‌ها ── *@
@section Styles {
    <link href="~/css/persian-datepicker.css" rel="stylesheet" />
    <link href="~/css/components/shared/a-card.css" rel="stylesheet" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" />
    <link href="~/css/components/shared/toast.css" rel="stylesheet" />
    <link href="~/css/components/shared/lines-table.css" rel="stylesheet" />
    <link href="~/css/arrival-form.css" rel="stylesheet" />
}

@* ── Toast container ── *@
<div id="toastContainer"></div>

<div class="arrival-wrap">

    @* ── فرم اصلی: کارت ۱ و ۲ ── *@
    <form asp-action="Create" method="post" id="arrivalForm" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ArrivalId" />
        <input type="hidden" asp-for="EditingLineId" />

        @* hidden inputs برای فیلدهای disabled تا مقدار submit شود *@
        <input type="hidden" id="ItemClassIdHidden" name="NewLine.ItemClassId" value="@Model?.NewLine?.ItemClassId" />
        <input type="hidden" id="ItemIdHidden" name="NewLine.ItemId" value="@Model?.NewLine?.ItemId" />
        <input type="hidden" id="DosePerVialIdHidden" name="NewLine.DosePerVialId" value="@Model?.NewLine?.DosePerVialId" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:13px;"></div>

        @* ── کارت ۱: اطلاعات اصلی ── *@
        <div class="a-card">
            <div class="a-card-header">
                <h6>
                    <i class="fa fa-plus-circle" style="color:#1d6fb8;"></i>
                    @formTitle
                </h6>
            </div>
            <div class="a-card-body">

                <div class="fg-3" style="margin-bottom:14px;">

                    <div class="f-group">
                        <label class="f-label">شماره گزارش</label>
                        <input asp-for="ReportNumber" class="f-control" placeholder="شماره گزارش را وارد کنید" />
                        <span asp-validation-for="ReportNumber" class="text-danger" style="font-size:11px;"></span>
                    </div>

                    <div class="f-group">
                        <label class="f-label">تاریخ ورود <span class="req-tag">اجباری</span></label>
                        <div class="date-triple">
                            <input type="text" id="DateDay" name="DateDay" class="f-control"
                                   inputmode="numeric" maxlength="2" placeholder="روز"
                                   autocomplete="off" style="text-align:center;" />
                            <input type="text" id="DateMonth" name="DateMonth" class="f-control"
                                   inputmode="numeric" maxlength="2" placeholder="ماه"
                                   autocomplete="off" style="text-align:center;" />
                            <input type="text" id="DateYear" name="DateYear" class="f-control"
                                   inputmode="numeric" maxlength="4" placeholder="سال"
                                   autocomplete="off" style="text-align:center;" />
                        </div>
                        <input type="hidden" asp-for="Date" id="Date" />
                        <span asp-validation-for="Date" class="text-danger" style="font-size:11px;"></span>
                    </div>

                    <div class="f-group">
                        <label class="f-label">سری ساخت <span class="req-tag">اجباری</span></label>
                        <input asp-for="NewLine.BatchNum" class="f-control" id="BatchNum"
                               placeholder="سری ساخت را وارد کنید" autocomplete="off" />
                        <span asp-validation-for="NewLine.BatchNum" class="text-danger" style="font-size:11px;"></span>
                    </div>

                </div>

                <div class="f-group">
                    <label class="f-label">ملاحظات</label>
                    <textarea asp-for="Note" class="f-control" placeholder="ملاحظات را وارد کنید"></textarea>
                </div>

            </div>
        </div>

        @* ── کارت ۲: جزئیات کالا ── *@
        <div class="a-card">
            <div class="a-card-header">
                <h6>
                    <i class="fa fa-info-circle" style="color:#1d6fb8;"></i>
                    جزئیات کالا
                </h6>
            </div>
            <div class="a-card-body">

                @* ردیف ۱: نوع کالا | کالا | دوز بر ویال *@
                <div class="fg-3" style="margin-bottom:14px;">
                    <div class="f-group">
                        <label class="f-label">نوع کالا <span class="opt">(خودکار)</span></label>
                        <input type="text" id="ItemClassDisplay" class="f-control"
                               value="واکسن" disabled placeholder="بر اساس سری ساخت" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">کالا <span class="opt">(خودکار)</span></label>
                        <input type="text" id="ItemDisplay" class="f-control" disabled placeholder="بر اساس سری ساخت" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">دوز بر ویال <span class="opt">(خودکار)</span></label>
                        <input type="text" id="DoseDisplay" class="f-control" disabled placeholder="بر اساس سری ساخت" />
                    </div>
                </div>

                @* ردیف ۲: انبار | نوع VVM | مرحله VVM *@
                <div class="fg-3" style="margin-bottom:14px;">
                    <div class="f-group">
                        <label class="f-label">انبار <span class="req-tag">اجباری</span></label>
                        <select asp-for="NewLine.StoreId" asp-items="ViewBag.StoreList" class="f-control">
                            <option value="">انتخاب کنید...</option>
                        </select>
                        <span asp-validation-for="NewLine.StoreId" class="text-danger" style="font-size:11px;"></span>
                    </div>
                    <div class="f-group">
                        <label class="f-label">نوع VVM</label>
                        <select asp-for="NewLine.VvmTypeId" asp-items="ViewBag.VvmTypeList"
                                class="f-control" id="VvmTypeId">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label">مرحله VVM</label>
                        <select asp-for="NewLine.VvmStageId" asp-items="ViewBag.VvmstageList"
                                class="f-control" id="VvmStageId" disabled>
                            <option value="">ابتدا نوع VVM را انتخاب کنید</option>
                        </select>
                    </div>
                </div>

                @* ردیف ۳: نام تجاری | سازنده | مورد استفاده *@
                <div class="fg-3" style="margin-bottom:14px;">
                    <div class="f-group">
                        <label class="f-label">نام تجاری</label>
                        <select asp-for="NewLine.CommertialNameId"
                                asp-items="ViewBag.CommercialNameList" class="f-control">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label">سازنده</label>
                        <select asp-for="NewLine.ManufacturerId"
                                asp-items="ViewBag.ManufacturerList" class="f-control">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label">مورد استفاده</label>
                        <select asp-for="NewLine.UseId" asp-items="ViewBag.UseList" class="f-control">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                </div>

                @* تعداد — hidden، در جدول لیست اقلام نمایش داده می‌شود *@
                <input type="hidden" name="NewLine.Quantity" id="QuantityHidden"
                       value="@Model?.NewLine?.Quantity" />

                <div class="section-divider"></div>

                @* تاریخ تولید و انقضا *@
                <div class="date-section">
                    <div>
                        <div class="date-group-label">تاریخ تولید <span class="opt">(خودکار)</span></div>
                        <div class="date-inner">
                            <input type="text" id="ProdDay" class="f-control" placeholder="روز" disabled style="text-align:center;" />
                            <input type="text" id="ProdMonth" class="f-control" placeholder="ماه" disabled style="text-align:center;" />
                            <input type="text" id="ProdYear" class="f-control" placeholder="سال" disabled style="text-align:center;" />
                        </div>
                        <input type="hidden" id="ProductionDate" value="@Model?.NewLine?.ProductionDateShamsi" />
                        <input type="hidden" asp-for="NewLine.ProductionDate" />
                    </div>
                    <div>
                        <div class="date-group-label">تاریخ انقضا <span class="opt">(خودکار)</span></div>
                        <div class="date-inner">
                            <input type="text" id="ExpDay" class="f-control" placeholder="روز" disabled style="text-align:center;" />
                            <input type="text" id="ExpMonth" class="f-control" placeholder="ماه" disabled style="text-align:center;" />
                            <input type="text" id="ExpYear" class="f-control" placeholder="سال" disabled style="text-align:center;" />
                        </div>
                        <input type="hidden" id="ExpiryDate" value="@Model?.NewLine?.ExpiryDateShamsi" />
                        <input type="hidden" asp-for="NewLine.ExpiryDate" />
                    </div>
                </div>

                <div class="f-group" style="margin-bottom:16px;">
                    <label class="f-label">ملاحظات</label>
                    <textarea asp-for="NewLine.Note" class="f-control"
                              placeholder="ملاحظات کالا را وارد کنید"></textarea>
                </div>

                <div style="display:flex; justify-content:flex-end;">
                    <button type="submit" name="command" value="addLine" class="btn-add-line">
                        <i class="fa fa-plus"></i> افزودن کالا
                    </button>
                </div>

            </div>
        </div>

    </form>
    @* ── پایان فرم اصلی ── *@

    @* ── کارت ۳: لیست اقلام — خارج از فرم اصلی ── *@
    <div class="a-card">
        <div class="a-card-header">
            <h6>
                <i class="fa fa-list" style="color:#1d6fb8;"></i>
                لیست اقلام این ورود
            </h6>
        </div>

        <div class="lines-table-wrap inset">
            <table class="lines-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>کالا</th>
                        <th>نام تجاری</th>
                        <th>سری ساخت</th>
                        <th>تعداد</th>
                        <th>انبار</th>
                        <th>انقضا</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Lines != null && Model.Lines.Any())
                    {
                        for (int i = 0; i < Model.Lines.Count; i++)
                        {
                            var line = Model.Lines[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@line.ItemName</td>
                                <td>@line.CommertialName</td>
                                <td>@line.BatchNum</td>
                                <td>@line.Quantity</td>
                                <td>@line.StoreName</td>
                                <td>@line.ExpiryDate?.ToShamsi()</td>
                                <td style="white-space:nowrap;">
                                    <form asp-action="Create" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ArrivalId" value="@Model?.ArrivalId" />
                                        <input type="hidden" name="command" value="editLine_@line.ArrivalLineId" />
                                        <button type="submit" class="btn-action btn-action-edit" title="ویرایش">
                                            <i class="fa fa-edit"></i>
                                        </button>
                                    </form>
                                    <form asp-action="Create" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ArrivalId" value="@Model?.ArrivalId" />
                                        <input type="hidden" name="command" value="deleteLine_@line.ArrivalLineId" />
                                        <button type="submit" class="btn-action btn-action-del" title="حذف">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" style="padding:24px; color:#9ca3af; text-align:center;">
                                آیتمی ثبت نشده است.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="form-footer">
            <button type="button" value="confirm" class="btn-confirm js-footer-btn">
                <i class="fa fa-check"></i> ثبت
            </button>
            <button type="button" value="draft" class="btn-draft js-footer-btn">
                <i class="fa fa-save"></i> پیش‌نویس
            </button>
            <a asp-action="Index" class="btn-back">
                <i class="fa fa-arrow-right"></i> بازگشت
            </a>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/persian-date.js"></script>
    <script src="~/js/persian-datepicker.js"></script>

    @* ── shared modules ── *@
    <script src="~/js/shared/toast.js"></script>
    <script src="~/js/shared/shamsi-date.js"></script>
    <script src="~/js/shared/vvm-cascade.js"></script>

    @* ── متغیرهای اختصاصی این صفحه: تزریق مقادیر C# به JS ── *@
    <script>
        var arrivalServerMsg   = "@(TempData["ToastMessage"] as string ?? "")";
        var arrivalServerType  = "@(TempData["ToastType"] as string ?? "info")";
        var arrivalGetBatchInfoUrl = "@Url.Action("GetBatchInfo", "Arrival")";

        var arrivalExistItemName = @Html.Raw(Json.Serialize(Model?.NewLine?.ItemName ?? ""));
        var arrivalExistDoseName = @Html.Raw(Json.Serialize(Model?.NewLine?.DoseName ?? ""));
        var arrivalExistItemId   = @Html.Raw(Json.Serialize(Model?.NewLine?.ItemId?.ToString() ?? ""));
        var arrivalExistDoseId   = @Html.Raw(Json.Serialize(Model?.NewLine?.DosePerVialId?.ToString() ?? ""));

        var arrivalItemName = @Html.Raw(Json.Serialize(Model?.NewLine?.ItemName ?? ""));
        var arrivalDoseName = @Html.Raw(Json.Serialize(Model?.NewLine?.DoseName ?? ""));
    </script>

    @* ── لاجیک اختصاصی فرم ── *@
    <script src="~/js/arrival-form.js"></script>
}
