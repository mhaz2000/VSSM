@using VSSM.Presentation.Web.Models.Arrival
@model ArrivalViewModel

@{
    string formTitle = Model?.ArrivalId > 0 ? "ویرایش ورود" : "ثبت ورود جدید";
}

@section Styles {
    <link href="~/css/persian-datepicker.css" rel="stylesheet" />
}

<style>

    .pale-green-btn {
        background-color: #e8f5e9; /* سبز خیلی کمرنگ */
        border: 1px solid #a5d6a7;
        color: #2e7d32;
    }

        .pale-green-btn:hover {
            background-color: #dcedc8;
            border-color: #81c784;
            color: #1b5e20;
        }

    .form-label {
        width: 140px;
        margin-left: 10px;
        text-align: left;
        font-weight: 600;
    }

    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        direction: rtl;
    }

    .form-control, .form-select {
        flex: 1;
    }

    .required-star {
        color: red;
        margin-right: 3px;
    }

    .card {
        direction: rtl;
    }

    .lines-table th, .lines-table td {
        vertical-align: middle;
        text-align: center;
    }

    .allign-text {
        margin-top: 10px;
    }

    .calc-box {
        background: #f5f9ff;
        border: 1px solid #d0d9f0;
        padding: 10px 15px;
        margin-top: 10px;
        border-radius: 6px;
    }
</style>

<div class="container-fluid">
    <div class="animated fadeIn">

        <!-- عنوان فرم -->
        <div class="card mb-2">
            <div class="card-block">
                <h5>@formTitle</h5>
            </div>
        </div>

        <div class="card">
            <div class="card-block">

                <form asp-action="Create" method="post" class="form-horizontal">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="ArrivalId" />

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- ================== بخش هدر ورود ================== -->
                    <div class="col-lg-12">
                        <div class="form-group">
                            <span class="form-label">
                                <span class="required-star">*</span>
                                تاریخ ورود:
                            </span>

                            <input type="text" asp-for="Date" class="form-control" />
                            <span asp-validation-for="Date" class="text-danger"></span>
                        </div>



                        <!-- منبع (الزامی) -->
                        <div class="form-group">
                            <span class="form-label">
                                منبع:
                            </span>
                            <select asp-for="SourceId"
                                    asp-items="ViewBag.SourceList"
                                    class="form-select">
                                <option value="">انتخاب کنید...</option>
                            </select>
                        </div>

                        <!-- شماره گزارش -->
                        <div class="form-group">
                            <span class="form-label">
                                شماره گزارش:
                            </span>
                            <input asp-for="ReportNumber" class="form-control" />
                            <span asp-validation-for="ReportNumber" class="text-danger"></span>
                        </div>

                        <!-- حجم بسته -->
                        <div class="form-group">
                            <span class="form-label">
                                حجم بسته(لیتر):
                            </span>
                            <input asp-for="PackedVolume" class="form-control" />

                        </div>

                        <!-- وزن کل -->
                        <div class="form-group">
                            <span class="form-label">
                                وزن کل (کیلوگرم):
                            </span>
                            <input asp-for="TotalWeight" class="form-control" />

                        </div>

                        <!-- حجم کل لیتر (خلاصه) -->
                        <div class="form-group">
                            <span class="form-label">
                                حجم کل (لیتر):
                            </span>
                            <input asp-for="TotalVolume" class="form-control" readonly />
                        </div>

                        <!-- تشخیص دهنده سرما -->
                        <div class="form-group">
                            <span class="form-label">تشخیص دهنده سرما:</span>
                            <input asp-for="Frzindc" class="form-control" />
                        </div>

                        <!-- تشخیص دهنده سرما غیر معتبر -->
                        <div class="form-group">
                            <span class="form-label">تشخیص دهنده سرما غیر معتبر:</span>
                            <input asp-for="FrzindcNok" class="form-control" />
                        </div>

                        <!-- ملاحظات -->
                        <div class="form-group">
                            <span class="form-label">ملاحظات:</span>
                            <textarea asp-for="Note" class="form-control"></textarea>
                        </div>

                    </div>






                    <!-- ================== بخش جزییات کالا (ArrivalLine) ================== -->

                    <div class="col-lg-12">
                        <h6 class="mb-3">جزئیات کالا</h6>

                        <div class="row">

                            <div class="col-lg-6">

                                <!-- نوع کالا -->
                                <div class="form-group">
                                    <span class="form-label">
                                        <span class="required-star">*</span>
                                        نوع کالا:
                                    </span>
                                    <select id="ItemClassId"
                                            asp-for="NewLine.ItemClassId"
                                            asp-items="ViewBag.itemClassList"
                                            class="form-select">
                                        <option value="">انتخاب کنید...</option>
                                    </select>
                                </div>

                                <!-- کالا -->
                                <div class="form-group">
                                    <span class="form-label">
                                        <span class="required-star">*</span>
                                        کالا:
                                    </span>
                                    <select id="ItemId"
                                            asp-for="NewLine.ItemId"
                                            data-selected="@Model?.NewLine?.ItemId"
                                            class="form-select"
                                            disabled>
                                        <option value="">ابتدا نوع کالا را انتخاب کنید</option>
                                    </select>
                                </div>


                                <!-- نام تجاری -->
                                <div class="form-group">
                                    <span class="form-label">نام تجاری:</span>
                                    <select asp-for="NewLine.CommertialNameId"
                                            asp-items="ViewBag.CommercialNameList"
                                            class="form-select">
                                        <option value="">انتخاب کنید...</option>
                                    </select>
                                </div>

                                <!-- سازنده -->
                                <div class="form-group">
                                    <span class="form-label">سازنده:</span>
                                    <select asp-for="NewLine.ManufacturerId"
                                            asp-items="ViewBag.ManufacturerList"
                                            class="form-select">
                                        <option value="">انتخاب کنید...</option>
                                    </select>
                                </div>

                                <!-- دوز بر ویال -->
                                <div class="form-group">
                                    <span class="form-label">
                                        <span class="required-star">*</span>
                                        دوز بر ویال
                                    </span>
                                    <select asp-for="NewLine.DosePerVialId"
                                            asp-items="ViewBag.DosePerVialList"
                                            data-selected="@Model?.NewLine?.DosePerVialId"
                                            class="form-select"
                                            id="DosePerVialId"
                                            disabled>
                                        <option value="">ابتدا کالا را انتخاب کنید</option>
                                    </select>

                                    <span asp-validation-for="NewLine.DosePerVialId" class="text-danger"></span>
                                </div>

                                <!-- تعداد (الزامی) -->
                                <div class="form-group">
                                    <span class="form-label">
                                        <span class="required-star">*</span>
                                        تعداد:
                                    </span>
                                    <input asp-for="NewLine.Quantity" class="form-control" id="Quantity" />
                                    <span asp-validation-for="NewLine.Quantity" class="text-danger"></span>
                                </div>

                                <!-- تعداد ویال (محاسبه‌ای) -->
                                <div class="form-group">
                                    <span class="form-label">تعداد ویال:</span>
                                    <input asp-for="NewLine.NumVials" class="form-control" id="NumVials" readonly />
                                </div>

                                <!-- حجم واحد (لیتر) -->
                                <div class="form-group">
                                    <span class="form-label">حجم واحد (لیتر):</span>
                                    <input asp-for="NewLine.UnitVolume" class="form-control" id="UnitVolume" />
                                </div>

                                <!-- حجم کل (لیتر) -->
                                <div class="form-group">
                                    <span class="form-label">حجم کل (لیتر):</span>
                                    <input asp-for="NewLine.TotalVolume" class="form-control" id="LineTotalVolume" />
                                </div>

                            </div>

                            <div class="col-lg-6">

                                <!-- انبار (الزامی) -->
                                <div class="form-group">
                                    <span class="form-label">
                                        <span class="required-star">*</span>
                                        انبار:
                                    </span>
                                    <select asp-for="NewLine.StoreId"
                                            asp-items="ViewBag.StoreList"
                                            class="form-select">
                                        <option value="">انتخاب کنید...</option>
                                    </select>
                                    <span asp-validation-for="NewLine.StoreId" class="text-danger"></span>
                                </div>

                                <!-- مورد استفاده -->
                                <div class="form-group">
                                    <span class="form-label">مورد استفاده:</span>
                                    <select asp-for="NewLine.UseId"
                                            asp-items="ViewBag.UseList"
                                            class="form-select">
                                        <option value="">انتخاب کنید...</option>
                                    </select>
                                </div>

                                <!-- نوع VVM -->
                                <!-- نوع VVM -->
                                <div class="form-group">
                                    <span class="form-label">نوع VVM:</span>
                                    <select asp-for="NewLine.VvmTypeId"
                                            asp-items="ViewBag.VvmTypeList"
                                            class="form-select"
                                            id="VvmTypeId">
                                        <option value="">انتخاب کنید...</option>
                                    </select>
                                </div>

                                <!-- مرحله VVM -->
                                <div class="form-group">
                                    <span class="form-label">مرحله VVM:</span>
                                    <select asp-for="NewLine.VvmStageId"
                                            asp-items="ViewBag.VvmstageList"
                                            class="form-select"
                                            id="VvmStageId"
                                            disabled>
                                        <option value="">ابتدا نوع VVM را انتخاب کنید</option>
                                    </select>
                                </div>


                                <!-- نوع بسته -->
                                <div class="form-group">
                                    <span class="form-label">نوع بسته:</span>
                                    <select asp-for="NewLine.PackingTypeId"
                                            asp-items="ViewBag.PackingTypeList"
                                            class="form-select">
                                        <option value="">انتخاب کنید...</option>
                                    </select>
                                </div>

                                <!-- سایز بسته -->
                                <div class="form-group">
                                    <span class="form-label">سایز بسته:</span>
                                    <input asp-for="NewLine.PackageSize" class="form-control" />
                                </div>

                                <!-- سری ساخت -->
                                <div class="form-group">
                                    <span class="form-label">
                                        <span class="required-star">*</span>
                                        سری ساخت:
                                    </span>
                                    <input asp-for="NewLine.BatchNum" class="form-control" />
                                    <span asp-validation-for="NewLine.BatchNum" class="text-danger"></span>
                                </div>


                                <div class="form-group">
                                    <label class="form-label">تاریخ تولید:</label>
                                    <input type="date"
                                           asp-for="NewLine.ProductionDate"
                                           class="form-control"
                                           value="" />
                                </div>

                                <div class="form-group">
                                    <span class="form-label">
                                        <span class="required-star">*</span>
                                        تاریخ انقضا:
                                    </span>
                                    <input type="date"
                                           asp-for="NewLine.ExpiryDate"
                                           class="form-control" />
                                    <span asp-validation-for="NewLine.ExpiryDate" class="text-danger"></span>
                                </div>




                                <!-- ملاحظات خط -->
                                <div class="form-group">
                                    <span class="form-label">ملاحظات:</span>
                                    <textarea asp-for="NewLine.Note" class="form-control"></textarea>
                                </div>

                            </div>
                        </div>

                        @*      <!-- جعبه پایین برای حداقل/حداکثر/سطح درخواست و محاسبه (طبق منطق تو) -->
                        <div class="calc-box">
                            <div class="row">
                                <div class="col-lg-4">
                                    <div class="form-group mb-2">
                                        <span class="form-label">حداقل موجودی:</span>
                                        <input class="form-control" id="CalcStockMin" />
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="form-group mb-2">
                                        <span class="form-label">حداکثر موجودی:</span>
                                        <input class="form-control" id="CalcStockMax" />
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="form-group mb-2">
                                        <span class="form-label">سطح درخواست:</span>
                                        <input class="form-control" id="CalcOrderLevel" />
                                    </div>
                                </div>
                            </div>

                            <button type="button" class="btn btn-info w-100" onclick="showCalcPopup()">
                                محاسبه
                            </button>
                        </div> *@

                        <!-- دکمه افزودن کالا به گرید -->
                        <div class="text-center mt-3 allign-text">
                            <button type="submit"
                                    name="command"
                                    value="addLine"
                                    class="btn btn-light px-4 pale-green-btn">
                                افزودن کالا
                            </button>
                        </div>


                    </div>



                    <!-- ================== گرید خطوط موجود ================== -->

                    <div class="col-lg-12 allign-text">
                        <h6 class="mb-2">لیست اقلام این ورود</h6>

                        <table class="table table-bordered table-striped table-condensed lines-table">
                            <thead>
                                <tr>
                                    <th>کالا</th>
                                    <th>نام تجاری</th>
                                    <th>سری ساخت</th>
                                    <th>تعداد</th>
                                    <th>تعداد ویال</th>
                                    <th>حجم کل (لیتر)</th>
                                    <th>انبار</th>
                                    <th>انقضا</th>
                                    <th>عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Lines != null && Model.Lines.Any())
                                {
                                    for (int i = 0; i < Model.Lines.Count; i++)
                                    {
                                        var line = Model.Lines[i];
                                        <tr>
                                            <td>@line.ItemName</td> @* یا نام کالا اگر در DTO آورده‌ای *@
                                            <td>@line.CommertialName</td>
                                            <td>@line.BatchNum</td>
                                            <td>@line.Quantity</td>
                                            <td>@line.NumVials</td>
                                            <td>@line.TotalVolume</td>
                                            <td>@line.StoreName</td>
                                            <td>@line.ExpiryDate?.ToString("yyyy/MM/dd")</td>
                                            <td>
                                                <button type="submit"
                                                        name="command"
                                                        value="deleteLine_@line.ArrivalLineId"
                                                        class="btn btn-danger btn-sm">
                                                    حذف
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted">
                                            آیتمی ثبت نشده است.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- دکمه‌های اصلی فرم -->
                    <div class="text-center mt-4 mb-2">
                        <button type="submit" name="command" value="draft" class="btn btn-warning px-4">
                            ذخیره به عنوان پیش‌نویس
                        </button>
                        <button type="submit" name="command" value="confirm" class="btn btn-success px-4 mx-2">
                            تایید
                        </button>
                        @*    <button type="submit" name="command" value="deleteAll" class="btn btn-danger px-4">
                            حذف کل ورود
                        </button> *@
                        <a asp-action="Index" class="btn btn-primary px-4 mx-2">بازگشت به لیست</a>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/persian-date.js"></script>
    <script src="~/js/persian-datepicker.js"></script>
    <script>
        $(function () {


            const $itemClass = $("#ItemClassId");
            const $item = $("#ItemId");
            const $dose = $("#DosePerVialId");
            const $vvmType = $("#VvmTypeId");
            const $vvmStage = $("#VvmStageId");

            async function loadItemsByClass(classId, selectedItemId) {
                $item.prop("disabled", true).empty()
                     .append($("<option>").val("").text("در حال دریافت..."));

                if (!classId) {
                    $item.empty().append($("<option>").val("").text("ابتدا نوع کالا را انتخاب کنید"));
                    return;
                }

                const res = await $.getJSON("/Arrival/GetItemsByClass", { classId });

                $item.empty().append($("<option>").val("").text("انتخاب کنید..."));
                res.forEach(x => $item.append($("<option>").val(x.id).text(x.text)));

                $item.prop("disabled", false);

                if (selectedItemId) $item.val(selectedItemId).trigger("change");
            }

            async function loadDosePerVials(itemId, selectedDoseId) {
                $dose.prop("disabled", true).empty()
                     .append($("<option>").val("").text("در حال دریافت..."));

                if (!itemId) {
                    $dose.empty().append($("<option>").val("").text("ابتدا کالا را انتخاب کنید"));
                    return;
                }

                const res = await $.get("@Url.Action("GetDosePerVialsByItem", "Arrival")", { itemId });

                $dose.empty().append($("<option>").val("").text("انتخاب کنید..."));
                res.forEach(x => $dose.append($("<option>").val(x.value).text(x.text)));

                $dose.prop("disabled", false);
                if (selectedDoseId) $dose.val(selectedDoseId);
            }

            // events
            $itemClass.on("change", function () {
                loadItemsByClass($(this).val(), null);
            });

            $item.on("change", function () {
                loadDosePerVials($(this).val(), null);
            });

            $vvmType.on("change", function () {
                if($vvmType.val() != "")
                    $vvmStage.prop("disabled", false);
                else{
                    $vvmStage.prop("disabled", true);
                    $vvmStage.val("");
                }
            });

            // ✅ init from server model after return View
            const initClassId = $itemClass.val();
            const initItemId = $("#ItemId").attr("data-selected");   // می‌سازیم پایین
            const initDoseId = $("#DosePerVialId").attr("data-selected");

            if (initClassId) {
                loadItemsByClass(initClassId, initItemId);
                if (initItemId) loadDosePerVials(initItemId, initDoseId);
            }




            // ===============================
            // Calculations (NumVials + TotalVolume)
            // ===============================
            function recalcNumVials() {
                var qty = parseFloat($("#Quantity").val()) || 0;
                var dose = parseFloat($("#DosePerVialId option:selected").text()) || 0;
                if (dose > 0) $("#NumVials").val(Math.floor(qty / dose));
                else $("#NumVials").val("");
            }


            $("#Quantity, #DosePerVialId").on("change keyup", function () {
                recalcNumVials();
                 ;
            });


            // ===============================
            // Datepicker (Persian only for Date)
            // ===============================
            $("#Date").pDatepicker({
                 format: "YYYY/MM/DD",
                timePicker: {
                    enabled: false
                },
                initialValueType: "1404/10/10",
                autoClose: true
            });

        });
    </script>






}
