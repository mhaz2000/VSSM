@model VSSM.Application.DTOs.BaseEntities.ArrivalRepConfig.ArrivalRepConfigDto
@using Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "تنظیمات گزارش ورود";
}

<div class="card">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">تنظیمات گزارش ورود</h5>
    </div>

    <div class="card-body">
        <form asp-action="Save" method="post">
            <div class="row">

                
                <div class="col-md-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="ReportNumber" checked disabled />
                        <input type="hidden" asp-for="ReportNumber" value="true" />
                        <label class="form-check-label" asp-for="ReportNumber">شماره گزارش</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Source" />
                        <label class="form-check-label" asp-for="Source">منبع</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="OrderPurchaseNumber" />
                        <label class="form-check-label" asp-for="OrderPurchaseNumber">Order Number</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="ItemClass" />
                        <label class="form-check-label" asp-for="ItemClass">نوع کالا</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="ItemCode" />
                        <label class="form-check-label" asp-for="ItemCode">کد</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="ItemName" checked disabled />
                        <input type="hidden" asp-for="ItemName" value="true" />
                        <label class="form-check-label" asp-for="ItemName">کالا</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Manufacturer" />
                        <label class="form-check-label" asp-for="Manufacturer">سازنده</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="BatchNumber" />
                        <label class="form-check-label" asp-for="BatchNumber">سری ساخت</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="DosePerVial" />
                        <label class="form-check-label" asp-for="DosePerVial">دوز به ویال</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="NumberOfVial" />
                        <label class="form-check-label" asp-for="NumberOfVial">تعداد دوز به ویال</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Quantity" checked disabled />
                        <input type="hidden" asp-for="Quantity" value="true" />
                        <label class="form-check-label" asp-for="Quantity">تعداد</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="UnitPrice" />
                        <label class="form-check-label" asp-for="UnitPrice">مبلغ واحد</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="TotalPrice" />
                        <label class="form-check-label" asp-for="TotalPrice">مبلغ کل</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Activity" />
                        <label class="form-check-label" asp-for="Activity">فعالیت</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="ExpireDate" />
                        <label class="form-check-label" asp-for="ExpireDate">تاریخ انقضا</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="UnitVolume" />
                        <label class="form-check-label" asp-for="UnitVolume">حجم واحد</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="TotalVolume" />
                        <label class="form-check-label" asp-for="TotalVolume">حجم کل</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="ArrivalDate" />
                        <label class="form-check-label" asp-for="ArrivalDate">تاریخ دریافت</label>
                    </div>
                </div>

            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-success">ذخیره</button>
            </div>
        </form>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mt-3">
                @TempData["Success"]
            </div>
        }
    </div>
</div>
