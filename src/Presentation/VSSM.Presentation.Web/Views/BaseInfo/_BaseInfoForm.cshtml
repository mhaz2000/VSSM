@using VSSM.Application.DTOs.BaseEntities.BaseInfo
@model BaseInfoInputDto

<div class="modal-header">
    <h5 class="modal-title">
        @(Model.BaseInfoId is null || Model.BaseInfoId == 0 ? "افزودن" : "ویرایش")
    </h5>
</div>

<form asp-action="Save"
      asp-controller="BaseInfo"
      method="post">

    <input asp-for="ParentId" type="hidden" />
    <input asp-for="BaseInfoId" type="hidden" />

    <div class="modal-body">


        <div class="form-group">
            <label asp-for="Title">عنوان <span style="color: grey">(اجباری)</span></label>
            <input asp-for="Title" class="form-control"/>
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Code">کد</label>
            <input asp-for="Code" class="form-control" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Order">ترتیب نمایش</label>
            <input asp-for="Order" class="form-control" />
            <span asp-validation-for="Order" class="text-danger"></span>
        </div>

    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-light"
                data-dismiss="modal">
            انصراف
        </button>

        <button type="submit"
                class="btn btn-primary">
            ذخیره
        </button>
    </div>

</form>

<script>
    $(document).ready(function() {
        $('form').on('submit', function(e) {
            // Clear previous validation
            $('.text-danger').empty();
            $('.is-invalid').removeClass('is-invalid');

            var title = $('#Title').val();
            var isValid = true;

            // Check title (using the DTO's required message)
            if (!title || title.trim() === '') {
                e.preventDefault();
                isValid = false;
                $('#Title').addClass('is-invalid');
                $('#Title').siblings('.text-danger').text('عنوان الزامی است.');
            }

            return isValid;
        });

        // Clear validation on input
        $('#Title').on('input', function() {
            if ($(this).val() && $(this).val().trim() !== '') {
                $(this).removeClass('is-invalid');
                $(this).siblings('.text-danger').empty();
            }
        });
    });
</script>