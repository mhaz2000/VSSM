@using VSSM.Application.DTOs.BaseEntities.Climate
@model UpdateClimateDto

@{
    ViewData["Title"] = "ویرایش شرایط اقلیمی";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-header">
                <h5 class="header-title">@ViewData["Title"]</h5>
            </div>

            <div class="card-block">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form asp-action="Edit" method="post" class="form-horizontal">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ClimateId" />

                    <div class="row mb-4 mx-0">

                        <div class="form-group col-lg-4">
                            <label class="form-label">کد</label>
                            <input asp-for="Code"
                                   class="form-control bg-warning-subtle"
                                   required />
                        </div>

                        <div class="form-group col-lg-4">
                            <label class="form-label">نام کامل</label>
                            <input asp-for="FullName"
                                   class="form-control bg-warning-subtle"
                                   required />
                        </div>
                        <div class="form-group col-lg-1"></div>
                        <div class="form-group col-lg-3">
                            <label class="form-label" style="margin-bottom:1.5rem;">وضعیت</label>

                            <div class="d-flex">
                                <div class="form-check">
                                    <input type="radio"
                                           asp-for="IsActive"
                                           value="true"
                                           class="form-check-input"
                                           id="activeTrue" />
                                    <label class="form-check-label" for="activeTrue">
                                        فعال
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input type="radio"
                                           asp-for="IsActive"
                                           value="false"
                                           class="form-check-input"
                                           id="activeFalse" />
                                    <label class="form-check-label" for="activeFalse">
                                        غیرفعال
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="text-left">
                            <button type="submit" class="btn btn-success px-5">ذخیره</button>
                            <a asp-action="Index" class="btn btn-success-outlet px-5">بازگشت</a>
                        </div>

                    </div>
                </form>
            </div>
        </div>

    </div>
</div>
