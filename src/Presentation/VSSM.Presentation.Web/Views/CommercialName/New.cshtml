@using Microsoft.AspNetCore.Mvc.TagHelpers
@model VSSM.Presentation.Web.Models.CommercialName.CommercialNameViewModel
@{
string formName = "ثبت";
if (Model != null && Model.CommercialNameId > 0)
formName = "ویرایش";
}

<style>
    .form-label {
        text-align: left;
        width: 130px;
        margin-left: 15px;
    }

    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        direction: rtl;
    }

    .form-control {
        flex: 1;
    }

    .form-check {
        display: flex;
        align-items: center;
        direction: rtl;
    }

    .form-check-input {
        margin-left: 10px; /* Space between checkbox and label */
    }

    .card {
        direction: rtl;
    }
</style>

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-block">
                <div class="col-lg-3">
                    <div><h5>@formName نام تجاری</h5></div>
                </div>
            </div>
        </div>

        <div>
            <div class="card">
                <div class="card-block">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <form asp-action="Create" method="post" class="form-horizontal">
                        <input type="hidden" asp-for="CommercialNameId" />

                        <div class="col-lg-6">
                            <div class="form-group">
                                <label class="form-label" asp-for="FullName">نام کامل:</label>
                                <input type="text" asp-for="FullName" class="form-control" maxlength="200" />
                            </div>

                            <div class="form-group">
                                <label class="form-label" asp-for="Code">کد:</label>
                                <input type="text" asp-for="Code" class="form-control" maxlength="50" />
                            </div>

                            <div class="form-group">
                                <div class="form-check">
                                    <input type="checkbox" asp-for="IsActive" class="form-check-input" />
                                    <label class="form-check-label" asp-for="IsActive">فعال؟</label>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label" asp-for="EntryDate">تاریخ ورود:</label>
                                <input type="date" asp-for="EntryDate" class="form-control" />
                            </div>

                            <div class="col-lg-8"></div>
                            <div class="col-lg-4">
                                <div class="text-center mt-4 align-middle">
                                    <button type="submit" class="btn btn-success px-5">ثبت</button>
                                    <a type="button" class="btn btn-primary px-5" asp-action="Index">لیست</a>
                                </div>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
