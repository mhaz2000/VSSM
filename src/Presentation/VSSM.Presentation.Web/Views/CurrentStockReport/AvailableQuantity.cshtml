@using VSSM.Application.DTOs.BaseEntities.BaseInfo
@using VSSM.Application.DTOs.BaseEntities.Recipient
@using VSSM.Application.DTOs.BaseEntities.Source
@using VSSM.Application.DTOs.BaseEntities.Store
@using VSSM.Presentation.Web.Models.Base
@{
    ViewData["Title"] = "گزارش مقدار موجود";
    var itemClasses = ViewBag.ItemClasses as List<BaseInfoDto>;
    var recipients = ViewBag.Recipients as List<RecipientGetDto>;
    var chainLevels = ViewBag.ChainLevels as List<int>;
    var items = ViewBag.Items as List<ItemListDto>;
    var sources = ViewBag.Sources as List<SourceGetDto>;
    var stores = ViewBag.Stores as List<StoreListDto>;
    var commercialNames = ViewBag.CommercialNames as List<BaseInfoDto>;
    var manufacturers = ViewBag.Manufacturers as List<BaseInfoDto>;
    var vvmstages = ViewBag.Vvmstages as List<BaseInfoDto>;
    var vvmtypes = ViewBag.Vvmtypes as List<BaseInfoDto>;

    // FIX: افزودن گزینه‌ی «همه مراکز» به‌عنوان مقدار پیش‌فرض
    var recipientOptions = new List<SelectOption>
    {
        new SelectOption { Value = "0", Text = "همه مراکز" }
    };
    if (recipients is not null)
    {
        recipientOptions.AddRange(recipients.Select(x => new SelectOption
        {
            Value = x.RecipientId.ToString(),
            Text = x.FullName
        }));
    }
}
@section Styles {
    <link href="~/css/components/shared/a-card.css" rel="stylesheet" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" />
    <link href="~/css/components/shared/toast.css" rel="stylesheet" />
    <link href="~/css/components/dispatches/dispatch-form.css" rel="stylesheet" />
    <link href="~/css/components/shared/searchable-controls.css" rel="stylesheet" />
    <link href="~/css/components/reports/available-quantity.css" rel="stylesheet" />
    <link href="~/css/components/shared/datepicker.css" rel="stylesheet" />
}
<div class="report-wrap">
    <div class="report-page-title">
        <i class="fa fa-filter" style="color:#3b82f6;"></i>
        <span>@ViewData["Title"]</span>
    </div>

    <form method="post"
          action="/CurrentStockReport/AvailableQuantityReport"
          target="_blank"
          id="availableQuantityForm">
        @Html.AntiForgeryToken()

        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-search" style="color:#3b82f6;"></i>
                <h6>فیلترهای جستجو</h6>
            </div>
            <div class="a-card-body">
                <div class="fg-5-5-3">
                    <!-- ROW 1 -->
                    <div class="f-group filter-item-class">
                        <label class="f-label" for="itemClassId">نوع کالا</label>
                        @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                        new SearchableSelectModel
                        {
                            Id = "itemClassId",
                            Name = "itemClassId",
                            Label = "",
                            Options = itemClasses?.Select(x => new SelectOption { Value = x.Id.ToString(), Text = x.Title }).ToList() ?? new List<SelectOption>()
                        })
                    </div>

                    <div class="f-group filter-items">
                        <label class="f-label" for="itemId">کالاها</label>
                        @await Html.PartialAsync("Components/SearchableMultiSelect/_SearchableMultiSelect",
                                                new SearchableMultiSelectModel
                                                {
                                                    Id = "itemId",
                                                    Name = "itemId",
                                                    Label = "",
                                                    DefaultText = "انتخاب کنید",
                                                    Options = items?.Select(x => new SelectOption { Value = x.ItemId.ToString(), Text = x.FullName }).ToList() ?? new List<SelectOption>()
                                                })
                    </div>

                    <!-- FIX: گزارش پایین با گزینه «همه مراکز» -->
                    <div class="f-group filter-recipient">
                        <label class="f-label" for="recipientId">گزارش پایین</label>
                        @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                                                new SearchableSelectModel
                                                {
                                                    Id = "recipientId",
                                                    Name = "recipientId",
                                                    IsRequired = false,
                                                    Label = "",
                                                    DefaultText = "همه مراکز",
                                                    Options = recipientOptions
                                                })
                    </div>

                    <div class="f-group filter-level">
                        <label class="f-label" for="level">سطح در زنجیره</label>
                        @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                                                new SearchableSelectModel
                                                {
                                                    Id = "level",
                                                    Name = "level",
                                                    IsRequired = false,
                                                    Label = "",
                                                    DefaultText = "-- انتخاب کنید --",
                                                    Options = chainLevels?.Select(x => new SelectOption { Value = x.ToString(), Text = x.ToString() }).ToList() ?? new List<SelectOption>()
                                                })
                    </div>

                    <div class="f-group filter-batch">
                        <label class="f-label" for="batchNumber">سری ساخت</label>
                        <input id="batchNumber" name="batchNumber" class="f-control" placeholder="شماره سری ساخت" autocomplete="off" />
                    </div>

                    <!-- ROW 2 -->
                    <div class="f-group filter-stores">
                        <label class="f-label" for="storeId">انبارها</label>
                        @await Html.PartialAsync("Components/SearchableMultiSelect/_SearchableMultiSelect",
                                                new SearchableMultiSelectModel
                                                {
                                                    Id = "storeId",
                                                    Name = "storeId",
                                                    Label = "",
                                                    DefaultText = "انتخاب کنید",
                                                    Options = stores?.Select(x => new SelectOption { Value = x.StoreId.ToString(), Text = x.FullName }).ToList() ?? new List<SelectOption>()
                                                })
                    </div>

                    <div class="f-group filter-source">
                        <label class="f-label" for="sourceId">منبع</label>
                        @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                                                new SearchableSelectModel
                                                {
                                                    Id = "sourceId",
                                                    Name = "sourceId",
                                                    Label = "",
                                                    DefaultText = "-- انتخاب کنید --",
                                                    Options = sources?.Select(x => new SelectOption { Value = x.SourceId.ToString(), Text = x.FullName }).ToList() ?? new List<SelectOption>()
                                                })
                    </div>

                    <div class="f-group filter-manufacturer">
                        <label class="f-label" for="manufacturerId">سازنده</label>
                        @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                                                new SearchableSelectModel
                                                {
                                                    Id = "manufacturerId",
                                                    Name = "manufacturerId",
                                                    Label = "",
                                                    DefaultText = "-- انتخاب کنید --",
                                                    Options = manufacturers?.Select(x => new SelectOption { Value = x.Id.ToString(), Text = x.Title }).ToList() ?? new List<SelectOption>()
                                                })
                    </div>

                    <div class="f-group filter-vvm-type">
                        <label class="f-label" for="vvmtypeId">نوع VVM</label>
                        @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                                                new SearchableSelectModel
                                                {
                                                    Id = "vvmtypeId",
                                                    Name = "vvmtypeId",
                                                    Label = "",
                                                    DefaultText = "-- انتخاب کنید --",
                                                    Options = vvmtypes?.Select(x => new SelectOption { Value = x.Id.ToString(), Text = x.Title }).ToList() ?? new List<SelectOption>()
                                                })
                    </div>

                    <div class="f-group filter-vvm-stage">
                        <label class="f-label" for="vvmstageId">مرحله VVM</label>
                        @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                                                new SearchableSelectModel
                                                {
                                                    Id = "vvmstageId",
                                                    Name = "vvmstageId",
                                                    Label = "",
                                                    DefaultText = "-- انتخاب کنید --",
                                                    Options = vvmstages?.Select(x => new SelectOption { Value = x.Id.ToString(), Text = x.Title }).ToList() ?? new List<SelectOption>()
                                                })
                    </div>

                    <!-- ROW 3 -->
                    <div class="row-3">
                        <div class="f-group filter-commercial-name">
                            <label class="f-label" for="commercialNameId">نام تجاری</label>
                            @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                                                        new SearchableSelectModel
                                                        {
                                                            Id = "commercialNameId",
                                                            Name = "commercialNameId",
                                                            Label = "",
                                                            DefaultText = "-- انتخاب کنید --",
                                                            Options = commercialNames?.Select(x => new SelectOption { Value = x.Id.ToString(), Text = x.Title }).ToList() ?? new List<SelectOption>()
                                                        })
                        </div>

                        <div class="f-group filter-production-date">
                            <label class="f-label" for="fromDate">تاریخ تولید</label>
                            <div class="datepicker-wrap">
                                <input id="fromDate"
                                       class="f-control datepicker-input"
                                       placeholder="تاریخ تولید"
                                       autocomplete="off" />
                                <i class="fa fa-calendar datepicker-ico"></i>
                            </div>
                            <input type="hidden" id="fromDateEn" name="productinDate" />
                        </div>

                        <div class="f-group filter-expiry-date">
                            <label class="f-label" for="toDate">تاریخ انقضا</label>
                            <div class="datepicker-wrap">
                                <input id="toDate"
                                       class="f-control datepicker-input"
                                       placeholder="تاریخ انقضا"
                                       autocomplete="off" />
                                <i class="fa fa-calendar datepicker-ico"></i>
                            </div>
                            <input type="hidden" id="toDateEn" name="expiryDate" />
                        </div>
                    </div>

                    <!-- All Sub Stores -->
                    <div class="row-checkbox">
                        <input type="checkbox" id="allSubRecipientStocks" class="big-checkbox" name="AllSubRecipientStocks" value="true" />
                        <label for="allSubRecipientStocks">تمام انبارهای زیر مجموعه</label>
                        <input type="hidden" name="AllSubRecipientStocks" value="false" />
                    </div>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <div class="form-footer">
            <a asp-action="Index" class="btn-back">
                <i class="fa fa-arrow-right"></i>
                <span>بازگشت</span>
            </a>
            <button type="submit" class="btn-confirm" name="reportType" value="detail">
                <i class="fa fa-search"></i>
                <span>جزئیات گزارش</span>
            </button>
            <button type="submit" class="btn-confirm" name="reportType" value="summary">
                <i class="fa fa-search"></i>
                <span>خلاصه گزارش</span>
            </button>
            <button type="submit" class="btn-confirm" name="reportType" value="summaryWithDosePerVial">
                <i class="fa fa-search"></i>
                <span>خلاصه با دوز بر ویال</span>
            </button>
            <button type="submit" class="btn-confirm" name="reportType" value="quantitySummary">
                <i class="fa fa-search"></i>
                <span>خلاصه موجودی</span>
            </button>
        </div>
    </form>
</div>

<div id="toastContainer"></div>

@section Scripts {
    <script src="~/js/components/shared/toast.js"></script>
    <script src="~/js/persian-date.js"></script>
    <script src="~/js/shared/datepicker.js"></script>
    <script src="~/js/components/reports/available-quantity.js"></script>
    <script src="~/js/shared/searchable-controls.js"></script>

    <script>
        $(document).ready(function () {
            $('.datepicker-input').each(function () {
                if (typeof DatePicker !== 'undefined' && typeof DatePicker.attach === 'function') {
                    DatePicker.attach($(this), 'jalali');
                }
            });
        });
    </script>

    @if (TempData["ToastMessage"] != null)
    {
        <script>
            showToast('@TempData["ToastMessage"]', '@TempData["ToastType"]');
        </script>
    }
}