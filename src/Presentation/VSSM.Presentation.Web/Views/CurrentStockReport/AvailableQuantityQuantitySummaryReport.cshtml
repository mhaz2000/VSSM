@using Microsoft.AspNetCore.WebUtilities
@using VSSM.Presentation.Web.Models.Base
@model GroupedGridViewModel<object, object>

@{
    Layout = "~/Views/Shared/_ReportLayout.cshtml";
}

@{
    ViewData["Title"] = "مقدار موجود - گزارش خلاصه موجودی";
}

@section Styles {
    <link href="~/css/components/reports/report-header-info.css" rel="stylesheet" />
}

<div style="margin-top: 1rem;">
    @await Html.PartialAsync("ReportHeader")
</div>

<h5 style="text-align: center;">
    @ViewData["Title"]
</h5>

<div style="margin-top: 1rem; display: flex; justify-content: flex-end;">
    <button type="button" class="btn btn-success" onclick="submitExcel()">
        <i class="fas fa-file-excel"></i> خروجی اکسل
    </button>
</div>

@await Html.PartialAsync("_ReportHeaderInfo")

<div style="margin-top: 1rem;">
    @await Html.PartialAsync("_GroupedDynamicGrid", Model)
</div>

@{
    var additional = ViewBag.AdditionalParam?.ToString() ?? "";
}

<!-- فرم ۱: Pagination -->
<form method="post"
      action="/CurrentStockReport/AvailableQuantityReport"
      id="reportForm"
      style="display:none;">
    @Html.AntiForgeryToken()
    @foreach (var pair in additional.Split('&', StringSplitOptions.RemoveEmptyEntries))
    {
        var parts = pair.Split('=', 2);
        var key = Uri.UnescapeDataString(parts[0]);
        var value = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : "";
        <input type="hidden" name="@key" value="@value" />
    }
</form>

<!-- فرم ۲: خروجی اکسل -->
<form method="post"
      action="/CurrentStockReport/AvailableQuantityReport"
      id="excelForm"
      style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="toExcel" value="true" />
    @foreach (var pair in additional.Split('&', StringSplitOptions.RemoveEmptyEntries))
    {
        var parts = pair.Split('=', 2);
        var key = Uri.UnescapeDataString(parts[0]);
        var value = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : "";
        <input type="hidden" name="@key" value="@value" />
    }
</form>

<script>
    (function () {
        let isNavigating = false;

        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.pagination-btn');
            if (!btn) return;
            if (btn.tagName === 'A') return;
            if (btn.classList.contains('disabled')) return;

            if (isNavigating) {
                e.preventDefault();
                e.stopImmediatePropagation();
                return false;
            }

            isNavigating = true;

            document.querySelectorAll('.pagination-btn')
                .forEach(b => b.classList.add('disabled'));

            setTimeout(function () { isNavigating = false; }, 10000);
        }, true);
    })();

    function submitExcel() {
        const form = document.getElementById('excelForm');
        if (!form) {
            console.error("Excel form not found.");
            return;
        }
        form.method = 'post';
        form.submit();
    }
</script>