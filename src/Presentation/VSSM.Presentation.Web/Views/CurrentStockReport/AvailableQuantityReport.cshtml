@using VSSM.Presentation.Web.Models.Base
@model GroupedGridViewModel<object, object>

@{
    Layout = "~/Views/Shared/_ReportLayout.cshtml";
    ViewData["Title"] = "مقدار موجود - جزئیات گزارش";
}

<div style="margin-top: 1rem;">
    @await Html.PartialAsync("ReportHeader")
</div>

<h5 style="text-align: center;">@ViewData["Title"]</h5>

<div style="margin-top: 1rem; display: flex; justify-content: flex-end;">
    <button type="button" class="btn btn-success" onclick="submitExcel()">
        <i class="fas fa-file-excel"></i> خروجی اکسل
    </button>
</div>

<div>
    <div><span>انبار</span>: @(ViewBag.Stores ?? "کلیه انبارها")</div>
    <div><span>کالاها</span>: @(ViewBag.Items ?? "کلیه کالاها")</div>
    <div><span>گزارش پایین</span>: @(ViewBag.RecipientTitle ?? "همه مراکز")</div>
</div>

<div style="margin-top: 1rem;">
    @await Html.PartialAsync("_GroupedDynamicGrid", Model)
</div>

<script>
    function submitExcel() {
        const form = document.querySelector('form');
        if (!form) { console.error("No form found for Excel export."); return; }

        let excelInput = form.querySelector('input[name="toExcel"]');
        if (!excelInput) {
            excelInput = document.createElement('input');
            excelInput.type = 'hidden';
            excelInput.name = 'toExcel';
            form.appendChild(excelInput);
        }
        excelInput.value = 'true';

        @if (ViewBag.AdditionalParam != null)
        {
                string raw = ViewBag.AdditionalParam.ToString();
                foreach (var p in raw.Split('&', StringSplitOptions.RemoveEmptyEntries))
                {
                        var parts = p.Split('=');
                        var key = parts[0];
                        var value = parts.Length > 1 ? parts[1] : "";
                        <text>
                            (function () {
                                let extra = form.querySelector('input[name="@key"]');
                                if (!extra) {
                                    extra = document.createElement('input');
                                    extra.type = 'hidden';
                                    extra.name = '@key';
                                    form.appendChild(extra);
                                }
                                extra.value = '@value';
                            })();
                        </text>
                }
        }

        form.method = 'post';
        form.submit();
    }
</script>