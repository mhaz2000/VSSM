@using VSSM.Presentation.Web.Models.Base
@model GridViewModel

@{
    Layout = "~/Views/Shared/_ReportLayout.cshtml";
}

@{
    ViewData["Title"] = "مقدار موجود - خلاصه گزارش با دوز بر ویال";
}

@section Styles {
    <link href="~/css/components/reports/report-header-info.css" rel="stylesheet" />
}

@{
    // ← cast به object تا dynamic-ness قطع شود و LINQ قابل کامپایل باشد
    object additionalRaw = ViewBag.AdditionalParam;
    string additional = additionalRaw?.ToString() ?? "";

    var additionalPairs = additional
        .Split('&', StringSplitOptions.RemoveEmptyEntries)
        .Select(p => p.Split('=', 2))
        .Select(p => new
        {
            Key = Uri.UnescapeDataString(p[0]),
            Value = p.Length > 1 ? Uri.UnescapeDataString(p[1]) : ""
        })
        .ToList();
}

<div style="margin-top: 1rem;">
    @await Html.PartialAsync("ReportHeader")
</div>


<h5 style="text-align: center;">
    @ViewData["Title"]
</h5>

<div style="margin-top: 1rem; display: flex; justify-content: flex-end;">
    <form method="post"
          action="/CurrentStockReport/AvailableQuantityReport"
          style="margin: 0;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="toExcel" value="true" />
        @foreach (var pair in additionalPairs)
        {
            <input type="hidden" name="@pair.Key" value="@pair.Value" />
        }
        <button type="submit" class="btn btn-success">
            <i class="fas fa-file-excel"></i> خروجی اکسل
        </button>
    </form>
</div>

@await Html.PartialAsync("_ReportHeaderInfo")

<div style="margin-top: 1rem;">
    @await Html.PartialAsync("_DynamicGrid", Model)
</div>

<!-- ═══════ فرم مخفی برای Pagination ═══════ -->
<form method="post"
      action="/CurrentStockReport/AvailableQuantityReport"
      id="reportForm"
      style="display:none;">
    @Html.AntiForgeryToken()
    @foreach (var pair in additionalPairs)
    {
        <input type="hidden" name="@pair.Key" value="@pair.Value" />
    }
</form>

<script>
    // جلوگیری از فریز Pagination در کلیک‌های سریع
    (function () {
        let isNavigating = false;

        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.pagination-btn');
            if (!btn) return;
            if (btn.tagName === 'A') return;
            if (btn.classList.contains('disabled')) return;

            if (isNavigating) {
                e.preventDefault();
                e.stopImmediatePropagation();
                return false;
            }

            isNavigating = true;

            document.querySelectorAll('.pagination-btn')
                .forEach(b => b.classList.add('disabled'));

            setTimeout(function () { isNavigating = false; }, 10000);
        }, true);
    })();
</script>