@using VSSM.Application.DTOs.BaseEntities.FiscalPeriod
@using VSSM.Application.DTOs.BaseEntities.Source
@using VSSM.Application.DTOs.BaseEntities.Store
@using VSSM.Presentation.Web.Models.Base

@{
    ViewData["Title"] = "گزارش عدم ارسال کالا به رده";
}

@{
    var itemClasses = ViewBag.ItemClasses as List<ItemClassListDto>;
    var fiscalPeriods = ViewBag.FiscalPeriods as List<FiscalPeriodDto>;
}


@section Styles {
    <link href="~/css/persian-datepicker.css" rel="stylesheet" />
}

<style>
    .form-control {
        padding: 16px !important;
    }

</style>

<div class="container-fluid">

    <div class="card mt-3">
        <div class="card-block">

            <div class="grid-wrapper">

                <div class="grid-header">
                    <strong style="font-size: 1.2rem">@ViewData["Title"]</strong>
                </div>

                    <form method="get" action="/CurrentStockReport/NotDispatchedToRecipientsReport" target="_blank" class="card p-3 mb-3">


                    <div class="row g-3">

                        <div class="col-md-6 input-sec">

                            @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                            new SearchableSelectModel
                            {
                                Id = "itemClassId",
                                IsRequired = true,
                                Name = "itemClassId",
                                Label = "نوع کالا",
                                Options = itemClasses
                            .Select(x => new SelectOption
                            {
                                Value = x.Id.ToString(),
                                Text = x.Name
                            }).ToList()
                            })
                        </div>

                        <div class="col-md-6 input-sec">

                            @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                                                        new SearchableSelectModel
                                                        {
                                                            Id = "itemId",
                                                            IsRequired = true,
                                                            Name = "itemId",
                                                            Label = "کالا",
                                                            Options = []
                                                        })
                        </div>

                        <div class="col-md-4 input-sec">

                            @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                                                        new SearchableSelectModel
                                                        {
                                                            Id = "fiscalPeriodId",
                                                            IsRequired = false,
                                                            Name = "fiscalPeriodId",
                                                            Label = "دوره فعالیت",
                                                            Options = fiscalPeriods
                                                        .Select(x => new SelectOption
                                                        {
                                                            Value = x.FiscalPeriodId.ToString(),
                                                            Text = x.FullName
                                                        }).ToList()
                                                        })
                        </div>

                        <div class="col-md-4 input-sec">
                            <label class="form-label">از تاریخ</label>
                            <input id="fromDate" class="form-control bg-warning-subtle" />
                            <input type="hidden" id="fromDateEn" name="fromDate" />
                        </div>

                        <div class="col-md-4 input-sec">
                            <label class="form-label">تا تاریخ</label>
                            <input id="toDate" class="form-control bg-warning-subtle" />
                            <input type="hidden" id="toDateEn" name="toDate" />
                        </div>

                    </div>

                    <div class="text-start mt-3" style="margin-top: 1rem; margin-right: 0px;">
                        <button type="submit" class="btn btn-primary" id="searchBtn" disabled>
                            <i class="fa fa-search"></i> جستجو
                        </button>

                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/persian-date.js"></script>
    <script src="~/js/persian-datepicker.js"></script>
    <script src="~/js/components/reports/not-dispatched-report.js"></script>
}
