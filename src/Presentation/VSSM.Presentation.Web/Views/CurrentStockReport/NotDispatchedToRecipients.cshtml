@using VSSM.Application.DTOs.BaseEntities.FiscalPeriod
@using VSSM.Application.DTOs.BaseEntities.Source
@using VSSM.Presentation.Web.Models.Base
@{
    ViewData["Title"] = "گزارش عدم ارسال کالا به رده";

    var itemClasses    = ViewBag.ItemClasses    as List<ItemClassListDto> ?? new();
    var fiscalPeriods  = ViewBag.FiscalPeriods  as List<FiscalPeriodDto>   ?? new();

    List<SelectOption> Opts<T>(IEnumerable<T> src, Func<T, string> v, Func<T, string> t)
        => src.Select(x => new SelectOption { Value = v(x), Text = t(x) }).ToList();
}

@section Styles {
    <link href="~/css/components/shared/a-card.css" rel="stylesheet" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" />
    <link href="~/css/components/shared/toast.css" rel="stylesheet" />
    <link href="~/css/components/shared/searchable-controls.css" rel="stylesheet" />
    <link href="~/css/components/shared/datepicker.css" rel="stylesheet" />
    <link href="~/css/components/reports/not-dispatched-report.css" rel="stylesheet" />
}

<div class="report-wrap">
    <div class="report-page-title">
        <i class="fa fa-ban" style="color:#16a34a;"></i>
        <span>@ViewData["Title"]</span>
    </div>

    <form method="post" action="/CurrentStockReport/NotDispatchedToRecipientsReport"
          target="_blank" id="notDispatchedReportForm">
        @Html.AntiForgeryToken()

        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-filter" style="color:#16a34a;"></i>
                <h6>فیلترها</h6>
            </div>
            <div class="a-card-body">

                <section class="filter-section">
                    <header class="filter-section-header">
                        <span class="filter-section-badge">۱</span>
                        <h5>جستجو</h5>
                    </header>
                    <div class="filters-grid filters-grid-2">

                        <div class="f-group">
                            <label class="f-label" for="itemClassId">
                                نوع کالا <span class="req">*</span>
                            </label>
                            @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                                new SearchableSelectModel
                                {
                                    Id = "itemClassId", Name = "itemClassId",
                                    IsRequired = true,
                                    Label = "", DefaultText = "انتخاب کنید",
                                    Options = Opts(itemClasses, x => x.Id.ToString(), x => x.Name)
                                })
                        </div>

                        <div class="f-group">
                            <label class="f-label" for="itemId">
                                کالا <span class="req">*</span>
                            </label>
                            @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                                new SearchableSelectModel
                                {
                                    Id = "itemId", Name = "itemId",
                                    IsRequired = true,
                                    Label = "", DefaultText = "ابتدا نوع کالا را انتخاب کنید",
                                    Options = new List<SelectOption>()
                                })
                        </div>

                    </div>
                </section>

                <section class="filter-section">
                    <header class="filter-section-header">
                        <span class="filter-section-badge">۲</span>
                        <h5>دوره و تاریخ</h5>
                    </header>
                    <div class="filter-section-body">

                        <div class="filters-grid filters-grid-3">

                            <div class="f-group">
                                <label class="f-label" for="fiscalPeriodId">دوره فعالیت</label>
                                @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                                    new SearchableSelectModel
                                    {
                                        Id = "fiscalPeriodId", Name = "fiscalPeriodId",
                                        IsRequired = false,
                                        Label = "", DefaultText = "انتخاب کنید",
                                        Options = Opts(fiscalPeriods,
                                            x => x.FiscalPeriodId.ToString(),
                                            x => x.FullName)
                                    })
                            </div>

                            <div class="f-group">
                                <div class="f-label-row">
                                    <label class="f-label" for="fromDate">از تاریخ</label>
                                    <button type="button" class="btn-toggle-date-mode"
                                            data-target="fromDate" data-mode="jalali">
                                        <i class="fa fa-exchange"></i>
                                        <span class="mode-label">شمسی</span>
                                    </button>
                                </div>
                                <div class="datepicker-wrap">
                                    <input id="fromDate" class="f-control datepicker-input"
                                           data-calendar-mode="jalali"
                                           placeholder="از تاریخ" autocomplete="off" />
                                    <i class="fa fa-calendar datepicker-ico"></i>
                                </div>
                                <input type="hidden" id="fromDateEn" name="fromDate" />
                            </div>

                            <div class="f-group">
                                <div class="f-label-row">
                                    <label class="f-label" for="toDate">تا تاریخ</label>
                                    <button type="button" class="btn-toggle-date-mode"
                                            data-target="toDate" data-mode="jalali">
                                        <i class="fa fa-exchange"></i>
                                        <span class="mode-label">شمسی</span>
                                    </button>
                                </div>
                                <div class="datepicker-wrap">
                                    <input id="toDate" class="f-control datepicker-input"
                                           data-calendar-mode="jalali"
                                           placeholder="تا تاریخ" autocomplete="off" />
                                    <i class="fa fa-calendar datepicker-ico"></i>
                                </div>
                                <input type="hidden" id="toDateEn" name="toDate" />
                            </div>

                        </div>
                    </div>
                </section>

                <div class="card-actions">
                    <button type="button" class="btn-secondary js-clear-filters">
                        <i class="fa fa-eraser"></i>
                        <span>پاک کردن فیلترها</span>
                    </button>
                    <button type="submit" class="btn-confirm btn-primary-action"
                            id="searchBtn" disabled>
                        <i class="fa fa-play"></i>
                        <span>تهیه گزارش</span>
                    </button>
                </div>

            </div>
        </div>
    </form>
</div>

<div id="toastContainer"></div>

@section Scripts {
    <script src="~/js/shared/toast.js"></script>
    <script src="~/js/shared/searchable-controls.js"></script>
    <script src="~/js/persian-date.js"></script>
    <script src="~/js/shared/datepicker.js"></script>
    <script src="~/js/components/reports/not-dispatched-report.js"></script>
}