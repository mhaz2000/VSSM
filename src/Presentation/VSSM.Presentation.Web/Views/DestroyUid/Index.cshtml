@{
    ViewBag.Title = "امحا UID";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/css/components/shared/a-card.css" rel="stylesheet" />
<link href="~/css/components/shared/btn.css" rel="stylesheet" />
<link href="~/css/components/shared/f-control.css" rel="stylesheet" />
<link href="~/css/components/shared/lines-table.css" rel="stylesheet" />
<link href="~/css/components/shared/toast.css" rel="stylesheet" />
<link href="~/css/components/shared/skeleton.css" rel="stylesheet" />
<link href="~/css/components/shared/datepicker.css" rel="stylesheet" />
<link href="~/css/components/shared/progress-bar.css" rel="stylesheet" />
<link href="~/css/components/DestroyUid/destroy-uid.css" rel="stylesheet" />

@Html.AntiForgeryToken()

<div id="toastContainer"></div>
<div class="du-page-wrapper">
    <div class="a-card">

        <div class="a-card-header">
            <i class="fa fa-trash-o" style="color:#dc2626;font-size:15px;"></i>
            <h6>امحا UID</h6>
        </div>

        <div class="a-card-body">

            <div class="du-seg-ctrl" role="group">
                <button class="du-seg-btn active" id="btnBatch" onclick="switchMode('batch')">
                    <i class="fa fa-barcode"></i>
                    سری ساخت
                </button>
                <button class="du-seg-btn" id="btnUid" onclick="switchMode('uid')">
                    <i class="fa fa-qrcode"></i>
                    QR کد
                </button>
            </div>

            <div class="section-divider"></div>

            <div id="secBatch">
                <div class="fg-3">
                    <div class="f-group">
                        <label class="f-label">
                            سری ساخت
                            <span class="req-tag">اجباری</span>
                        </label>
                        <div class="du-search-wrap">
                            <input type="text"
                                   id="batchInput"
                                   class="du-search-input"
                                   placeholder="سری ساخت را وارد کنید" />
                            <button type="button" class="du-search-btn" onclick="doSearch()" title="جستجو">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div id="secUid" style="display:none;">
                <div class="fg-3">
                    <div class="f-group">
                        <label class="f-label">
                            UID
                            <span class="req-tag">اجباری</span>
                        </label>
                        <div class="du-search-wrap">
                            <input type="text"
                                   id="uidInput"
                                   class="du-search-input"
                                   placeholder="QR کد مورد نظر را اسکن نمایید"
                                   maxlength="60"
                                   inputmode="numeric" />
                            <button type="button" class="du-search-btn" onclick="doSearch()" title="جستجو">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                        <div class="du-uid-progress-wrap" id="uidProgressWrap">
                            <div class="du-uid-progress-bg">
                                <div class="du-uid-progress-fill" id="uidBar" style="width:0%"></div>
                            </div>
                            <span class="du-uid-counter" id="uidCounter">0 / 60</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="lines-table-wrap inset">
            <table class="lines-table" id="resultsTable">
                <thead>
                    <tr>
                        <th>ردیف</th>
                        <th>سری ساخت</th>
                        <th>نام کالا</th>
                        <th>دوز بر ویال</th>
                        <th>تاریخ تولید</th>
                        <th>تاریخ انقضا</th>
                        <th>تعداد UID موجود</th>
                        <th>دلیل امحا <span class="req-tag">اجباری</span></th>
                        <th>تاریخ امحا <span class="req-tag">اجباری</span></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="resultsTbody">
                    <tr>
                        <td colspan="10" class="du-empty-cell">
                            <i class="fa fa-inbox du-empty-icon"></i>
                            <span>اطلاعاتی وارد نشد</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="form-footer">
            <button type="button"
                    class="btn-confirm"
                    id="submitBtn"
                    onclick="submitDestroy()"
                    style="display:none;">
                <i class="fa fa-check"></i>
                ثبت امحا
            </button>
        </div>

        <div id="submitProgressWrap" style="padding: 0 16px 16px;"></div>

    </div>
</div>

<script>
    var searchByBatchUrl         = '@Url.Action("SearchByBatch", "DestroyUid")';
    var searchByUidUrl           = '@Url.Action("SearchByUid", "DestroyUid")';
    var submitDestroyProgressUrl = '@Url.Action("SubmitDestroyProgress", "DestroyUid")';
    var todayShamsi              = '@ViewBag.TodayShamsi';

    var reasonList = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(ViewBag.ReasonList ?? new object[0])
        );
</script>

<script src="~/js/shared/toast.js"></script>
<script src="~/js/shared/skeleton.js"></script>
<script src="~/js/shared/datepicker.js"></script>
<script src="~/js/shared/progress-bar.js"></script>
<script src="~/js/components/DestroyUid/destroy-uid.js"></script>