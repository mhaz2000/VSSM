@using System.Globalization
@using VSSM.Application.DTOs.BaseEntities.Dispatches
@using VSSM.Application.DTOs.BaseEntities.Store

@section Styles {
    <link href="~/css/components/shared/a-card.css" rel="stylesheet" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" />
    <link href="~/css/components/shared/toast.css" rel="stylesheet" />
    <link href="~/css/components/shared/lines-table.css" rel="stylesheet" />
    <link href="~/css/components/dispatch/arrive-dispatch.css" rel="stylesheet" />
}

@{
    var dispatchLines = ViewBag.DispatchLines as List<ToBeArrivedDispatchLineDto>;
    var stores = ViewBag.Stores as List<StoreListDto>;

    var index = 0;
}

<div class="item-form-wrap">


    <form id="arriveForm" method="post" asp-action="ArriveSubmit">

        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-list" style="color:#3b82f6;"></i>
                <h6>اقلام محموله</h6>
            </div>
            <div class="a-card-body">

                @if (dispatchLines != null && dispatchLines.Any())
                {
                    <div class="lines-table-wrap">
                        <table class="lines-table">
                            <thead>
                                <tr>
                                    <th>نام کالا</th>
                                    <th>سازنده</th>
                                    <th>سری ساخت</th>
                                    <th>تاریخ انقضا</th>
                                    <th>دوز / ویال</th>
                                    <th>تعداد دوز</th>
                                    <th>VVM</th>
                                    <th style="min-width:220px;">انبار مقصد</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in dispatchLines)
                                {
                                    <tr data-use-above-zero="@line.UserAboveZeroStore"
                                        data-use-below-zero="@line.UserBelowZeroStore"
                                        data-use-ordinary="@line.UseOrdinaryStore">

                                        <input type="hidden" name="Lines[@index].DispatchLineId" value="@line.DispatchLineId" />
                                        <input type="hidden" name="Lines[@index].ItemId" value="@line.ItemId" />

                                        <td>@line.ItemName</td>
                                        <td>@line.Manufacure</td>
                                        <td>@line.BatchNumber</td>
                                        <td>@(line.ExpiryDate?.ToString("yyyy/MM/dd", CultureInfo.GetCultureInfo("fa-IR")) ?? "-")</td>
                                        <td>@line.DoesPerVial</td>
                                        <td>@line.DoseCount</td>
                                        <td>@line.Vvmstage</td>

                                        <td>
                                            <select class="f-control store-selector"
                                                    name="Lines[@index].StoreId"
                                                    required>
                                                <option value="">-- انتخاب انبار --</option>
                                                @foreach (var store in stores)
                                                {
                                                    <option value="@store.StoreId" data-type-id="@store.TypeId">
                                                        @store.FullName
                                                    </option>
                                                }
                                            </select>
                                            <div class="store-warning" style="display:none;"></div>
                                        </td>
                                    </tr>

                                    index++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p style="color:#dc2626; font-size:13px; margin:0;">
                        موردی برای دریافت یافت نشد
                    </p>
                }

            </div>
        </div>

        <div class="form-footer">
            <a asp-action="ToBeArrivedIndex" class="btn-back">
                <i class="fa fa-arrow-right"></i> بازگشت
            </a>
            <button type="submit" class="btn-confirm">
                <i class="fa fa-save"></i> ثبت دریافت
            </button>
        </div>

    </form>
</div>

<div id="toastContainer"></div>

@section Scripts {
    <script src="~/js/components/shared/toast.js"></script>
    <script src="~/js/components/dispatch/arrive-dispatch.js"></script>
}
