@using VSSM.Application.DTOs.BaseEntities.Dispatches
@using VSSM.Presentation.Web.Models.Base
@model GridViewModel


@section Styles {
    <link href="~/css/components/shared/grid-wrapper.css" rel="stylesheet" />
}

@{
    ViewData["Title"] = "ارسالات";
}

<div class="grid-wrapper">
    <div class="grid-header">

        <strong style="font-size: 1.2rem">@ViewData["Title"]</strong>

        <div class="d-flex align-items-center gap-2">

            <!-- Draft filter -->
            <form method="get" class="d-flex align-items-center gap-2">

                <!-- keep existing query values -->
                <input type="hidden" name="search" value="@Model.SearchTerm" />
                <input type="hidden" name="sort" value="@Model.CurrentSort" />
                <input type="hidden" name="direction" value="@Model.CurrentDirection" />
                <input type="hidden" name="pageSize" value="@Model.Data.PageSize" />


                <div class="form-group">

                    <select name="status"
                            class="form-select form-select-sm"
                            onchange="this.form.submit()"
                            style="padding: 7px; margin-left: 10px;">

                        <option value="">همه</option>
                        <option value="draft" selected="@(Context.Request.Query["status"] == "draft")">
                            پیش نویس
                        </option>
                        <option value="final" selected="@(Context.Request.Query["status"] == "final")">
                            نهایی
                        </option>
                    </select>
                </div>
            </form>

            <!-- shared search component untouched -->
            @await Component.InvokeAsync("SearchBar", new
            {
                searchTerm = Model.SearchTerm,
                        pageSize = Model.Data.PageSize,
                        sort = Model.CurrentSort,
                        direction = Model.CurrentDirection
                        })

            <div class="col-lg-3 mb-2 text-end">
                <a class="btn btn-success" asp-action="New"><i class="fa fa-plus-circle"></i> ثبت ارسال جدید</a>
            </div>

        </div>
    </div>

    <div>
        @await Html.PartialAsync("_DynamicGrid", Model)
    </div>
</div>


