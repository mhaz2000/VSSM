@using VSSM.Application.DTOs.BaseEntities.Dispatches
@using VSSM.Presentation.Web.Models.Base
@model GridViewModel

@section Styles {
    <link href="~/css/components/shared/grid-wrapper.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/components/shared/search-bar.css"  rel="stylesheet" asp-append-version="true" />
}

@{
    ViewData["Title"] = "مدیریت ارسالات";
    var currentStatus = Context.Request.Query["status"].ToString();
}

<div class="grid-wrapper">
    <div class="grid-header" style="direction:rtl;">

        <strong style="font-size:1.4rem; font-weight:600; color:#111827;">
            @ViewData["Title"]
        </strong>

        <div class="search-bar-root">

            <form method="get" class="m-0">
                <input type="hidden" name="sort"      value="@Model.CurrentSort" />
                <input type="hidden" name="direction" value="@Model.CurrentDirection" />
                <input type="hidden" name="pageSize"  value="@Model.Data.PageSize" />

                <div class="search-wrap">
                    <select name="status" class="search-select" onchange="this.form.submit()">
                            <option value="" selected="@(currentStatus == "")">همه</option>
                            <option value="draft" selected="@(currentStatus == "draft")">پیش‌نویس</option>
                            <option value="final" selected="@(currentStatus == "final")">نهایی</option>
                    </select>
                    <div class="search-divider"></div>
                    <input type="text" name="search" class="search-input"
                           value="@Model.SearchTerm" placeholder="جستجو..." />
                    <button type="submit" class="search-btn" title="جستجو">
                        <i class="fa fa-search"></i>
                    </button>
                </div>
            </form>

            <a asp-action="New" class="btn-add">
                <span class="plus-circle">+</span>
                افزودن
            </a>

        </div>
    </div>

    <div>
        @await Html.PartialAsync("_DynamicGrid", Model)
    </div>
</div>

@if (TempData["ToastMessage"] != null)
{
    <script>
        $(document).ready(function () {
            showToast('@Html.Raw(TempData["ToastMessage"])', '@TempData["ToastType"]');
        });
    </script>
}