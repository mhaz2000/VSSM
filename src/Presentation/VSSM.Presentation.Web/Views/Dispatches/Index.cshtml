@using VSSM.Application.DTOs.BaseEntities.Dispatches
@using VSSM.Presentation.Web.Models.Base
@using Microsoft.AspNetCore.Mvc.Rendering
@model GridViewModel

@section Styles {
    <link href="~/css/components/shared/grid-wrapper.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/components/shared/search-bar.css" rel="stylesheet" asp-append-version="true" />
}

@{
    ViewData["Title"] = "مدیریت ارسالات";

    // ── دریافت و پاک کردن TempData ──
    var toastMessage = TempData["ToastMessage"] as string;
    var toastType = TempData["ToastType"] as string ?? "info";
    TempData.Remove("ToastMessage");
    TempData.Remove("ToastType");

    var currentStatus = Context.Request.Query["status"].ToString();
    var filterOptions = new List<SelectListItem>
    {
        new SelectListItem { Value = "", Text = "همه" },
        new SelectListItem { Value = "draft", Text = "پیش‌نویس" },
        new SelectListItem { Value = "final", Text = "نهایی" }
    };
    foreach (var item in filterOptions)
    {
        item.Selected = (item.Value == currentStatus);
    }
}

<div class="grid-wrapper">
    <div class="grid-header" style="direction:rtl;">

        <strong style="font-size:1.4rem; font-weight:600; color:#111827;">
            @ViewData["Title"]
        </strong>

        @await Component.InvokeAsync("SearchBar", new
        {
            searchTerm = Model.SearchTerm,
                pageSize = Model.Data.PageSize,
                sort = Model.CurrentSort,
                direction = Model.CurrentDirection,
                filterOptions = filterOptions,
                filterName = "status",
                filterValue = currentStatus,
                addController = ViewContext.RouteData.Values["controller"]?.ToString(),
                addAction = "New",
                showAddButton = true
                })

    </div>

    <div>
        @await Html.PartialAsync("_DynamicGrid", Model)
    </div>
</div>

@if (!string.IsNullOrEmpty(toastMessage))
{
    <script>
        $(document).ready(function () {
            showToast(@System.Text.Json.JsonSerializer.Serialize(toastMessage), @System.Text.Json.JsonSerializer.Serialize(toastType));
        });
    </script>
}