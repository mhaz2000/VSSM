@using VSSM.Application.DTOs.BaseEntities
@using VSSM.Application.DTOs.BaseEntities.Dispatches
@using VSSM.Application.DTOs.BaseEntities.Recipient
@using VSSM.Presentation.Web.Models.Base
@model CreateDispatchDto

@{
    var transportModes = ViewBag.TransportModes as List<EnumListDto>;
    var recipients = ViewBag.Recipients as List<RecipientGetDto>;
    var receivingModes = ViewBag.ReceivingModes as List<EnumListDto>;
    var itemClasses = ViewBag.ItemClasses as List<ItemClassListDto>;
    string draftBtnLabel = "پیش فاکتور";
}

@section Styles {
    <link href="~/css/components/shared/a-card.css" rel="stylesheet" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" />
    <link href="~/css/components/shared/toast.css" rel="stylesheet" />
    <link href="~/css/components/shared/lines-table.css" rel="stylesheet" />
    <link href="~/css/components/shared/uid-modal.css" rel="stylesheet" />
    <link href="~/css/components/shared/search-bar.css" rel="stylesheet" />
    <link href="~/css/components/dispatches/dispatch-form.css" rel="stylesheet" />
    <link href="~/css/components/shared/datepicker.css" rel="stylesheet" />
}

<div id="toastContainer"></div>

@* ── مودال افزودن UID ── *@
<div class="uid-modal-overlay" id="uidModalOverlay">
    <div class="uid-modal">
        <div class="uid-modal-header">
            <h6><i class="fa fa-qrcode"></i> افزودن UID</h6>
            <button type="button" class="uid-modal-close" onclick="closeUidModal()">✕</button>
        </div>
        <div class="uid-modal-body">
            <div class="uid-stat-row">
                <div class="uid-stat">
                    <div class="lbl">موجودی جاری</div>
                    <div class="val" id="uidModalStock">0</div>
                </div>
                <div class="uid-stat">
                    <div class="lbl">تعداد UID افزوده‌شده</div>
                    <div class="val" id="uidModalCount">0</div>
                </div>
            </div>
            <div class="uid-input-row">
                <input type="text" id="uidInput" class="f-control"
                       placeholder="UID را اسکن یا وارد کنید" style="flex:1;" />
                <button type="button" class="btn-add-line" onclick="submitUid()">
                    <i class="fa fa-plus"></i> افزودن
                </button>
            </div>
            <div class="uid-list" id="uidList"></div>
        </div>
    </div>
</div>

<div class="dispatch-wrap">

    <form id="dispatchForm" asp-action="Create" method="post" novalidate>
        @Html.AntiForgeryToken()

        @* ══════════════════════════════════════════════
           کارت ۱: اطلاعات اصلی ارسال
           ══════════════════════════════════════════════ *@
        <div class="a-card">
            <div class="a-card-header">
                <h6><i class="fa fa-truck" style="color:#1d6fb8;"></i> ثبت ارسال</h6>
            </div>
            <div class="a-card-body">

                <div class="fg-3" style="margin-bottom:14px;">

                    <div class="f-group">
                        <label class="f-label">تاریخ ارسال <span class="req-tag">اجباری</span></label>
                        <div class="datepicker-wrap">
                            <input asp-for="Date" id="Date"
                                   class="f-control datepicker-input"
                                   placeholder="مثال: ۱۴۰۴/۰۱/۱۵"
                                   autocomplete="off" />
                            <i class="fa fa-calendar datepicker-ico"></i>
                        </div>
                        <span asp-validation-for="Date" class="text-danger" style="font-size:11px;"></span>
                    </div>

                    <div class="f-group">
                        <label class="f-label">نوع کالا <span class="req-tag">اجباری</span></label>
                        @* ✅ مورد ۳: فیلتر نوع کالا — فقط واکسن (fkclassid=55) نمایش داده می‌شود *@
                        <select id="itemClassSelect" class="f-control">
                            <option value="">انتخاب کنید...</option>
                            @foreach (var ic in itemClasses)
                            {
                                <option value="@ic.Id">@ic.Name</option>
                            }
                        </select>
                    </div>

                    <div class="f-group">
                        <label class="f-label">کالا <span class="req-tag">اجباری</span></label>
                        @* ✅ مورد ۶: کالا با SearchableSelect — آیتم‌ها توسط JS پس از انتخاب نوع کالا پر می‌شوند *@
                        @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect", new SearchableSelectModel
                        {
                            Id = "itemSelect",
                                                Name = "itemSelect",
                                                Label = "",
                                                IsRequired = false,
                                                DefaultText = "ابتدا نوع کالا را انتخاب کنید",
                                                Options = new List<SelectOption>()
                                                })
                    </div>

                </div>

                <div class="fg-3" style="margin-bottom:14px;">

                    <div class="f-group">
                        <label class="f-label">گیرنده <span class="req-tag">اجباری</span></label>
                        @* ✅ مورد ۶: گیرنده با SearchableSelect — امکان جستجو دارد *@
                        @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect", new SearchableSelectModel
                                                {
                            Id = "ReceiverId",
                                                Name = "ReceiverId",
                                                DefaultText = "جستجوی گیرنده...",
                                                Label = "",
                                                IsRequired = false,
                                                Options = recipients.Select(r => new SelectOption
                                                {
                                                    Value = r.RecipientId.ToString(),
                                                    Text = r.FullName
                                                }).ToList()
                                                })
                        <span asp-validation-for="ReceiverId" class="text-danger" style="font-size:11px;"></span>
                    </div>

                    <div class="f-group">
                        <label class="f-label">شماره فاکتور</label>
                        <input asp-for="DispatchVoucherNumber" type="number" class="f-control"
                               placeholder="شماره فاکتور را وارد کنید" />
                    </div>

                    <div class="f-group">
                        <label class="f-label">شماره درخواست</label>
                        <input asp-for="RequestNum" class="f-control"
                               placeholder="شماره درخواست را وارد کنید" />
                    </div>

                </div>

                <div class="fg-3" style="margin-bottom:14px;">

                    <div class="f-group">
                        <label class="f-label">تعداد / دوز <span class="req-tag">اجباری</span></label>
                        @* ✅ مورد ۴: تعداد اجباری — اسکن UID موجودی را محاسبه می‌کند *@
                        <input type="number" id="doseCountInput" class="f-control"
                               placeholder="تعداد را وارد کنید" min="1" />
                    </div>

                    <div class="f-group">
                        <label class="f-label">روش دریافت</label>
                        <select asp-for="ReceivingMode" class="f-control">
                            <option value="">انتخاب کنید...</option>
                            @foreach (var m in receivingModes)
                            {
                                <option value="@m.Name">@m.Description</option>
                            }
                        </select>
                    </div>

                    <div class="f-group">
                        <label class="f-label">طریقه حمل</label>
                        <select asp-for="TransportMode" class="f-control">
                            <option value="">انتخاب کنید...</option>
                            @foreach (var m in transportModes)
                            {
                                <option value="@m.Name">@m.Description</option>
                            }
                        </select>
                    </div>

                </div>

                <div class="fg-2" style="margin-bottom:14px;">

                    <div class="f-group">
                        <label class="f-label">مرحله VVM</label>
                        <select id="vvmStagesSelect" class="f-control">
                            <option value="">انتخاب کنید</option>
                            @foreach (var s in ViewBag.VVMStages)
                            {
                                <option value="@s.VvmstageId">@s.FullName</option>
                            }
                        </select>
                    </div>

                    <div class="f-group">
                        <label class="f-label">ملاحظات</label>
                        <textarea asp-for="Note" class="f-control" rows="1"
                                  placeholder="ملاحظات مورد نیاز ..."></textarea>
                    </div>

                </div>

            </div>
        </div>

        @* ══════════════════════════════════════════════
           کارت ۲: انتخاب سری ساخت
           ══════════════════════════════════════════════ *@
        <div class="a-card">
            <div class="a-card-header">
                <h6><i class="fa fa-list" style="color:#1d6fb8;"></i> انتخاب سری ساخت</h6>
            </div>
            <div class="a-card-body" style="padding:16px;">

                <div class="lines-table-wrap">
                    <table class="lines-table" id="itemDetailsTable">
                        <thead>
                            <tr>
                                <th>انتخاب</th>
                                <th>کالا</th>
                                <th>انقضا</th>
                                <th>سازنده</th>
                                <th>موجودی</th>
                                <th>دوز/ویال</th>
                                <th>انبار</th>
                                <th>سری ساخت</th>
                            </tr>
                        </thead>
                        <tbody id="itemDetailsTbody">
                            <tr>
                                <td colspan="8" style="padding:24px;color:#9ca3af;text-align:center;">
                                    کالایی انتخاب نشده
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div style="padding:10px 0 4px; text-align:center; display:none;" id="showMoreWrap">
                    <button type="button" class="btn-show-more" onclick="showMoreRows()">
                        <i class="fa fa-chevron-down"></i> نمایش بیشتر
                    </button>
                </div>

                <div style="padding:12px 0 0; display:flex; justify-content:flex-end;">
                    <button type="button" class="btn-add-line" onclick="addSelectedItem()">
                        <i class="fa fa-plus"></i> افزودن
                    </button>
                </div>

            </div>
        </div>

        @* hidden inputs آیتم‌های افزوده‌شده *@
        <div id="hiddenInputsContainer"></div>

        @* ══════════════════════════════════════════════
           کارت ۳: کالاهای افزوده‌شده
           ══════════════════════════════════════════════ *@
        <div class="a-card">
            <div class="a-card-header">
                <h6><i class="fa fa-check-square" style="color:#1d6fb8;"></i> کالاهای افزوده‌شده</h6>
            </div>
            <div class="a-card-body" style="padding:16px;">

                <div class="lines-table-wrap">
                    <table class="lines-table" id="addedItemsTable">
                        <thead>
                            <tr>
                                <th>سری ساخت</th>
                                <th>کالا</th>
                                <th>انقضا (شمسی)</th>
                                <th>تعداد/دوز</th>
                                <th>تعداد ویال</th>
                                <th>نوع VVM</th>
                                <th>مرحله VVM</th>
                                <th>سازنده</th>
                                <th>ملاحظات</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody id="addedItemsTbody">
                            <tr id="noAddedRow">
                                <td colspan="10" style="padding:24px;color:#9ca3af;text-align:center;">
                                    کالایی اضافه نشده
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

        @* ── فوتر ── *@
        <div class="form-footer">
            @* ✅ مورد ۵: دکمه افزودن = ارسال به فرم مدیریت *@
            <button type="button" class="btn-confirm js-footer-btn" data-submit="final">
                <i class="fa fa-check"></i> ارسال
            </button>
            <button type="button" class="btn-draft js-footer-btn" data-submit="draft">
                <i class="fa fa-file-text"></i> @draftBtnLabel
            </button>
            <button type="button" class="btn-back" style="border-color:#dc2626;color:#dc2626;"
                    onclick="confirmDelete()">
                <i class="fa fa-trash"></i> حذف
            </button>
            <a asp-action="Index" class="btn-back">
                <i class="fa fa-arrow-right"></i> بازگشت
            </a>
        </div>

    </form>
</div>

@section Scripts {
    <script src="~/js/persian-date.js"></script>

    @* ── shared modules ── *@
    <script src="~/js/shared/toast.js"></script>
    <script src="~/js/shared/uid-modal.js"></script>
    <script src="~/js/shared/datepicker.js"></script>
    <script src="~/js/shared/batch-table.js"></script>

    @* ── متغیرهای تزریقی از C# به JS ── *@
    <script>
        var dispatchServerMsg        = "@(TempData["ToastMessage"] as string ?? "")";
        var dispatchServerType       = "@(TempData["ToastType"] as string ?? "info")";
        var dispatchGetItemsByClass  = "@Url.Action("GetItemsByClass", "Dispatches")";
        var dispatchGetBatchesByItem = "@Url.Action("GetBatchesByItem", "Dispatches")";
        var setUidUrl                = "@Url.Action("SetUid", "Dispatches")";
    </script>

    @* ── لاجیک اختصاصی فرم ── *@
    <script src="~/js/components/dispatches/dispatch-form.js"></script>
}
