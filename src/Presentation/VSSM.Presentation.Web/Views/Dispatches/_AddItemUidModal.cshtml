<div class="modal fade" id="addItemUidModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">افزودن UID</h5>
            </div>

            <div class="modal-body">
                <label class="form-label">UID</label>
                <input type="number"
                       maxlength="20"
                       id="uidInput"
                       class="form-control" />

                <div id="uidLoading" style="display:none">
                    در حال ثبت...
                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-primary"
                        id="saveUidBtn">
                    ثبت
                </button>

                <button type="button"
                        class="btn btn-secondary"
                        data-dismiss="modal">

                    بستن
                </button>
            </div>

        </div>
    </div>
</div>