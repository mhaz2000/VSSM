@model DosePerVialViewModel
@{
    string formName = "ثبت";
    if (Model != null && Model.DosePerVialId > 0)
        formName = "ویرایش";
}


<div class="container-fluid">
    <div class="animated fadeIn">


        <div class="card">
            <div class="card-header">
                <h5 class="header-title">@formName دوز بر ویال</h5>
            </div>
            <div class="card-block">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <form asp-action="Create" method="post" class="form-horizontal">
                        <input type="hidden" asp-for="DosePerVialId" />
                        <div class="row mx-0 mb-4">
                            
                            <div class="form-group col-lg-4">
                                <label class="form-label" for="DisplayOrder">تعداد دوز بر ویال </label>
                                <input type="number" asp-for="NumDosePerVial" name="NumDosePerVial" class="form-control" min="0" />
                            </div>
                            <div class="col-lg-2"></div>
                            <div class="col-lg-6">
                                <label class="form-label">وضعیت</label>

                                <div class="d-flex">
                                    <div class="form-check">
                                    <input type="radio"
                                        asp-for="IsActive"
                                        value="true"
                                        class="form-check-input"
                                        id="isActiveTrue" />
                                    <label class="form-check-label" for="isActiveTrue">
                                        فعال
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input type="radio"
                                        asp-for="IsActive"
                                        value="false"
                                        class="form-check-input"
                                        id="isActiveFalse" />
                                    <label class="form-check-label" for="isActiveFalse">
                                        غیرفعال
                                    </label>
                                </div>
                            </div>
                            
                            <div class="text-left">
                            <button type="submit" class="btn btn-success px-5">ثبت</button>
                            <a asp-action="Index" class="btn btn-success-outlet px-5">بازگشت</a>
                        </div>
                        </div>
                    </form>

                </div>

        </div>
        
</div>
