@using VSSM.Application.DTOs.BaseEntities.EduType
@model PagingSearchOrderDto<EduTypeGetDto>

@{
    ViewData["Title"] = "مدیریت تحصیلات";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="row m-0 card-header align-items-center">
                <div class="col-lg-6">
                    <h5 class="header-title">@ViewData["Title"]</h5>
                </div>

                <div class="col-lg-6 d-flex align-items-center justify-content-end">
                    <div class="col-lg-5 d-flex align-items-center justify-content-end">
                            @await Component.InvokeAsync("SearchBar", new
                            {
                                searchTerm = Model.SearchText,
                                pageSize = Model.Paging.PageSize,
                                sort = Model.SortField,
                                direction = Model.SortOrder
                            })
                        </div>
                    <div class="col-lg-2 d-flex align-items-center justify-content-end">
                        <a class="btn btn-success m-0" asp-controller="EduType" asp-action="New">
                            <i class="fa fa-plus-circle ml-2"></i>افزودن
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-block">
                <div class="table-wrapper">
                    <table class="table table-bordered table-striped table-condensed text-center mb-0">
                        <thead>
                            <tr>
                                <th>
                                    <a href="?sortField=FullName&sortOrder=@(Model.SortOrder == "asc" ? "desc" : "asc")">
                                        نام
                                    </a>
                                </th>
                                <th>وضعیت</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items != null && Model.Items.Any())
                            {
                                foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@item.FullName</td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge badge-success">فعال</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">غیرفعال</span>
                                            }
                                        </td>
                                        <td>
                                            <a class="btn btn-link text-info btn-sm" asp-action="Edit" asp-route-id="@item.EduTypeId">
                                                <i class="fa fa-edit" style="font-size:18px;"></i>
                                            </a>

                                            <form asp-action="Delete" asp-route-id="@item.EduTypeId" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-link text-danger btn-sm"
                                                        onclick="return confirm('آیا مطمئن هستید می‌خواهید این تحصیلات را حذف کنید؟');">
                                                    <i class="fa fa-trash" style="font-size:18px;"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-danger">داده‌ای یافت نشد</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
               @{
                    int page = Model.Paging.Page;
                    int totalPages = Model.Paging.TotalPages;

                    // چند صفحه اطراف صفحه فعلی
                    int window = 2;

                    // پارامترهای فیلتر/مرتب‌سازی که باید حفظ شوند
                    var search = Model.SearchText ?? "";
                    var sortField = Model.SortField ?? "";
                    var sortOrder = Model.SortOrder ?? "";

                    // typeId از QueryString میاد (چون تو Model نیست)
                    var typeId = Context.Request.Query["typeId"].ToString() ?? "";

                    // انتخاب صفحات: 1, ... , (page-window..page+window), ... , total
                    var selected = new SortedSet<int>();
                    if (totalPages >= 1) selected.Add(1);

                    for (int p = page - window; p <= page + window; p++)
                        if (p >= 1 && p <= totalPages) selected.Add(p);

                    if (totalPages >= 2) selected.Add(totalPages);

                    string PageUrl(int p)
                    => $"?search={search}&typeId={typeId}&sortField={sortField}&sortOrder={sortOrder}&page={p}";
                }

                <nav class="pager-wrap mt-2 m-auto" aria-label="Page navigation">
                    <ul class="cpageination pager-modern m-auto">

                        <!-- قبلی -->
                        <li class="page-item @(page == 1 ? "disabled" : "")">
                            <a class="page-link" href="@(page == 1 ? "#" : PageUrl(page - 1))" tabindex="@(page == 1 ? "-1" : "0")">
                                <
                            </a>
                        </li>

                        @{
                            int prev = 0;
                            foreach (var p in selected)
                            {
                                if (prev != 0 && p - prev > 1)
                                {
                                    <li class="page-item disabled ellipsis">
                                        <span class="page-link">…</span>
                                    </li>
                                }

                                <li class="page-item @(p == page ? "active" : "")">
                                    <a class="page-link" href="@PageUrl(p)">@p</a>
                                </li>

                                prev = p;
                            }
                        }
                        <li class="page-item @(page == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@(page == 1 ? "#" : PageUrl(page + 1))" tabindex="@(page == 1 ? "-1" : "0")">
                                >
                            </a>
                        </li>
                        </nav>
                    </div>

                    </div>
                </div>
            
            
        </div>

    </div>
</div>
