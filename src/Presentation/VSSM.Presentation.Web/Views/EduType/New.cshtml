@model VSSM.Presentation.Web.Models.EduType.EduTypeViewModel

@{
    string formName = Model != null && Model.EduTypeId > 0 ? "ویرایش" : "ثبت";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card form-card">
            <div class="card-header card-form-header">
                <h5 class="header-title">@formName تحصیلات</h5>
            </div>
            <div class="card-block">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form asp-action="Create" method="post" class="form-horizontal">
                    <input type="hidden" asp-for="EduTypeId" />

                    <div class="row mb-4">
                        <div class="form-group col-lg-6">
                            <label class="form-label" asp-for="FullName">نام کامل</label>
                            <input type="text" asp-for="FullName" class="form-control bg-warning-subtle" maxlength="200" required />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <!-- IsActive as radio buttons -->
                        <div class="form-group col-lg-1"></div>
                        <div class="form-group col-lg-5">
                            <label class="form-label">وضعیت</label>
                            <div class="d-flex">
                                <div class="form-check">
                                    <input type="radio" asp-for="IsActive" value="true" class="form-check-input" id="isActiveTrue" />
                                    <label class="form-check-label" for="isActiveTrue">فعال</label>
                                </div>
                                <div class="form-check">
                                    <input type="radio" asp-for="IsActive" value="false" class="form-check-input" id="isActiveFalse" />
                                    <label class="form-check-label" for="isActiveFalse">غیرفعال</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="text-left">
                        <button type="submit" class="btn btn-success px-5">ثبت</button>
                        <a asp-action="Index" class="btn btn-success-outlet px-5">بازگشت</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
