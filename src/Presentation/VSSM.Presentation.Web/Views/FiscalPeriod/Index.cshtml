@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PagingSearchOrderDto<VSSM.Application.DTOs.BaseEntities.FiscalPeriod.FiscalPeriodDto>
@{
ViewData["Title"] = "مدیریت دوره‌های مالی";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-block">
                <div class="col-lg-3">
                    <h5>مدیریت دوره‌های مالی</h5>
                </div>

                <form method="get" class="col-lg-8">
                    <div class="input-group">
                        <input type="text" name="search" value="@Model.SearchText" class="form-control" placeholder="جستجو...">
                        <div class="input-group-btn">
                            <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> جستجو</button>
                        </div>
                    </div>
                </form>

                <div class="col-lg-1">
                    <a class="btn btn-success" asp-action="New"><i class="fa fa-plus-circle"></i> جدید</a>
                </div>
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-block">
                        <table class="table table-bordered table-striped table-condensed text-center">
                            <thead>
                            <tr>
                                <th><a href="?sortField=FullName&sortOrder=@(Model.SortOrder=="asc" ? "desc" : "asc")">نام کامل</a></th>
                                <th><a href="?sortField=StartDate&sortOrder=@(Model.SortOrder=="asc" ? "desc" : "asc")">تاریخ شروع</a></th>
                                <th><a href="?sortField=EndTime&sortOrder=@(Model.SortOrder=="asc" ? "desc" : "asc")">تاریخ پایان</a></th>
                                <th><a href="?sortField=SuggestedEndDate&sortOrder=@(Model.SortOrder=="asc" ? "desc" : "asc")">تاریخ پایان پیشنهادی</a></th>
                                <th><a href="?sortField=IsActive&sortOrder=@(Model.SortOrder=="asc" ? "desc" : "asc")">وضعیت</a></th>
                                <th>عملیات</th>
                            </tr>
                            </thead>
                            <tbody>
                            @if (Model.Items != null && Model.Items.Any())
                            {
                            foreach (var item in Model.Items)
                            {
                            <tr>
                                <td>@item.FullName</td>
                                <td>@item.StartDate?.ToString("yyyy-MM-dd")</td>
                                <td>@item.EndTime?.ToString("yyyy-MM-dd")</td>
                                <td>@item.SuggestedEndDate?.ToString("yyyy-MM-dd")</td>
                                <td>@(item.IsActive == true ? "فعال" : "غیرفعال")</td>
                                <td>
                                    <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@item.FiscalPeriodId">ویرایش</a>
                                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.FiscalPeriodId"
                                       onclick="return confirm('آیا مطمئن هستید؟')">حذف</a>
                                </td>
                            </tr>
                            }
                            }
                            else
                            {
                            <tr>
                                <td colspan="6" class="text-center text-danger">داده‌ای یافت نشد</td>
                            </tr>
                            }
                            </tbody>
                        </table>

                        <nav>
                            <ul class="pagination">
                                <li class="page-item @(Model.Paging.Page == 1 ? "disabled" : "")">
                                    <a class="page-link" href="?search=@Model.SearchText&page=@(Model.Paging.Page-1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">قبلی</a>
                                </li>

                                @for (int i = 1; i <= Model.Paging.TotalPages; i++)
                                {
                                <li class="page-item @(Model.Paging.Page == i ? "active" : "")">
                                    <a class="page-link" href="?search=@Model.SearchText&page=@i&sortField=@Model.SortField&sortOrder=@Model.SortOrder">@i</a>
                                </li>
                                }

                                <li class="page-item @(Model.Paging.Page == Model.Paging.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="?search=@Model.SearchText&page=@(Model.Paging.Page+1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">بعدی</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // اسکریپت اضافی (در صورت نیاز)
</script>
}
