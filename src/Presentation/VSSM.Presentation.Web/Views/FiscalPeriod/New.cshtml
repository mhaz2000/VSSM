@model VSSM.Application.DTOs.BaseEntities.FiscalPeriod.FiscalPeriodDto
@{
string formName = "ثبت";
if (Model != null && Model.FiscalPeriodId > 0)
formName = "ویرایش";
}

<style>
    .form-label {
        text-align: left;
        width: 130px;
        margin-left: 15px;
    }

    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        direction: rtl;
    }

    .form-control, .form-select {
        flex: 1;
    }

    .form-check {
        margin-inline-end: 20px;
        margin-right: 30px !important;
    }

    .form-check-label {
        padding-right: 0rem !important;
    }

    .card {
        direction: rtl;
    }
</style>

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card mb-3">
            <div class="card-block">
                <h5>@formName دوره مالی</h5>
            </div>
        </div>

        <div class="card">
            <div class="card-block">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form asp-action="@(Model.FiscalPeriodId > 0 ? "Edit" : "New")" method="post" class="form-horizontal">
                    <input type="hidden" asp-for="FiscalPeriodId"/>
                    <div class="col-lg-6">

                        <div class="form-group">
                            <label class="form-label" for="FullName">نام کامل:</label>
                            <input type="text" asp-for="FullName" class="form-control" required />
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="StartDate">تاریخ شروع:</label>
                            <input type="date" asp-for="StartDate" class="form-control" required />
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="EndTime">تاریخ پایان:</label>
                            <input type="date" asp-for="EndTime" class="form-control" />
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="SuggestedEndDate">تاریخ پایان پیشنهادی:</label>
                            <input type="date" asp-for="SuggestedEndDate" class="form-control" />
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="EntryDate">تاریخ ثبت:</label>
                            <input type="date" asp-for="EntryDate" class="form-control" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">وضعیت:</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" checked />
                                <label class="form-check-label" for="IsActive">فعال است</label>
                            </div>
                        </div>

                        <div class="col-lg-8"></div>
                        <div class="col-lg-4">
                            <div class="text-center mt-4 align-middle">
                                <button type="submit" class="btn btn-success px-5">
                                    @(Model.FiscalPeriodId > 0 ? "ذخیره تغییرات" : "ثبت")
                                </button>
                                <a type="button" class="btn btn-primary px-5" asp-action="Index">لیست</a>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
