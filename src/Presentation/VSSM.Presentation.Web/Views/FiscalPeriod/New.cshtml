@model VSSM.Application.DTOs.BaseEntities.FiscalPeriod.FiscalPeriodDto

@{
    ViewData["Title"] = "دوره مالی";
    var isEdit = Model != null && Model.FiscalPeriodId > 0;
    var formName = isEdit ? "ویرایش دوره مالی" : "ثبت دوره مالی جدید";
    var successMessage = TempData["Success"]?.ToString();
}

@section Styles {
    <link href="~/css/components/shared/a-card.css" rel="stylesheet" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" />
    <link href="~/css/components/shared/datepicker.css" rel="stylesheet" />
    <link href="~/css/components/shared/toast.css" rel="stylesheet" />
    <link href="~/css/pages/fiscal-period/fiscal-period-form.css" rel="stylesheet" />
}

<div class="fiscal-period-wrap">
    <div id="toastContainer"></div>

    <div class="fiscal-period-title">
        <i class="fa fa-calendar"></i>
        @formName
    </div>

    <form asp-action="@(isEdit ? "Edit" : "New")" method="post" class="fiscal-period-form" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="FiscalPeriodId" />

        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-info-circle" style="color:#1d6fb8;"></i>
                <h6>اطلاعات دوره مالی</h6>
            </div>

            <div class="a-card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="fg-2">
                    <div class="f-group">
                        <label class="f-label" for="FullName">
                            نام کامل
                            <span class="req-tag">اجباری</span>
                        </label>
                        <input type="text" asp-for="FullName" class="f-control" id="FullName" required />
                        <span id="fullNameError" class="field-validation-error"></span>
                        <span asp-validation-for="FullName" class="field-validation-error"></span>
                    </div>

                    <div class="f-group">
                        <label class="f-label" for="SuggestedEndDate">تاریخ پایان پیشنهادی</label>
                        <div class="datepicker-wrap">
                            <input type="text" asp-for="SuggestedEndDate" class="datepicker-input" id="SuggestedEndDate" placeholder="____/__/__" />
                            <i class="fa fa-calendar datepicker-ico"></i>
                        </div>
                        <span asp-validation-for="SuggestedEndDate" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="fiscal-period-warning">
                    <i class="fa fa-exclamation-triangle"></i>
                    <span>
                        <strong>توجه:</strong>
                        وقتی یک دوره تراکنش جدید ثبت کنید، دوره‌های تراکنش قبلی غیر فعال می‌شوند و دیگر امکان فعال نمودن آنها وجود نخواهد داشت.
                    </span>
                </div>
            </div>

            <div class="form-footer" style="justify-content: center;">
                <button type="submit" class="btn-confirm" disabled>
                    <i class="fa fa-save"></i>
                    @(isEdit ? "ذخیره تغییرات" : "ثبت")
                </button>
                <a asp-action="Index" class="btn-back">
                    <i class="fa fa-list"></i>
                    لیست
                </a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/shared/datepicker.js"></script>
    <script src="~/js/shared/toast.js"></script>
    <script src="~/js/pages/fiscal-period/fiscal-period-form.js"></script>

    <script>
        (function() {
            'use strict';

            var successMessage = '@Html.Raw(successMessage ?? string.Empty)';

            if (successMessage) {
                if (typeof window.FiscalPeriodForm !== 'undefined') {
                    window.FiscalPeriodForm.showToast(successMessage, 'success');
                } else if (typeof window.showToast === 'function') {
                    window.showToast(successMessage, 'success');
                }
            }
        })();
    </script>
}