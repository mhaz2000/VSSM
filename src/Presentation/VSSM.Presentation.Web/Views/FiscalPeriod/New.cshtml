@model VSSM.Application.DTOs.BaseEntities.FiscalPeriod.FiscalPeriodDto
@{
    string formName = "ثبت";
    if (Model != null && Model.FiscalPeriodId > 0)
        formName = "ویرایش";
}

<style>
    .form-label {
        text-align: left;
        width: 130px;
        margin-left: 15px;
    }

    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        direction: rtl;
    }

    .form-control, .form-select {
        flex: 1;
    }

    .form-check {
        margin-inline-end: 20px;
        margin-right: 30px !important;
    }

    .form-check-label {
        padding-right: 0rem !important;
    }

    .card {
        direction: rtl;
    }
    
    .oneline-warning {
        white-space: nowrap;
        margin: 10px 0;
        width: auto !important; 
    }
</style>

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card mb-3">
            <div class="card-block">
                <h5>@formName دوره مالی</h5>
            </div>
        </div>

        <div class="card">

            <div class="card-block">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form asp-action="@(Model.FiscalPeriodId > 0 ? "Edit" : "New")" method="post" class="form-horizontal">
                    <input type="hidden" asp-for="FiscalPeriodId"/>
                    
                    <div class="col-lg-6"> 

                        <div class="form-group">
                            <label class="form-label" for="FullName">نام کامل:</label>
                            <input type="text" asp-for="FullName" class="form-control" required />
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="SuggestedEndDate">تاریخ پایان پیشنهادی:</label>
                            <input type="date" asp-for="SuggestedEndDate" class="form-control" />
                        </div>
                    </div>
                    
                    <div class="col-lg-12 mt-4">

                        <div class="form-group justify-content-center">
                            <label class="form-label text-danger oneline-warning">
                                وقتی یک دوره تراکنش جدید ثبت کنید، دوره‌های تراکنش قبلی غیر فعال می‌شوند و دیگر امکان فعال نمودن آنها وجود نخواهد داشت.
                            </label>
                        </div>
                        
                        <div class="text-center mt-4 align-middle">
                            <button type="submit" class="btn btn-success px-5">
                                @(Model.FiscalPeriodId > 0 ? "ذخیره تغییرات" : "ثبت")
                            </button>
                            <a type="button" class="btn btn-primary px-5" asp-action="Index">لیست</a>
                        </div>
                        
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>