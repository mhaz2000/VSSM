@{
    ViewData["Title"] = "داشبورد";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<ol class="breadcrumb">
    <li class="breadcrumb-item active">داشبورد</li>
</ol>

<div class="db-page">

    <!-- ردیف وسط: در RTL از راست شروع می‌شه -->
    <!-- راست: کارت‌های کوچک | وسط: area سبز | چپ: bar آبی -->
    <div class="db-row-mid">

        <!-- ستون راست: محموله رسیده + پیش نویس -->
        <div class="db-col-sm">

            <div class="db-card db-card-sm">
                <div class="db-sm-row">
                    <!-- در RTL: آیکون اول = سمت راست -->
                    <div class="db-sm-icon">
                        <i class="fa fa-archive"></i>
                    </div>
                    <div class="db-sm-text">
                        <div class="db-lbl">محموله رسیده</div>
                        <div class="db-val">۴۰۰</div>
                    </div>
                </div>
            </div>

            <div class="db-card db-card-sm">
                <div class="db-draft-hd">
                    <div class="db-draft-dot"></div>
                    <span class="db-lbl" style="margin:0">پیش نویس</span>
                </div>
                <div class="db-draft-stats">
                    <!-- در RTL: ارسالی سمت راست، ورودی سمت چپ -->
                    <div class="db-draft-stat">
                        <div class="db-val">۴۴</div>
                        <div class="db-sub">ارسالی</div>
                    </div>
                    <div class="db-draft-stat">
                        <div class="db-val">۲۵</div>
                        <div class="db-sub">ورودی</div>
                    </div>
                </div>
            </div>

        </div>

        <!-- وسط: کالاهای زیر حداقل (area سبز) -->
        <div class="db-card db-card-chart">
            <div class="db-ch">
                <span class="db-ct">کالاهای زیر حداقل</span>
                <span class="db-badge up"><i class="fa fa-arrow-up"></i> ۸٪</span>
            </div>
            <div class="db-chart-wrap">
                <canvas id="chart-below-min" role="img" aria-label="نمودار کالاهای زیر حداقل"></canvas>
            </div>
        </div>

        <!-- چپ: کالاهای زیر سطح درخواست (bar آبی) -->
        <div class="db-card db-card-chart">
            <div class="db-ch">
                <span class="db-ct">کالاهای زیر سطح درخواست</span>
                <span class="db-badge dn"><i class="fa fa-arrow-down"></i> ۸٪</span>
            </div>
            <div class="db-chart-wrap">
                <canvas id="chart-below-request" role="img" aria-label="نمودار کالاهای زیر سطح درخواست"></canvas>
            </div>
        </div>

    </div>

    <!-- ردیف پایین -->
    <!-- راست: نزدیک منقضی (سبز) | چپ: بالای حداکثر (آبی) -->
    <div class="db-row-btm">

        <!-- راست: کالاهای نزدیک به منقضی شدن (zigzag سبز) -->
        <div class="db-card db-card-chart">
            <div class="db-ch">
                <span class="db-ct">کالاهای نزدیک به منقضی شدن</span>
                <span class="db-badge dn"><i class="fa fa-arrow-down"></i> ۸٪</span>
            </div>
            <div class="db-chart-wrap">
                <canvas id="chart-near-expiry" role="img" aria-label="نمودار کالاهای نزدیک به منقضی شدن"></canvas>
            </div>
        </div>

        <!-- چپ: کالاهای بالای حداکثر (zigzag آبی) -->
        <div class="db-card db-card-chart">
            <div class="db-ch">
                <span class="db-ct">کالاهای بالای حداکثر</span>
                <span class="db-badge up"><i class="fa fa-arrow-up"></i> ۸٪</span>
            </div>
            <div class="db-chart-wrap">
                <canvas id="chart-above-max" role="img" aria-label="نمودار کالاهای بالای حداکثر"></canvas>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}