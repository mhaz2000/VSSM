@using VSSM.Application.DTOs.Dashboard
﻿@using VSSM.Presentation.Web.Models
@model DashboardViewModel

@{
    ViewData["Title"] = "داشبورد";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<ol class="breadcrumb">
    <li class="breadcrumb-item active">داشبورد</li>
</ol>

<div class="db-page">

    <div class="db-row-mid">

        <div class="db-col-sm">

            <a asp-controller="Dispatches"
               asp-action="ToBeArrivedIndex"
               class="db-card db-card-sm"
               style="text-decoration: none; color: inherit; display: block;">
                <div class="db-sm-row">
                    <div class="db-sm-icon">
                        <i class="fa fa-archive"></i>
                    </div>
                    <div class="db-sm-text">
                        <div class="db-lbl">محموله رسیده</div>
                        <div class="db-val">@Model.ArrivedShipments</div>
                    </div>
                </div>
            </a>

            <div class="db-card db-card-sm">
                <div class="db-draft-hd">
                    <div class="db-draft-dot"></div>
                    <span class="db-lbl" style="margin:0">پیش نویس</span>
                </div>
                <div class="db-draft-stats">
                    <a asp-controller="Dispatches"
                       asp-action="Index"   
                       class="db-draft-stat"
                       style="text-decoration: none; color: inherit; display: block;">
                        <div class="db-val">@Model.DraftOutgoing</div>
                        <div class="db-sub">ارسالی</div>
                    </a>
                    <a asp-controller="Arrival"
                       asp-action="Index"
                       class="db-draft-stat"
                       style="text-decoration: none; color: inherit; display: block;">
                        <div class="db-val">@Model.DraftIncoming</div>
                        <div class="db-sub">ورودی</div>
                    </a>
                </div>
            </div>

        </div>

        <div class="db-card db-card-chart">
            <div class="db-ch">
                <span class="db-ct">کالاهای زیر حداقل</span>
            </div>
            <div class="db-chart-wrap">
                <canvas id="chart-below-min" role="img" aria-label="نمودار کالاهای زیر حداقل"></canvas>
            </div>
        </div>

        <div class="db-card db-card-chart">
            <div class="db-ch">
                <span class="db-ct">کالاهای زیر سطح درخواست</span>
            </div>
            <div class="db-chart-wrap">
                <canvas id="chart-below-request" role="img" aria-label="نمودار کالاهای زیر سطح درخواست"></canvas>
            </div>
        </div>

    </div>

    <div class="db-row-btm">

        <div class="db-card db-card-chart">
            <div class="db-ch">
                <span class="db-ct">کالاهای نزدیک به منقضی شدن</span>
            </div>
            <div class="db-chart-wrap">
                <canvas id="chart-near-expiry" role="img" aria-label="نمودار کالاهای نزدیک به منقضی شدن"></canvas>
            </div>
        </div>

        <div class="db-card db-card-chart">
            <div class="db-ch">
                <span class="db-ct">کالاهای بالای حداکثر</span>
            </div>
            <div class="db-chart-wrap">
                <canvas id="chart-above-max" role="img" aria-label="نمودار کالاهای بالای حداکثر"></canvas>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const belowMinLabels = @Html.Raw(Json.Serialize(Model.BelowMinItems.Select(x => x.Label)));
            const belowMinValues = @Html.Raw(Json.Serialize(Model.BelowMinItems.Select(x => x.Value)));

            const belowRequestLabels = @Html.Raw(Json.Serialize(Model.BelowRequestItems.Select(x => x.Label)));
            const belowRequestValues = @Html.Raw(Json.Serialize(Model.BelowRequestItems.Select(x => x.Value)));

            const nearExpiryLabels = @Html.Raw(Json.Serialize(Model.NearExpiryItems.Select(x => x.Label)));
            const nearExpiryValues = @Html.Raw(Json.Serialize(Model.NearExpiryItems.Select(x => x.Value)));

            const aboveMaxLabels = @Html.Raw(Json.Serialize(Model.AboveMaxItems.Select(x => x.Label)));
            const aboveMaxValues = @Html.Raw(Json.Serialize(Model.AboveMaxItems.Select(x => x.Value)));

            function createChart(canvasId, labels, data, color) {
                const ctx = document.getElementById(canvasId).getContext('2d');
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: data,
                            backgroundColor: color,
                            borderColor: color,
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { display: false }
                            },
                            x: {
                                grid: { display: false }
                            }
                        }
                    }
                });
            }

            if (belowMinLabels.length) {
                createChart('chart-below-min', belowMinLabels, belowMinValues, 'rgba(46, 204, 113, 0.7)');
            }
            if (belowRequestLabels.length) {
                createChart('chart-below-request', belowRequestLabels, belowRequestValues, 'rgba(52, 152, 219, 0.7)');
            }
            if (nearExpiryLabels.length) {
                createChart('chart-near-expiry', nearExpiryLabels, nearExpiryValues, 'rgba(46, 204, 113, 0.7)');
            }
            if (aboveMaxLabels.length) {
                createChart('chart-above-max', aboveMaxLabels, aboveMaxValues, 'rgba(52, 152, 219, 0.7)');
            }
        })();
    </script>
}