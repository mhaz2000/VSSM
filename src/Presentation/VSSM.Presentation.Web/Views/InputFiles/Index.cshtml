@using VSSM.Presentation.Web.Models.Base
@model GridViewModel

@{
    ViewData["Title"] = "بارگذاری فایل";
}

@section Styles {
    <link rel="stylesheet" href="~/css/components/shared/a-card.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/shared/btn.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/shared/f-control.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/shared/toast.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/shared/modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/shared/progress-bar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/shared/dynamic-grid.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/shared/submit-btn.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/InputFiles/input-files.css" asp-append-version="true" />
}

@{
    var items = ViewBag.Items as List<ItemListDto>;
}

<div class="report-wrap">
    <div class="report-page-title">
        <i class="fa fa-file-text-o" style="color:#3b82f6;"></i>
        <span>@ViewData["Title"]</span>
    </div>

    <div class="a-card">
        <div class="a-card-header">
            <i class="fa fa-upload" style="color:#16a34a;"></i>
            <h6>آپلود فایل XML</h6>
        </div>
        <div class="a-card-body">
            <form asp-controller="InputFiles"
                  asp-action="Upload"
                  method="post"
                  enctype="multipart/form-data"
                  id="uploadForm">

                <div class="fg-3">

                    <div class="f-group">
                        <label class="f-label" for="xmlFile">
                            انتخاب فایل XML
                            <span class="req-tag">اجباری</span>
                        </label>
                        <div class="file-upload-wrapper">
                            <div class="file-upload-control">
                                <div class="file-btn-wrapper">
                                    <button type="button"
                                            class="file-upload-btn"
                                            title="انتخاب فایل">
                                        <i class="fa fa-upload"></i>
                                        <span>انتخاب فایل</span>
                                    </button>
                                    <input type="file"
                                           id="xmlFile"
                                           name="xmlFile"
                                           class="file-input-hidden"
                                           accept=".xml,text/xml" />
                                </div>

                                <span class="file-name-display" id="fileNameDisplay">
                                    هیچ فایلی انتخاب نشده است
                                </span>

                                <button type="button"
                                        id="fileRemoveBtn"
                                        class="file-remove-btn d-none"
                                        title="حذف فایل">
                                    <i class="fa fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="f-group">
                        <label class="f-label" for="ItemId">
                            کالا
                            <span class="req-tag">اجباری</span>
                        </label>
                        <select id="ItemId" name="ItemId" class="f-control">
                            <option value="">-- انتخاب کنید --</option>
                            @foreach (var item in items ?? new List<ItemListDto>())
                            {
                                <option value="@item.ItemId">@item.FullName</option>
                            }
                        </select>
                    </div>

                    <div class="f-group">
                        <label class="f-label" for="DosePerVialId">
                            دوز بر ویال
                            <span class="req-tag">اجباری</span>
                        </label>
                        <select id="DosePerVialId" name="DosePerVialId" class="f-control" disabled>
                            <option value="">-- ابتدا کالا را انتخاب کنید --</option>
                        </select>
                    </div>

                </div>

                <div id="progressContainer" style="margin-top: 1rem;"></div>

                <div class="form-footer">       
                    <button id="uploadBtn"
                            type="submit"
                            class="btn-confirm js-submit-btn"
                            disabled>
                        <span class="js-btn-content">
                            <i class="fa fa-upload"></i> آپلود فایل
                        </span>
                        <span class="js-btn-spinner" hidden>
                            <span class="submit-spinner"></span>
                        </span>
                    </button>
                </div>

            </form>
        </div>
    </div>

    <hr class="section-divider" />

    <div class="a-card">
        <div class="a-card-header">
            <i class="fa fa-list" style="color:#3b82f6;"></i>
            <h6>لیست فایل‌های آپلود شده</h6>
        </div>
        <div class="a-card-body">
            @await Html.PartialAsync("_DynamicGrid", Model)
        </div>
    </div>
</div>

<div id="toastContainer"></div>

@section Scripts {
    <script src="~/js/components/shared/toast.js" asp-append-version="true"></script>
    <script src="~/js/components/shared/modal.js" asp-append-version="true"></script>
    <script src="~/js/components/shared/progress-bar.js" asp-append-version="true"></script>
    <script src="~/js/components/shared/dynamic-grid.js" asp-append-version="true"></script>
    <script src="~/js/components/shared/submit-btn.js" asp-append-version="true"></script>
    <script src="~/js/components/InputFiles/input-files.js" asp-append-version="true"></script>

    @if (TempData["ToastMessage"] != null)
    {
        <script>
            $(document).ready(function() {
                var message = @System.Text.Json.JsonSerializer.Serialize(TempData["ToastMessage"]);
                var type = '@TempData["ToastType"]';
                if (typeof toastService !== 'undefined') {
                    toastService.show(message, type);
                } else {
                    showToast(message, type);
                }
            });
        </script>
    }
}