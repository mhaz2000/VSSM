@using VSSM.Presentation.Web.Models.Base
@model GridViewModel

@{
    ViewData["Title"] = "فایل های ورودی";
}

@{
    var items = ViewBag.Items as List<ItemListDto>;
}

<div class="container-fluid">

    <div class="card mt-3">
        <div class="card-block">

            <div class="grid-wrapper">

                <div class="grid-header mb-4">
                    <strong style="font-size:1.2rem">@ViewData["Title"]</strong>
                </div>

                <form asp-controller="InputFiles"
                      asp-action="Upload"
                      method="post"
                      enctype="multipart/form-data">

                    <div class="row g-3" style="display: flex; align-items: center; margin-bottom: 2rem;">

                        <div class="col-md-4" style="position: relative">

                            <label class="mb-2" style="font-size:18px">انتخاب فایل XML<span class="input-req-tag" style="margin-top: 3px;">(اجباری)</span></label>

                            <div class="input-group">

                                <input type="file"
                                       id="xmlFile"
                                       name="xmlFile"
                                       class="form-control"
                                       accept=".xml,text/xml"
                                       onchange="handleFileSelect(this)" />

                            </div>

                            <small id="fileName" class="text-muted" style="position: absolute">
                                هیچ فایلی انتخاب نشده است
                            </small>

                        </div>

                        <div class="col-md-4 input-sec">

                            @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                            new SearchableSelectModel
                            {
                                Id = "ItemId",
                                IsRequired = true,
                                Name = "ItemId",
                                Label = "کالا",
                                SelectedValue = string.Empty,
                                Options = items
                            .Select(x => new SelectOption
                            {
                                Value = x.Id.ToString(),
                                Text = x.FullName
                            }).ToList()
                            })
                        </div>

                        <div class="col-md-4 input-sec">

                            @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                                                        new SearchableSelectModel
                                                        {
                                                            Id = "DosePerVialId",
                                                            IsRequired = true,
                                                            Name = "DosePerVialId",
                                                            Label = "دوز بر ویال",
                                                            SelectedValue = string.Empty,
                                                            Options = []
                                                        })
                        </div>

                    </div>

                    <button id="uploadBtn"
                            type="submit"
                            class="btn btn-primary mt-3"
                            disabled>
                        آپلود فایل
                    </button>



                </form>

                <div style="margin-top: 1rem;">
                    @await Html.PartialAsync("_DynamicGrid", Model)
                </div>

            </div>
        </div>
    </div>


</div>

@section Scripts {
    <script src="~/js/components/InputFiles/input-files.js"></script>
}