@model ItemViewModel
@{
    string formName = "ثبت";
    if (Model != null && Model.ItemId > 0)
        formName = "ویرایش";
}

<div class="container-fluid">
    <div class="animated fadeIn">
        <div class="card form-card">
            <div class="card-header card-form-header">
                <h5 class="header-title">@formName کالا</h5>
                <p>برای تعیین حجم واکسنها و حلالها به منوی "دوز اختصاص داده شده به کالا" مراجعه کنید</p>
            </div>
            <div class="card-block">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <form asp-action="Create" method="post" class="form-horizontal">
                        <input type="hidden" asp-for="ItemId"/>
                        <div class="row mx-0 mb-4">

                            <div class="form-group col-md-4">
                                <label class="form-label">نوع کالا</label>
                                <select class="form-control" asp-for="ItemClassId">
                                    <option value="">-- انتخاب کنید --</option>

                                    @foreach (var itemType in ViewBag.ItemClass)
                                    {
                                        <option value="@itemType.Id">@itemType.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="form-group col-md-4">
                                <label class="form-label">حجم (لیتر)</label>
                                <input type="number" class="form-control" asp-for="Volume" name="Volume"/>
                            </div>
                            <div class="form-group col-md-4">
                                <label class="form-label">کد</label>
                                <input class="form-control" asp-for="Code"/>
                                
                            </div>
                            <div class="form-group col-md-4">
                                <label class="form-label">نام کامل</label>
                                <input class="form-control" asp-for="FullName"/>
                            </div>

                            <div class="form-group col-md-4">
                                <div class="mb-2" style="padding-right: 20px;">
                                    <input class="form-check-input" style="margin-top: 0.65rem;"
                                     type="checkbox" id="requiresDiluentCheckbox" asp-for="RequiresDiluent"/>
                                    <label class="form-label m-0" asp-for="RequiresDiluent">نیاز به حلال</label>
                                </div>

                                <select class="form-control" id="itemClassDropdown" asp-for="DiluentId" disabled>
                                    <option value="">-- انتخاب کنید --</option>
                                    @foreach (var itemType in ViewBag.DiluentDropDown)
                                    {
                                    <option value="@itemType.Id">@itemType.Name</option>
                                    }
                                </select>
                            </div>


                            <div class="form-group col-md-4">
                                <label class="form-label">روزهای قبل از تاریخ انقضا</label>
                                <input type="number" class="form-control" asp-for="DayToWarmExpire"/>
                            </div>

                            <div class="form-group col-lg-4">
                                <label class="form-label">ترتیب نمایش در لیست</label>
                                <input type="number" class="form-control" asp-for="OrderInList"/>
                            </div>

                            <div class="form-group col-lg-6" style="padding:3rem 2rem 1rem 1rem;">
                                <div class="form-group col-md-3">
                                    <input class="form-check-input" type="checkbox" asp-for="UserBelowZeroStore" name="UserBelowZeroStore"/>
                                    <label class="form-check-label">انبار در زیر صفر درجه</label>
                                </div>

                                <div class="form-group col-md-3">
                                    <input class="form-check-input" type="checkbox" asp-for="UserAboveZeroStore" name="UserAboveZeroStore"/>
                                    <label class="form-check-label">انبار در بالای صفر درجه</label>
                                </div>

                                <div class="form-group col-md-3">
                                    <input class="form-check-input" type="checkbox" asp-for="UseOrdinaryStore" name="UseOrdinaryStore"/>
                                    <label class="form-check-label">انبار معمولی</label>
                                </div>

                                <div class="form-group col-md-3">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" name="IsActive"/>
                                    <label class="form-check-label">وضعیت فعال است</label>
                                </div>
                            </div>

                        </div>
                         <div class="text-left">
                            <button type="submit" class="btn btn-success px-5">ثبت</button>
                            <a asp-action="Index" class="btn btn-success-outlet px-5">بازگشت</a>
                        </div>
                    </form>


                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                </div>

        </div>
        <!--/col-->
    </div>
</div>

@section Scripts {
<script>
        //var classId = 1;
    // وقتی صفحه لود شد
    document.addEventListener("DOMContentLoaded", function() {
        const checkbox = document.getElementById("requiresDiluentCheckbox");
        const dropdown = document.getElementById("itemClassDropdown");
            const $item = $("#itemClassDropdown");


                    $item.prop("disabled", !checkbox.checked);
        

        // تغییر وضعیت هنگام تغییر چک‌باکس
        checkbox.addEventListener("change", function() {
                $item.prop("disabled", !checkbox.checked);


                if(this.checked){
                    
                    $item.prop("disabled", true);
                    $item.empty();
                        $.getJSON("/Arrival/GetItemsByClass", { classId: 1 })
                        .done(function (data) {

                            $item.append('<option value="">انتخاب کنید...</option>');

                            data.forEach(x => {
                                $item.append(
                                    `<option value="${x.id}">${x.text}</option>`
                                );
                            });

                            $item.prop("disabled", false);
                        });
                }
                else{
                       $item.prop("disabled", true);
                       $item.empty();
                       $item.append('<option value="">انتخاب کنید...</option>');
                }


        });
    });



    $(function () {
                const checkbox = document.getElementById("requiresDiluentCheckbox");
                    const $item = $("#itemClassDropdown");
                const $itemClass = $("#ItemClassId");
                $itemClass.on("change", function () {

                    var classId = $(this).val();
                    if(classId == 6){
                         checkbox.disabled = false;
                    }
                    else{
                         checkbox.disabled = true;
                            checkbox.checked = false;
                                $item.prop("disabled", true);
                           $item.empty();
                           $item.append('<option value="">انتخاب کنید...</option>');
                    }
                });
        });
</script>
}