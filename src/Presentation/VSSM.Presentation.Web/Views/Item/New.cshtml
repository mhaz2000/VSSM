﻿@using VSSM.Presentation.Web.Models.Item
@model ItemViewModel

@section Styles {
    <link href="~/css/components/shared/a-card.css" rel="stylesheet" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" />
    <link href="~/css/components/shared/toast.css" rel="stylesheet" />
    <link href="~/css/components/item/item-form.css" rel="stylesheet" />
}

@{
    string formName = (Model != null && Model.ItemId > 0) ? "ویرایش" : "ثبت";
    ViewData["Title"] = formName + " کالا";
}

<div class="item-form-wrap">

    <div class="item-page-title">
        <i class="fa @(Model != null && Model.ItemId > 0 ? "fa-pencil" : "fa-plus-circle")" style="color:#3b82f6;"></i>
        @formName کالا
    </div>

    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="ItemId" />

        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-box" style="color:#3b82f6;"></i>
                <h6>اطلاعات اصلی کالا</h6>
            </div>
            <div class="a-card-body">

                <div class="fg-2">
                    <div class="f-group required-field">
                        <label class="f-label">نوع کالا <span class="req-tag">اجباری</span></label>
                        <select class="f-control" asp-for="ItemClassId" id="ItemClassId">
                            <option value="">-- انتخاب کنید --</option>
                            @foreach (var itemType in ViewBag.ItemClass)
                            {
                                <option value="@itemType.Id" selected="@(Model?.ItemClassId == itemType.Id)">
                                    @itemType.Title
                                </option>
                            }
                        </select>
                        <div class="field-error">نوع کالا را انتخاب کنید</div>
                    </div>

                    <div class="f-group required-field">
                        <label class="f-label">کد <span class="opt">(اختیاری)</span></label>
                        <input class="f-control" asp-for="Code" placeholder="کد کالا را وارد کنید" />
                    </div>

                    <div class="f-group required-field">
                        <label class="f-label">نام کامل <span class="req-tag">اجباری</span></label>
                        <input class="f-control" asp-for="FullName" id="FullName" placeholder="نام کامل کالا" />
                        <div class="field-error">نام کامل کالا را وارد کنید</div>
                    </div>

                    <div class="f-group required-field">
                        <label class="f-label">روزهای قبل از تاریخ انقضا <span class="req-tag">اجباری</span></label>
                        <input type="number" class="f-control" asp-for="DayToWarmExpire" id="DayToWarmExpire" min="0" placeholder="مثلاً ۳۰" />
                        <div class="field-error">روزهای قبل از تاریخ انقضا را وارد کنید</div>
                    </div>
                </div>

            </div>
        </div>

        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-warehouse" style="color:#16a34a;"></i>
                <h6>تنظیمات انبار و حلال</h6>
            </div>
            <div class="a-card-body">

                <div class="checkbox-group">
                    <label class="checkbox-label">
                        <input type="checkbox" asp-for="UserBelowZeroStore" />
                        انبار زیر صفر درجه
                    </label>
                    <label class="checkbox-label">
                        <input type="checkbox" asp-for="UserAboveZeroStore" />
                        انبار بالای صفر درجه
                    </label>
                    <label class="checkbox-label">
                        <input type="checkbox" asp-for="UseOrdinaryStore" />
                        انبار معمولی
                    </label>
                    <label class="checkbox-label">
                        <input type="checkbox" asp-for="IsActive" />
                        وضعیت فعال
                    </label>
                    <label class="checkbox-label">
                        <input type="checkbox" id="requiresDiluentCheckbox" asp-for="RequiresDiluent" />
                        نیاز به حلال دارد
                    </label>
                </div>

                <div class="section-divider"></div>

                <div class="diluent-wrap">
                    <div class="f-group">
                        <label class="f-label">حلال <span class="opt">(اختیاری)</span></label>
                        @{
                            bool diluentEnabled = Model?.RequiresDiluent == true;
                        }
                        <select class="f-control" id="diluentDropdown" asp-for="DiluentId"
                                data-selected="@Model?.DiluentId"
                                disabled="@(!diluentEnabled)">
                            <option value="">-- انتخاب کنید --</option>
                            @if (ViewBag.DiluentDropDown != null)
                            {
                                foreach (var d in ViewBag.DiluentDropDown)
                                {
                                    bool isSelected = Model?.DiluentId == d.ItemId;
                                    <option value="@d.ItemId" selected="@isSelected">@d.FullName</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <p class="item-form-note" style="margin-top: 1rem;">
                    برای تعیین حجم واکسن‌ها و حلال‌ها به منوی «دوز اختصاص‌داده‌شده به کالا» مراجعه کنید.
                </p>

            </div>
        </div>

        <div class="form-footer">
            <a asp-action="Index" class="btn-back">
                <i class="fa fa-arrow-right"></i> بازگشت
            </a>
            <button type="submit" class="btn-confirm">
                <i class="fa fa-save"></i> @formName
            </button>
        </div>

    </form>
</div>

<div id="toastContainer"></div>

@section Scripts {
    <script src="~/js/components/shared/toast.js"></script>
    <script src="~/js/components/item/item-form.js"></script>
    @if (TempData["ToastMessage"] != null)
    {
        <script>
            showToast('@TempData["ToastMessage"]', '@TempData["ToastType"]');
        </script>
    }
}