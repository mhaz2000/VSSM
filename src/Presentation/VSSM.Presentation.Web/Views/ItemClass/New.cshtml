@model ItemClassViewModel
@{
    string formName = "ثبت";
    if (Model != null && Model.ItemClassId > 0)
        formName = "ویرایش";
}
<style>
    .form-label {
        text-align: left;
        width: 130px;
        margin-left: 15px;
    }

    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        direction: rtl;
    }

    .form-control, .form-select {
        flex: 1;
    }

    .form-check {
        margin-inline-end: 20px;
        margin-right: 30px !important;
    }

    .form-check-label {
        padding-right: 0rem !important;
    }

    .card {
        direction: rtl;
    }
</style>

<div class="container-fluid">
    <div class="animated fadeIn">


        <div class="card">
            <div class="card-block">
                <div class="col-lg-3">
                    <div>
                        <h5>@formName نوع کالا</h5>
                    </div>
                </div>
            </div>
        </div>

        <div>

            <div class="card">
                <div class="card-block">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <form asp-action="Create" method="post" class="form-horizontal">
                        <input type="hidden" asp-for="ItemClassId"/>
                        <div class="col-lg-6">
                            <div class="form-group">
                                <label class="form-label" for="Code">کد:</label>
                                <input type="text" asp-for="Code" name="Code" class="form-control bg-warning-subtle" required/>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="FullName">نام کامل:</label>
                                <input type="text" asp-for="FullName" name="FullName" class="form-control bg-warning-subtle" required/>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="Unit">واحد حجم:</label>
                                <select asp-for="UnitName" asp-items="ViewBag.UnitList" class="form-select">
                                </select>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="DisplayOrder">ترتیب نمایش:</label>
                                <input type="number" asp-for="OrderInList" name="OrderInList" class="form-control" min="0"/>
                            </div>

                            <div class="form-group">
                                <label class="form-label">وضعیت:</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" name="IsActive" checked/>
                                    <label class="form-check-label" for="IsActive" id="IsActive">فعال است</label>
                                </div>
                            </div>

                            @* <hr /> *@

                            <div class="form-group">
                                <label class="form-label">فیلدهای اجرایی:</label>
                                <div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" asp-for="ReqManufacturer" name="ReqManufacturer"/>
                                        <label class="form-check-label" for="lbbReqManufacturer">سازنده</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" asp-for="ReqBatchNo" name="ReqBatchNo"/>
                                        <label class="form-check-label" for="lblReqBatchNo">سری ساخت</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" asp-for="ReqExpireDate" name="ReqExpireDate"/>
                                        <label class="form-check-label" for="lblReqExpireDate">تاریخ انقضاء</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input type="hidden" asp-for="ReqDosePerVial" name="ReqDosePerVial" value="true"/>
                                        <input class="form-check-input" type="checkbox" disabled checked/>
                                        <label class="form-check-label" for="lblReqDosePerVial">دوز بر وال</label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-8"></div>
                            <div class="col-lg-4">
                                <div class="text-center mt-4 align-middle">
                                    <button type="submit" class="btn btn-success px-5">ثبت</button>
                                    <a type="button" class="btn btn-primary px-5" asp-action="Index">لیست</a>
                                </div>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
        <!--/col-->
    </div>
    <!--/row-->
</div>