@using VSSM.Presentation.Web.Models.Base
@model GridViewModel

@{
    ViewData["Title"] = "مدیریت اختصاص دوز به کالا";
}

@if (TempData["ToastMessage"] != null)
{
    <script>
        $(document).ready(function() {
            var message = @System.Text.Json.JsonSerializer.Serialize(TempData["ToastMessage"]);
            var type = '@TempData["ToastType"]';
            toastService.show(message, type);
        });
    </script>
}

@section Styles {
    <link href="~/css/components/shared/grid-wrapper.css" rel="stylesheet" />
    <link href="~/css/components/shared/grid-header.css" rel="stylesheet" />

}

<div class="grid-wrapper">
    <div class="grid-header" style="direction:rtl;">

        <strong style="font-size:1.4rem; font-weight:600; color:#111827;">
            @ViewData["Title"]
        </strong>

        <div class="d-flex align-items-center gap-2">

            <form method="get" class="m-0">
                <input type="hidden" name="sort" value="@Model.CurrentSort" />
                <input type="hidden" name="direction" value="@Model.CurrentDirection" />
                <input type="hidden" name="pageSize" value="@Model.Data.PageSize" />

                <div class="search-wrap">
                    <div class="search-divider"></div>
                    <input type="text" name="search" class="search-input"
                           value="@Model.SearchTerm" placeholder="جستجو..." />
                    <button type="submit" class="search-btn" title="جستجو">
                        <i class="fa fa-search"></i>
                    </button>
                </div>
            </form>

            <a asp-action="New" class="btn-add">
                <span class="plus-circle">+</span>
                افزودن
            </a>

        </div>
    </div>

    <div>
        @await Html.PartialAsync("_DynamicGrid", Model)
    </div>

    <div class="modal fade" id="deleteConfirmModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">تایید حذف</h5>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning" style="font-size:14px; line-height:1.6;">
                        <i class="fa fa-exclamation-triangle" style="margin-left:6px;"></i>
                        آیا از حذف این آیتم اطمینان دارید؟
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-dismiss="modal">انصراف</button>
                    <button type="button" class="btn btn-danger" id="deleteConfirmSubmit">حذف</button>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/shared/dynamic-grid.js" asp-append-version="true"></script>
    <script>
        $(function () {
            var pendingDeleteForm = null;

            $(document).on("click", ".delete-item", function (e) {
                e.preventDefault();
                pendingDeleteForm = $(this).closest("form");
                $("#deleteConfirmModal").modal("show");
            });

            $("#deleteConfirmSubmit").on("click", function () {
                if (pendingDeleteForm) {
                    pendingDeleteForm.submit();
                }
                $("#deleteConfirmModal").modal("hide");
            });
        });
    </script>
}
