@model ItemDoseAssignmentViewModel

@{
    string formName = Model is not null && Model.ItemDoseAssignmentId > 0 ? "ویرایش اختصاص دوز به کالا" : "ثبت اختصاص دوز به کالا";
    var isEdit = Model is not null && Model.ItemDoseAssignmentId > 0;
    var serverMsg = TempData["ToastMessage"]?.ToString();
    var serverType = TempData["ToastType"]?.ToString();
    TempData.Remove("ToastMessage");
    TempData.Remove("ToastType");
}

@section Styles {
    <link href="~/css/components/shared/a-card.css" rel="stylesheet" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" />
    <link href="~/css/components/shared/toast.css" rel="stylesheet" />
    <link href="~/css/components/user/user-form.css" rel="stylesheet" />
}

<div class="user-form-wrap">
    <div id="toastContainer"></div>
    <strong class="user-form-title">@formName</strong>

    <form asp-action="Create" method="post" style="margin-top: 1rem;" novalidate>
        <input type="hidden" asp-for="ItemDoseAssignmentId" />

        <!-- اختصاص دوز به کالا -->
        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-flask" style="color:#1d6fb8;"></i>
                <h6>اختصاص دوز به کالا</h6>
            </div>
            <div class="a-card-body">
                <div class="fg-3">
                    <div class="f-group">
                        <label class="f-label">نوع کالا <span class="req-tag">اجباری</span></label>
                        <select id="ItemClassId"
                                asp-for="ItemClassId"
                                asp-items="ViewBag.ItemClass" required
                                class="f-control">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label">کالا <span class="req-tag">اجباری</span></label>
                        <select id="ItemId" asp-for="ItemId"
                                class="f-control" required disabled>
                            <option value="">ابتدا نوع کالا را انتخاب کنید</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label">دوز بر ویال <span class="req-tag">اجباری</span></label>
                        <select class="f-control" asp-for="DoseId">
                            <option value="">-- انتخاب کنید --</option>
                            @foreach (var itemType in ViewBag.DosePerVial)
                            {
                                <option value="@itemType.Id">@itemType.Title</option>
                            }
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label">حجم بر دوز (cm3) </label>
                        <input type="number" asp-for="VialPerDoseCm3" class="f-control" min="0" />
                    </div>
                </div>
            </div>
        </div>

        <!-- فوتر -->
        <div class="form-footer a-card">
            <a asp-action="Index" class="btn-back">
                <i class="fa fa-arrow-right"></i> بازگشت
            </a>
            <button type="submit" class="btn-confirm">
                <i class="fa fa-save"></i> ثبت
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/shared/toast.js"></script>
    <script>
        var serverMsg  = "@(serverMsg ?? "")";
        var serverType = "@(serverType ?? "info")";

        $(function () {
            if (serverMsg) {
                showToast(serverMsg, serverType);
            }

            const $itemClass = $("#ItemClassId");
            const $item = $("#ItemId");

            $itemClass.on("change", function () {
                const classId = $(this).val();

                $item.prop("disabled", true);
                $item.empty();

                if (!classId) {
                    $item.append('<option value="">ابتدا نوع کالا را انتخاب کنید</option>');
                    return;
                }

                $.getJSON("/Arrival/GetItemsByClass", { classId: classId })
                    .done(function (data) {
                        $item.append('<option value="">انتخاب کنید...</option>');
                        data.forEach(x => {
                            $item.append(
                                `<option value="${x.id}">${x.text}</option>`
                            );
                        });
                        $item.prop("disabled", false);

                        // If editing, pre-select the ItemId after loading items
                        var selectedItemId = '@(Model?.ItemId)';
                        if (selectedItemId) {
                            $item.val(selectedItemId);
                        }
                    });
            });

            // If editing, pre-select ItemClass and trigger load
            var initialClassId = '@(Model?.ItemClassId)';
            if (initialClassId) {
                $itemClass.val(initialClassId).trigger("change");
            }
        });
    </script>
}
