@model ItemDoseAssignmentViewModel
@{
    string formName = "ثبت";
    if (Model != null && Model.ItemDoseAssignmentId > 0)
        formName = "ویرایش";
}


<div class="container-fluid">
    <div class="animated fadeIn">


        <div class="card form-card">
            <div class="card-header card-form-header">
                <h5 class="header-title">@formName  اختصاص دوز به کالا</h5>
            </div>
                  <div class="card-block">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <form asp-action="Create" method="post" class="form-horizontal">
                        <input type="hidden" asp-for="ItemDoseAssignmentId" />
                        <div class="row mx-0 mb-4">


                            <!-- نوع کالا -->
                                <div class="form-group col-lg-3">
                                    <label class="form-label">نوع کالا <span class="form-label-caption"> (اجباری)</span>
                                    </label>
                                    <select id="ItemClassId"
                                        asp-items="ViewBag.ItemClass" required
                                            class="form-control form-select">
                                        <option value="">انتخاب کنید...</option>
                                    </select>
                                </div>

                                <!-- کالا -->
                            <div class="form-group col-lg-3">
                                    <label class="form-label">کالا 
                                        <span class="form-label-caption"> (اجباری)</span>
                                    </label>
                                <select id="ItemId" asp-for="ItemId"
                                        class="form-control form-select" required
                                            disabled>
                                        <option value="">ابتدا نوع کالا را انتخاب کنید</option>
                                    </select>
                                </div>

                            <div class="form-group col-lg-3">
                                <label class="form-label"> دوز بر ویال
                                    <span class="form-label-caption"> (اجباری)</span>
                                </label>
                                <select class="form-control" asp-for="DoseId">
                                    <option value="">-- انتخاب کنید --</option>

                                    @foreach (var itemType in ViewBag.DosePerVial)
                                    {
                                        <option value="@itemType.DosePerVialId">@itemType.NumDosePerVial</option>
                                    }
                                </select>
                            </div>

                            <div class="form-group col-lg-3">
                                <label class="form-label" for="DisplayOrder">حجم بر دوز (cm3) :</label>
                                <input type="number" asp-for="VialPerDoseCm3" name="VialPerDoseCm3" class="form-control" min="0" />
                            </div>


                           
                         <div class="text-left">
                            <button type="submit" class="btn btn-success px-5">ثبت</button>
                            <a asp-action="Index" class="btn btn-success-outlet px-5">بازگشت</a>
                        </div>
                    </form>

                </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        $(function () {

            const $itemClass = $("#ItemClassId");
            const $item = $("#ItemId");

            // تغییر نوع کالا
            $itemClass.on("change", function () {

                const classId = $(this).val();

                // reset
                $item.prop("disabled", true);
                $item.empty();

                if (!classId) {
                    $item.append('<option value="">ابتدا نوع کالا را انتخاب کنید</option>');
                    return;
                }

                // load filtered items
                $.getJSON("/Arrival/GetItemsByClass", { classId: classId })
                    .done(function (data) {

                        $item.append('<option value="">انتخاب کنید...</option>');

                        data.forEach(x => {
                            $item.append(
                                `<option value="${x.id}">${x.text}</option>`
                            );
                        });

                        $item.prop("disabled", false);
                    });
            });
        });

    </script>
}