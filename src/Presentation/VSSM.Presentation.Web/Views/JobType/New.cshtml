@model VSSM.Presentation.Web.Models.JobType.JobTypeViewModel

@{
    string formName = Model.JobTypeId > 0 ? "ویرایش" : "ثبت";
}


<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card form-card">
            <div class="card-header card-form-header">
                <h5 class="header-title">@formName عنوان شغل
            </h5>
            </div>
            <div class="card-block">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="JobTypeId" />

                    <div class="row mb-4 mx-0">

                        <div class="form-group col-lg-6">
                            <label class="form-label">نام کامل <span class="form-label-caption"> (اجباری)</span></label>
                                    
                            <input asp-for="FullName" class="form-control bg-warning-subtle" />
                        </div>
                        <span class="text-danger" asp-validation-for="FullName"></span>

                        <div class="form-group col-lg-6">
                            <label class="form-label">وضعیت</label>

                            <div class="form-check">
                                <input type="radio"
                                    asp-for="IsActive"
                                    value="true"
                                    class="form-check-input"
                                    id="isActiveTrue" />
                                <label class="form-check-label" for="isActiveTrue">
                                    فعال
                                </label>
                            </div>

                            <div class="form-check">
                                <input type="radio"
                                    asp-for="IsActive"
                                    value="false"
                                    class="form-check-input"
                                    id="isActiveFalse" />
                                <label class="form-check-label" for="isActiveFalse">
                                    غیرفعال
                                </label>
                            </div>
                        </div>

                        

                    </div>
                    <div class="text-left">
                        <button type="submit" class="btn btn-success px-5">ثبت</button>
                        <a asp-action="Index" class="btn btn-success-outlet px-5">بازگشت</a>
                    </div>
                </form>
            </div>
                    

   
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
