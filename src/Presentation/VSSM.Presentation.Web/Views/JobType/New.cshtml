@model VSSM.Presentation.Web.Models.JobType.JobTypeViewModel

@{
    string formName = Model.JobTypeId > 0 ? "ویرایش" : "ثبت";
}

<style>
    .form-label {
        width: 130px;
        text-align: left;
        margin-left: 15px;
    }

    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        direction: rtl;
    }

    .form-control {
        flex: 1;
    }

    .form-check {
        display: flex;
        align-items: center;
        margin-right: 30px !important;
    }
</style>

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-block">
                <h5>@formName عنوان شغل</h5>
            </div>
        </div>

        <div class="card mt-2">
            <div class="card-block">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="JobTypeId" />

                    <div class="col-lg-6">

                        <div class="form-group">
                            <label class="form-label">نام کامل:</label>
                            <input asp-for="FullName" class="form-control bg-warning-subtle" />
                        </div>
                        <span class="text-danger" asp-validation-for="FullName"></span>

                        <div class="form-group">
                            <label class="form-label">وضعیت:</label>
                            <div class="form-check">
                                <input type="checkbox" asp-for="IsActive" class="form-check-input" />
                                <label class="form-check-label">فعال است</label>
                            </div>
                        </div>

                        <div class="text-center mt-4">
                            <button class="btn btn-success px-5">ثبت</button>
                            <a asp-action="Index" class="btn btn-primary px-5">لیست</a>
                        </div>

                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
