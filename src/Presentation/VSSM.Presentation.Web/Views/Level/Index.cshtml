@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PagingSearchOrderDto<VSSM.Application.DTOs.BaseEntities.Levels.LevelDto>
@{
    ViewData["Title"] = "مدیریت سطوح";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="row m-0  card-header">
                <div class="col-lg-9">
                    <h5 class="header-title">@ViewData["Title"]</h5>
                </div>
                <div class="col-lg-3 row d-flex align-items-center justify-content-between">

                        <div class="col-lg-9">
                            @await Component.InvokeAsync("SearchBar", new
                            {
                                searchTerm = Model.SearchText,
                                pageSize = Model.Paging.PageSize,
                                sort = Model.SortField,
                                direction = Model.SortOrder
                            })
                        </div>
                        <div class="col-lg-3">
                            <a class="btn btn-success m-0" 
                                asp-controller="level"
                       asp-action="New"><i class="fa fa-plus ml-2"></i>افزودن</a>
                        </div>

                </div>
            </div>
            <div class="card-block">
                    <div class="table-wrapper">
                        <table class="table table-bordered table-striped table-condensed text-center mb-0">
                            <thead>
                            <tr>
                                <th>سطح در زنجیره</th>
                                <th>تعداد ارسال</th>
                                <th>درصد موجودی ایمنی</th>
                                <th>ماه موجودی ایمنی</th>
                                <th>حداکثر روز عدم اتصال</th>
                                <th>یادداشت</th>
                                <th>عملیات</th>
                            </tr>
                            </thead>
                            <tbody>
                            @if (Model.Items != null && Model.Items.Any())
                            {
                                foreach (var level in Model.Items)
                                {
                                    <tr>
                                        <td>@level.LevelId</td>
                                        <td>@level.ShipCount</td>
                                        <td>@level.SafetyStockPercentage</td>
                                        <td>@level.SafetyStockMonth</td>
                                        <td>@level.MaxDay</td>
                                        <td>@level.Note</td>
                                        <td>
                                            <a class="btn btn-link text-info btn-sm"
                                                asp-action="Edit"
                                                asp-route-id="@level.LevelId">
                                                <i class="fa fa-edit" style="font-size:18px;"></i>
                                            </a>

                                            <form asp-action="Delete"
                                                asp-route-id="@level.LevelId"
                                                method="post"
                                                style="display:inline;">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-link text-danger btn-sm p-0"
                                                        onclick="return confirm('آیا مطمئن هستید می‌خواهید حذف کنید؟');">
                                                    <i class="fa fa-trash" style="font-size:18px;"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-danger">داده‌ای یافت نشد</td>
                                </tr>
                            }
                            </tbody>
                        </table>

                       
                    </div>
                    <!-- Pagination -->
               @{
                    int page = Model.Paging.Page;
                    int totalPages = Model.Paging.TotalPages;

                    // چند صفحه اطراف صفحه فعلی
                    int window = 2;

                    // پارامترهای فیلتر/مرتب‌سازی که باید حفظ شوند
                    var search = Model.SearchText ?? "";
                    var sortField = Model.SortField ?? "";
                    var sortOrder = Model.SortOrder ?? "";

                    // typeId از QueryString میاد (چون تو Model نیست)
                    var typeId = Context.Request.Query["typeId"].ToString() ?? "";

                    // انتخاب صفحات: 1, ... , (page-window..page+window), ... , total
                    var selected = new SortedSet<int>();
                    if (totalPages >= 1) selected.Add(1);

                    for (int p = page - window; p <= page + window; p++)
                        if (p >= 1 && p <= totalPages) selected.Add(p);

                    if (totalPages >= 2) selected.Add(totalPages);

                    string PageUrl(int p)
                    => $"?search={search}&typeId={typeId}&sortField={sortField}&sortOrder={sortOrder}&page={p}";
                }

                <nav class="pager-wrap mt-2 m-auto" aria-label="Page navigation">
                    <ul class="cpageination pager-modern m-auto">

                        <!-- قبلی -->
                        <li class="page-item @(page == 1 ? "disabled" : "")">
                            <a class="page-link" href="@(page == 1 ? "#" : PageUrl(page - 1))" tabindex="@(page == 1 ? "-1" : "0")">
                                <
                            </a>
                        </li>

                        @{
                            int prev = 0;
                            foreach (var p in selected)
                            {
                                if (prev != 0 && p - prev > 1)
                                {
                                    <li class="page-item disabled ellipsis">
                                        <span class="page-link">…</span>
                                    </li>
                                }

                                <li class="page-item @(p == page ? "active" : "")">
                                    <a class="page-link" href="@PageUrl(p)">@p</a>
                                </li>

                                prev = p;
                            }
                        }
                        <li class="page-item @(page == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@(page == 1 ? "#" : PageUrl(page + 1))" tabindex="@(page == 1 ? "-1" : "0")">
                                >
                            </a>
                        </li>
                        </nav>
                </div>
        </div>


    </div>
</div>

@section Scripts {
    <script>
        // Optional: Add any JavaScript if needed
    </script>
}