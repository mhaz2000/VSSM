@using Microsoft.AspNetCore.Mvc.TagHelpers
@model VSSM.Presentation.Web.Models.Level.LevelViewModel
@{
    string formName = "ثبت";
    if (Model != null && Model.LevelId > 0)
        formName = "ویرایش";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-header">
                <h5 class="header-title">@formName سطح</h5>
            </div>

            <div class="card-block">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <form asp-action="Create" method="post" class="form-horizontal">
                        <input type="hidden" asp-for="LevelId" />

                        <div class="row mx-0 mb-4">
                            <div class="form-group col-lg-3">
                                <label class="form-label" for="ShipCount">تعداد ارسال</label>
                                <input type="number" asp-for="ShipCount" class="form-control" min="0" />
                            </div>

                            <div class="form-group col-lg-3">
                                <label class="form-label" for="SafetyStockPercentage">درصد موجودی ایمنی</label>
                                <input type="number" asp-for="SafetyStockPercentage" class="form-control" min="0" max="100" step="0.01" />
                            </div>

                            <div class="form-group col-lg-3">
                                <label class="form-label" for="SafetyStockMonth">ماه موجودی ایمنی</label>
                                <input type="number" asp-for="SafetyStockMonth" class="form-control" min="0" step="0.01" />
                            </div>

                            <div class="form-group col-lg-3">
                                <label class="form-label" for="MaxDay">حداکثر روز عدم اتصال</label>
                                <input type="number" asp-for="MaxDay" class="form-control" min="0" />
                            </div>

                            <div class="form-group col-lg-12">
                                <label class="form-label" for="Note">یادداشت</label>
                                <textarea asp-for="Note" class="form-control" rows="8"></textarea>
                            </div>

                        </div>
                        <div class="text-left">
                            <button type="submit" class="btn btn-success px-5">ثبت</button>
                            <a asp-action="Index" class="btn btn-success-outlet px-5">بازگشت</a>
                        </div>
                    </form>

                </div>


         </div>
    </div>
</div>
