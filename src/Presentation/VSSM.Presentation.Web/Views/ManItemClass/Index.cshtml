@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PagingSearchOrderDto<VSSM.Application.DTOs.BaseEntities.ManItemClass.ManItemClassDto>

@{
ViewData["Title"] = "نام های تجاری";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-block">
                <div class="col-lg-3">
                    <h5>مدیریت کلاس‌های آیتم تولیدکننده</h5>
                </div>

                <form method="get">
                    <div class="col-lg-4">
                        <div class="input-group">
                            <input type="text" name="search" value="@Model.SearchText" class="form-control" placeholder="جستجو...">
                            <div class="input-group-btn">
                                <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> جستجو</button>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="col-lg-1 ms-auto">
                    <a class="btn btn-success" asp-controller="ManItemClass" asp-action="New">
                        <i class="fa fa-plus-circle"></i> جدید
                    </a>
                </div>
            </div>
        </div>

        <!-- Data Table -->
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body p-0">

                        <table class="table table-bordered table-striped table-condensed text-center mb-0">
                            <thead>
                            <tr>
                                <th>شناسه</th>
                                <th>کد کلاس</th>
                                <th>شناسه تولیدکننده</th>
                                <th>عملیات</th>
                            </tr>
                            </thead>

                            <tbody>
                            @if (Model.Items != null && Model.Items.Any())
                            {
                            foreach (var item in Model.Items)
                            {
                            <tr>
                                <td>@item.ManItemClassId</td>
                                <td>@item.ItemClassCode</td>
                                <td>@item.ManufacturerId</td>

                                <td>
                                    <a class="btn btn-primary btn-sm"
                                       asp-controller="ManItemClass"
                                       asp-action="Edit"
                                       asp-route-id="@item.ManItemClassId">
                                        ویرایش
                                    </a>

                                    <form asp-controller="ManItemClass"
                                          asp-action="Delete"
                                          asp-route-id="@item.ManItemClassId"
                                          method="post"
                                          style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('آیا مطمئن هستید می‌خواهید حذف کنید؟');">
                                            حذف
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            }
                            }
                            else
                            {
                            <tr>
                                <td colspan="4" class="text-center text-danger">داده‌ای یافت نشد</td>
                            </tr>
                            }
                            </tbody>
                        </table>

                        <!-- Pagination -->
                        <nav class="mt-2">
                            <ul class="pagination justify-content-center">

                                <!-- Previous -->
                                <li class="page-item @(Model.Paging.Page <= 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?search=@Model.SearchText&page=@(Model.Paging.Page - 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">
                                        قبلی
                                    </a>
                                </li>

                                <!-- Page Numbers -->
                                @for (int i = 1; i <= Model.Paging.TotalPages; i++)
                                {
                                <li class="page-item @(Model.Paging.Page == i ? "active" : "")">
                                    <a class="page-link"
                                       href="?search=@Model.SearchText&page=@i&sortField=@Model.SortField&sortOrder=@Model.SortOrder">
                                        @i
                                    </a>
                                </li>
                                }

                                <!-- Next -->
                                <li class="page-item @(Model.Paging.Page >= Model.Paging.TotalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?search=@Model.SearchText&page=@(Model.Paging.Page + 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">
                                        بعدی
                                    </a>
                                </li>

                            </ul>
                        </nav>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    // Optional JavaScript
</script>
}
