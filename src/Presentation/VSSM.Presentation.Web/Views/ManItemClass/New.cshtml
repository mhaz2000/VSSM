@using Microsoft.AspNetCore.Mvc.TagHelpers
@model VSSM.Presentation.Web.Models.ManItemClass.ManItemClassViewModel
@{
    // Determine if we are creating (ثبت) or editing (ویرایش)
    string formName = "ثبت";
    if (Model != null && Model.ManItemClassId > 0)
        formName = "ویرایش";
}

<style>
    /* Styling copied from the Level example for consistency */
    .form-label {
        text-align: left;
        width: 130px;
        margin-left: 15px;
    }

    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        direction: rtl;
    }

    .form-control, .form-select {
        flex: 1;
    }

    /* Custom style for boolean checkboxes (Not used in this view but kept for consistency) */
    .form-check-group {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        direction: rtl;
    }

    .form-check-group .form-label {
        width: 130px; /* Keep label width consistent */
        margin-left: 15px;
        flex-shrink: 0; /* Prevent label from shrinking */
    }

    .form-check-input {
        margin-right: 0 !important; /* Override default margin */
        margin-left: 10px;
    }

    .card {
        direction: rtl;
    }
</style>

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-block">
                <div class="col-lg-3">
                    <div><h5>@formName کلاس/تولیدکننده</h5></div>
                </div>
            </div>
        </div>

        <div>
            <div class="card">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <form asp-controller="ManItemClass" asp-action="Create" method="post" class="form-horizontal">
                        @* Hidden field for the ID. If > 0, we are editing. *@
                        <input type="hidden" asp-for="ManItemClassId" />

                        <div class="col-lg-6">

                            @* ItemClassCode *@
                            <div class="form-group">
                                <label class="form-label" for="ItemClassCode">کد کلاس قلم:</label>
                                <input type="text" asp-for="ItemClassCode" class="form-control" />
                            </div>
                            <span asp-validation-for="ItemClassCode" class="text-danger"></span>

                            @* ManufacturerId (Dropdown/Select) *@
                            <div class="form-group">
                                <label class="form-label" for="ManufacturerId">تولید کننده:</label>
                                @* In a real application, you would populate the dropdown list 
                                    (e.g., using a list of SelectListItem in the ViewModel) here 
                                * @
                                <select asp-for="ManufacturerId" class="form-select">
                                    <option value="">انتخاب کنید...</option>
                                    @* Example options (Replace with actual data) *@
                                    <option value="1">تولید کننده A</option>
                                    <option value="2">تولید کننده B</option>
                            </div>
                            <span asp-validation-for="ManufacturerId" class="text-danger"></span>
                            
                            <hr class="my-4"/>

                            @* Action Buttons *@
                            <div class="col-lg-8"></div>
                            <div class="col-lg-4">
                                <div class="text-center mt-4 align-middle">
                                    <button type="submit" class="btn btn-success px-5">@formName</button>
                                    <a type="button" class="btn btn-primary px-5" asp-controller="ManItemClass" asp-action="Index">لیست</a>
                                </div>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>