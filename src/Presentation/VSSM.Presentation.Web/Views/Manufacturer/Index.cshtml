@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PagingSearchOrderDto<VSSM.Application.DTOs.BaseEntities.Manufacturer.ManufacturerDto>
@{
ViewData["Title"] = "مدیریت تولید کنندگان";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-block">
                <div class="col-lg-3">
                    <h5>سازندگان</h5>
                </div>
                <div class="col-lg-4">
                </div>
                <form method="get">
                    <div class="col-lg-4">
                        <div class="input-group">
                            <input type="text" name="search" value="@Model.SearchText" class="form-control" placeholder="جستجو...">
                            <div class="input-group-btn">
                                <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> جستجو</button>
                            </div>

                        </div>
                    </div>

                </form>

                <div class="col-lg-1 ms-auto">
                    <a class="btn btn-success" asp-controller="Manufacturer" asp-action="New"><i class="fa fa-plus-circle"></i> جدید</a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body p-0">
                        <table class="table table-bordered table-striped table-condensed text-center mb-0">
                            <thead>
                            <tr>
                                <th>شناسه</th>
                                <th>کد</th>
                                <th>نام کامل</th>
                                <th>تاریخ ورود</th>
                                <th>نمایش برای VAC</th>
                                <th>نمایش برای سایر</th>
                                <th>فعال</th>
                                <th>عملیات</th>
                            </tr>
                            </thead>
                            <tbody>
                            @if (Model.Items != null && Model.Items.Any())
                            {
                            foreach (var manufacturer in Model.Items)
                            {
                            <tr>
                                <td>@manufacturer.ManufacturerId</td>
                                <td>@manufacturer.Code</td>
                                <td>@manufacturer.FullName</td>
                                <td>@manufacturer.EntryShamsiDate</td>
                                <td>@(manufacturer.ShowForVac ? "بله" : "خیر")</td>
                                <td>@(manufacturer.ShowForOther ? "بله" : "خیر")</td>
                                <td>@(manufacturer.IsActive ? "فعال" : "غیرفعال")</td>
                                <td>
                                    <a class="btn btn-outline-primary btn-sm" asp-controller="Manufacturer" asp-action="Edit" asp-route-id="@manufacturer.ManufacturerId">ویرایش</a>

                                    <form asp-controller="Manufacturer" asp-action="Delete" asp-route-id="@manufacturer.ManufacturerId" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('آیا مطمئن هستید می‌خواهید حذف کنید؟');">حذف</button>
                                    </form>
                                </td>
                            </tr>
                            }
                            }
                            else
                            {
                            <tr>
                                <td colspan="8" class="text-center text-danger">داده‌ای یافت نشد</td>
                            </tr>
                            }
                            </tbody>
                        </table>

                        <nav class="mt-2">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(Model.Paging.Page <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="?search=@Model.SearchText&page=@(Model.Paging.Page - 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">قبلی</a>
                                </li>

                                @for (int i = 1; i <= Model.Paging.TotalPages; i++)
                                {
                                <li class="page-item @(Model.Paging.Page == i ? "active" : "")">
                                    <a class="page-link" href="?search=@Model.SearchText&page=@i&sortField=@Model.SortField&sortOrder=@Model.SortOrder">@i</a>
                                </li>
                                }

                                <li class="page-item @(Model.Paging.Page >= Model.Paging.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="?search=@Model.SearchText&page=@(Model.Paging.Page + 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">بعدی</a>
                                </li>
                            </ul>
                        </nav>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    // Optional: Add any JavaScript if needed
</script>
}