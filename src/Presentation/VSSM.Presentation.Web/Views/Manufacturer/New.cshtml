@using Microsoft.AspNetCore.Mvc.TagHelpers
@model VSSM.Presentation.Web.Models.Manufacturer.ManufacturerViewModel
@{
    string formName = "ثبت";
    if (Model != null && Model.ManufacturerId > 0)
        formName = "ویرایش";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-header">
                <h5 class="header-title">@formName سازنده</h5>
            </div>
            <div class="card-block">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form asp-controller="Manufacturer" asp-action="Create" method="post" class="form-horizontal">
                    <input type="hidden" asp-for="ManufacturerId" />

                    <div class="row equal-height mb-4 mx-0">
                        <div class="form-group col-lg-4">
                            <label class="form-label" for="Code">کد
                            <span class="form-label-caption">(اجباری)</span>
                            </label>
                            <input type="text" asp-for="Code" class="form-control bg-warning-subtle" required />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>

                        <div class="form-group col-lg-4">
                            <label class="form-label" for="FullName">نام کامل
                            <span class="form-label-caption">(اجباری)</span>
                            </label>
                            <input type="text" asp-for="FullName" class="form-control bg-warning-subtle" required />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>


                        <div class="form-group col-lg-12">
                            <div class="row mx-0  form-group col-lg-12" >
                                <div class="d-flex col-lg-3">
                                    <div class="form-group" style="margin-left: 20px;">
                                        <label class="custom-checkbox">
                                            <input type="checkbox" asp-for="IsActive" value="true" checked />
                                            <span class="checkmark"></span>
                                            <span class="label-text">فعال</span>
                                        </label>
                                    </div>

                                    <div class="form-group col-lg-3" style="margin-left: 15px;">
                                        <label class="custom-checkbox">
                                            <input type="checkbox" asp-for="ShowForVac" />
                                            <span class="checkmark"></span>
                                            <span class="label-text">VAC</span>
                                        </label>
                                    </div>

                                    <div class="form-group col-lg-3">
                                        <label class="custom-checkbox">
                                            <input type="checkbox" asp-for="ShowForOther" />
                                            <span class="checkmark"></span>
                                            <span class="label-text">سایر</span>
                                        </label>
                                    </div>
                                </div>
                                
                            </div>

                            <div class="form-group row d-flex col-lg-12">
                                <label class="form-label" style="width:auto;">نوع کالا:</label>
                                <div class="border d-flex rounded p-3 bg-white" style="gap:8px;padding:2px 8px;max-height: 200px; overflow-y: auto;">
                                    @foreach (var item in Model.ItemClass)
                                    {
                                        bool isChecked = Model.SelectedItemClassIds != null &&
                                                        Model.SelectedItemClassIds.Contains(int.Parse(item.Value));
                                        <div class="form-group mb-2 mx-2">
                                            <label class="custom-checkbox">
                                                <input type="checkbox" 
                                                    name="SelectedItemClassIds" 
                                                    value="@item.Value" 
                                                    @(isChecked ? "checked" : "") />
                                                <span class="checkmark"></span>
                                                <span class="label-text">@item.Text</span>
                                            </label>
                                        </div>
                                    }
                                </div>
                                <span asp-validation-for="SelectedItemClassIds" class="text-danger"></span>
                            </div>
                            
                        </div>




                    </div>
                         <div class="text-left">
                            <button type="submit" class="btn btn-success px-5">@formName</button>
                            <a asp-action="Index" class="btn btn-success-outlet px-5">بازگشت</a>
                        </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}