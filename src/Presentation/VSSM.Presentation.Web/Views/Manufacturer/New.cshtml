@using Microsoft.AspNetCore.Mvc.TagHelpers
@model VSSM.Presentation.Web.Models.Manufacturer.ManufacturerViewModel

@{
string formName = Model != null && Model.ManufacturerId > 0 ? "ویرایش" : "ثبت";
}

<style>
    .form-label {
        text-align: left;
        width: 130px;
        margin-left: 15px;
    }

    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        direction: rtl;
    }

    .form-control {
        flex: 1;
    }

    .form-check-group {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        direction: rtl;
    }

    .form-check-input {
        margin-left: 10px;
    }

    .checkbox-container {
        max-height: 250px;
        overflow-y: auto;
        border: 1px solid #ced4da;
        border-radius: .375rem;
        padding: 10px;
        background: #fff;
    }

    .card {
        direction: rtl;
    }
</style>

<div class="container-fluid">
    <div class="animated fadeIn">

        <!-- Card Title -->
        <div class="card mb-3">
            <div class="card-body">
                <h5>@formName سازنده</h5>
            </div>
        </div>

        <!-- Form Card -->
        <div class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <form asp-controller="Manufacturer" asp-action="Create" method="post">
                    <input type="hidden" asp-for="ManufacturerId" />

                    <div class="col-lg-6">

                        <!-- Code -->
                        <div class="form-group">
                            <label class="form-label" for="Code">کد:</label>
                            <input type="text" asp-for="Code" class="form-control" />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>

                        <!-- Full Name -->
                        <div class="form-group">
                            <label class="form-label" for="FullName">نام کامل:</label>
                            <input type="text" asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <!-- Entry Date -->
                        <div class="form-group">
                            <label class="form-label" for="EntryDate">تاریخ ورود:</label>
                            <input type="date" asp-for="EntryDate" class="form-control" />
                            <span asp-validation-for="EntryDate" class="text-danger"></span>
                        </div>

                        <hr class="my-4"/>

                        <!-- Boolean Fields -->
                        <div class="form-check-group">
                            <label class="form-label" for="ShowForVac">نمایش برای VAC:</label>
                            <input type="checkbox" asp-for="ShowForVac" class="form-check-input" />
                        </div>

                        <div class="form-check-group">
                            <label class="form-label" for="ShowForOther">نمایش برای سایر:</label>
                            <input type="checkbox" asp-for="ShowForOther" class="form-check-input" />
                        </div>

                        <div class="form-check-group">
                            <label class="form-label" for="IsActive">فعال:</label>
                            <input type="checkbox" asp-for="IsActive" class="form-check-input" />
                        </div>

                        <hr class="my-4"/>

                        <!-- ItemClasses Multi-Select with Checkboxes -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">کلاس‌های قلم:</label>
                            <div class="checkbox-container">
                                @foreach (var item in Model.ItemClasses)
                                {
                                bool isChecked = Model.SelectedItemClassIds != null && Model.SelectedItemClassIds.Contains(int.Parse(item.Value));

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="SelectedItemClassIds"
                                           value="@item.Value"
                                           id="chk_@item.Value"
                                           @(isChecked ? "checked" : "") />
                                    <label class="form-check-label" for="chk_@item.Value">
                                        @item.Text
                                    </label>
                                </div>
                                }
                            </div>
                            <small class="text-muted d-block mt-1">
                                برای انتخاب چند مورد کافیست تیک‌ها را بزنید، نیازی به نگه داشتن Ctrl نیست.
                            </small>
                            <span asp-validation-for="SelectedItemClassIds" class="text-danger"></span>
                        </div>

                        <!-- Action Buttons aligned left -->
                        <div class="mt-4 text-start">
                            <button type="submit" class="btn btn-success px-5">@formName</button>
                            <a class="btn btn-primary px-5" asp-controller="Manufacturer" asp-action="Index">لیست</a>
                        </div>

                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
