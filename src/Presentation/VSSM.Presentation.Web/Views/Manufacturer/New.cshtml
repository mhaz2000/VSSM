@using Microsoft.AspNetCore.Mvc.TagHelpers
@model VSSM.Presentation.Web.Models.Manufacturer.ManufacturerViewModel
@{
    string formName = "ثبت";
    if (Model != null && Model.ManufacturerId > 0)
        formName = "ویرایش";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-header">
                <h5 class="header-title">@formName سازنده</h5>
            </div>
            <div class="card-block">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form asp-controller="Manufacturer" asp-action="Create" method="post" class="form-horizontal">
                    <input type="hidden" asp-for="ManufacturerId" />

                    <div class="row equal-height mb-4 mx-0">
                        <div class="form-group col-lg-4">
                            <label class="form-label" for="Code">کد</label>
                            <input type="text" asp-for="Code" class="form-control bg-warning-subtle" required />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>

                        <div class="form-group col-lg-4">
                            <label class="form-label" for="FullName">نام کامل</label>
                            <input type="text" asp-for="FullName" class="form-control bg-warning-subtle" required />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="form-group col-lg-1"></div>
                        <div class="form-group col-lg-2">
                            <label class="form-label">وضعیت</label>
                            <div class="d-flex">
                                <div class="form-check">
                                    <input type="radio"
                                           asp-for="IsActive"
                                           value="true"
                                           class="form-check-input"
                                           id="isActiveTrue" />
                                    <label class="form-check-label" for="isActiveTrue">
                                        فعال
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input type="radio"
                                           asp-for="IsActive"
                                           value="false"
                                           class="form-check-input"
                                           id="isActiveFalse" />
                                    <label class="form-check-label" for="isActiveFalse">
                                        غیرفعال
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="form-group col-lg-2">
                            <label class="form-label">نوع کالا</label>
                            <div class="border rounded p-3 bg-white d-flex">
                                @foreach (var item in Model.ItemClass)
                                {
                                    bool isChecked = Model.SelectedItemClassIds != null &&
                                                    Model.SelectedItemClassIds.Contains(int.Parse(item.Value));
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedItemClassIds"
                                               value="@item.Value"
                                               id="itemClass_@item.Value"
                                               @(isChecked ? "checked" : "") />
                                        <label class="form-check-label" for="itemClass_@item.Value">
                                            @item.Text
                                        </label>
                                    </div>
                                }
                            </div>
                            <span asp-validation-for="SelectedItemClassIds" class="text-danger"></span>
                        </div>
                        <div class="form-group col-lg-3">
                            <label class="form-label" >نمایش برای</label>
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           asp-for="ShowForVac" />
                                    <label class="form-check-label">VAC</label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           asp-for="ShowForOther" />
                                    <label class="form-check-label">سایر</label>
                                </div>
                            </div>
                        </div>



                    </div>
                         <div class="text-left">
                            <button type="submit" class="btn btn-success px-5">@formName</button>
                            <a asp-action="Index" class="btn btn-success-outlet px-5">بازگشت</a>
                        </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}