@using VSSM.Presentation.Web.Models.MinMaxItem
@model MinMaxItemViewModel

@{
    string formName = Model?.MinMaxItemId > 0
        ? "ویرایش حداقل/حداکثر"
        : "ثبت حداقل/حداکثر";

    ViewData["Title"] = formName;
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card form-card">

            <!-- Header -->
            <div class="card-header card-form-header">
                <h5 class="header-title">@ViewData["Title"]</h5>
            </div>

            <!-- Body -->
            <div class="card-block">

                <form asp-action="Create" method="post" class="form-horizontal">

                    <input type="hidden" asp-for="MinMaxItemId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row equal-height mb-4 mx-0">

                        <!-- Item -->
                        <div class="form-group col-lg-6">
                            <label class="form-label">کالا</label>
                            <select asp-for="ItemId"
                                    asp-items="ViewBag.ItemList"
                                    class="form-control bg-warning-subtle">
                                <option value="">انتخاب کنید...</option>
                            </select>
                            <span asp-validation-for="ItemId" class="text-danger"></span>
                        </div>

                        <!-- Recipient -->
                        <div class="form-group col-lg-6">
                            <label class="form-label">محل خدمت (گیرنده)</label>
                            <select asp-for="RecipientId"
                                    asp-items="ViewBag.RecipientList"
                                    class="form-control bg-warning-subtle">
                                <option value="">انتخاب کنید...</option>
                            </select>
                        </div>

                    </div>

                    <hr />

                    <h6 class="mb-3 text-center">
                        نوع محاسبه برای تعیین حداکثر را انتخاب کنید
                    </h6>

                    <!-- OPTION BLOCKS (LOGIC UNCHANGED) -->
                    <div class="row">

                        <div class="col-lg-4 mb-3">
                            <div class="card p-3 h-100 option-block form-card">
                                <div class="form-check mb-2">
                                    <input type="radio"
                                           class="form-check-input"
                                           name="OrderLevel"
                                           value="1"
                                           @(Model.OrderLevel == 1 ? "checked" : "") />
                                    <label class="form-check-label">
                                        گزینه ۱
                                    </label>
                                </div>

                                <input asp-for="AnnualNeeds" class="form-control mb-2" placeholder="نیاز سالیانه" />
                                <input asp-for="NumberShipment" class="form-control mb-2" placeholder="تعداد ورودی در سال" />
                                <input asp-for="LeadConsumption" class="form-control" placeholder="زمان بین درخواست و ورود" />
                            </div>
                        </div>

                        <div class="col-lg-4 mb-3">
                            <div class="card p-3 h-100 option-block form-card">
                                <div class="form-check mb-2">
                                    <input type="radio"
                                           class="form-check-input"
                                           name="OrderLevel"
                                           value="2"
                                           @(Model.OrderLevel == 2 ? "checked" : "") />
                                    <label class="form-check-label">
                                        گزینه ۲
                                    </label>
                                </div>

                                <input asp-for="TotalPop" class="form-control mb-2" placeholder="جمعیت کل" />
                                <input asp-for="PercentUnder" class="form-control mb-2" placeholder="درصد زیر یکسال" />
                                <input asp-for="NumDose" class="form-control mb-2" placeholder="تعداد دوز" />
                                <input asp-for="Wastage" class="form-control mb-2" placeholder="فاکتور پرت" />
                                <input asp-for="PercentCoverage" class="form-control mb-2" placeholder="درصد پوشش" />
                                <input asp-for="NumberShipment" class="form-control mb-2" placeholder="تعداد ورودی در سال" />
                                <input asp-for="PercentSafety" class="form-control mb-2" placeholder="سلامت موجودی (%)" />
                                <input asp-for="LeadConsumption" class="form-control" placeholder="زمان بین درخواست و ورود" />
                            </div>
                        </div>

                        <div class="col-lg-4 mb-3">
                            <div class="card p-3 h-100 option-block form-card">
                                <div class="form-check mb-2">
                                    <input type="radio"
                                           class="form-check-input"
                                           name="OrderLevel"
                                           value="3"
                                           @(Model.OrderLevel == 3 ? "checked" : "") />
                                    <label class="form-check-label">
                                        گزینه ۳
                                    </label>
                                </div>

                                <input asp-for="Min" class="form-control mb-2" placeholder="موجودی حداقل" />
                                <input asp-for="Max" class="form-control" placeholder="موجودی حداکثر" />
                            </div>
                        </div>

                    </div>

                    <hr />

                    <!-- Result Box -->
                    <div class="row justify-content-center mt-3">
                        <div class="col-lg-10">
                            <div class="card p-3 bg-light form-card">
                                <div class="row align-items-end">

                                    <div class="form-group col-lg-3">
                                        <label class="form-label">حداقل موجودی</label>
                                        <input asp-for="StockMin"
                                            class="form-control"
                                            placeholder="حداقل موجودی" />
                                    </div>

                                    <div class="form-group col-lg-3">
                                        <label class="form-label">حداکثر موجودی</label>
                                        <input asp-for="StockMax"
                                            class="form-control"
                                            placeholder="حداکثر موجودی" />
                                    </div>

                                    <div class="form-group col-lg-3">
                                        <label class="form-label">سطح درخواست</label>
                                        <input asp-for="OrderLevel"
                                            class="form-control"
                                            placeholder="سطح درخواست" />
                                    </div>

                                    <div class="form-group col-lg-3" style="padding-top:2.5rem;">
                                        <button type="button"
                                                class="btn btn-info"
                                                onclick="showCalcPopup()">
                                            محاسبه
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-left mt-4">
                        <button type="submit" class="btn btn-success px-5">ذخیره</button>
                        <a asp-action="Index" class="btn btn-success-outlet px-5">بازگشت</a>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}