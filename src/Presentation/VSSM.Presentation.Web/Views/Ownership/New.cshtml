@model OwnershipViewModel
@{
    string formName = "ثبت";
    if (Model != null && Model.OwnershipId > 0)
        formName = "ویرایش";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-header">
                <h5 class="header-title">@formName نوع مالکیت</h5>
            </div>
            <div class="card-block">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <form asp-action="Create" method="post" class="form-horizontal">
                    <input type="hidden" asp-for="OwnershipId" />

                    <div class="row mb-4 mx-0">
                        <div class="form-group col-lg-4">
                            <label class="form-label" for="Code">کد
                            <span class="form-label-caption">(اجباری)</span>
                            </label>
                            <input type="text" asp-for="Code" class="form-control bg-warning-subtle" required />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>

                        <div class="form-group col-lg-4">
                            <label class="form-label" for="FullName">نام کامل
                            <span class="form-label-caption">(اجباری)</span>
                            </label>
                            <input type="text" asp-for="FullName" class="form-control bg-warning-subtle" required />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="form-group col-lg-1"></div>

                        <div class="col-lg-12">
                            <div class="d-flex">
                                <div class="form-group" style="margin-left: 20px;">
                                    <label class="custom-checkbox">
                                        <input type="checkbox" asp-for="IsActive" value="true" checked />
                                        <span class="checkmark"></span>
                                        <span class="label-text">فعال</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="text-left">
                            <button type="submit" class="btn btn-success px-5">ثبت</button>
                            <a asp-action="Index" class="btn btn-success-outlet px-5">بازگشت</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}