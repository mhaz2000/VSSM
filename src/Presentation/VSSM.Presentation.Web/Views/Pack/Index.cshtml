@using VSSM.Application.DTOs.BaseEntities.Pack
@model PagingSearchOrderDto<PackGetDto>
@{
    ViewData["Title"] = "مدیریت بسته‌بندی";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-block">

                <div class="col-lg-3">
                    <h5>مدیریت بسته‌بندی</h5>
                </div>

                <div class="col-lg-4"></div>

                <form method="get">
                    <div class="col-lg-4">
                        <div class="input-group">
                            <input type="text"
                                   name="search"
                                   value="@Model.SearchText"
                                   class="form-control"
                                   placeholder="جستجو..." />
                            <div class="input-group-btn">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-search"></i> جستجو
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="col-lg-1">
                    <a class="btn btn-success"
                       asp-controller="Pack"
                       asp-action="New">
                        <i class="fa fa-plus-circle"></i> جدید
                    </a>
                </div>

            </div>
        </div>

        <div class="row mt-2">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-block">

                        <table class="table table-bordered table-striped table-condensed text-center">
                            <thead>
                                <tr>
                                    <th>
                                        <a href="?sortField=Code&sortOrder=@(Model.SortOrder == "asc" ? "desc" : "asc")">کد</a>
                                    </th>
                                    <th>
                                        <a href="?sortField=FullName&sortOrder=@(Model.SortOrder == "asc" ? "desc" : "asc")">نام</a>
                                    </th>
                                    <th>حجم خالص</th>
                                    <th>اندازه خارجی</th>
                                    <th>وزن</th>
                                    <th>وضعیت</th>
                                    <th>عملیات</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model != null && Model.Items.Any())
                                {
                                    foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>@item.Code</td>
                                            <td>@item.FullName</td>
                                            <td>@item.NetVolume</td>
                                            <td>@item.ExternalSize</td>
                                            <td>@item.PackWeight</td>
                                            <td>@(item.IsActive ? "فعال" : "غیرفعال")</td>
                                            <td>
                                                <a class="btn btn-primary btn-sm"
                                                   asp-controller="Pack"
                                                   asp-action="New"
                                                   asp-route-id="@item.PackId">
                                                    ویرایش
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-danger">داده‌ای یافت نشد</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <nav>
                            <ul class="pagination">
                                <li class="page-item @(Model.Paging.Page == 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?search=@Model.SearchText&page=@(Model.Paging.Page - 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">
                                        قبلی
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.Paging.TotalPages; i++)
                                {
                                    <li class="page-item @(Model.Paging.Page == i ? "active" : "")">
                                        <a class="page-link"
                                           href="?search=@Model.SearchText&page=@i&sortField=@Model.SortField&sortOrder=@Model.SortOrder">
                                            @i
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(Model.Paging.Page == Model.Paging.TotalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?search=@Model.SearchText&page=@(Model.Paging.Page + 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">
                                        بعدی
                                    </a>
                                </li>
                            </ul>
                        </nav>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
