@using VSSM.Application.DTOs.BaseEntities.ReceivingMode
@model UpdateReceivingModeDto

@{
    ViewData["Title"] = "ویرایش روش دریافت";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-header">
                <h5 class="header-title">ویرایش روش دریافت</h5>
            </div>

            <div class="card-block">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form asp-action="Edit" method="post" class="form-horizontal">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReceivingModeId"/>

                    <div class="row mb-4 mx-0">

                        <div class="form-group col-lg-4">
                            <label class="form-label">کد <span class="form-label-caption">(اجباری)</span></label>
                            <input asp-for="Code"
                                   class="form-control bg-warning-subtle"
                                   required />
                        </div>

                        <div class="form-group col-lg-4">
                            <label class="form-label">نام کامل <span class="form-label-caption">(اجباری)</span></label>
                            <input asp-for="FullName"
                                   class="form-control bg-warning-subtle"
                                   required />
                        </div>
                        <div class="form-group col-lg-1"></div>

                        <div class="col-lg-3" style="padding-top:3rem;">
                                <div class="d-flex">
                                    <div class="form-group" style="margin-left: 20px;">
                                        <label class="custom-checkbox">
                                            <input type="checkbox" asp-for="IsActive" value="true" checked />
                                            <span class="checkmark"></span>
                                            <span class="label-text">فعال</span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                        <div class="text-left">
                            <button type="submit" class="btn btn-success px-5">ذخیره</button>
                            <a asp-action="Index" class="btn btn-success-outlet px-5">بازگشت</a>
                        </div>

                    </div>
                </form>

            </div>
        </div>

    </div>
</div>
