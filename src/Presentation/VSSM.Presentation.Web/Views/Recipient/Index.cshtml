@using VSSM.Application.DTOs.BaseEntities.Recipient
@model PagingSearchOrderDto<RecipientGetDto>

@{
    ViewData["Title"] = "مدیریت گیرنده‌ها";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-block">
                <div class="col-lg-3">
                    <h5>مدیریت گیرنده‌ها</h5>
                </div>

                <div class="col-lg-3">
                    <button type="button" class="btn btn-light" onclick="alert('در حال تولید');">
                        گزارش های مربوط به پایانه
                    </button>
                    <button type="button" class="btn btn-light" onclick="alert('در حال تولید');">
                        اطلاعات تماسی گیرندگان
                    </button>
                </div>

                <form method="get">
                    <div class="col-lg-4">
                        <div class="input-group">
                            <input type="text" name="search" value="@Model.SearchText" class="form-control" placeholder="جستجو بر اساس کد یا نام..." />
                            <div class="input-group-btn">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-search"></i> جستجو
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="col-lg-1">
                    <a class="btn btn-success" asp-controller="Recipient" asp-action="New">
                        <i class="fa fa-plus-circle"></i> جدید
                    </a>
                </div>
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-block">
                        <table class="table table-bordered table-striped table-condensed text-center">
                            <thead>
                                <tr>
                                    <th>فعال است</th>
                                    <th>آخرین ورود به سیستم</th> @* شما بعداً می‌توانید با فیلد مناسب جایگزین کنید *@
                                    <th>طریقه حمل و نقل</th>
                                    <th>روش دریافت</th>
                                    <th>تاریخ شروع فعالیت</th>
                                    <th>نوع</th>
                                    <th>
                                        <a href="?sortField=Year&sortOrder=@(Model.SortOrder == "asc" ? "desc" : "asc")">
                                            سال
                                        </a>
                                    </th>
                                    <th>جمعیت</th>
                                    <th>سطح در زنجیره</th>
                                    <th>
                                        <a href="?sortField=FullName&sortOrder=@(Model.SortOrder == "asc" ? "desc" : "asc")">
                                            نام کامل
                                        </a>
                                    </th>
                                    <th>
                                        <a href="?sortField=Code&sortOrder=@(Model.SortOrder == "asc" ? "desc" : "asc")">
                                            کد
                                        </a>
                                    </th>
                                    <th>عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Items.Any())
                                {
                                    foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>@(item.IsActive ? "✓" : "")</td>
                                            <td>@item.TransportModeName</td>
                                            <td>@item.ReceivingModeName</td>
                                            <td>@item.StartUp?.ToShortDateString()</td>
                                            <td>@item.ParentId</td> @* بعداً می‌توانید با enum نمایش دهید *@
                                            <td>@item.Year</td>
                                            <td>@item.Population</td>
                                            <td>@item.ChainLevel</td>
                                            <td>@item.FullName</td>
                                            <td>@item.Code</td>
                                            <td>
                                                <a class="btn btn-primary btn-sm"
                                                   asp-controller="Recipient"
                                                   asp-action="New"
                                                   asp-route-id="@item.RecipientId">ویرایش</a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="12" class="text-danger text-center">
                                            داده‌ای یافت نشد
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <nav>
                            <ul class="pagination">
                                <li class="page-item @(Model.Paging.Page == 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?search=@Model.SearchText&page=@(Model.Paging.Page - 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">
                                        قبلی
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.Paging.TotalPages; i++)
                                {
                                    <li class="page-item @(Model.Paging.Page == i ? "active" : "")">
                                        <a class="page-link"
                                           href="?search=@Model.SearchText&page=@i&sortField=@Model.SortField&sortOrder=@Model.SortOrder">
                                            @i
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(Model.Paging.Page == Model.Paging.TotalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?search=@Model.SearchText&page=@(Model.Paging.Page + 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">
                                        بعدی
                                    </a>
                                </li>
                            </ul>
                        </nav>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
