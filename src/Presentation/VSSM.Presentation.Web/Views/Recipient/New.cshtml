﻿@using VSSM.Presentation.Web.Models.Base
@model VSSM.Presentation.Web.Models.Recipient.RecipientViewModel

@{
    bool isEdit = Model.RecipientId > 0;
    string formName = isEdit ? "ویرایش گیرنده" : "ثبت گیرنده جدید";
}

@section Styles {
    <link href="~/css/components/shared/a-card.css" rel="stylesheet" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" />
    <link href="~/css/components/recipient/recipient-form.css" rel="stylesheet" />
}

<div class="recipient-form-wrap">
    <strong class="recipient-form-title">@formName</strong>

    <form asp-action="Create" method="post" id="recipientForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="RecipientId" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-user" style="color:#1d6fb8;"></i>
                <h6>اطلاعات اصلی</h6>
            </div>
            <div class="a-card-body">
                <div class="fg-3" style="margin-bottom:14px;">
                    <div class="f-group">
                        <label class="f-label">کد <span class="req-tag">اجباری</span></label>
                        <input asp-for="Code" class="f-control" placeholder="کد را وارد کنید" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">نام کامل <span class="req-tag">اجباری</span></label>
                        <input asp-for="FullName" class="f-control" placeholder="نام کامل را وارد کنید" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">جمعیت</label>
                        <input asp-for="Population" class="f-control" type="number" min="0" placeholder="فقط عدد وارد نمایید" />
                    </div>
                </div>
                <div class="fg-3" style="margin-bottom:14px;">
                    <div class="f-group">
                        <label class="f-label">سال</label>
                        <input asp-for="Year" class="f-control" type="number" min="1300" max="1500" placeholder="فقط عدد وارد نمایید" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">فاصله</label>
                        <input asp-for="Distance" class="f-control" type="number" min="0" placeholder="فقط عدد وارد نمایید" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">آدرس ۱</label>
                        <input asp-for="Address1" class="f-control" placeholder="آدرس را وارد کنید" />
                    </div>
                </div>
                <div class="fg-3" style="margin-bottom:14px;">
                    <div class="f-group">
                        <label class="f-label">آدرس ۲</label>
                        <input asp-for="Address2" class="f-control" placeholder="آدرس دوم را وارد کنید" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">فاصله زمانی (دقیقه)</label>
                        <input asp-for="DistanceTime" class="f-control" type="number" min="0" placeholder="فقط عدد وارد نمایید" />
                    </div>
                </div>
            </div>
        </div>

        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-phone" style="color:#16a34a;"></i>
                <h6>اطلاعات تماس و موقعیت</h6>
            </div>
            <div class="a-card-body">
                <div class="fg-3" style="margin-bottom:14px;">
                    <div class="f-group">
                        <label class="f-label">کد پستی</label>
                        <input asp-for="PostalCode" class="f-control" placeholder="کد پستی را وارد کنید" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">استان</label>
                        <input asp-for="Province" class="f-control" placeholder="استان را وارد کنید" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">شهر</label>
                        <input asp-for="City" class="f-control" placeholder="شهر را وارد کنید" />
                    </div>
                </div>
                <div class="fg-3" style="margin-bottom:14px;">
                    <div class="f-group">
                        <label class="f-label">تلفن</label>
                        <input asp-for="Phone" class="f-control" placeholder="تلفن را وارد کنید" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">پست الکترونیکی</label>
                        <input asp-for="Email" class="f-control" type="email" placeholder="ایمیل را وارد کنید" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">زمان بین درخواست و ورود محموله</label>
                        <input asp-for="LeadTime" class="f-control" type="number" min="0" placeholder="فقط عدد وارد نمایید" />
                    </div>
                </div>
            </div>
        </div>

        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-cog" style="color:#8b5cf6;"></i>
                <h6>تنظیمات عملیاتی <span class="req-tag">همه اجباری</span></h6>
            </div>
            <div class="a-card-body">
                <div class="fg-3" style="margin-bottom:14px;">
                    <div class="f-group">
                        <label class="f-label">طریقه حمل و نقل <span class="req-tag">اجباری</span></label>
                        <select asp-for="TransportModeId" asp-items="ViewBag.TransportList" class="f-control">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label">سطح در زنجیره <span class="req-tag">اجباری</span></label>
                        <select asp-for="ChainLevel" asp-items="ViewBag.LevelList" class="f-control">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label">روش دریافت <span class="req-tag">اجباری</span></label>
                        <select asp-for="ReceivingModeId" asp-items="ViewBag.ReceivingList" class="f-control">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                </div>
                <div class="fg-3" style="margin-bottom:14px;">
                    <div class="f-group">
                        <label class="f-label">والد</label>
                        <select asp-for="ParentType" asp-items="ViewBag.ParentTypeList" class="f-control">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label">شرایط اقلیمی <span class="req-tag">اجباری</span></label>
                        <select asp-for="ClimateId" asp-items="ViewBag.ClimateList" class="f-control">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label">نوع مالکیت <span class="req-tag">اجباری</span></label>
                        <select asp-for="OwnershipId" asp-items="ViewBag.OwnershipList" class="f-control">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                </div>
                <div class="fg-3" style="margin-bottom:14px;">
                    <div class="f-group">
                        <label class="f-label">منبع انرژی <span class="req-tag">اجباری</span></label>
                        <select asp-for="PowerSourceId" asp-items="ViewBag.PowerSourceList" class="f-control">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label">نوع راه <span class="req-tag">اجباری</span></label>
                        <select asp-for="TypeOfRoadId" asp-items="ViewBag.RoadTypeList" class="f-control">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-check-square" style="color:#f59e0b;"></i>
                <h6>سایر تنظیمات</h6>
            </div>
            <div class="a-card-body">
                <div class="fg-3" style="margin-bottom:14px;">
                    <div class="f-group">
                        <label class="f-label">تلفن ثابت</label>
                        <div class="checkbox-group">
                            <label class="checkbox-label">
                                <input type="checkbox" asp-for="HasLandLine" />
                                فعال
                            </label>
                        </div>
                    </div>
                    <div class="f-group">
                        <label class="f-label">اینترنت</label>
                        <div class="checkbox-group">
                            <label class="checkbox-label">
                                <input type="checkbox" asp-for="HasInternet" />
                                فعال
                            </label>
                        </div>
                    </div>
                </div>
                <div class="f-group" style="margin-bottom:14px;">
                    <label class="f-label">ملاحظات</label>
                    <textarea asp-for="Note" class="f-control" placeholder="ملاحظات را وارد کنید"></textarea>
                </div>
                <div class="alert alert-info recipient-help-text">
                    وقتی شما دکمه ثبت را فشار دهید، گیرنده تعریف می‌گردد و شما می‌توانید هر کالایی را به آن گیرنده ارسال دارید. وقتی این گیرنده هنوز فرد سیستم نشده و نمی‌تواند با سیستم کار کند تا شما دکمه "شروع فعالیت" را فعال نکرده باشید. برای فعال کردن شروع فعالیت به اطلاعات پایه ➜ گیرندگان رفته و گزینه مدیریت را انتخاب کرده و در جعبه مقابل "شروع فعالیت" علامت بگذارید. پس از این گیرنده به سیستم‌آمده می‌گردد. این عمل وقتی باید انجام شود که گزارش این گیرنده آموزش لازم را دیده و آمادگی شروع فعالیت را داشته باشند. برای اطلاعات بیشتر به قسمت کمک مربوط به گیرندگان مراجعه نمایید. تعریف اقلا یک کاربر را برای این گیرنده فراموش نکنید!
                </div>
            </div>
        </div>

        <div class="form-footer">
            <a asp-action="Index" class="btn-back">
                <i class="fa fa-arrow-right"></i> بازگشت
            </a>
            <button type="submit" class="btn-confirm">
                <i class="fa fa-save"></i> @(isEdit ? "ذخیره" : "ثبت")
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('input[type="number"]').on('keypress', function (e) {
                var charCode = e.which ? e.which : e.keyCode;
                if (charCode < 48 || charCode > 57) {
                    e.preventDefault();
                    return false;
                }
                return true;
            });

            $('input[type="number"]').on('paste', function (e) {
                var pastedText = (e.originalEvent || e).clipboardData.getData('text');
                if (!/^\d+$/.test(pastedText)) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}