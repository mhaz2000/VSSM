@model VSSM.Presentation.Web.Models.Recipient.RecipientViewModel

@{
    string formName = Model.RecipientId > 0 ? "ویرایش گیرنده" : "ثبت گیرنده جدید";
}

<style>
    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
        direction: rtl;
    }

    .form-label {
        width: 140px;
        margin-left: 10px;
        font-weight: 600;
    }

    .form-control, .form-select {
        flex: 1;
    }

    .checkbox-wrapper {
        display: flex;
        align-items: center;
        flex-direction: row-reverse; /* چک‌باکس سمت راست */
        justify-content: flex-end; /* چسباندن به سمت راست */
        gap: 5px; /* فاصله کمتر */
        width: 100%;
    }

    .help-text {
        color: #0055cc;
        margin-top: 20px;
        font-size: 13px;
        line-height: 1.9;

        padding: 12px;
        border-radius: 8px;
    }

</style>

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card mb-3">
            <div class="card-block p-3">
                <h5 class="m-0">@formName</h5>
            </div>
        </div>

        <div class="card">
            <div class="card-block p-4">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="RecipientId" />

                    <div class="col-lg-6">

                        <!-- TEXT INPUTS -->
                        @foreach (var item in new[] {
                                                new { Label = "کد:", Field = "", Type = "text" },
                                                new { Label = "نام کامل:", Field = "", Type = "text" },
                                                new { Label = "سطح در زنجیره:", Field = "", Type = "number" },
                                                new { Label = "جمعیت:", Field = "", Type = "number" },
                                                new { Label = "سال:", Field = "", Type = "number" },
                                                new { Label = "آدرس 1:", Field = "", Type = "text" },
                                                new { Label = "آدرس 2:", Field = "", Type = "text" },
                                                new { Label = "کد پستی:", Field = "", Type = "text" },
                                                new { Label = "شهر:", Field = "", Type = "text" },
                                                new { Label = "استان:", Field = "", Type = "text" },
                                                new { Label = "تلفن:", Field = "", Type = "text" },
                                                new { Label = "پست الکترونیکی:", Field = "", Type = "text" },
                                                new { Label = "زمان بین درخواست و ورود محموله:", Field = "", Type = "number" },
                                                new { Label = "فاصله زمانی (دقیقه):", Field = "", Type = "number" }
                                                })
                        {
                            <div class="form-group">
                                <span class="form-label">@item.Label</span>
                                <input asp-for="@item.Field" type="@item.Type" class="form-control" />
                            </div>
                        }

                        <!-- SELECT BOXES -->
                        <div class="form-group">
                            <span class="form-label">طریقه حمل و نقل:</span>
                            <select asp-for="TransportModeId" asp-items="ViewBag.TransportList" class="form-select"></select>
                        </div>

                        <div class="form-group">
                            <span class="form-label">روش دریافت:</span>
                            <select asp-for="ReceivingModeId" asp-items="ViewBag.ReceivingList" class="form-select"></select>
                        </div>

                        <div class="form-group">
                            <span class="form-label">نوع:</span>
                            <select asp-for="ParentType" asp-items="ViewBag.ParentTypeList" class="form-select"></select>
                        </div>

                        <div class="form-group">
                            <span class="form-label">شرایط اقلیمی:</span>
                            <select asp-for="ClimateId" asp-items="ViewBag.ClimateList" class="form-select"></select>
                        </div>

                        <div class="form-group">
                            <span class="form-label">نوع مالکیت:</span>
                            <select asp-for="OwnershipId" asp-items="ViewBag.OwnershipList" class="form-select"></select>
                        </div>

                        <div class="form-group">
                            <span class="form-label">منبع انرژی:</span>
                            <select asp-for="PowerSourceId" asp-items="ViewBag.PowerSourceList" class="form-select"></select>
                        </div>

                        <div class="form-group">
                            <span class="form-label">نوع راه:</span>
                            <select asp-for="TypeOfRoadId" asp-items="ViewBag.RoadTypeList" class="form-select"></select>
                        </div>

                        <!-- DATE -->
                        <div class="form-group">
                            <span class="form-label">تاریخ ثبت (روز/ماه/سال):</span>
                            <input asp-for="StartUp" class="form-control" placeholder="مثال: 03/01/24" />
                            <span asp-validation-for="StartUp" class="text-danger"></span>
                        </div>

                        <!-- CHECKBOXES -->
                        <div class="form-group">
                            <span class="form-label">تلفن ثابت:</span>
                            <div class="checkbox-wrapper">
                                <input class="form-check-input" type="checkbox" asp-for="HasLandLine" />
                            </div>
                        </div>

                        <div class="form-group">
                            <span class="form-label">ارتباط اینترنتی:</span>
                            <div class="checkbox-wrapper">
                                <input class="form-check-input" type="checkbox" asp-for="HasInternet" />
                            </div>
                        </div>

                        <div class="form-group">
                            <span class="form-label">وضعیت (فعال/غیرفعال):</span>
                            <div class="checkbox-wrapper">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                            </div>
                        </div>

                        <!-- NOTE -->
                        <div class="form-group">
                            <span class="form-label">ملاحظات:</span>
                            <textarea asp-for="Note" class="form-control"></textarea>
                        </div>

                        <!-- HELP TEXT -->
                        <div class="help-text">
                            وقتی دکمه «ثبت» را فشار دهید، گیرنده تعریف می‌شود ولی هنوز وارد سیستم فعال نشده است.
                            برای فعال‌سازی باید از مسیر «اطلاعات پایه → مدیریت → اعضا» وضعیت «شروع فعالیت» را فعال کنید.
                            این کار تنها زمانی انجام شود که کاربران آموزش دیده باشند.
                            برای اطلاعات بیشتر، بخش «کمک» را مطالعه کنید و فراموش نکنید برای این گیرنده یک کاربر تعریف نمایید.
                        </div>

                        <!-- BUTTONS -->
                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-success px-5">ثبت</button>
                            <a asp-action="Index" class="btn btn-primary px-5">لیست</a>
                        </div>

                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
