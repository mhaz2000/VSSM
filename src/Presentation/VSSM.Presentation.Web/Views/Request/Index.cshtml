@using VSSM.Application.DTOs.RequestEntities
@model PagingSearchOrderDto<RequestListDto>;
@{
    ViewData["Title"] = "مدیریت درخواست ها";
    int current = Model.Paging.Page;
    int total = Model.Paging.TotalPages;

    int start = Math.Max(1, current - 5);
    int end = Math.Min(total, current + 5);
}

<div class="container-fluid">
    <div class="animated fadeIn">


        <div class="card">
            <div class="card-block">
                <div class="col-lg-3">
                    <div><h5> مدیریت درخواست ها</h5></div>
                </div>

                <div class="col-lg-3">
                </div>
                <form method="get">
                    <div class="col-lg-4">
                        <div class="input-group">
                            <input type="text" name="search" value="@Model.SearchText" class="form-control" placeholder="جستجو...">
                            <div class="input-group-btn">
                                <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> جستجو</button>
                            </div>
                        </div>
                    </div>
                </form>
                <div class="col-lg-1">
                    <a type="submit" class="btn btn btn-success" asp-controller="Request" asp-action="New"><i class="fa fa-plus-circle"></i> ثبت درخواست</a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">

                    <div class="card-block">
                        <table class="table table-bordered table-striped table-condensed text-center">
                            <thead>
                                <tr>
                                    @* <th>ردیف</th> *@
                                    <th>شماره درخواست</th>
                                    <th>تاریخ</th>
                                    <th>وضعیت</th>
                                    <th>Entred By</th>
                                    <th>تاریخ تایید</th>
                                    <th>عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Items.Any())
                                {
                                    int i = 1;
                                    foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            @* <td>@i</td> *@
                                            <td>@item.RequestStatus</td>
                                            <td>@item.SendDate.Value.ToString("yyyy/MM/dd")</td>
                                            <td>@item.RequestStatus</td>
                                            <td>@item.EnteredBy</td>
                                            <td>@item.ConfirmDate.Value.ToString("yyyy/MM/dd")</td>
                                            <td>
                                                @if (item.RequestStatus == 0){
                                                    <a class="btn btn-danger btn-sm" asp-controller="ItemClass" asp-action="Edit" asp-route-id="@item.Id">حذف</a>
                                                }
                                            </td>
                                        </tr>
                                        i++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-danger">داده‌ای یافت نشد</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <nav>
                            <ul class="pagination">

                                <!-- Previous -->
                                <li class="page-item @(current == 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?search=@Model.SearchText&page=@(current - 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">
                                        قبلی
                                    </a>
                                </li>

                                <!-- First Page -->
                                @if (start > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="?search=@Model.SearchText&page=1&sortField=@Model.SortField&sortOrder=@Model.SortOrder">1</a>
                                    </li>

                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }

                                <!-- Middle Pages -->
                                @for (int i = start; i <= end; i++)
                                {
                                    <li class="page-item @(current == i ? "active" : "")">
                                        <a class="page-link"
                                           href="?search=@Model.SearchText&page=@i&sortField=@Model.SortField&sortOrder=@Model.SortOrder">@i</a>
                                    </li>
                                }

                                <!-- Last Page -->
                                @if (end < total)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>

                                    <li class="page-item">
                                        <a class="page-link"
                                           href="?search=@Model.SearchText&page=@total&sortField=@Model.SortField&sortOrder=@Model.SortOrder">@total</a>
                                    </li>
                                }

                                <!-- Next -->
                                <li class="page-item @(current == total ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?search=@Model.SearchText&page=@(current + 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">
                                        بعدی
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
            <!--/col-->
        </div>
        <!--/row-->
    </div>
</div>



@section Scripts {
    <script>


    </script>
}