@using VSSM.Presentation.Web.Models.Request
@model RequestViewModel
@{
    string formName = "ثبت";
    if (Model != null && Model.Id > 0)
        formName = "ویرایش";
}


<div class="container-fluid">
    <div class="animated fadeIn">


        <div class="card">
            <div class="card-block">
                <div class="col-lg-3">
                    <div>
                        <h5>@formName  درخواست</h5>
                    </div>
                </div>
            </div>
        </div>

        <div>

            <div class="card">
                <div class="card-block">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <form asp-action="Create" method="post" class="form-horizontal">
                        <input type="hidden" asp-for="Id" />
                        <div class="col-lg-12">

                            
                                <!-- نوع کالا -->
                                <div class="form-group col-md-6">
                                    <span class="form-label">نوع کالا:</span>
                                    <select id="ItemClassId"
                                            asp-items="ViewBag.itemClassList"
                                            class="form-select">
                                        <option value="">انتخاب کنید...</option>
                                    </select>
                                </div>

                                <!-- کالا -->
                            <div class="form-group col-md-6">
                                    <span class="form-label">کالا:</span>
                                    <select id="ItemId"
                                            class="form-select"
                                            disabled>
                                        <option value="">ابتدا نوع کالا را انتخاب کنید</option>
                                    </select>
                                </div>
                            
                            <div class="form-group col-md-6">
                                <span class="form-label">
                                    مقدار مجاز : 
                                </span>
                                <input type="text" class="form-control" asp-for="NewLine.Anncount" disabled />
                            </div>
                            <div class="form-group col-md-6">
                                <span class="form-label">
                                    تعداد موجودی انبار :
                                </span>
                                <input type="text" class="form-control" asp-for="NewLine.Currentcount" disabled />
                            </div>

                            <div class="form-group col-md-6">
                                <span class="form-label">
                                    مقدار ورودی :
                                </span>
                                <input type="text" class="form-control" asp-for="NewLine.Arivcount" disabled />
                            </div>
                            <div class="form-group col-md-6">
                                <span class="form-label">
                                    تعداد مصرف شده :
                                </span>
                                <input type="text" class="form-control" asp-for="NewLine.Usedcount" disabled />
                            </div>

                            <div class="form-group col-md-6">
                                <span class="form-label">
                                    سلامت موجودی (ماه) :
                                </span>
                                <input type="text" class="form-control" asp-for="NewLine.InventoryHealth" disabled />
                            </div>
                            <div class="form-group col-md-6">
                                <span class="form-label">
                                    زمان بین درخواست و ورود محموله (روز) :
                                </span>
                                <input type="text" class="form-control" asp-for="NewLine.TimeBetweenRequestAndArrival" disabled />
                            </div>

                            <div class="form-group col-md-6">
                                <span class="form-label">
                                    جهت دوره :
                                </span>
                                <select asp-items="ViewBag.ForPeriodList" asp-for="NewLine.Forperiod" class="form-select">
                                    </select>
                            </div>
                            

                            <div class="form-group col-md-6">
                                <span class="form-label">
                                    تعداد پیشنهادی :
                                </span>
                                <input type="text" class="form-control" asp-for="NewLine.Offercount" disabled />
                            </div>
                            <div class="form-group col-md-6">
                                <span class="form-label">
                                    تعداد درخواستی :
                                </span>
                                <input type="text" class="form-control" asp-for="NewLine.Reqcount" />
                            </div>


                            <div class="col-lg-12"></div>
                            <div class="col-lg-6"></div>
                            <div class="col-lg-4">
                                <div class="text-center mt-4 align-middle">
                                    <div class="text-center mt-3 allign-text">
                                        <button type="submit"
                                                name="command"
                                                value="addLine"
                                                class="btn btn-light px-4 pale-green-btn">
                                            افزودن 
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-lg-12 allign-text">
                            <table class="table table-bordered table-striped table-condensed lines-table">
                                <thead>
                                    <tr>
                                        <th>کالا</th>
                                        <th> مقدار مجاز</th>
                                        <th> تعداد ورودی</th>
                                        <th>تعداد مصرف شده</th>
                                        <th>تعداد موجودی انبار</th>
                                        <th>جهت دوره</th>
                                        <th>تعداد پیشنهادی</th>
                                        <th>تعداد درخواستی</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.RequestLines != null && Model.RequestLines.Any())
                                    {
                                        for (int i = 0; i < Model.RequestLines.Count; i++)
                                        {
                                            var line = Model.RequestLines[i];
                                            <tr>
                                                <td>@line.ItemId</td> @* یا نام کالا اگر در DTO آورده‌ای *@
                                                <td>@line.Anncount</td>
                                                <td>@line.Arivcount</td>
                                                <td>@line.Usedcount</td>
                                                <td>@line.Currentcount</td>
                                                <td>@line.Forperiod</td>
                                                <td>@line.Offercount</td>
                                                <td>@line.Reqcount</td>
                                                <td>
                                                    <button type="submit"
                                                            name="command"
                                                            value="deleteLine_@line.Id"
                                                            class="btn btn-danger btn-sm">
                                                        حذف
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center text-muted">
                                                آیتمی ثبت نشده است.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </form>

                </div>
            </div>
        </div>
        <!--/col-->
    </div>
    <!--/row-->
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/persian-date.js"></script>
    <script src="~/js/persian-datepicker.js"></script>
    <script>
            $(function () {

            const $itemClass = $("#ItemClassId");
            const $item = $("#ItemId");

            // تغییر نوع کالا
            $itemClass.on("change", function () {

                const classId = $(this).val();

                // reset
                $item.prop("disabled", true);
                $item.empty();

                if (!classId) {
                    $item.append('<option value="">ابتدا نوع کالا را انتخاب کنید</option>');
                    return;
                }

                // load filtered items
                $.getJSON("/Arrival/GetItemsByClass", { classId: classId })
                    .done(function (data) {

                        $item.append('<option value="">انتخاب کنید...</option>');

                        data.forEach(x => {
                            $item.append(
                                `<option value="${x.id}">${x.text}</option>`
                            );
                        });

                        $item.prop("disabled", false);
                    });
            });

            // تغییر نوع کالا
            $item.on("change", function () {

                const itemId = $(this).val();

                $.getJSON("/Request/GetItemDetailsByItem", { itemId: itemId })
                    .done(function (data) {

                    });
            });

        });

       

    </script>


}