@using VSSM.Presentation.Web.Models.Request
@model RequestViewModel
@{
    string formName = "ثبت";
    if (Model != null && Model.Id > 0)
        formName = "ویرایش";
}


<div class="container-fluid">
    <div class="animated fadeIn">


        <div class="card">
            <div class="card-block">
                <div class="col-lg-3">
                    <div>
                        <h5>@formName  اختصاص دوز به کالا</h5>
                    </div>
                </div>
            </div>
        </div>

        <div>

            <div class="card">
                <div class="card-block">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <form asp-action="Create" method="post" class="form-horizontal">
                        <input type="hidden" asp-for="Id" />
                        <div class="col-lg-6">

                            <div class="form-group col-md-10">
                                <label class="form-label">نوع کالا</label>
                                <select class="form-control" id="ddlItemClass">
                                    <option value="">-- انتخاب کنید --</option>

                                    @foreach (var itemType in ViewBag.ItemClass)
                                    {
                                        <option value="@itemType.Id">@itemType.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-lg-6"></div>
                            <div class="col-lg-4">
                                <div class="text-center mt-4 align-middle">
                                    <button type="submit" class="btn btn-success px-5">ثبت</button>
                                    <a type="button" class="btn btn-primary px-5" asp-action="Index">لیست</a>
                                </div>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
        <!--/col-->
    </div>
    <!--/row-->
</div>

@section Scripts {
    <script>
        $("#ddlItemClass").on("change", function () {

                let typeId = $(this).val();
                if (!typeId) {
                    $("#ItemId").empty();
                    return;
                }

                $.ajax({
                    url: "/Item/GetItemsByItemClass",
                    type: "GET",
                    data: { typeId: typeId },
                    success: function (data) {


                    }
                });
            });

    </script>
}