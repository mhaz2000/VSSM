@using VSSM.Presentation.Web.Models.Request
@model RequestViewModel

@section Styles {
    <link href="~/css/components/shared/a-card.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/components/shared/lines-table.css" rel="stylesheet" asp-append-version="true" />
}

<div style="margin:1.5rem; direction:rtl;">

    @* ═══ کارت اقلام درخواست ═══ *@
    <div class="a-card">
        <div class="a-card-header">
            <i class="fa fa-list" style="color:#1d6fb8;"></i>
            <h6>جزئیات درخواست</h6>
        </div>
        <div class="a-card-body">
            <div class="lines-table-wrap">
                <table class="lines-table">
                    <thead>
                        <tr>
                            <th>کالا</th>
                            <th>مقدار مجاز</th>
                            <th>تعداد ورودی</th>
                            <th>تعداد مصرف شده</th>
                            <th>موجودی انبار</th>
                            <th>جهت دوره</th>
                            <th>تعداد پیشنهادی</th>
                            <th>تعداد درخواستی</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RequestLines != null && Model.RequestLines.Any())
                        {
                            foreach (var line in Model.RequestLines)
                            {
                                <tr>
                                    <td>@line.ItemName</td>
                                    <td>@line.Anncount</td>
                                    <td>@line.Arivcount</td>
                                    <td>@line.Usedcount</td>
                                    <td>@line.Currentcount</td>
                                    <td>@line.Forperiod</td>
                                    <td>@line.Offercount</td>
                                    <td>@line.Reqcount</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" style="text-align:center; color:#9ca3af; padding:32px 0; font-size:13px;">
                                    <i class="fa fa-inbox" style="display:block; font-size:26px; margin-bottom:8px; color:#d1d5db;"></i>
                                    آیتمی ثبت نشده است
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ═══ کارت ملاحظات ═══ *@
    @if (!string.IsNullOrEmpty(Model.Note))
    {
        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-sticky-note-o" style="color:#374151;"></i>
                <h6>ملاحظات</h6>
            </div>
            <div class="a-card-body">
                <div class="f-group">
                    <input type="text" class="f-control" value="@Model.Note" readonly />
                </div>
            </div>
        </div>
    }

    @* ═══ فوتر دکمه‌ها ═══ *@
    <div class="form-footer">
        <a class="btn-back" asp-action="ReceivedRequests">
            <i class="fa fa-arrow-right"></i>
            بازگشت به لیست
        </a>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
