@model RoadTypeManagementViewModel

<style>
    .panel {
        border: 1px solid #aac6ff;
        margin-bottom: 25px;
    }

    .panel-header {
        background-color: #dce6ff;
        height: 35px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        direction: rtl;
    }

        table th, table td {
            border: 1px solid #aac6ff;
            padding: 4px;
            text-align: center;
        }

    .input-yellow {
        background-color: #ffffcc;
        border: 1px solid #ccc;
        width: 200px;
        height: 25px;
    }

    .form-label {
        width: 120px;
        display: inline-block;
    }
</style>

<div style="text-align:center; font-size:24px; margin-bottom:10px;">
    مدیریت
</div>

<!-- ================= PANEL 1: نمایش کامل ================= -->
<div class="panel">
    <div class="panel-header"></div>

    <div style="padding:20px;">
        <h6 style="text-align:center;">مدیریت نوع راه</h6>

        <form method="get">
            <input type="text" name="search" class="input-yellow" value="@Model.Search" />
            <button type="submit">جستجو</button>
        </form>

        <br />

        <table>
            <thead>
                <tr>
                    <th>وضعیت</th>
                    <th>نام کامل</th>
                    <th>کد</th>
                    <th>نمایش</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@(item.IsActive ? "✓" : "✗")</td>
                        <td>@item.FullName</td>
                        <td>@item.Code</td>
                        <td>
                            <a href="?id=@item.RoadTypeId">نمایش</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


<!-- ================= PANEL 2: نمایش بعد از جستجو ================= -->
@if (!string.IsNullOrEmpty(Model.Search))
{
    <div class="panel">
        <div class="panel-header"></div>

        <div style="padding:20px;">
            <h6 style="text-align:center;">مدیریت نوع راه</h6>

            <form method="get">
                <input type="text" name="search" class="input-yellow" value="@Model.Search" />
                <button type="submit">جستجو</button>
            </form>

            <br />

            <table>
                <thead>
                    <tr>
                        <th>وضعیت</th>
                        <th>نام کامل</th>
                        <th>کد</th>
                        <th>نمایش</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@(item.IsActive ? "✓" : "✗")</td>
                            <td>@item.FullName</td>
                            <td>@item.Code</td>
                            <td><a href="?id=@item.RoadTypeId">نمایش</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}


<!-- ================= PANEL 3: فرم ویرایش ================= -->
@if (Model.EditItem != null)
{
    <div class="panel">
        <div class="panel-header"></div>

        <div style="padding:20px;">

            <form method="post" asp-controller="RoadType" asp-action="Update">


                <input type="hidden" name="RoadTypeId" value="@Model.EditItem.RoadTypeId" />

                <div>
                    <span class="form-label">کد:</span>
                    <input type="text" name="Code" class="input-yellow" value="@Model.EditItem.Code" />
                </div>

                <div style="margin-top:10px;">
                    <span class="form-label">نام کامل:</span>
                    <input type="text" name="FullName" class="input-yellow" value="@Model.EditItem.FullName" />
                </div>

                <!-- 🔥 اینجا این بخش را قرار بده -->
                <div style="margin-top:10px;">
                    <span class="form-label">وضعیت:</span>

                    <input type="hidden" name="IsActive" value="false" />

                    <input type="checkbox"
                           name="IsActive"
                           value="true"
                           @(Model.EditItem.IsActive ? "checked" : "") />

                    فعال است
                </div>

                <div style="margin-top:15px;">
                    <button type="submit">ذخیره</button>
                </div>

            </form>
        </div>
    </div>
}

