@model VSSM.Presentation.Web.Models.RoadType.RoadTypeViewModel

@{
    bool isEdit = Model != null && Model.RoadTypeId > 0;
    ViewData["Title"] = isEdit ? "ویرایش نوع راه" : "ثبت نوع راه";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card from-card">
            <div class="card-header card-form-header">
                <h5 class="header-title">@ViewData["Title"]</h5>
            </div>

            <div class="card-block">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form asp-action="@(isEdit ? "Edit" : "Create")"
                      method="post"
                      class="form-horizontal">

                    <input type="hidden" asp-for="RoadTypeId" />

                    <div class="row mb-4 mx-0">

                        <div class="form-group col-lg-4">
                            <label class="form-label">کد</label>
                            <input asp-for="Code"
                                   class="form-control bg-warning-subtle" />
                            <span class="text-danger" asp-validation-for="Code"></span>
                        </div>

                        <div class="form-group col-lg-4">
                            <label class="form-label">نام کامل</label>
                            <input asp-for="FullName"
                                   class="form-control bg-warning-subtle" />
                            <span class="text-danger" asp-validation-for="FullName"></span>
                        </div>
                        <div class="form-group col-lg-1"></div>

                        <div class="form-group col-lg-3">
                            <label class="form-label" style="margin-bottom:1.5rem;">وضعیت</label>

                            <div class="d-flex">
                                <div class="form-check">
                                    <input type="radio"
                                           asp-for="IsActive"
                                           value="true"
                                           class="form-check-input"
                                           id="activeTrue" />
                                    <label class="form-check-label" for="activeTrue">
                                        فعال
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input type="radio"
                                           asp-for="IsActive"
                                           value="false"
                                           class="form-check-input"
                                           id="activeFalse" />
                                    <label class="form-check-label" for="activeFalse">
                                        غیرفعال
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="text-left">
                            <button type="submit" class="btn btn-success px-5">
                                @(isEdit ? "ذخیره" : "ثبت")
                            </button>

                            <a asp-action="Index"
                               class="btn btn-success-outlet px-5">
                                بازگشت
                            </a>
                        </div>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>
