@model VSSM.Presentation.Web.Models.Base.PaginationModel

<style>

    .custom-pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 15px;
        gap: 10px;
    }

    /* Range text */
    .pagination-info {
        font-size: 14px;
        color: #555;
    }

    /* Button container */
    .pagination-controls {
        display: flex;
        gap: 6px;
    }

    /* Buttons */
    .pagination-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
        height: 32px;
        padding: 0 8px;
        border-radius: 6px;
        border: 1px solid #d1d1d1;
        background-color: white;
        color: #333;
        text-decoration: none;
        transition: all 0.2s ease;
        font-weight: 500;
    }

        /* Hover */
        .pagination-btn:hover {
            background-color: #f1f1f1;
            border-color: #0d6efd;
            color: #0d6efd;
        }

        /* Disabled */
        .pagination-btn.disabled {
            pointer-events: none;
            opacity: 0.5;
            cursor: not-allowed;
        }


</style>

@functions {
    string BuildPageUrl(int page, int pageSize, ViewContext viewContext)
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(
            viewContext.HttpContext.Request.QueryString.Value ?? ""
        );

        var dict = new Dictionary<string, string>();

        // Copy existing query params
        foreach (var item in query)
        {
            dict[item.Key] = item.Value;
        }

        // Override pagination params
        dict["pageNumber"] = page.ToString();
        dict["pageSize"] = pageSize.ToString();

        var path = viewContext.HttpContext.Request.Path;
        var qs = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(path, dict);

        return qs;
    }
}


@{
    var data = Model.Data;

    var totalPages = data.TotalPages <= 0 ? 1 : data.TotalPages;
    var currentPage = data.PageNumber <= 0 ? 1 : data.PageNumber;

    var startItem = data.TotalCount == 0
        ? 0
        : ((currentPage - 1) * data.PageSize) + 1;

    var endItem = Math.Min(currentPage * data.PageSize, data.TotalCount);
}

<nav class="custom-pagination">
    <div class="pagination-info">
        @startItem-@endItem از @data.TotalCount
    </div>

    <div class="pagination-controls">
        @* Helper to render either a Link or a JS-Button *@
        @foreach (var p in new[] {
                new { Label = "|<", Page = 1, Disabled = currentPage == 1 },
                new { Label = "<", Page = currentPage - 1, Disabled = currentPage == 1 },
                new { Label = ">", Page = currentPage + 1, Disabled = currentPage >= totalPages },
                new { Label = ">|", Page = totalPages, Disabled = currentPage >= totalPages }
                })
        {
            if (ViewBag.IsPost == true)
            {
                @* POST VERSION: Uses onclick *@
                <button type="button"
                        class="pagination-btn @(p.Disabled ? "disabled" : "")"
                        onclick="submitPagination(@p.Page)">
                    @p.Label
                </button>
            }
            else
            {
                @* GET VERSION: Uses href *@
                <a class="pagination-btn @(p.Disabled ? "disabled" : "")"
                   href="@BuildPageUrl(p.Page, data.PageSize, ViewContext)">
                    @p.Label
                </a>
            }
        }
    </div>
</nav>

@if (ViewBag.IsPost == true)
{
    <script>
                function submitPagination(pageNum) {

            const form = document.querySelector('form');
            if (!form) {
                console.error("No form found for POST pagination.");
                return;
            }

            // --- Page number ---
            let pageInput = form.querySelector('input[name="pageNumber"]');
            if (!pageInput) {
                pageInput = document.createElement('input');
                pageInput.type = 'hidden';
                pageInput.name = 'pageNumber';
                form.appendChild(pageInput);
            }
            pageInput.value = pageNum;

            // --- Page size ---
            let sizeInput = form.querySelector('input[name="pageSize"]');
            if (!sizeInput) {
                sizeInput = document.createElement('input');
                sizeInput.type = 'hidden';
                sizeInput.name = 'pageSize';
                form.appendChild(sizeInput);
            }
            sizeInput.value = '@data.PageSize';

            // --- Additional param from controller ---
                   @if (ViewBag.AdditionalParam != null)
        {
                string raw = ViewBag.AdditionalParam.ToString();
                var pairs = raw.Split('&');

                foreach (var p in pairs)
                {
                        if (string.IsNullOrWhiteSpace(p)) { continue; }

                        var parts = p.Split('=');
                        var key = parts[0];
                        var value = parts.Length > 1 ? parts[1] : "";

                        <text>
                            (function() {
                                let extra = form.querySelector('input[name="@key"]');
                                if (!extra) {
                                    extra = document.createElement('input');
                                    extra.type = 'hidden';
                                    extra.name = '@key';
                                    form.appendChild(extra);
                                }
                                extra.value = '@value';
                            })();
                        </text>
                }
        }


            // Always POST
            form.method = 'post';
            form.submit();
        }

    </script>
}

