@using VSSM.Presentation.Web.Models.Base
@model SearchableMultiSelectModel

@{
    var totalCount = Model.Options?.Count ?? 0;
    var selectedCount = Model.SelectedValues?.Count ?? 0;
    var maxLabels = Model.MaxSelectedLabels <= 0 ? int.MaxValue : Model.MaxSelectedLabels;

    var isAllSelected = selectedCount > 0 && totalCount > 0 && selectedCount == totalCount;
    var isOverflow = selectedCount > maxLabels;

    var visibleValues = (isAllSelected || isOverflow)
        ? new List<string>()
        : (Model.SelectedValues?.Take(maxLabels).ToList() ?? new List<string>());

    var allText = (Model.AllSelectedFormat ?? "همه ({0} مورد)").Replace("{0}", selectedCount.ToString());
    var overflowText = (Model.OverflowSelectedFormat ?? "{0} مورد انتخاب شده").Replace("{0}", selectedCount.ToString());
}

<div class="ms-wrapper"
     data-max-labels="@Model.MaxSelectedLabels"
     data-all-format="@(Model.AllSelectedFormat ?? "همه ({0} مورد)")"
     data-overflow-format="@(Model.OverflowSelectedFormat ?? "{0} مورد انتخاب شده")"
     data-placeholder="@Model.DefaultText">

    @if (!string.IsNullOrEmpty(Model.Label))
    {
        <label class="form-label">
            @Model.Label

            @if (Model.IsRequired)
            {
                <span class="form-mandatory">(اجباری)</span>
            }
        </label>
    }

    <input type="hidden"
           id="@Model.Id"
           name="@Model.Name"
           value="@string.Join(",", Model.SelectedValues)" />

    <div class="ms-control">

        <div class="ms-display">

            <div class="ms-tags">

                @if (selectedCount == 0)
                {
                    <span class="ms-placeholder">@Model.DefaultText</span>
                }
                else if (isAllSelected)
                {
                    <span class="ms-tag ms-tag-summary" title="@allText">
                        <i class="fa fa-check-double"></i>
                        <span class="ms-tag-text">@allText</span>
                    </span>
                }
                else if (isOverflow)
                {
                    <span class="ms-tag ms-tag-summary" title="@overflowText">
                        <i class="fa fa-list-ul"></i>
                        <span class="ms-tag-text">@overflowText</span>
                    </span>
                }
                else
                {
                    foreach (var val in visibleValues)
                    {
                        var text = Model.Options.FirstOrDefault(x => x.Value == val)?.Text;

                        if (text != null)
                        {
                            <span class="ms-tag" data-value="@val">
                                <span class="ms-tag-text">@text</span>
                                <i class="fa fa-times ms-remove-tag"></i>
                            </span>
                        }
                    }
                }

            </div>

            <i class="fa fa-chevron-down ms-caret"></i>

        </div>


        <div class="ms-dropdown">

            <input type="text"
                   class="ms-search form-control"
                   placeholder="جستجو..." />

            <div class="ms-options">

                <div class="ms-option ms-select-all" data-value="__all__">
                    <input type="checkbox" />
                    <span>انتخاب همه</span>
                </div>

                <hr class="ms-option-separator" />


                @foreach (var item in Model.Options)
                {
                    var isSelected = Model.SelectedValues.Contains(item.Value);

                    <div class="ms-option @(isSelected ? "selected" : "")"
                         data-value="@item.Value">

                        <input type="checkbox" @(isSelected ? "checked" : "") />

                        <span>@item.Text</span>

                    </div>

                    <hr class="ms-option-separator" />
                }

            </div>

        </div>

    </div>

</div>