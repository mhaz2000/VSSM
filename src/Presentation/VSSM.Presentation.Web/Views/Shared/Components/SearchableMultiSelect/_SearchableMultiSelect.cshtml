@using VSSM.Presentation.Web.Models.Base
@model SearchableMultiSelectModel

<div class="ms-wrapper">

    @if (!string.IsNullOrEmpty(Model.Label))
    {
        <label class="form-label">
            @Model.Label

            @if (Model.IsRequired)
            {
                <span class="form-mandatory">
                    (اجباری)
                </span>
            }
        </label>
    }

    <input type="hidden"
           id="@Model.Id"
           name="@Model.Name"
           value="@string.Join(",", Model.SelectedValues)" />

    <div class="ms-control">

        <div class="ms-display">

            <div class="ms-tags">

                @if (Model.SelectedValues.Any())
                {
                    foreach (var val in Model.SelectedValues)
                    {
                        var text = Model.Options
                        .FirstOrDefault(x => x.Value == val)
                        ?.Text;

                        if (text != null)
                        {
                            <span class="ms-tag"
                                  data-value="@val">

                                <span class="ms-tag-text">
                                    @text
                                </span>

                                <i class="fa fa-times ms-remove-tag"></i>

                            </span>
                        }
                    }
                }
                else
                {
                    <span class="ms-placeholder">
                        @Model.DefaultText
                    </span>
                }

            </div>

            <i class="fa fa-chevron-down ms-caret"></i>

        </div>


        <div class="ms-dropdown">

            <input type="text"
                   class="ms-search form-control"
                   placeholder="جستجو..." />

            <div class="ms-options">

                <!-- Select All -->

                <div class="ms-option ms-select-all"
                     data-value="__all__">

                    <input type="checkbox" />

                    <span>
                        انتخاب همه
                    </span>

                </div>

                <hr class="ms-option-separator" />


                <!-- Options -->
                @foreach (var item in Model.Options)
                {
                    var isSelected =
                    Model.SelectedValues.Contains(item.Value);

                    <div class="ms-option @(isSelected ? "selected" : "")"
                         data-value="@item.Value">

                        <input type="checkbox"
                               @(isSelected ? "checked" : "") />

                        <span>
                            @item.Text
                        </span>

                    </div>

                    <hr class="ms-option-separator" />
                }

            </div>

        </div>

    </div>

</div>