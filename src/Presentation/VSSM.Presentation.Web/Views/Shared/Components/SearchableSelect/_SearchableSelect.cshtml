@using VSSM.Presentation.Web.Models.Base
@model SearchableSelectModel

<div class="ss-wrapper">

    @if (!string.IsNullOrEmpty(Model.Label))
    {
        <label class="form-label">

            @Model.Label

            @if (Model.IsRequired)
            {
                <span class="input-req-tag">
                    (اجباری)
                </span>
            }

        </label>
    }


    @if (Model.IsRequired &&
        !string.IsNullOrEmpty(Model.ValidationMessage))
    {
        <input type="hidden"
               id="@Model.Id"
               name="@Model.Name"
               value="@Model.SelectedValue"
               data-val="true"
               data-val-required="@Model.ValidationMessage" />
    }
    else
    {
        <input type="hidden"
               id="@Model.Id"
               name="@Model.Name"
               value="@Model.SelectedValue" />
    }


    <div class="ss-control">

        <div class="ss-display">

            <span class="ss-text">

                @(Model.Options
                                .FirstOrDefault(
                                x => x.Value == Model.SelectedValue
                                )?.Text
                                ?? Model.DefaultText)

            </span>

            <i class="fa fa-chevron-down ss-caret"></i>

        </div>


        <div class="ss-dropdown">

            <input type="text"
                   class="ss-search form-control"
                   placeholder="جستجو..." />

            <div class="ss-options">

                @foreach (var item in Model.Options)
                {
                    <div class="ss-option"
                         data-value="@item.Value">

                        @item.Text

                    </div>

                    <hr class="ss-option-separator" />
                }

            </div>

        </div>

    </div>

</div>