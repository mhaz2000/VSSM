@using VSSM.Presentation.Web.Models.Base
@model SearchableSelectModel

<div class="ss-wrapper">
    <label class="form-label">
        @Model.Label
        @if (Model.IsRequired)
        {
            <span class="form-mandatory">(اجباری)</span>
        }
    </label>
    <input type="hidden"
           id="@Model.Id"
           name="@Model.Name"
           value="@Model.SelectedValue" />

    <div class="ss-control">
        <div class="ss-display form-select d-flex justify-content-between align-items-center" style="padding: 14px !important;">
            <span class="ss-text">
                @(Model.Options.FirstOrDefault(x => x.Value == Model.SelectedValue)?.Text ?? Model.DefaultText)
            </span>

            <i class="fa fa-chevron-down ss-caret"></i>
        </div>

        <div class="ss-dropdown">
            <input type="text"
                   class="ss-search form-control"
                   placeholder="جستجو..." />

            <div class="ss-options">
                @foreach (var item in Model.Options)
                {
                    <div class="ss-option"
                         data-value="@item.Value">
                        @item.Text
                    </div>
                    <hr style="margin: 5px" />
                }
            </div>
        </div>
    </div>
</div>