@* ─────────────────────────────────────────────────────
   ViewComponent: SearchBar
   ───────────────────────────────────────────────────── *@
@using Microsoft.AspNetCore.Mvc.Rendering
@model VSSM.Presentation.Web.Models.Base.SearchBarModel

<link href="~/css/components/shared/search-bar.css" rel="stylesheet" />

<div class="search-bar-root">

    <form method="get" class="m-0 p-0">

        <input type="hidden" name="sort" value="@Model.Sort" />
        <input type="hidden" name="direction" value="@Model.Direction" />
        <input type="hidden" name="pageSize" value="@Model.PageSize" />

        <div class="search-wrap">

            @if (Model.FilterOptions != null && Model.FilterOptions.Any())
            {
                <select name="@Model.FilterName"
                        class="search-select"
                        onchange="this.form.submit()">
                    @foreach (var opt in Model.FilterOptions)
                    {
                        <option value="@opt.Value"
                                selected="@(opt.Value == Model.FilterValue)">
                            @opt.Text
                        </option>
                    }
                </select>
                <div class="search-divider"></div>
            }

            <input type="text"
                   name="search"
                   class="search-input"
                   value="@Model.SearchTerm"
                   placeholder="جستجو..." />

            <button type="submit" class="search-btn" title="جستجو">
                <i class="fa fa-search"></i>
            </button>

        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.FilterValue))
    {
        var routeValues = new
        {
            search = (string?)null,
            status = (string?)null,  
            sort = Model.Sort,
            direction = Model.Direction,
            pageSize = Model.PageSize
        };
        <a href="@Url.Action(ViewContext.RouteData.Values["action"]?.ToString(),
                                        ViewContext.RouteData.Values["controller"]?.ToString(),
                                        routeValues)"
       class="btn-all" title="حذف فیلترها و نمایش همه">
        <i class="fa fa-undo" style="font-size:12px;"></i>
        <span style="font-size:12px;">همه</span>
    </a>
        }

    @if (Model.ShowAddButton)
    {
        <a asp-controller="@Model.AddController"
           asp-action="@Model.AddAction"
           class="btn-add">
            <span class="plus-circle">+</span>
            افزودن
        </a>
    }

</div>