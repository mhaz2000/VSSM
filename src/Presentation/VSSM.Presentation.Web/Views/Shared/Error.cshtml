@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>خطای غیرمنتظره</title>
    <style>
        body {
            background: #f8f9fa;
            margin: 0;
            padding: 0;
            font-family: tahoma, sans-serif;
            direction: rtl;
            text-align: center;
        }

        .error-box {
            background: white;
            width: 50%;
            margin: 100px auto;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }

        h1 {
            font-size: 30px;
            margin-bottom: 25px;
            color: #d63031;
        }

        p {
            font-size: 18px;
            color: #555;
        }

        .code {
            margin-top: 25px;
            padding: 15px;
            background: #f1f1f1;
            border-radius: 10px;
            font-family: Consolas;
            direction: ltr;
            color: #333;
        }
    </style>
</head>
<body>

    <div class="error-box">
        <h1>خطای غیرمنتظره رخ داد</h1>
        <p>متاسفانه مشکلی در پردازش درخواست شما پیش آمد.</p>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="code">@ViewBag.ErrorMessage</div>
        }
    </div>

</body>
</html>