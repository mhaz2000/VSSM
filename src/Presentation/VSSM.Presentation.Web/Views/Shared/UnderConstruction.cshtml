@{
    Layout = "_Layout";
}

@section Styles {
    <style>
        /* ═══════════════════════════════════════════════
                   استایل‌های مودال در حال توسعه
                   ═══════════════════════════════════════════════ */

        .modal-overlay {
            position: fixed;
            inset: 0;
            z-index: 9999;
            display: flex;
            justify-content: center;
            align-items: center;
            background: rgba(0, 0, 0, 0.35);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            animation: overlayFadeIn 0.4s ease;
        }

        @@keyframes overlayFadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        .modal-box {
            background: #ffffff;
            border-radius: 32px;
            padding: 52px 56px 44px;
            max-width: 580px;
            width: 92%;
            text-align: center;
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.25);
            animation: modalSlideUp 0.4s ease;
            position: relative;
        }

        @@keyframes modalSlideUp {
            from {
                opacity: 0;
                transform: scale(0.92) translateY(30px);
            }

            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        /* ── دکمه بستن ── */
        .modal-close-btn {
            position: absolute;
            top: 18px;
            left: 22px;
            background: none;
            border: none;
            font-size: 28px;
            color: #9ca3af;
            cursor: pointer;
            transition: color 0.2s, transform 0.2s;
            line-height: 1;
        }

            .modal-close-btn:hover {
                color: #374151;
                transform: rotate(90deg);
            }


        .modal-icon {
            margin-bottom: 0;
            position: relative;
        }

            .modal-icon img {
                width: 200px; 
                height: 200px;
                display: block;
                margin: 0 auto 8px;
            }

   
        .modal-divider {
            width: 92%; 
            max-width: 480px;
            height: 1.5px;
            margin: 12px auto 20px;
            background: linear-gradient( to right, transparent 0%, #d1d5db 15%, #9ca3af 50%, #d1d5db 85%, transparent 100% );
            border-radius: 2px;
            opacity: 0.7;
        }

        /* ── عنوان ── */
        .modal-title {
            font-size: 24px;
            font-weight: 700;
            color: #111827;
            margin-bottom: 10px;
        }

        /* ── زیرنویس (با فونت معمولی) ── */
        .modal-subtitle {
            font-size: 15px;
            color: #6b7280;
            line-height: 1.8;
            margin-bottom: 28px;
        }

        /* ── دکمه تأیید ── */
        .modal-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 36px;
            border-radius: 12px;
            border: none;
            background: #1d6fb8;
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s, transform 0.15s;
        }

            .modal-btn:hover {
                background: #1558a0;
                transform: translateY(-2px);
            }

            .modal-btn:active {
                transform: translateY(0);
            }

        /* ── واکنش‌گرایی ── */
        @@media (max-width: 576px) {
            .modal-box {
                padding: 32px 24px 28px;
            }

            .modal-icon img {
                width: 96px;
                height: 96px;
            }

            .modal-divider {
                width: 88%;
            }

            .modal-title {
                font-size: 20px;
            }

            .modal-subtitle {
                font-size: 14px;
            }
        }

        @@media (max-width: 400px) {
            .modal-icon img {
                width: 80px;
                height: 80px;
            }

            .modal-divider {
                width: 80%;
            }
        }
    </style>
}

<!-- ============================================ -->
<!--  مودال در حال توسعه                          -->
<!-- ============================================ -->
<div class="modal-overlay" id="underConstructionModal">
    <div class="modal-box">

        <button type="button" class="modal-close-btn" id="modalCloseBtn" aria-label="بستن">
            <i class="fa fa-times"></i>
        </button>

        <div class="modal-icon">
            <img src="~/img/Hourglass.svg" alt="در حال توسعه" />
        </div>

        <!-- خط ظریف زیر آیکون (تا نزدیک لبه‌های مودال) -->
        <div class="modal-divider"></div>

        <h2 class="modal-title">در حال توسعه</h2>

        <p class="modal-subtitle">
            این بخش در حال توسعه است و به‌زودی از طریق نهایی‌سازی به صورت رسمی در دسترس قرار خواهد گرفت.
        </p>

        <button type="button" class="modal-btn" id="modalConfirmBtn">
            <i class="fa fa-check"></i>
            متوجه شدم
        </button>

    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            // ═══════════════════════════════════════════════
            //  ۱. بستن همه زیرمنوهای سایدبار
            // ═══════════════════════════════════════════════
            function closeAllDropdowns() {
                var dropdowns = document.querySelectorAll('.nav-dropdown');
                dropdowns.forEach(function (dropdown) {
                    dropdown.classList.remove('open');
                    var items = dropdown.querySelector('.nav-dropdown-items');
                    if (items) items.style.display = 'none';
                    var toggle = dropdown.querySelector('.nav-dropdown-toggle');
                    if (toggle) toggle.setAttribute('aria-expanded', 'false');
                });

                var activeItems = document.querySelectorAll('.nav-item.active');
                activeItems.forEach(function (item) {
                    item.classList.remove('active');
                });
            }

            // ═══════════════════════════════════════════════
            //  ۲. مدیریت مودال و بازگشت به صفحه قبل
            // ═══════════════════════════════════════════════
            var modal = document.getElementById('underConstructionModal');
            var closeBtn = document.getElementById('modalCloseBtn');
            var confirmBtn = document.getElementById('modalConfirmBtn');

            function goBack() {
                if (document.referrer && document.referrer.length > 0) {
                    window.history.back();
                } else {
                    window.location.href = '/';
                }
            }

            if (closeBtn) closeBtn.addEventListener('click', goBack);
            if (confirmBtn) confirmBtn.addEventListener('click', goBack);

            if (modal) {
                modal.addEventListener('click', function (e) {
                    if (e.target === modal) goBack();
                });
            }

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') goBack();
            });

            // ═══════════════════════════════════════════════
            //  ۳. مقداردهی اولیه
            // ═══════════════════════════════════════════════
            document.addEventListener('DOMContentLoaded', function () {
                closeAllDropdowns();
                document.body.style.overflow = 'hidden';
            });

            window.VSSM = window.VSSM || {};
            window.VSSM.UnderConstruction = {
                close: goBack
            };

        })();
    </script>
}