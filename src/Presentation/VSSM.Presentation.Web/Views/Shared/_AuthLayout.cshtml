<!DOCTYPE html>
<html lang="fa-IR" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="Content-Security-Policy"
          content="default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; script-src 'self' 'unsafe-inline';" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " | " : "")سامانه مدیریت نگهداری و توزیع واکسن</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --blue-deep: #0D47A1;
            --blue-mid: #1565C0;
            --blue-light: #42A5F5;
            --white: #FFFFFF;
            --gray-50: #F8FAFC;
            --gray-200: #E2E8F0;
            --gray-400: #94A3B8;
            --gray-600: #475569;
            --gray-800: #1E293B;
            --error: #EF4444;
        }

        body {
            font-family: 'Vazirmatn', system-ui, sans-serif;
            background: linear-gradient(135deg, #F5F9FF 0%, #EBF3FE 40%, #DAEAF9 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
            overflow-y: auto;
            position: relative;
        }

            body::before {
                content: '';
                position: fixed;
                inset: 0;
                background: radial-gradient(ellipse 80% 60% at 20% 30%, rgba(255,255,255,.35) 0%, transparent 60%), radial-gradient(ellipse 60% 80% at 80% 70%, rgba(13,71,161,.15) 0%, transparent 60%);
                pointer-events: none;
                z-index: 0;
            }

            body::after {
                content: '';
                position: fixed;
                width: 600px;
                height: 600px;
                border-radius: 50%;
                background: rgba(255,255,255,.18);
                top: -200px;
                right: -150px;
                pointer-events: none;
                z-index: 0;
            }

        .bg-circle {
            position: fixed;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: rgba(13,71,161,.04);
            bottom: -100px;
            left: -100px;
            pointer-events: none;
            z-index: 0;
        }

        .auth-wrapper {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 520px;
            padding: 40px 24px;
            display: flex;
            flex-direction: column;
            align-items: center;
            animation: fadeSlideUp .5s cubic-bezier(.16,1,.3,1) both;
        }

        @@keyframes fadeSlideUp {
            from {
                opacity: 0;
                transform: translateY(24px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* عنوان بیرون کارت */
        .app-header {
            width: calc(100% + 48px);
            text-align: center;
            margin-bottom: 18px;
        }

        .app-title {
            font-size: 1.55rem;
            font-weight: 800;
            color: var(--gray-800);
            line-height: 1.5;
            margin-bottom: 4px;
            letter-spacing: -.02em;
        }

        .app-subtitle {
            font-size: .78rem;
            color: var(--gray-600);
            letter-spacing: .05em;
            font-weight: 400;
        }

        /* کارت */
        .auth-card {
            width: 100%;
            background: rgba(255,255,255,.93);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 24px;
            padding: 36px 40px 32px;
            box-shadow: 0 4px 6px rgba(13,71,161,.04), 0 16px 48px rgba(13,71,161,.12), 0 1px 0 rgba(255,255,255,.9) inset;
            border: 1px solid rgba(255,255,255,.8);
        }

        /* لوگو */
        .logo-section {
            text-align: center;
            margin-bottom: 20px;
        }

        /* لوگو — بدون سایه، جزء فرم */
        .logo-section {
            text-align: center;
            margin-bottom: 20px;
        }

        .logo-wrap {
            position: relative;
            display: inline-block;
        }

            .logo-wrap img {
                width: 80px;
                height: 80px;
                object-fit: contain;
                display: block;
            }

            /* متن روی لوگو — پایین تصویر */
            .logo-wrap .logo-badge {
                position: absolute;
                bottom: -2px;
                left: 50%;
                transform: translateX(-50%);
                background: rgba(255,255,255,0.88);
                backdrop-filter: blur(4px);
                -webkit-backdrop-filter: blur(4px);
                border: 1px solid rgba(21,101,192,0.15);
                border-radius: 20px;
                padding: 2px 10px;
                font-size: .62rem;
                font-weight: 700;
                color: #1565C0;
                white-space: nowrap;
                letter-spacing: .02em;
            }

        /* هدر فرم */
        .form-header {
            text-align: center;
            margin-bottom: 24px;
        }

        .form-title {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--gray-800);
            margin-bottom: 4px;
        }

        .form-subtitle {
            font-size: .85rem;
            color: var(--gray-400);
            font-weight: 400;
        }

        /* فیلدها */
        .field-group {
            margin-bottom: 16px;
        }

        .field-label {
            display: block;
            font-size: .82rem;
            font-weight: 600;
            color: var(--gray-600);
            margin-bottom: 6px;
        }

        .field-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .field-input {
            width: 100%;
            height: 48px;
            padding: 0 44px 0 16px;
            border: 1.5px solid var(--gray-200);
            border-radius: 12px;
            font-family: inherit;
            font-size: .92rem;
            color: var(--gray-800);
            background: var(--gray-50);
            transition: border-color .2s, box-shadow .2s, background .2s;
            outline: none;
            text-align: right;
            direction: rtl;
        }

            .field-input[type="password"]::-ms-reveal,
            .field-input[type="password"]::-ms-clear,
            .field-input[type="password"]::-webkit-contacts-auto-fill-button,
            .field-input[type="password"]::-webkit-credentials-auto-fill-button {
                display: none !important;
            }

            .field-input[type="password"] {
                padding-left: 44px;
            }

            .field-input::placeholder {
                color: var(--gray-400);
                font-weight: 300;
            }

            .field-input:focus {
                border-color: var(--blue-light);
                background: var(--white);
                box-shadow: 0 0 0 4px rgba(66,165,245,.12);
            }

            .field-input.has-error {
                border-color: var(--error);
                background: var(--white);
                box-shadow: 0 0 0 4px rgba(239,68,68,.08);
            }

        .field-icon {
            position: absolute;
            right: 14px;
            width: 18px;
            height: 18px;
            color: var(--gray-400);
            pointer-events: none;
            transition: color .2s;
        }

        .field-wrap:focus-within .field-icon {
            color: var(--blue-mid);
        }

        .toggle-password {
            position: absolute;
            left: 12px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            color: var(--gray-400);
            transition: color .2s;
            display: flex;
            align-items: center;
        }

            .toggle-password:hover {
                color: var(--blue-mid);
            }

        .error-text {
            margin-top: 6px;
            font-size: .82rem;
            color: var(--error);
            font-weight: 500;
            text-align: right;
        }

        /* دکمه ورود */
        .btn-login {
            width: 100%;
            height: 50px;
            border: none;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--blue-mid) 0%, var(--blue-deep) 100%);
            color: var(--white);
            font-family: inherit;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: transform .15s, box-shadow .15s, filter .15s;
            box-shadow: 0 4px 16px rgba(21,101,192,.35);
            position: relative;
            overflow: hidden;
            margin-top: 8px;
        }

            .btn-login::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg, rgba(255,255,255,.15) 0%, transparent 60%);
                opacity: 0;
                transition: opacity .2s;
            }

            .btn-login:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 24px rgba(21,101,192,.4);
                filter: brightness(1.05);
            }

                .btn-login:hover::before {
                    opacity: 1;
                }

            .btn-login:active {
                transform: translateY(0);
                box-shadow: 0 2px 8px rgba(21,101,192,.3);
            }

        /* فوتر */
        .auth-footer {
            margin-top: 24px;
            text-align: center;
            font-size: .78rem;
            color: var(--gray-400);
            line-height: 1.8;
        }

            .auth-footer a {
                color: var(--blue-mid);
                text-decoration: none;
                font-weight: 500;
            }

                .auth-footer a:hover {
                    text-decoration: underline;
                }

        @@media (max-width: 560px) {
            .auth-wrapper {
                max-width: 100%;
                padding: 20px 16px;
            }

            .auth-card {
                padding: 28px 20px 24px;
                border-radius: 20px;
            }

            .app-header {
                width: 100%;
            }

            .app-title {
                font-size: 1rem;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="bg-circle" aria-hidden="true"></div>

    <main class="auth-wrapper" role="main">
        @RenderBody()
    </main>

    <script>
        (function () {
            var EYE_OPEN = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
            var EYE_SHUT = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>'
                         + '<path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>'
                         + '<path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/>'
                         + '<line x1="1" y1="1" x2="23" y2="23"/>';

            window.togglePassword = function () {
                var input   = document.getElementById('Password');
                var icon    = document.getElementById('eye-icon');
                var btn     = document.querySelector('.toggle-password');
                var visible = input.type === 'text';
                input.type     = visible ? 'password' : 'text';
                icon.innerHTML = visible ? EYE_OPEN : EYE_SHUT;
                btn.setAttribute('aria-label', visible ? 'نمایش رمز عبور' : 'پنهان کردن رمز عبور');
            };
        })();
    </script>

    @{
        var toastMessage = TempData["ToastMessage"]?.ToString();
        var toastType = TempData["ToastType"]?.ToString();
    }
    @if (!string.IsNullOrEmpty(toastMessage))
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (typeof showToast === 'function') {
                    showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastMessage)),
                              @Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastType ?? "success")));
                }
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>