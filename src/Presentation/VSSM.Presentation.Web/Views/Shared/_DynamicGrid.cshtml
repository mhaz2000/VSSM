@* 
   _DynamicGrid.cshtml
    *@
@using VSSM.Presentation.Web.Models.Base
@model GridViewModel

@{
    bool hasData = Model.Data?.Items != null && Model.Data.Items.Any();
    int colCount = Model.Columns.Count + 1;

    const string cssKey = "_DynamicGrid_CSS";
    const string jsKey = "_DynamicGrid_JS";

    bool needsCss = !ViewContext.HttpContext.Items.ContainsKey(cssKey);
    bool needsJs = !ViewContext.HttpContext.Items.ContainsKey(jsKey);

    if (needsCss) ViewContext.HttpContext.Items[cssKey] = true;
    if (needsJs) ViewContext.HttpContext.Items[jsKey] = true;
}

@*  CSS  *@
@if (needsCss)
{
    <link rel="stylesheet"
          href="~/css/components/shared/dynamic-grid.css"
          asp-append-version="true" />
}

@*  HTML  *@
<div class="dg-wrap">
    <div class="dg-card">

        <div class="dg-table-scroll">
            <table class="dg-table">
                <thead>
                    <tr class="dg-col-row">

                        <th>ردیف</th>

                        @foreach (var col in Model.Columns)
                        {
                            <th>
                                @if (col.Sortable && !string.IsNullOrEmpty(col.PropertyName))
                                {
                                    var isSorted = Model.CurrentSort == col.PropertyName;
                                    var btnClass = isSorted
                                    ? $"dg-sort-btn is-sorted dir-{Model.CurrentDirection}"
                                    : "dg-sort-btn";

                                    <button type="button"
                                            class="@btnClass"
                                            data-dg-sort="@col.PropertyName"
                                            data-dg-current-sort="@Model.CurrentSort"
                                            data-dg-current-dir="@Model.CurrentDirection"
                                            title="مرتب‌سازی بر اساس @col.Header">

                                        @col.Header

                                        @if (isSorted && Model.CurrentDirection == "asc")
                                        {
                                            <i class="fa fa-arrow-up dg-sort-icon" aria-hidden="true"></i>
                                        }
                                        else if (isSorted && Model.CurrentDirection == "desc")
                                        {
                                            <i class="fa fa-arrow-down dg-sort-icon" aria-hidden="true"></i>
                                        }
                                        else
                                        {
                                            <i class="fa fa-sort dg-sort-icon" aria-hidden="true"></i>
                                        }
                                    </button>
                                }
                                else
                                {
                                    @col.Header
                                }
                            </th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @if (!hasData)
                    {
                        <tr>
                            <td colspan="@colCount">
                                <div class="dg-empty">
                                    <i class="fa fa-inbox" aria-hidden="true"></i>
                                    رکوردی برای نمایش یافت نشد.
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        int rowNum = (Model.Data.PageNumber - 1) * Model.Data.PageSize + 1;

                        foreach (var item in Model.Data.Items)
                        {
                            <tr>
                                <td class="dg-row-num">@(rowNum++)</td>

                                @foreach (var col in Model.Columns)
                                {
                                    @*  ستون عملیات  *@
                                    if (col.IsActionColumn)
                                    {
                                        <td>
                                            <div class="dg-actions">
                                                @foreach (var act in Model.Actions)
                                                {
                                                    var skip = act.DynamicSkip?.Invoke(item);
                                                    if (!string.IsNullOrEmpty(skip) && bool.Parse(skip)) { continue; }

                                                    var title = act.DynamicTitle?.Invoke(item) ?? act.Title;
                                                    if (string.IsNullOrEmpty(title)) { continue; }

                                                    var controller = act.DynamicController?.Invoke(item) ?? act.Controller;
                                                    var actionName = act.DynamicAction?.Invoke(item) ?? act.Action;
                                                    var iconClass = act.DynamicIconClass?.Invoke(item) ?? act.IconClass;
                                                    var iconStyle = act.DynamicIconStyle?.Invoke(item) ?? act.IconStyle;
                                                    var linkClass = act.DynamicLinkClass?.Invoke(item) ?? act.LinkClass;
                                                    var routeProp = item.GetType().GetProperty(act.RouteIdProperty);
                                                    var routeValue = routeProp?.GetValue(item);

                                                    if (act.OpenModal)
                                                    {
                                                        <a href="#"
                                                           class="action-btn @linkClass open-modal"
                                                           data-url="@Url.Action(actionName, controller, new { id = routeValue })"
                                                           title="@title">
                                                            <i class="@iconClass" style="@iconStyle" aria-hidden="true"></i>
                                                        </a>
                                                    }
                                                    else if (act.Method == "GET")
                                                    {
                                                        <a asp-controller="@controller"
                                                           asp-action="@actionName"
                                                           asp-route-id="@routeValue"
                                                           class="action-btn @linkClass"
                                                           title="@title">
                                                            <i class="@iconClass" style="@iconStyle" aria-hidden="true"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <form asp-controller="@controller"
                                                              asp-action="@actionName"
                                                              asp-route-id="@routeValue"
                                                              method="@act.Method"
                                                              style="display:inline;">
                                                            <button type="submit"
                                                                    class="action-btn @linkClass"
                                                                    title="@title">
                                                                <i class="@iconClass" style="@iconStyle" aria-hidden="true"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                }
                                            </div>
                                        </td>
                                    }

                                    @*  ستون Badge  *@
                                    else if (col.IsBadgeColumn && col.BadgeMap != null)
                                    {
                                        var prop = item.GetType().GetProperty(col.PropertyName ?? "");
                                        var raw = prop?.GetValue(item)?.ToString() ?? "";

                                        <td>
                                            @if (col.BadgeMap.TryGetValue(raw, out var badge))
                                            {
                                                <span class="dg-badge @badge.CssClass">@badge.Text</span>
                                            }
                                            else
                                            {
                                                @raw
                                            }
                                        </td>
                                    }

                                    @*  ستون معمولی  *@
                                    else
                                    {
                                        var prop = item.GetType().GetProperty(col.PropertyName ?? "");
                                        var value = prop?.GetValue(item);
                                        string display = "";

                                        if (value != null)
                                        {
                                            if (col.IsAmount && decimal.TryParse(value.ToString(), out var amount))
                                                display = amount.ToString("N0");
                                            else
                                                display = value.ToString() ?? "";
                                        }

                                        <td>@display</td>
                                    }
                                }
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>

        <div class="dg-footer">
            @await Component.InvokeAsync("Pagination", new
            {
                model = Model.Data,
                        sort = Model.CurrentSort,
                        direction = Model.CurrentDirection
                        })
        </div>

    </div>
</div>

@if (needsJs)
{
    <script src="~/js/shared/dynamic-grid.js" asp-append-version="true"></script>
}
