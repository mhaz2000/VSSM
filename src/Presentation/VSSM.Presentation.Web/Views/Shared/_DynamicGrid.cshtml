@using VSSM.Presentation.Web.Models.Base
@model GridViewModel

<div class="dynamic-grid-wrapper">
    <table class="dynamic-grid table table-bordered table-hover">
    <thead>
        <tr>
            <th class="row-col">#</th>

            @foreach (var column in Model.Columns)
            {
                <th>
                    @column.Header

                    @if (column.Sortable)
                    {
                        var newDirection =
                            Model.CurrentSort == column.PropertyName &&
                            Model.CurrentDirection == "asc"
                            ? "desc" : "asc";

                        <a href="?pageNumber=@Model.Data.PageNumber&pageSize=@Model.Data.PageSize&sort=@column.PropertyName&direction=@newDirection">

                            <i class="fa fa-sort"></i>
                        </a>
                    }
                </th>
            }
        </tr>
    </thead>

<tbody>
@{
    int rowIndex = (Model.Data.PageNumber - 1) * Model.Data.PageSize + 1;
}
@foreach (var item in Model.Data.Items)
{
    <tr>
        <td>@rowIndex</td>
                    @{
                        rowIndex++;
                    }
        @foreach (var column in Model.Columns)
        {
            if (column.IsActionColumn)
            {
                <td class="grid-actions">
                    @{
                        var idProp = item.GetType().GetProperty("Id");
                        var idValue = idProp?.GetValue(item);
                    }

                    @foreach (var action in Model.Actions)
                    {
                        var routeProp = item.GetType().GetProperty(action.RouteIdProperty);
                        var routeValue = routeProp?.GetValue(item);

                        <a asp-controller="@action.Controller"
                           asp-action="@action.Action"
                           asp-route-id="@routeValue"
                           class="action-btn @action.LinkClass"
                           title="@action.Title">

                            <i class="@action.IconClass"></i>
                        </a>
                    }
                </td>
            }
            else
            {
                <td>
                    @{
                        var prop = item.GetType().GetProperty(column.PropertyName);
                        var value = prop?.GetValue(item);
                        string displayValue = "";

                        if (value != null)
                        {
                            if (column.IsAmount && decimal.TryParse(value.ToString(), out var amount))
                            {
                                displayValue = amount.ToString("N0");
                            }
                            else
                            {
                                displayValue = value.ToString();
                            }
                        }
                    }
                    @displayValue
                </td>
            }
        }
    </tr>
}
</tbody>

</table>
</div>
@await Component.InvokeAsync("Pagination",
    new {
        model = Model.Data,
        sort = Model.CurrentSort,
        direction = Model.CurrentDirection
    })
