@{
    Layout = "_Layout";
    ViewData["Title"] = "دسترسی غیرمجاز";
}

<div class="forbidden-wrapper">
    <div class="forbidden-container">
        <div class="forbidden-illust" aria-hidden="true">
            <svg class="shield-svg" viewBox="0 0 720 430">
                <defs>
                    <linearGradient id="shieldGrad" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#3d8ff5" />
                        <stop offset="100%" stop-color="#1f69cb" />
                    </linearGradient>

                    <linearGradient id="shieldInner" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#ffffff" stop-opacity=".23" />
                        <stop offset="100%" stop-color="#ffffff" stop-opacity=".05" />
                    </linearGradient>

                    <linearGradient id="sweepGrad" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0%" stop-color="rgba(255,255,255,0)" />
                        <stop offset="46%" stop-color="rgba(255,255,255,0)" />
                        <stop offset="50%" stop-color="rgba(255,255,255,.56)" />
                        <stop offset="54%" stop-color="rgba(255,255,255,0)" />
                        <stop offset="100%" stop-color="rgba(255,255,255,0)" />
                    </linearGradient>
                </defs>

                <!-- network lines -->
                <g class="network" fill="none" stroke="#9fc6ee" stroke-width="2" opacity=".55">
                    <path d="M70 110 C175 40, 265 42, 350 108" />
                    <path d="M370 108 C455 42, 545 40, 650 116" />
                    <path d="M78 300 C188 370, 280 370, 350 305" />
                    <path d="M370 305 C445 372, 540 368, 642 296" />
                </g>

                <!-- subtle particles -->
                <g class="particles">
                    <circle class="p p1" cx="140" cy="160" r="3" />
                    <circle class="p p2" cx="575" cy="155" r="2.8" />
                    <circle class="p p3" cx="560" cy="268" r="3" />
                    <circle class="p p4" cx="170" cy="270" r="2.6" />
                </g>

                <!-- main shield -->
                <g class="shield-group">
                    <path d="M360 56
                           C316 89, 250 95, 215 103
                           L215 214
                           C215 305, 281 375, 360 410
                           C439 375, 505 305, 505 214
                           L505 103
                           C470 95, 404 89, 360 56Z"
                          fill="url(#shieldGrad)" />

                    <path d="M360 84
                           C325 111, 275 116, 248 123
                           L248 214
                           C248 288, 301 345, 360 372
                           C419 345, 472 288, 472 214
                           L472 123
                           C445 116, 395 111, 360 84Z"
                          fill="url(#shieldInner)"
                          stroke="rgba(255,255,255,.30)"
                          stroke-width="2.2" />

                    <!-- 403 ON SHIELD -->
                    <text x="360" y="245" text-anchor="middle" class="code-on-shield">403</text>

                    <!-- light sweep -->
                    <rect class="sweep" x="205" y="80" width="80" height="290"
                          fill="url(#sweepGrad)" opacity="0"
                          transform="rotate(12 360 230)" />
                </g>
            </svg>
        </div>

        <h1 class="forbidden-title">دسترسی ممنوع</h1>
        <p class="forbidden-desc">
            شما مجوز مشاهده این بخش را ندارید.<br />
            در صورت نیاز با پشتیبانی سیستم تماس بگیرید.
        </p>

        <div class="forbidden-actions">
            <a href="/" class="btn btn-primary btn-lg">
                <i class="fa fa-arrow-right"></i>بازگشت
            </a>
        </div>
    </div>
</div>

<style>
    .forbidden-wrapper {
        min-height: 82vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        direction: rtl;
        background: radial-gradient(1200px 500px at 50% -20%, #e7f2ff 0%, #f3f8ff 52%, #f7fbff 100%);
    }

    .forbidden-container {
        width: 100%;
        max-width: 760px;
        background: #fff;
        border-radius: 2rem;
        border: 1px solid rgba(47,128,237,.12);
        box-shadow: 0 25px 60px rgba(0,40,80,.09);
        text-align: center;
        padding: 2rem 2rem 2.4rem;
        overflow: hidden;
    }

    .forbidden-illust {
        width: min(620px,100%);
        margin: 0 auto .6rem;
    }

    .shield-svg {
        width: 100%;
        height: auto;
        display: block;
    }

    .shield-group {
        transform-origin: 360px 230px;
        animation: shieldFloat 6.1s ease-in-out infinite;
        will-change: transform;
    }

    .code-on-shield {
        font-size: 86px;
        font-weight: 800;
        fill: #ffffff;
        letter-spacing: 2px;
        opacity: .96;
        paint-order: stroke;
        stroke: rgba(18,67,122,.25);
        stroke-width: 2px;
        animation: codeAppear .8s ease forwards .08s;
    }

    .network path {
        stroke-dasharray: 360;
        stroke-dashoffset: 0;
        animation: networkPulse 4.8s ease-in-out infinite;
    }

    .particles .p {
        fill: #9ac6ef;
        opacity: .56;
    }

    .p1 {
        animation: pA 8s ease-in-out infinite;
    }

    .p2 {
        animation: pB 9s ease-in-out infinite;
    }

    .p3 {
        animation: pA 8.7s ease-in-out infinite reverse;
    }

    .p4 {
        animation: pB 7.8s ease-in-out infinite reverse;
    }

    .sweep {
        animation: sweep 7.8s ease-in-out infinite;
        will-change: transform,opacity;
    }

    .forbidden-title {
        margin: .4rem 0 .8rem;
        color: #16324f;
        font-size: clamp(1.8rem, 2.6vw, 2.3rem);
        font-weight: 800;
        opacity: 0;
        transform: translateY(8px);
        animation: enterUp .7s ease forwards .22s;
    }

    .forbidden-desc {
        color: #4f6883;
        font-size: 1.08rem;
        line-height: 1.9;
        margin: 0 0 2rem;
        opacity: 0;
        transform: translateY(8px);
        animation: enterUp .7s ease forwards .36s;
    }

    .forbidden-actions {
        display: flex;
        gap: .8rem;
        justify-content: center;
        flex-wrap: wrap;
        opacity: 0;
        transform: translateY(8px);
        animation: enterUp .7s ease forwards .5s;
    }

    .btn {
        border-radius: 60px;
        padding: .78rem 2rem;
        font-weight: 700;
        text-decoration: none;
        min-width: 196px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: transform .24s ease, box-shadow .24s ease, background-color .24s ease, color .24s ease;
    }

    .btn-primary {
        background: #2f80ed;
        color: #fff;
        border: none;
        box-shadow: 0 9px 24px rgba(47,128,237,.25);
    }

        .btn-primary:hover {
            background: #1f69cb;
            color: #fff;
            transform: translateY(-2px) scale(1.018);
            box-shadow: 0 14px 30px rgba(47,128,237,.34);
        }

    .btn-outline-primary {
        background: #fff;
        color: #2f80ed;
        border: 2px solid #2f80ed;
    }

        .btn-outline-primary:hover {
            background: #2f80ed;
            color: #fff;
            transform: translateY(-2px) scale(1.012);
            box-shadow: 0 12px 26px rgba(47,128,237,.22);
        }

    @@keyframes shieldFloat {
        0%, 100% {
            transform: translate3d(0,0,0);
        }

        50% {
            transform: translate3d(0,-8px,0);
        }
    }

    @@keyframes networkPulse {
        0%, 100% {
            opacity: .46;
            stroke-dashoffset: 0;
        }

        50% {
            opacity: .78;
            stroke-dashoffset: 12;
        }
    }

    @@keyframes pA {
        0%, 100% {
            transform: translate3d(0,0,0);
            opacity: .42;
        }

        50% {
            transform: translate3d(0,-8px,0);
            opacity: .82;
        }
    }

    @@keyframes pB {
        0%, 100% {
            transform: translate3d(0,0,0);
            opacity: .40;
        }

        50% {
            transform: translate3d(-6px,5px,0);
            opacity: .78;
        }
    }

    @@keyframes sweep {
        0%, 70% {
            opacity: 0;
            transform: translateX(-220px) rotate(12deg);
        }

        78% {
            opacity: .56;
        }

        92% {
            opacity: .2;
        }

        100% {
            opacity: 0;
            transform: translateX(260px) rotate(12deg);
        }
    }

    @@keyframes codeAppear {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: .96;
            transform: translateY(0);
        }
    }

    @@keyframes enterUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .forbidden-container {
            padding: 1.5rem 1.1rem 2rem;
            border-radius: 1.3rem;
        }

        .code-on-shield {
            font-size: 68px;
        }

        .forbidden-title {
            font-size: 1.7rem;
        }

        .forbidden-desc {
            font-size: 1rem;
            line-height: 1.8;
        }

        .btn {
            min-width: 165px;
            padding: .7rem 1.3rem;
            font-size: .96rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            animation: none !important;
            transition: none !important;
        }

        .forbidden-title, .forbidden-desc, .forbidden-actions {
            opacity: 1 !important;
            transform: none !important;
        }

        .sweep {
            opacity: 0 !important;
        }
    }
</style>
