@using System.ComponentModel.DataAnnotations
@using VSSM.Presentation.Web.Models.Base
@model GroupedGridViewModel<object, object>

<div class="grouped-grid-wrapper">

@foreach (var group in Model.Groups)
{
    <div class="group-section">

        <!-- META DATA -->
        <div class="group-meta">
        @foreach (var prop in group.Meta.GetType().GetProperties())
        {
            var display = prop.GetCustomAttributes(typeof(DisplayAttribute), false)
                              .Cast<DisplayAttribute>()
                              .FirstOrDefault()?.Name ?? prop.Name;
        
            <div class="meta-row">
                <strong>@display :</strong>
                <span>@prop.GetValue(group.Meta)</span>
            </div>
        }
        </div>

        <!-- DETAIL TABLE -->
        <div class="dynamic-grid-wrapper mt-2">
            <table class="dynamic-grid table table-bordered table-hover">
                <thead>
                    <tr>
                        <th class="row-col">#</th>

                        @foreach (var column in Model.Columns)
                        {
                            <th>@column.Header</th>
                        }
                    </tr>
                </thead>

                <tbody>
                @{
                    int rowIndex = 1;
                }

                @foreach (var detail in group.Details)
                {
                    <tr>
                        <td>@rowIndex</td>
                        @{
                            rowIndex++;
                        }

                        @foreach (var column in Model.Columns)
                        {
                            <td>
                                @{
                                    var prop = detail.GetType().GetProperty(column.PropertyName);
                                    var value = prop?.GetValue(detail);
                                }
                                @value
                            </td>
                        }
                    </tr>
                }

                </tbody>
            </table>
        </div>

    </div>
}

</div>

@await Component.InvokeAsync("Pagination",
    new {
        model = Model.Data,
        sort = Model.CurrentSort,
        direction = Model.CurrentDirection,
        isPost = true 
    })
