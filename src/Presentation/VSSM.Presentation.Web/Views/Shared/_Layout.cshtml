</html>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var latestLink = document.getElementById("latestLink");
        latestLink.addEventListener("click", function (e) {
            e.preventDefault(); // جلوگیری از رفتار پیش‌فرض لینک
            var messageDiv = document.getElementById("message");
            messageDiv.innerText = "در حال تولید...";

            // اگر بخواهی پیام بعد از چند ثانیه ناپدید شود
            setTimeout(function () {
                messageDiv.innerText = "";
            }, 3000); // 3 ثانیه
        });
    });

    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll('.sidebar .nav-dropdown').forEach(function (item) {
            item.classList.remove('open');
        });
    });


</script>