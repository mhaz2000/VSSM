    @using System.Text.Json
    @{
        var toastMessage = TempData["ToastMessage"]?.ToString();
        var toastType = TempData["ToastType"]?.ToString();
    }

    <script>
        const toastMessage = @Html.Raw(JsonSerializer.Serialize(toastMessage));
        const toastType = @Html.Raw(JsonSerializer.Serialize(toastType ?? "success"));

        if (toastMessage) {
            showToast(toastMessage, toastType);
        }
    </script>
    <!-- Grunt watch plugin
    <script src="//localhost:35729/livereload.js"></script> -->
