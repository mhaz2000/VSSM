    <style>

        .card {
            margin-bottom: 0px !important;
            border: 0px !important;
        }

        .page-name {
            margin-left: 20px;
        }

        .table th, tr {
            text-align: center !important
        }

        .form-label {
            text-align: left;
            width: 130px;
            margin-left: 15px;
        }

        .form-group {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
            direction: rtl;
        }

        .form-control, .form-select {
            flex: 1;
        }

        .form-check {
            margin-inline-end: 20px;
            margin-right: 30px !important;
        }

        .form-check-label {
            padding-right: 0rem !important;
        }

        .card {
            direction: rtl;
        }
    </style>


    @await RenderSectionAsync("Styles",false)


