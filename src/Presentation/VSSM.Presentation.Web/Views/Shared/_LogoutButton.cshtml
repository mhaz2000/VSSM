@* 
    استفاده: هر جا در layout اصلی نیاز به دکمه خروج دارید این partial را رندر کنید
    مثال: @await Html.PartialAsync("_LogoutButton")
    
    [SECURITY]: Logout باید POST باشد تا از CSRF جلوگیری شود.
    لینک ساده <a href="/Account/Logout"> کافی نیست و باید حذف شود.
*@
<form method="post" asp-controller="Account" asp-action="Logout" class="logout-form">
    @Html.AntiForgeryToken()
    <button type="submit" class="logout-btn" title="خروج از سامانه">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" y1="12" x2="9" y2="12" />
        </svg>
        خروج
    </button>
</form>