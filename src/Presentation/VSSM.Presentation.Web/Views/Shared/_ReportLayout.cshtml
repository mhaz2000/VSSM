@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="IR-fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>سامانه مدیریت، نگهداری و توزیع واکسن</title>
    <link href="~/css/font-awesome.min.css" rel="stylesheet">
    <link href="~/css/simple-line-icons.css" rel="stylesheet">
    <!-- Main styles for this application -->
    <link href="~/dest/style.css" rel="stylesheet">
    <link href="~/css/components/shared/toast.css" rel="stylesheet" />
    <link href="~/css/site-select.css" rel="stylesheet" />
    <link href="~/css/components/shared/dynamic-grid-style.css" rel="stylesheet" />

    <style>

        @@font-face {
            font-family: 'iranyekan';
            src: url('/fonts/iranyekan/Qs_Iranyekan.ttf') format('truetype');
            font-weight: normal;
            font-style: normal;
        }

        @@font-face {
            font-family: 'iranyekan';
            src: url('/fonts/iranyekan/Qs_Iranyekan_bold.ttf') format('truetype');
            font-weight: bold;
            font-style: normal;
        }


        body,
        h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, .h5, .h6 {
            font-family: 'iranyekan', sans-serif !important;
        }

        h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, .h5, .h6 {
            font-weight: bold !important;
        }

        .report-wrapper{
            margin: 1rem;
        }

        body.mobile-open .main1 {
            width: 1440px;
            margin: auto;
        }

        .row.equal-height {
            display: flex;
            flex-wrap: wrap;
        }

            .row.equal-height > [class*='col-'] {
                display: flex;
                flex-direction: column;
            }

                .row.equal-height > [class*='col-'] > * {
                    flex-grow: 1;
                }

        .card {
            margin-bottom: 0px !important;
            border: 0px !important;
            direction: rtl;
            border-radius: 24px;
            padding-right: 4px;
            padding-left: 4px;
            padding-top: 16px;
            background: #F6F6F6;
        }

            .card.form-card, .card-form-header {
                background: white !important;
            }

        .card-header {
            background: #F6F6F6;
            border-radius: 24px;
            border: 0;
        }

        .page-name {
            margin-left: 20px;
        }

        .table th,
        .table tr {
            text-align: center !important;
        }

        .header-title {
            font-weight: 800;
            font-size: 24px;
            line-height: 32px;
            text-align: right;
        }

        /* Spacing Utilities */
        .m-0 {
            margin: 0 !important;
        }

        .mx-0 {
            margin: auto 0;
        }

        .mx-2 {
            margin: auto 0.5rem;
        }

        .ml-2 {
            margin-left: 4px;
        }

        .m-auto {
            margin: auto !important;
        }

        .mb-2 {
            margin-bottom: 0.5rem
        }

        /* Form Layout */
        .form-group {
            display: block;
            direction: rtl;
        }

        .form-label {
            text-align: right;
            width: 100%;
            margin-bottom: 8px;
            font-size: 18px;
            font-weight: 500;
            line-height: 32px;
        }

        .form-label-caption {
            text-align: right;
            font-size: 14px;
            font-weight: 300;
            line-height: 32px;
            color: gray;
        }

        .required-marker {
            color: red;
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-control,
        .form-select {
            flex: 1;
            border-radius: 8px;
            border: 1px solid #C2C5C6;
            padding: auto 16px;
        }

        .form-group > .form-control {
            min-height: 40px;
        }

        .form-check {
            margin-inline-end: 20px;
            margin-right: 30px !important;
            display: flex;
            align-items: center;
        }

        .form-check-label {
            padding-right: 0rem !important;
        }

        /* Buttons */
        .btn {
            border-radius: 12px;
            font-size: 14px;
            font-weight: 500;
            line-height: 24px;
            min-height: 40px;
            min-width: 120px;
        }

        .btn-success {
            background: #37842F;
            border: 1px solid #37842F;
            color: white;
        }

        .btn-primary {
            background: #0071B7;
            border: 1px solid #0071B7;
            color: white;
        }

        .btn-light {
        }

        .card-header .btn {
            margin-top: 0 !important;
        }

        .btn-success-outlet {
            border-radius: 12px;
            color: #37842F;
            border: 1px solid #37842F;
            font-size: 14px;
            font-weight: 500;
            line-height: 24px;
            min-height: 40px;
            min-width: 120px;
        }

        .text-left {
            text-align: left;
        }

        /* Table Wrapper */
        .table-wrapper {
            border-radius: 18px;
            overflow: hidden;
            border: 1px solid #dee2e6;
            margin-bottom: 32px;
        }

        .table {
            margin: 0;
        }


        .pager-wrap {
            display: flex;
            justify-content: flex-start;
            margin-top: 12px;
            direction: rtl;
        }

        .cpageination {
            display: flex;
            gap: 8px;
        }

        .pager-modern .page-item .page-link {
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            margin-left: -1px;
            background: #fff;
            color: #262626;
            font-weight: 500;
            font-size: 14px;
            width: 32px;
            height: 32px;
        }

            .pager-modern .page-item .page-link .fa {
                font-size: 18px;
                font-weight: 400;
            }

        .pager-modern .page-item.active .page-link {
            background: #0071B7;
            border-color: #0071B7;
            color: #fff;
        }

        .pager-modern .page-item.disabled .page-link {
            background: #f9fafb;
            color: #9ca3af;
            cursor: not-allowed;
        }

        .pager-modern .page-item.ellipsis .page-link {
            pointer-events: none;
        }

        .d-flex {
            display: flex;
            gap: 8px;
        }

        .justify-content-end {
            justify-content: end;
        }

        .justify-content-center {
            justify-content: center;
        }

        .col-xs-1, .col-xs-2, .col-xs-3, .col-xs-4, .col-xs-5, .col-xs-6, .col-xs-7, .col-xs-8, .col-xs-9, .col-xs-10, .col-xs-11, .col-xs-12, .col-sm-1, .col-sm-2, .col-sm-3, .col-sm-4, .col-sm-5, .col-sm-6, .col-sm-7, .col-sm-8, .col-sm-9, .col-sm-10, .col-sm-11, .col-sm-12, .col-md-1, .col-md-2, .col-md-3, .col-md-4, .col-md-5, .col-md-6, .col-md-7, .col-md-8, .col-md-9, .col-md-10, .col-md-11, .col-md-12, .col-lg-1, .col-lg-2, .col-lg-3, .col-lg-4, .col-lg-5, .col-lg-6, .col-lg-7, .col-lg-8, .col-lg-9, .col-lg-10, .col-lg-11, .col-lg-12, .col-xl-1, .col-xl-2, .col-xl-3, .col-xl-4, .col-xl-5, .col-xl-6, .col-xl-7, .col-xl-8, .col-xl-9, .col-xl-10, .col-xl-11, .col-xl-12 {
            padding-left: 4px;
            padding-right: 4px;
        }

        .badge {
            padding: 2px 8px;
            border-radius: 8px;
            max-width: 100px;
            width: 100%;
            display: block;
            margin: auto;
        }

        .badge-success {
            background: #E4F6E2 !important;
            color: #37842F !important;
        }

        .badge-danger {
            background: #FFDFDF !important;
            color: #ED1515 !important;
        }

        table tbody tr:hover {
            background-color: rgba(52, 152, 219, 0.1) !important;
            transition: background-color 0.3s ease;
            cursor: pointer;
        }

        /* Alternative hover with border */
        tr:hover {
            background-color: #F0F8FF !important;
            transition: all 0.2s ease;
        }

            /* Hover effect for action buttons */
            tr:hover .btn-link {
                opacity: 1;
                transform: scale(1.1);
            }

        .btn-link {
            opacity: 0.8;
            transition: all 0.2s ease;
        }

            .btn-link:hover {
                opacity: 1;
                transform: scale(1.15);
            }

        /* Zebra striping with hover (maintains hover even on striped rows) */
        .table-striped tbody tr:nth-of-type(odd):hover {
            background-color: rgba(52, 152, 219, 0.15) !important;
        }

        .table-striped tbody tr:nth-of-type(even):hover {
            background-color: rgba(52, 152, 219, 0.1) !important;
        }

        /* Smooth transitions */
        .table tbody tr {
            transition: all 0.2s ease;
        }


        .custom-checkbox {
            display: inline-flex;
            align-items: center;
            cursor: pointer;
            font-size: 14px;
            gap: 8px;
            direction: rtl; /* for Persian */
        }

            .custom-checkbox input {
                display: none;
            }

        .checkmark {
            width: 22px;
            height: 22px;
            border: 1px solid #0071B7;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }

            .checkmark::after {
                content: "";
                width: 10px;
                height: 6px;
                border-left: 2px solid #0071B7;
                border-bottom: 2px solid #0071B7;
                transform: rotate(-45deg) scale(0);
                transition: transform 0.2s ease;
            }

        /* Checked state */
        .custom-checkbox input:checked + .checkmark {
            background-color: #ffffffff;
        }

            .custom-checkbox input:checked + .checkmark::after {
                transform: rotate(-45deg) scale(1);
            }

    </style>


    @await RenderSectionAsync("Styles", false)


</head>

<body>
    <div class="report-wrapper">
        @RenderBody()
    </div>
</body>
</html>
