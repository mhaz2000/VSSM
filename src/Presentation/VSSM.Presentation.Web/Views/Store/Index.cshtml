@using VSSM.Application.DTOs.BaseEntities.Store
@model PagingSearchOrderDto<StoreListDto>

@{
    ViewData["Title"] = "مدیریت انبارها";
}

<style>
    .w-full {
        width: 100%;
    }

    .pager-wrap {
        display: flex;
        justify-content: flex-start; /* ← راست‌چین */
        margin-top: 12px;
        direction: rtl;
    }


    .pager-modern {
        margin: 0;
        gap: 0;
    }

        .pager-modern .page-item .page-link {
            min-width: 44px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #e5e7eb;
            border-radius: 0;
            margin-left: -1px; /* چسبیدن مثل عکس */

            background: #fff;
            color: #1d4ed8; /* آبی متن */
            font-weight: 500;
        }

        .pager-modern .page-item.active .page-link {
            background: #0ea5e9; /* آبی/فیروزه‌ای مثل عکس */
            border-color: #0ea5e9;
            color: #fff;
        }

        .pager-modern .page-item.disabled .page-link {
            background: #f9fafb;
            color: #9ca3af;
            cursor: not-allowed;
        }

        .pager-modern .page-item.ellipsis .page-link {
            pointer-events: none;
        }

</style>
<div class="container-fluid">
    <div class="animated fadeIn">

        <!-- Search Card -->
        <div class="card mb-3">
            <div class="card-block">

                <form method="get">
                    <div class="row d-flex align-items-center justify-content-between">

                        <div class="col-lg-3">
                            <input class="form-control"
                                   name="search"
                                   value="@Model.SearchText"
                                   placeholder="جستجو بر اساس کد یا نام..." />
                        </div>

                        <div class="col-lg-3">
                            <select name="typeId" class="form-select" asp-items="ViewBag.TypeList">
                                <option value="">نوع انبار</option>
                            </select>
                        </div>

                        <div class="col-lg-2 d-flex justify-content-start">
                            <button type="submit" class="btn btn-primary w-100">جستجو</button>
                        </div>

                        <div class="col-lg-2 d-flex justify-content-start mt-2 mt-lg-0">
                            <a class="btn btn-success w-100" asp-action="New">+ جدید</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- TABLE -->
        <div class="card">
            <div class="card-block">

                <table class="table table-bordered table-striped text-center">
                    <thead>
                        <tr>
                            <th>کد</th>
                            <th>نام</th>
                            <th>نوع انبار</th>
                            <th>حجم (لیتر)</th>
                            <th>حجم خالی (لیتر)</th>
                            <th>ملاحظات</th>
                            <th>فعال است</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.Code</td>
                                    <td>@item.FullName</td>
                                    <td>@item.TypeName</td>
                                    <td>@item.Volume</td>
                                    <td>@item.FreeVolume</td>
                                    <td>@item.Note</td>
                                    <td>
                                        <input type="checkbox" checked="@item.IsActive" disabled />
                                    </td>
                                    <td>
                                        <a class="btn btn-primary btn-sm"
                                           asp-action="New"
                                           asp-route-id="@item.StoreId">
                                            ویرایش
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-danger">داده‌ای یافت نشد</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Pagination -->
                @{
                    int page = Model.Paging.Page;
                    int totalPages = Model.Paging.TotalPages;

                    // چند صفحه اطراف صفحه فعلی
                    int window = 2;

                    // پارامترهای فیلتر/مرتب‌سازی که باید حفظ شوند
                    var search = Model.SearchText ?? "";
                    var sortField = Model.SortField ?? "";
                    var sortOrder = Model.SortOrder ?? "";

                    // typeId از QueryString میاد (چون تو Model نیست)
                    var typeId = Context.Request.Query["typeId"].ToString() ?? "";

                    // انتخاب صفحات: 1, ... , (page-window..page+window), ... , total
                    var selected = new SortedSet<int>();
                    if (totalPages >= 1) selected.Add(1);

                    for (int p = page - window; p <= page + window; p++)
                        if (p >= 1 && p <= totalPages) selected.Add(p);

                    if (totalPages >= 2) selected.Add(totalPages);

                    string PageUrl(int p)
                    => $"?search={search}&typeId={typeId}&sortField={sortField}&sortOrder={sortOrder}&page={p}";
                }

                <nav class="pager-wrap mt-2" aria-label="Page navigation">
                    <ul class="pagination pager-modern">

                        <!-- قبلی -->
                        <li class="page-item @(page == 1 ? "disabled" : "")">
                            <a class="page-link" href="@(page == 1 ? "#" : PageUrl(page - 1))" tabindex="@(page == 1 ? "-1" : "0")">
                                قبلی
                            </a>
                        </li>

                        @{
                            int prev = 0;
                            foreach (var p in selected)
                            {
                                if (prev != 0 && p - prev > 1)
                                {
                                    <li class="page-item disabled ellipsis">
                                        <span class="page-link">…</span>
                                    </li>
                                }

                                <li class="page-item @(p == page ? "active" : "")">
                                    <a class="page-link" href="@PageUrl(p)">@p</a>
                                </li>

                                prev = p;
                            }
                        }


            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
