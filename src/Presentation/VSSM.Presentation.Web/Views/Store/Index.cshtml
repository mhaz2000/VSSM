﻿@using VSSM.Presentation.Web.Models.Base
@using Microsoft.AspNetCore.Mvc.Rendering
@model GridViewModel

@section Styles {
    <link href="~/css/components/shared/grid-wrapper.css" rel="stylesheet" />
    <link href="~/css/components/shared/grid-header.css" rel="stylesheet" />
}

@{
    ViewData["Title"] = "مدیریت انبار‌ها";

    var currentType = Context.Request.Query["typeId"].ToString();
    var currentRecipient = Context.Request.Query["recipientId"].ToString();

    var storeTypeList = ViewBag.StoreTypeList as List<SelectListItem> ?? new List<SelectListItem>();
    var recipientList = ViewBag.RecipientListForFilter as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="grid-wrapper">
    <div class="grid-header" style="direction:rtl;">

        <strong style="font-size:1.4rem; font-weight:600; color:#111827;">
            @ViewData["Title"]
        </strong>

        @await Component.InvokeAsync("SearchBar", new
        {
            searchTerm = Model.SearchTerm,
                pageSize = Model.Data.PageSize,
                sort = Model.CurrentSort,
                direction = Model.CurrentDirection,
                addController = "Store",
                addAction = "New",
                showAddButton = true,
                filterName = "typeId",
                filterValue = currentType,
                filterOptions = storeTypeList.Count > 0
                ? storeTypeList.Prepend(new SelectListItem("همه", "", currentType == "")).ToList()
                : new List<SelectListItem> { new SelectListItem("همه", "", currentType == "") },
                filterName2 = "recipientId",
                filterValue2 = currentRecipient,
                filterOptions2 = recipientList.Count > 0
                ? recipientList.Prepend(new SelectListItem("همه", "", currentRecipient == "")).ToList()
                : new List<SelectListItem> { new SelectListItem("همه", "", currentRecipient == "") }
                })

    </div>

    <div>
        @await Html.PartialAsync("_DynamicGrid", Model)
    </div>
</div>

