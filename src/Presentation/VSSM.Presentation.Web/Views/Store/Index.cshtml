@using VSSM.Application.DTOs.BaseEntities.Store
@model PagingSearchOrderDto<StoreListDto>

@{
    ViewData["Title"] = "مدیریت انبارها";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <!-- Search Card -->
        <div class="card mb-3">
            <div class="card-block">

                <form method="get">
                    <div class="row d-flex align-items-center justify-content-between">

                        <div class="col-lg-3">
                            <input class="form-control"
                                   name="search"
                                   value="@Model.SearchText"
                                   placeholder="جستجو بر اساس کد یا نام..." />
                        </div>

                        <div class="col-lg-3">
                            <select name="typeId" class="form-select" asp-items="ViewBag.TypeList">
                                <option value="">نوع انبار</option>
                            </select>
                        </div>

                        <div class="col-lg-2 d-flex justify-content-start">
                            <button type="submit" class="btn btn-primary w-100">جستجو</button>
                        </div>

                        <div class="col-lg-2 d-flex justify-content-start mt-2 mt-lg-0">
                            <a class="btn btn-success w-100" asp-action="New">+ جدید</a>
                        </div>




                    </div>
                </form>

            </div>
        </div>

        <!-- TABLE -->
        <div class="card">
            <div class="card-block">

                <table class="table table-bordered table-striped text-center">
                    <thead>
                        <tr>
                            <th>کد</th>
                            <th>نام</th>
                            <th>نوع انبار</th>
                            <th>حجم (لیتر)</th>
                            <th>حجم خالی (لیتر)</th>
                            <th>ملاحظات</th>
                            <th>فعال است</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.Code</td>
                                    <td>@item.FullName</td>
                                    <td>@item.TypeName</td>
                                    <td>@item.Volume</td>
                                    <td>@item.FreeVolume</td>
                                    <td>@item.Note</td>
                                    <td>
                                        <input type="checkbox" checked="@item.IsActive" disabled />
                                    </td>
                                    <td>
                                        <a class="btn btn-primary btn-sm"
                                           asp-action="Edit"
                                           asp-route-id="@item.StoreId">
                                            ویرایش
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-danger">داده‌ای یافت نشد</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Pagination -->
                <nav class="mt-2">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.Paging.Page == 1 ? "disabled" : "")">
                            <a class="page-link" href="?search=@Model.SearchText&page=@(Model.Paging.Page - 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">قبلی</a>
                        </li>

                        @for (int i = 1; i <= Model.Paging.TotalPages; i++)
                        {
                            <li class="page-item @(Model.Paging.Page == i ? "active" : "")">
                                <a class="page-link" href="?search=@Model.SearchText&page=@i&sortField=@Model.SortField&sortOrder=@Model.SortOrder">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.Paging.Page == Model.Paging.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="?search=@Model.SearchText&page=@(Model.Paging.Page + 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">بعدی</a>
                        </li>
                    </ul>
                </nav>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
