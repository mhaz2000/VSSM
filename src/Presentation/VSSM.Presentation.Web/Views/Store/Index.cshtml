@using VSSM.Application.DTOs.BaseEntities.Store
@model PagingSearchOrderDto<StoreListDto>

@{
    ViewData["Title"] = "مدیریت انبارها";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-block">

                <form method="get">
                    <div class="row d-flex align-items-center">

                        <!-- RIGHT SIDE -->
                        <div class="col-lg-3 text-right">
                            <input class="form-control"
                                   name="search"
                                   value="@Model.SearchText"
                                   placeholder="جستجو..." />
                        </div>

                        <div class="col-lg-3 text-right">
                            <select name="typeId" class="form-select" asp-items="ViewBag.TypeList">
                                <option value="">نوع درجه حرارت</option>
                            </select>
                        </div>

                        <!-- LEFT SIDE -->
                        <div class="col-lg-2 text-left">
                            <button type="submit" class="btn btn-primary w-50">جستجو</button>
                        </div>

                        <div class="col-lg-2 text-left">
                            <a class="btn btn-success w-50" asp-action="New">جدید +</a>
                        </div>

                    </div>
                </form>


            </div>
        </div>


        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-block">

                        <table class="table table-bordered table-striped table-condensed text-center">
                            <thead>
                                <tr>
                                    <th>
                                        <a href="?sortField=Code&sortOrder=@(Model.SortOrder == "asc" ? "desc" : "asc")">
                                            کد
                                        </a>
                                    </th>
                                    <th>
                                        <a href="?sortField=Name&sortOrder=@(Model.SortOrder == "asc" ? "desc" : "asc")">
                                            نام انبار
                                        </a>
                                    </th>
                                    <th>حجم</th>
                                    <th>وضعیت</th>
                                    <th>عملیات</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model != null && Model.Items.Any())
                                {
                                    foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>@item.Code</td>
                                            <td>@item.FullName</td>
                                            <td>@item.FreeVolume</td>
                                            <td>@(item.IsActive ? "فعال" : "غیرفعال")</td>
                                            <td>
                                                <a class="btn btn-primary btn-sm"
                                                   asp-controller="Store"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.StoreId">
                                                    ویرایش
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-danger">
                                            داده‌ای یافت نشد
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <nav>
                            <ul class="pagination">
                                <li class="page-item @(Model.Paging.Page == 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?search=@Model.SearchText&page=@(Model.Paging.Page - 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">
                                        قبلی
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.Paging.TotalPages; i++)
                                {
                                    <li class="page-item @(Model.Paging.Page == i ? "active" : "")">
                                        <a class="page-link"
                                           href="?search=@Model.SearchText&page=@i&sortField=@Model.SortField&sortOrder=@Model.SortOrder">
                                            @i
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(Model.Paging.Page == Model.Paging.TotalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?search=@Model.SearchText&page=@(Model.Paging.Page + 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">
                                        بعدی
                                    </a>
                                </li>
                            </ul>
                        </nav>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
