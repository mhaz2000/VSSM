@using VSSM.Application.DTOs.BaseEntities.Recipient
@using VSSM.Presentation.Web.Models.Base
@model VSSM.Presentation.Web.Models.Store.StoreViewModel

@{
    string formName = Model?.StoreId > 0 ? "ویرایش انبار" : "ثبت انبار جدید";
    var recipients = ViewBag.RecipientList as List<SelectListItem>;

}

@section Styles {
    <link href="~/css/components/shared/a-card.css" rel="stylesheet" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" />
    <link href="~/css/components/store/store-form.css" rel="stylesheet" />
}

<div class="store-form-wrap">
    <strong class="store-form-title">@formName</strong>

    <form asp-action="Create" asp-controller="Store" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="StoreId" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!-- اطلاعات اصلی -->
        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-warehouse" style="color:#1d6fb8;"></i>
                <h6>اطلاعات اصلی</h6>
            </div>
            <div class="a-card-body">

                <div class="fg-3" style="margin-bottom:14px;">
                    <div class="f-group">
                        <label class="f-label">کد <span class="req-tag">اجباری</span></label>
                        <input asp-for="Code" placeholder="کد را وارد کنید" class="f-control" />
                        <span class="text-danger" asp-validation-for="Code"></span>
                    </div>
                    <div class="f-group">
                        <label class="f-label">نام انبار <span class="req-tag">اجباری</span></label>
                        <input asp-for="Name" placeholder="نام انبار را وارد کنید" class="f-control" />
                        <span class="text-danger" asp-validation-for="Name"></span>
                    </div>
                    <div class="f-group">
                        <label class="f-label">نوع درجه حرارت <span class="req-tag">اجباری</span></label>
                        <select asp-for="TypeId" asp-items="ViewBag.StoreTypeList" class="f-control">
                            <option value="">انتخاب کنید...</option>
                        </select>
                        <span class="text-danger" asp-validation-for="TypeId"></span>
                    </div>
                </div>

                <div class="fg-3" style="margin-bottom:14px;">

                    <div class="f-group">
                        <label class="f-label">گیرنده <span class="req-tag">اجباری</span></label>

                        @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect", new SearchableSelectModel
                        {
                            Id = "RecipientId",
                            Name = "RecipientId",
                            DefaultText = "جستجوی گیرنده...",
                            Label = "",
                            IsRequired = true,
                            SelectedValue = Model?.RecipientId?.ToString(),
                            ValidationMessage = "گیرنده نمی‌تواند خالی باشد.",
                            Options = recipients.Select(r => new SelectOption
                            {
                                Value = r.Value.ToString(),
                                Text = r.Text
                            }).ToList()
                        })

                        <span class="text-danger" asp-validation-for="RecipientId"></span>

                    </div>

                    <div class="f-group">
                        <label class="f-label">حجم کلی فضا (لیتر)</label>
                        <input asp-for="Volume" placeholder="لیتر را وارد کنید" class="f-control" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">حجم مفید</label>
                        <input asp-for="FreeVolume" placeholder="حجم مفید را وارد کنید" class="f-control" />
                        <span class="text-danger" asp-validation-for="FreeVolume"></span>
                    </div>

                </div>

                <div class="fg-2">
                    <div class="f-group">
                        <label class="f-label">سال نصب</label>
                        <input asp-for="Year" placeholder="سال نصب را وارد کنید" class="f-control" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">ملاحظات</label>
                        <textarea asp-for="Note" placeholder="ملاحظات را وارد کنید" class="f-control"></textarea>
                    </div>
                </div>

            </div>
        </div>

        <!-- فوتر -->
        <div class="form-footer">
            <button type="submit" class="btn-confirm">
                <i class="fa fa-save"></i> ثبت
            </button>
            <a asp-action="Index" class="btn-back">
                <i class="fa fa-arrow-right"></i> بازگشت
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ensure jQuery validation validates SearchableSelect hidden inputs
        $(function() {
            $('.ss-wrapper').each(function() {
                var $form = $(this).closest('form');
                if ($form.length && $form.data('validator')) {
                    $form.data('validator').settings.ignore = '';
                }
            });
        });
    </script>
}
