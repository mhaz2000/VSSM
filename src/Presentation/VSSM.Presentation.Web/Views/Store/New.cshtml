@model VSSM.Presentation.Web.Models.Store.StoreViewModel

@{
    string formName = Model?.StoreId > 0 ? "ویرایش انبار" : "ثبت انبار جدید";
}


<div class="container-fluid">
    <div class="animated fadeIn">
        <div class="card from-card">
                <div class="card-header card-form-header">
                    <h5 class="header-title">@formName</h5>
                </div>
                <div class="card-block">
                    
                    <form asp-action="Create" asp-controller="Store" method="post" 
                    class="form-horizontal">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="StoreId" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row mb-4 mx-0">

                        
                            <div class="col-lg-4">

                                <!-- Code -->
                                <div class="form-group">
                                    <span class="form-label">کد
                                    <span class="form-label-caption"> (اجباری)</span>
                                    </span>
                                    <input asp-for="Code" placeholder="کد را وارد کنید" 
                                    class="form-control bg-warning-subtle" />
                                </div>
                                <span class="text-danger" asp-validation-for="Code"></span>

                                <!-- Volume -->
                                <div class="form-group">
                                    <label class="form-label">حجم کلی فضا (لیتر)</label>
                                    <input asp-for="Volume" placeholder="لیتر را وارد کنید" class="form-control" />
                                </div>


                            </div>


                            <div class="col-lg-4">

                                <!-- Name -->
                                <div class="form-group">
                                    <span class="form-label">
                                            نام انبار <span class="form-label-caption"> (اجباری)</span>
                                    </span>
                                    <input asp-for="Name"  placeholder="نام انبار  را وارد کنید"  class="form-control bg-warning-subtle" />
                                </div>
                                <span class="text-danger" asp-validation-for="Name"></span>


                                <!-- FreeVolume -->
                                <div class="form-group">
                                    <label class="form-label">حجم مفید</label>
                                    <input asp-for="FreeVolume"  placeholder="حجم مفید را وارد کنید"  class="form-control" />
                                </div>
                                <span class="text-danger" asp-validation-for="FreeVolume"></span>

                            </div>
                            


                            <div class="col-lg-4">

                                <!-- Type -->
                                <div class="form-group">
                                    <span class="form-label">
                                        نوع درجه حرارت<span class="form-label-caption"> (اجباری)</span>
                                    </span>
                                    <select asp-for="TypeId"
                                            asp-items="ViewBag.StoreTypeList"
                                            class="form-control form-select ">
                                        <option value="">انتخاب کنید...</option>
                                    </select>
                                </div>
                                <span class="text-danger" asp-validation-for="TypeId"></span>

                                <!-- Recipient -->
                                <div class="form-group">
                                    <label class="form-label">گیرنده</label>
                                    <select asp-for="RecipientId"
                                            asp-items="ViewBag.RecipientList"
                                            class="form-control form-select">
                                        <option value="">انتخاب کنید...</option>
                                    </select>
                                </div>

                            </div>

                            <div class="row m-0">
                                <div class="col-lg-6">

                                    <!-- Year -->
                                    <div class="form-group">
                                        <label class="form-label">سال نصب</label>
                                        <input asp-for="Year"   placeholder="سال نصب را وارد کنید" class="form-control" />
                                    </div>

                                </div>
                                <div class="col-lg-6">

                                    <!-- Note -->
                                    <div class="form-group">
                                        <label class="form-label">ملاحظات</label>
                                        <textarea asp-for="Note"   placeholder="ملاحظات را وارد کنید" class="form-control"></textarea>
                                    </div>   

                            </div>
                            </div>
                        </div>

                        <div class="text-left">
                            <button type="submit" class="btn btn-success px-5">ثبت</button>
                            <a asp-action="Index" class="btn btn-success-outlet px-5">بازگشت</a>
                        </div>
                    </form>
                </div>
            </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
