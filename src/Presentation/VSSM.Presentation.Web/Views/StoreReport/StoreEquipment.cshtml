@using VSSM.Application.DTOs.BaseEntities.BaseInfo
@using VSSM.Application.DTOs.BaseEntities.Recipient
@using VSSM.Presentation.Web.Models.Base
@{
    ViewData["Title"] = "گزارش تجهیزات انبار";

    var recipients = ViewBag.Recipients as List<RecipientGetDto> ?? new();
    var typeList   = ViewBag.TypeList   as List<BaseInfoDto>    ?? new();
    var years      = ViewBag.Years      as List<int>            ?? new();

    List<SelectOption> Opts<T>(IEnumerable<T> src, Func<T, string> v, Func<T, string> t)
        => src.Select(x => new SelectOption { Value = v(x), Text = t(x) }).ToList();
}

@section Styles {
    <link href="~/css/components/shared/a-card.css" rel="stylesheet" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" />
    <link href="~/css/components/shared/toast.css" rel="stylesheet" />
    <link href="~/css/components/shared/searchable-controls.css" rel="stylesheet" />
    <link href="~/css/components/reports/store-equipment.css" rel="stylesheet" />
}

<div class="report-wrap">
    <div class="report-page-title">
        <i class="fa fa-warehouse" style="color:#16a34a;"></i>
        <span>@ViewData["Title"]</span>
    </div>

    <form method="post" action="/StoreReport/StoreEquipmentReport"
          target="_blank" id="storeEquipmentForm">
        @Html.AntiForgeryToken()

        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-filter" style="color:#16a34a;"></i>
                <h6>فیلترها</h6>
            </div>
            <div class="a-card-body">

                <section class="filter-section">
                    <header class="filter-section-header">
                        <span class="filter-section-badge">۱</span>
                        <h5>جستجو</h5>
                    </header>
                    <div class="filters-grid filters-grid-2">

                        <div class="f-group">
                            <label class="f-label" for="recipientId">گزارش پایین</label>
                            @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                                new SearchableSelectModel
                                {
                                    Id = "recipientId", Name = "recipientId",
                                    IsRequired = false,
                                    Label = "", DefaultText = "همه مراکز",
                                    Options = Opts(recipients, x => x.RecipientId.ToString(), x => x.FullName)
                                })
                        </div>

                        <div class="f-group">
                            <label class="f-label" for="storeTypeId">نوع انبار</label>
                            @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                                new SearchableSelectModel
                                {
                                    Id = "storeTypeId", Name = "storeTypeId",
                                    IsRequired = false,
                                    Label = "", DefaultText = "همه انواع",
                                    Options = Opts(typeList, x => x.Id.ToString(), x => x.Title)
                                })
                        </div>

                    </div>
                </section>

                <section class="filter-section">
                    <header class="filter-section-header">
                        <span class="filter-section-badge">۲</span>
                        <h5>محدوده ظرفیت</h5>
                    </header>
                    <div class="filters-grid filters-grid-4">

                        <div class="f-group">
                            <label class="f-label" for="volumeStart">حجم خالص (لیتر) از</label>
                            <input id="volumeStart" name="volumeStart" type="number"
                                   class="f-control" placeholder="از" autocomplete="off" />
                        </div>

                        <div class="f-group">
                            <label class="f-label" for="volumeEnd">حجم خالص (لیتر) تا</label>
                            <input id="volumeEnd" name="volumeEnd" type="number"
                                   class="f-control" placeholder="تا" autocomplete="off" />
                        </div>

                        <div class="f-group">
                            <label class="f-label" for="freeVolumeStart">حجم کلی فضا از</label>
                            <input id="freeVolumeStart" name="freeVolumeStart" type="number"
                                   class="f-control" placeholder="از" autocomplete="off" />
                        </div>

                        <div class="f-group">
                            <label class="f-label" for="freeVolumeEnd">حجم کلی فضا تا</label>
                            <input id="freeVolumeEnd" name="freeVolumeEnd" type="number"
                                   class="f-control" placeholder="تا" autocomplete="off" />
                        </div>

                    </div>
                </section>

                <section class="filter-section">
                    <header class="filter-section-header">
                        <span class="filter-section-badge">۳</span>
                        <h5>سال نصب و وضعیت</h5>
                    </header>
                    <div class="filters-grid filters-grid-3">

                        <div class="f-group">
                            <label class="f-label" for="yearStart">سال نصب از</label>
                            @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                                new SearchableSelectModel
                                {
                                    Id = "yearStart", Name = "yearStart",
                                    IsRequired = false,
                                    Label = "", DefaultText = "از سال",
                                    Options = Opts(years, x => x.ToString(), x => x.ToString())
                                })
                        </div>

                        <div class="f-group">
                            <label class="f-label" for="yearEnd">سال نصب تا</label>
                            @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                                new SearchableSelectModel
                                {
                                    Id = "yearEnd", Name = "yearEnd",
                                    IsRequired = false,
                                    Label = "", DefaultText = "تا سال",
                                    Options = Opts(years, x => x.ToString(), x => x.ToString())
                                })
                        </div>

                        <div class="f-group">
                            <label class="f-label" for="isActive">وضعیت فعال</label>
                            <select id="isActive" name="isActive" class="f-control">
                                <option value="-1">همه</option>
                                <option value="1">بله</option>
                                <option value="0">خیر</option>
                            </select>
                        </div>

                    </div>
                </section>

                <div class="card-actions">
                    <button type="button" class="btn-secondary js-clear-filters">
                        <i class="fa fa-eraser"></i>
                        <span>پاک کردن فیلترها</span>
                    </button>
                    <button type="submit" class="btn-confirm btn-primary-action" id="searchBtn">
                        <i class="fa fa-play"></i>
                        <span>تهیه گزارش</span>
                    </button>
                </div>

            </div>
        </div>
    </form>
</div>

<div id="toastContainer"></div>

@section Scripts {
    <script src="~/js/shared/toast.js"></script>
    <script src="~/js/shared/searchable-controls.js"></script>
    <script src="~/js/components/reports/store-equipment.js"></script>
}