@using VSSM.Application.DTOs.BaseEntities.FiscalPeriod
@using VSSM.Application.DTOs.BaseEntities.Recipient
@using VSSM.Application.DTOs.BaseEntities.Source
@using VSSM.Application.DTOs.BaseEntities.Store
@using VSSM.Presentation.Web.Models.Base
@model GridViewModel

@{
    ViewData["Title"] = "گزارش تجهیزات انبار";
}

@{
    var recipients = ViewBag.Recipients as List<RecipientGetDto>;
    var years = ViewBag.Years as List<int>;
}


@section Styles {
    <link href="~/css/persian-datepicker.css" rel="stylesheet" />
}

<style>
    /* .form-control {
        padding: 16px !important;
    } */

</style>

<div class="container-fluid">

    <div class="card mt-3">
        <div class="card-block">

            <div class="grid-wrapper">

                <div class="grid-header">
                    <strong style="font-size: 1.2rem">@ViewData["Title"]</strong>
                </div>

                <form method="get" action="/StoreReport/StoreEquipmentReport" target="_blank" class="card p-3 mb-3">

                    <div class="row g-3">


                        <div class="col-md-6 input-sec">

                            @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect",
                            new SearchableSelectModel
                            {
                                Id = "recipientId",
                                IsRequired = false,
                                Name = "recipientId",
                                Label = "گزارش پایین",
                                Options = recipients
                            .Select(x => new SelectOption
                            {
                                Value = x.RecipientId.ToString(),
                                Text = x.FullName
                            }).ToList()
                            })
                        </div>
                        
                        <div class="row">
                        <div class="col-md-6 input-sec">
                            <label class="form-label">نوع انبار</label>
                            <select name="typeId" class="form-control form-select m-0"
                                    style="height:42px!important" id="storeTypeId" name="storeTypeId"
                                    asp-items="ViewBag.TypeList">
                                <option value="">نوع انبار</option>
                            </select>
                        </div>
                        </div>

                        <div class="col-md-3 input-sec">
                                <label class="form-label">حجم خالص (لیتر):  از</label>
                            <input type="number" class="form-control" id="volumeStart" name="volumeStart" />
                            
                        </div>
                        <div class="col-md-3 input-sec">
                            <label class="form-label">تا</label>
                            <input type="number" class="form-control" id="volumeEnd" name="volumeEnd" />
                        </div>

                        <div class="col-md-3 input-sec">
                            <label class="form-label">حجم کلی فضا :  از</label>
                            <input type="number" class="form-control" id="freeVolumeStart" name="freeVolumeStart" />
                        </div>
                        <div class="col-md-3 input-sec">
                            <label class="form-label">تا</label>
                            <input type="number" class="form-control" id="freeVolumeEnd" name="freeVolumeEnd" />
                        </div>
                        <div class="col-md-3 input-sec">
                            <label class="form-label">سال نصب :  از</label>
                            <select name="typeId" class="form-control form-select m-0"
                                    style="height:42px!important" id="yearStart" name="yearStart"
                                    asp-items="ViewBag.Years">
                                <option value="">سال نصب</option>
                            </select>
                        </div>
                        <div class="col-md-3 input-sec">
                            <label class="form-label">تا</label>
                            <select name="typeId" class="form-control form-select m-0"
                                    style="height:42px!important" id="yearEnd" name="yearEnd"
                                    asp-items="ViewBag.Years">
                                <option value="">سال نصب</option>
                            </select>
                        </div>

                        <div class="col-md-3 input-sec">
                            <br />
                            <div><label class="form-label"></label></div>
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox" id="isActive" name="isActive" />
                                <label class="form-check-label">فعال</label>
                            </div>
                        </div>

                    </div>

                    <div class="text-start mt-3" style="margin-top: 1rem; margin-right: 0px;">
                        <button type="submit" class="btn btn-primary" id="searchBtn">
                            <i class="fa fa-search"></i> خلاصه گزارش
                        </button>

                    </div>
                </form>

                @if (Model != null)
                {
                    <div style="margin-top: 1rem;">
                        @await Html.PartialAsync("_DynamicGrid", Model)
                    </div>
                }

            </div>
        </div>

    </div>
</div>

@section Scripts {
    
}
