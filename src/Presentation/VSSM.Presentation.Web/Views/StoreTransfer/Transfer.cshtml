@using Microsoft.AspNetCore.Mvc.TagHelpers
@model VSSM.Presentation.Web.Models.StoreTransfer.StoreTransferViewModel

@{
    ViewData["Title"] = "انتقال بین انبارها";
}

<style>
    .required-star {
        color: red;
        margin-right: 3px;
    }
</style>

<div class="container-fluid">
    <div class="animated fadeIn">

        <!-- Header -->
        <div class="card mb-3">
            <div class="card-block p-3">
                <h5>انتقال موجودی بین انبارها</h5>
            </div>
        </div>

        <!-- Form Card -->
        <div class="card">
            <div class="card-block p-3">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <form asp-controller="StoreTransfer"
                      asp-action="Transfer"
                      method="post"
                      class="form-horizontal">

                    <div class="col-lg-6">

                        <!-- From Store -->
                        <div class="form-group">
                            <label class="form-label">
                                <span class="required-star">*</span>
                                انتقال از انبار:
                            </label>
                            <select class="form-control" asp-for="FromStoreId" id="FromStoreId">
                                <option value="">-- انتخاب کنید --</option>
                                @foreach (var store in Model.Stores)
                                {
                                    <option value="@store.Value">@store.Text</option>
                                }
                            </select>
                            <span asp-validation-for="FromStoreId" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label">حجم کل انبار مبدا</label>
                            <input type="number" id="FromStoreCapacity" class="form-control" readonly />
                        </div>

                        <div class="form-group">
                            <label class="form-label">حجم خالی انبار مبدا</label>
                            <input type="number" id="FromStoreFreeCapacity" class="form-control" readonly />
                        </div>

                        <hr />

                        <!-- To Store -->
                        <div class="form-group">
                            <label class="form-label">
                                <span class="required-star">*</span>
                                انتقال به انبار:
                            </label>
                            <select class="form-control" asp-for="ToStoreId" id="ToStoreId">
                                <option value="">-- انتخاب کنید --</option>
                                @foreach (var store in Model.Stores)
                                {
                                    <option value="@store.Value">@store.Text</option>
                                }
                            </select>
                            <span asp-validation-for="ToStoreId" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label">حجم کل انبار مقصد</label>
                            <input type="number" id="ToStoreCapacity" class="form-control" readonly />
                        </div>

                        <div class="form-group">
                            <label class="form-label">حجم خالی انبار مقصد</label>
                            <input type="number" id="ToStoreFreeCapacity" class="form-control" readonly />
                        </div>

                        <hr />

                        <!-- Items Table -->
                        <h6>لیست کالاهای موجود در انبار مبدا</h6>
                        <table class="table table-bordered table-striped" id="itemsTable">
                            <thead>
                                <tr>
                                    <th><input type="checkbox" id="selectAll" /></th>
                                    <th>نام کالا</th>
                                    <th>موجودی فعلی</th>
                                    <th>مقدار انتقال</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>

                        <!-- Buttons -->
                        <div class="text-center mt-4">
                            <button type="button" class="btn btn-success px-5" id="btnTransfer">ثبت انتقال</button>
                            <a asp-controller="Store" asp-action="Index" class="btn btn-primary px-5">لیست</a>
                        </div>

                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<!-- Modal تایید نهایی -->
<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">تایید انتقال</h5>
        <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
      </div>
      <div class="modal-body">
        آیا از انتقال کالاهای انتخاب شده اطمینان دارید؟
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">لغو</button>
        <button type="button" class="btn btn-success" id="confirmSubmit">تایید و انتقال</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
    // --- Load Store Capacity ---
    function loadStoreCapacity(storeId, capacityId, freeCapacityId) {
        if (!storeId) {
            document.getElementById(capacityId).value = "";
            document.getElementById(freeCapacityId).value = "";
            return;
        }

        fetch(`/StoreTransfer/GetStoreCapacity?storeId=${storeId}`)
            .then(res => res.json())
            .then(data => {
                document.getElementById(capacityId).value = data.capacity;
                document.getElementById(freeCapacityId).value = data.freeCapacity;
            })
            .catch(() => {
                document.getElementById(capacityId).value = "";
                document.getElementById(freeCapacityId).value = "";
            });
    }

    const fromStore = document.getElementById("FromStoreId");
    const toStore = document.getElementById("ToStoreId");

    fromStore.addEventListener("change", function () {
        loadStoreCapacity(this.value, "FromStoreCapacity", "FromStoreFreeCapacity");
        loadItemsByStore(this.value);
    });

    toStore.addEventListener("change", function () {
        loadStoreCapacity(this.value, "ToStoreCapacity", "ToStoreFreeCapacity");
    });

    // --- Load Items Table ---
    const tableBody = document.querySelector("#itemsTable tbody");

    function loadItemsByStore(storeId) {
        tableBody.innerHTML = "";
        if (!storeId) return;

        fetch(`/StoreTransfer/GetItemsByStore?storeId=${storeId}`)
            .then(res => res.json())
            .then(items => {
                items.forEach((item, index) => {
                    const row = `
<tr>
<td>
<input type="checkbox" name="Items[${index}].IsSelected" value="true" />
<input type="hidden" name="Items[${index}].ItemDetailStoreId" value="${item.itemDetailStoreId}" />
</td>
<td>${item.itemName}</td>
<td>${item.currentStock}</td>
<td>
<input type="number" name="Items[${index}].Quantity" class="form-control" min="1" max="${item.currentStock}" />
</td>
</tr>`;
                    tableBody.insertAdjacentHTML("beforeend", row);
                });
            });
    }

    // --- Select All Checkbox ---
    document.getElementById("selectAll").addEventListener("change", function() {
        const checks = tableBody.querySelectorAll("input[type='checkbox']");
        checks.forEach(c => c.checked = this.checked);
    });

    // --- نمایش Modal هنگام کلیک دکمه انتقال ---
    document.getElementById("btnTransfer").addEventListener("click", function () {
        const checked = tableBody.querySelectorAll("input[type='checkbox']:checked");
        if (checked.length === 0) {
            alert("لطفاً حداقل یک کالا را انتخاب کنید.");
            return;
        }

        const modalEl = new bootstrap.Modal(document.getElementById("confirmModal"));
        modalEl.show();
    });

    // --- تایید و ارسال فرم ---
    document.getElementById("confirmSubmit").addEventListener("click", function () {
        document.querySelector("form").submit();
    });
</script>
}
