@using Microsoft.AspNetCore.Mvc.TagHelpers
@model VSSM.Presentation.Web.Models.StoreTransfer.StoreTransferViewModel

@{
    ViewData["Title"] = "انتقال بین انبارها";
}

@section Styles {
    <link href="~/css/components/shared/a-card.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/components/shared/lines-table.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/components/shared/table-common.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/components/store-transfer/store-transfer.css" rel="stylesheet" asp-append-version="true" />
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <form id="transferForm" asp-controller="StoreTransfer" asp-action="Transfer" method="post" novalidate>
            @Html.AntiForgeryToken()

            <!-- Card 1: اطلاعات انبارها -->
            <div class="a-card mb-3">
                <div class="a-card-header">
                    <h6><i class="fa fa-warehouse" style="color:#1d6fb8;"></i> اطلاعات انبارها</h6>
                </div>
                <div class="a-card-body card-body-custom">

                    <div class="fg-3" style="margin-bottom:14px;">
                        <div class="f-group">
                            <label class="f-label">
                                <span class="required-star">*</span> انتقال از انبار
                                <span class="req-tag">اجباری</span>
                            </label>
                            <select asp-for="FromStoreId" id="FromStoreId" class="f-control">
                                <option value="">-- انتخاب کنید --</option>
                                @foreach (var store in Model.Stores)
                                {
                                    <option value="@store.Value">@store.Text</option>
                                }
                            </select>
                            <span asp-validation-for="FromStoreId" class="text-danger" style="font-size:11px;"></span>
                        </div>

                        <div class="f-group">
                            <label class="f-label">حجم کل انبار مبدا</label>
                            <input type="number" id="FromStoreCapacity" class="f-control" readonly />
                        </div>

                        <div class="f-group">
                            <label class="f-label">حجم خالی انبار مبدا</label>
                            <input type="number" id="FromStoreFreeCapacity" class="f-control" readonly />
                        </div>
                    </div>

                    <div class="fg-3" style="margin-bottom:0;">
                        <div class="f-group">
                            <label class="f-label">
                                <span class="required-star">*</span> انتقال به انبار
                                <span class="req-tag">اجباری</span>
                            </label>
                            <select asp-for="ToStoreId" id="ToStoreId" class="f-control">
                                <option value="">-- انتخاب کنید --</option>
                                @foreach (var store in Model.Stores)
                                {
                                    <option value="@store.Value">@store.Text</option>
                                }
                            </select>
                            <span asp-validation-for="ToStoreId" class="text-danger" style="font-size:11px;"></span>
                        </div>

                        <div class="f-group">
                            <label class="f-label">حجم کل انبار مقصد</label>
                            <input type="number" id="ToStoreCapacity" class="f-control" readonly />
                        </div>

                        <div class="f-group">
                            <label class="f-label">حجم خالی انبار مقصد</label>
                            <input type="number" id="ToStoreFreeCapacity" class="f-control" readonly />
                        </div>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger mt-3" style="font-size:13px;"></div>

                </div>
            </div>

            <!-- Card 2: لیست کالاها با اسکرول و لودینگ -->
            <div class="a-card mb-3">
                <div class="a-card-header">
                    <h6><i class="fa fa-list" style="color:#1d6fb8;"></i> لیست کالاهای موجود در انبار مبدا</h6>
                </div>
                <div class="a-card-body card-body-custom">

                    <div class="lines-table-wrap">
                        <table class="lines-table" id="itemsTable">
                            <thead>
                                <tr>
                                    <th style="width:40px;"><input type="checkbox" id="selectAll" /></th>
                                    <th>نام کالا</th>
                                    <th>موجودی فعلی</th>
                                    <th style="min-width:150px;">مقدار انتقال</th>
                                </tr>
                            </thead>
                            <tbody id="itemsTbody">
                                <!-- محتوای جدول توسط JS ساخته می‌شود -->
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

            <div class="form-footer">
                <a class="btn-back" asp-action="Index">
                    <i class="fa fa-arrow-right"></i>
                    بازگشت
                </a>

                <button type="button" class="btn-confirm" id="btnTransfer">
                    <i class="fa fa-exchange"></i>
                    ثبت انتقال
                </button>
            </div>

            <div id="hiddenInputsContainer"></div>

        </form>

    </div>
</div>

@section Scripts {
    <script src="~/js/shared/scrollable-table.js" asp-append-version="true"></script>
    <script src="~/js/components/store-transfer/store-transfer.js" asp-append-version="true"></script>
}