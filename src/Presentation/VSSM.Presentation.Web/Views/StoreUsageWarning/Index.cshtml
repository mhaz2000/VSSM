@model VSSM.Application.DTOs.BaseEntities.StoreUsageWarning.StoreUsageWarningDto

@{
    ViewData["Title"] = "اخطار میزان مصرف انبار";
}

<div class="card mt-3 shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">اخطار میزان مصرف انبار</h5>
    </div>

    <div class="card-body">
        <form asp-action="Index" method="post" novalidate>
            
            <div class="row">
                
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold" for="Dry">Dry (%)</label>
                    <input asp-for="Dry" class="form-control form-control-sm" type="number" min="0" max="100" />
                    <span asp-validation-for="Dry" class="text-danger small"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold" for="Bz">Bz (%)</label>
                    <input asp-for="Bz" class="form-control form-control-sm" type="number" min="0" max="100" />
                    <span asp-validation-for="Bz" class="text-danger small"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold" for="Az">Az (%)</label>
                    <input asp-for="Az" class="form-control form-control-sm" type="number" min="0" max="100" />
                    <span asp-validation-for="Az" class="text-danger small"></span>
                </div>

            </div>
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-success mt-2">ذخیره</button>
            </div>
        </form>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-4" role="alert">
                @ViewBag.Message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>
</div>

<!-- Validation Scripts و JS جمع درصد -->
<partial name="_ValidationScriptsPartial" />

<script>
    const form = document.querySelector('form');
    form.addEventListener('submit', function (e) {
        const dry = parseInt(document.querySelector('[name="Dry"]').value) || 0;
        const bz = parseInt(document.querySelector('[name="Bz"]').value) || 0;
        const az = parseInt(document.querySelector('[name="Az"]').value) || 0;

        if (dry > 100) {
            alert("dry نباید بیشتر از 100 باشد");
            e.preventDefault();
        }

        if (bz > 100) {
            alert("bz نباید بیشتر از 100 باشد");
            e.preventDefault();
        }

        if (az > 100) {
            alert("az نباید بیشتر از 100 باشد");
            e.preventDefault();
        }
    });
</script>
