@model VSSM.Application.DTOs.BaseEntities.StoreUsageWarning.StoreUsageWarningDto

@{
    ViewData["Title"] = "اخطار میزان مصرف انبار";
}

@section Styles {
    <link href="~/css/components/shared/a-card.css" rel="stylesheet" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" />
    <link href="~/css/components/shared/toast.css" rel="stylesheet" />
    <link href="~/css/pages/store-usage-warning/store-usage-warning.css" rel="stylesheet" />
}

<div class="store-usage-wrap">
    <div class="item-page-title">
        <i class="fa fa-exclamation-triangle" style="color:#dc2626;"></i>
        @ViewData["Title"]
    </div>

    <form asp-action="Index" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-sliders-h" style="color:#1d6fb8;"></i>
                <h6>تنظیمات درصد هشدار مصرف انبار</h6>
            </div>

            <div class="a-card-body">
                <div class="store-usage-info-text">
                    <i class="fa fa-info-circle"></i>
                    درصدهای مصرف انبار را وارد کنید. در صورت تجاوز از این درصدها، هشدار نمایش داده می‌شود.
                </div>

                <div class="store-usage-grid">
                    <div class="f-group">
                        <label asp-for="Dry" class="f-label">Dry (%)</label>
                        <input asp-for="Dry" class="f-control" type="number" min="0" max="100" placeholder="مثلاً ۸۰" />
                        <span asp-validation-for="Dry" class="field-error"></span>
                    </div>

                    <div class="f-group">
                        <label asp-for="Bz" class="f-label">Bz (%)</label>
                        <input asp-for="Bz" class="f-control" type="number" min="0" max="100" placeholder="مثلاً ۷۰" />
                        <span asp-validation-for="Bz" class="field-error"></span>
                    </div>

                    <div class="f-group">
                        <label asp-for="Az" class="f-label">Az (%)</label>
                        <input asp-for="Az" class="f-control" type="number" min="0" max="100" placeholder="مثلاً ۶۰" />
                        <span asp-validation-for="Az" class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="form-footer" style="justify-content:flex-end;">
                <button type="submit" class="btn-confirm">
                    <i class="fa fa-save"></i>
                    ذخیره تنظیمات
                </button>
            </div>
        </div>
    </form>
</div>

<div id="toastContainer"></div>

<partial name="_ValidationScriptsPartial" />

@section Scripts {
    <script src="~/js/components/shared/toast.js"></script>
    <script src="~/js/pages/store-usage-warning/store-usage-warning.js"></script>
    @if (ViewBag.Message != null)
    {
        <script>
            showToast('@ViewBag.Message', 'success');
        </script>
    }
}