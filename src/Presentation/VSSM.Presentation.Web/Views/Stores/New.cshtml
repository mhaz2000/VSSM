@model VSSM.Presentation.Web.Models.Store.StoreViewModel

@{
    string formName = "ثبت";
    if (Model != null && Model.StoreId > 0)
        formName = "ویرایش";
}

<style>
    .form-label {
        text-align: left;
        width: 130px;
        margin-left: 15px;
    }

    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        direction: rtl;
    }

    .form-control, .form-select {
        flex: 1;
    }

    .form-check {
        margin-inline-end: 20px;
        margin-right: 30px !important;
        display: flex;
        align-items: center;
    }

    .form-check-label {
        padding-right: 0rem !important;
    }

    .card {
        direction: rtl;
    }
</style>

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-block">
                <div class="col-lg-3">
                    <div><h5>@formName انبار</h5></div>
                </div>
            </div>
        </div>

        <div>
            <div class="card">
                <div class="card-block">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <form asp-action="Create" method="post" class="form-horizontal">
                        <input type="hidden" asp-for="StoreId" />

                        <div class="col-lg-8">

                            <div class="form-group">
                                <label class="form-label" for="Code">کد:</label>
                                <input asp-for="Code" class="form-control bg-warning-subtle" />
                            </div>
                            <span class="text-danger" asp-validation-for="Code"></span>

                            <div class="form-group">
                                <label class="form-label" for="Name">نام انبار:</label>
                                <input asp-for="Name" class="form-control bg-warning-subtle" />
                            </div>
                            <span class="text-danger" asp-validation-for="Name"></span>

                            <div class="form-group">
                                <label class="form-label" for="TypeId">نوع درجه حرارت:</label>
                                <select asp-for="TypeId"
                                        asp-items="ViewBag.StoreTypeList"
                                        class="form-select">
                                    <option value="">انتخاب کنید...</option>
                                </select>
                            </div>
                            <span class="text-danger" asp-validation-for="TypeId"></span>

                            <div class="form-group">
                                <label class="form-label" for="FreeVolume">حجم:</label>
                                <input asp-for="FreeVolume" class="form-control" />
                            </div>
                            <span class="text-danger" asp-validation-for="FreeVolume"></span>

                            <div class="form-group">
                                <label class="form-label" for="Volume">حجم کلی فضا:</label>
                                <input asp-for="Volume" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="RecipientId">گیرنده:</label>
                                <select asp-for="RecipientId"
                                        asp-items="ViewBag.RecipientList"
                                        class="form-select">
                                    <option value="">انتخاب کنید...</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="GrossVol">GrossVol:</label>
                                <input asp-for="GrossVol" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="Year">سال نصب:</label>
                                <input asp-for="Year" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="Model">مدل:</label>
                                <input asp-for="Model" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="Manufacturer">سازنده:</label>
                                <input asp-for="Manufacturer" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="Pqsno">PQS No:</label>
                                <input asp-for="Pqsno" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="CoolingUnitNo">تعداد واحدهای سردخانه:</label>
                                <input asp-for="CoolingUnitNo" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="RefrigerantGas">گاز یخچال:</label>
                                <input asp-for="RefrigerantGas" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="RoomBox">Room/Box:</label>
                                <input asp-for="RoomBox" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="PoweSource">منبع انرژی:</label>
                                <select asp-for="PoweSource"
                                        asp-items="ViewBag.PowerSourceList"
                                        class="form-select">
                                    <option value="">انتخاب کنید...</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="Source">منبع:</label>
                                <select asp-for="Source"
                                        asp-items="ViewBag.SourceList"
                                        class="form-select">
                                    <option value="">انتخاب کنید...</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="Barcode">بارکد:</label>
                                <input asp-for="Barcode" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="PeriodNotUse">مدت زمان استفاده نشده:</label>
                                <input asp-for="PeriodNotUse" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="UnitCost">هزینه واحد:</label>
                                <input asp-for="UnitCost" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="Note">ملاحظات:</label>
                                <textarea asp-for="Note" class="form-control"></textarea>
                            </div>

                            <div class="form-group">
                                <label class="form-label">وضعیت:</label>
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           asp-for="IsActive" />
                                    <label class="form-check-label" for="IsActive">فعال است</label>
                                </div>
                            </div>

                            <div class="text-center mt-4">
                                <button type="submit" class="btn btn-success px-5">ثبت</button>
                                <a asp-action="Index" class="btn btn-primary px-5">لیست</a>
                            </div>

                        </div>
                    </form>

                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
