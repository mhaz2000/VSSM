@using VSSM.Application.DTOs.UidHistory
@model UidHistorySearchDto

@section Styles {
    <link href="~/css/components/shared/a-card.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/components/shared/table-common.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/components/shared/lines-table.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/components/UidHistory/uid-history.css" rel="stylesheet" asp-append-version="true" />
}

@{
    ViewData["Title"] = "تاریخچه UID";
}

@* ── کارت جستجو ── *@
<div class="a-card">
    <div class="a-card-header">
        <h6><i class="fa fa-search" style="color:#1d6fb8;"></i> جستجوی UID</h6>
    </div>
    <div class="a-card-body" style="padding:16px;">
        <div class="uh-search-wrap">
            <input type="text" id="uidInput" class="f-control"
                   placeholder="UID (حداقل ۲۰ کاراکتر) را وارد کنید..." />
            <button id="searchBtn"
                    class="btn-confirm uh-search-btn"
                    disabled>
                <i class="fa fa-search"></i>
                جستجو
            </button>
        </div>
        <div class="uh-progress-wrap" style="margin-top:8px;">
            <div class="uh-progress-bg">
                <div id="uidProgress" class="uh-progress-fill" style="width:0%;"></div>
            </div>
            <span id="uidCounter" class="uh-counter">0 / 20</span>
        </div>
    </div>
</div>

@* ── کارت نتایج ── *@
<div class="a-card">
    <div class="a-card-header">
        <h6><i class="fa fa-history" style="color:#1d6fb8;"></i> تاریخچه UID</h6>
    </div>
    <div class="a-card-body" style="padding:16px;">
        <div class="lines-table-wrap">
            <table class="lines-table" id="historyTable">
                <thead>
                    <tr>
                        <th style="width:60px;">ردیف</th>
                        <th style="width:150px;">تاریخ</th>
                        <th>توضیحات</th>
                    </tr>
                </thead>
                <tbody id="historyTbody">
                    <tr>
                        <td colspan="3" style="padding:24px;color:#9ca3af;text-align:center;">
                            <i class="fa fa-search" style="display:block;font-size:24px;margin-bottom:8px;"></i>
                            برای مشاهده تاریخچه، UID مورد نظر را جستجو کنید
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var searchUrl = '@Url.Action("Search", "UidHistory")';
    </script>
    <script src="~/js/components/UidHistory/uid-history.js" asp-append-version="true"></script>
}