@using VSSM.Presentation.Web.Models.Base
@model GridViewModel

@section Styles {
    <link href="~/css/components/shared/grid-wrapper.css" rel="stylesheet" />
    <link href="~/css/components/shared/grid-header.css" rel="stylesheet" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" />
    <link href="~/css/components/shared/uid-modal.css" rel="stylesheet" />
}

@{
    ViewData["Title"] = "مدیریت کاربران";
}

@if (TempData["ToastMessage"] != null)
{
    <script>
        $(document).ready(function() {
            var message = @System.Text.Json.JsonSerializer.Serialize(TempData["ToastMessage"]);
            var type = '@TempData["ToastType"]';
            toastService.show(message, type);
        });
    </script>
}

<div class="grid-wrapper">
    <div class="grid-header" style="direction:rtl;">

        <strong style="font-size:1.4rem; font-weight:600; color:#111827;">
            @ViewData["Title"]
        </strong>

        <div class="d-flex align-items-center gap-2">

            <form method="get" class="m-0">
                <input type="hidden" name="sortField" value="@Model.CurrentSort" />
                <input type="hidden" name="sortOrder" value="@Model.CurrentDirection" />
                <input type="hidden" name="pageSize" value="@Model.Data.PageSize" />

                <div class="search-wrap">
                    <div class="search-divider"></div>
                    <input type="text" name="search" class="search-input"
                           value="@Model.SearchTerm" placeholder="جستجو..." />
                    <button type="submit" class="search-btn" title="جستجو">
                        <i class="fa fa-search"></i>
                    </button>
                </div>
            </form>

            <a asp-action="New" class="btn-add">
                <span class="plus-circle">+</span>
                افزودن
            </a>

        </div>
    </div>

    <div>
        @await Html.PartialAsync("_DynamicGrid", Model)
    </div>

    <div class="uid-modal-overlay" id="changePasswordModal">
        <div class="uid-modal" id="changePasswordModalContent">
        </div>
    </div>

    <div class="uid-modal-overlay" id="toggleActivationModal">
        <div class="uid-modal">
            <div class="uid-modal-header">
                <h6>
                    <i class="fa fa-exclamation-triangle" id="toggleModalIcon" style="color:#dc2626;"></i>
                    <span id="toggleModalTitle">تایید حذف</span>
                </h6>
                <button type="button" class="uid-modal-close" onclick="closeToggleModal()">✕</button>
            </div>
            <div class="uid-modal-body">
                <p id="toggleModalMessage" style="font-size:14px; line-height:1.6; margin:0;">
                    آیا از حذف این کاربر اطمینان دارید؟
                </p>
            </div>
            <div class="uid-modal-header" style="justify-content:flex-end;gap:8px;border-top:1px solid #e5e7eb;border-bottom:none;">
                <button type="button" class="btn-back" onclick="closeToggleModal()" style="padding:6px 16px;font-size:13px;">
                    انصراف
                </button>
                <button type="button" class="btn-confirm" id="toggleConfirmSubmit" style="padding:6px 16px;font-size:13px;">
                    <i class="fa fa-trash" id="toggleConfirmIcon"></i>
                    <span id="toggleConfirmText">حذف</span>
                </button>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(function () {
            var pendingDeleteForm = null;

            var token = $('input[name="__RequestVerificationToken"]').val();
            if (!token) {
                token = $('form').first().find('input[name="__RequestVerificationToken"]').val();
            }

            $(document).on("click", ".open-modal", function (e) {
                e.preventDefault();
                const url = $(this).data("url");
                $("#changePasswordModalContent").load(url, function () {
                    $('#changePasswordModal').addClass('open');
                });
            });

            $(document).on("click", "#changePasswordModal", function (e) {
                if ($(e.target).is("#changePasswordModal")) {
                    $('#changePasswordModal').removeClass('open');
                }
            });

            $(document).on("click", ".delete-user", function (e) {
                e.preventDefault();
                var form = $(this).closest("form");

                if (form.find('input[name="__RequestVerificationToken"]').length === 0 && token) {
                    form.append('<input type="hidden" name="__RequestVerificationToken" value="' + token + '" />');
                }

                pendingDeleteForm = form;

                var isActivation = $(this).find(".fa-check").length > 0;

                var $icon = $("#toggleModalIcon");
                var $title = $("#toggleModalTitle");
                var $message = $("#toggleModalMessage");
                var $confirmBtn = $("#toggleConfirmSubmit");
                var $confirmIcon = $("#toggleConfirmIcon");
                var $confirmText = $("#toggleConfirmText");

                if (isActivation) {
                    $icon.attr("class", "fa fa-check-circle").css("color", "#16a34a");
                    $title.text("تایید فعالسازی");
                    $message.text("آیا از فعال کردن این کاربر اطمینان دارید؟");
                    $confirmIcon.attr("class", "fa fa-check");
                    $confirmText.text("فعال کردن");
                    $confirmBtn.css({ background: "", border: "", color: "" });
                } else {
                    $icon.attr("class", "fa fa-exclamation-triangle").css("color", "#dc2626");
                    $title.text("تایید حذف");
                    $message.text("آیا از حذف این کاربر اطمینان دارید؟");
                    $confirmIcon.attr("class", "fa fa-trash");
                    $confirmText.text("حذف");
                    $confirmBtn.css({
                        background: "#dc2626",
                        border: "2px solid #b91c1c",
                        color: "#fff"
                    });
                }

                $("#toggleActivationModal").addClass("open");
            });

            $(document).on("click", "#toggleActivationModal", function (e) {
                if ($(e.target).is("#toggleActivationModal")) {
                    $("#toggleActivationModal").removeClass("open");
                }
            });

            window.closeChangePasswordModal = function () {
                $('#changePasswordModal').removeClass('open');
            };

            window.closeToggleModal = function () {
                $("#toggleActivationModal").removeClass("open");
            };

            $("#toggleConfirmSubmit").on("click", function () {
                if (pendingDeleteForm) {
                    pendingDeleteForm.submit();
                }
                $("#toggleActivationModal").removeClass("open");
            });
        });
    </script>
}