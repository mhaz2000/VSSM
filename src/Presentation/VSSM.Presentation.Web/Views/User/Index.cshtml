@using VSSM.Application.DTOs.BaseEntities.User
@model PagingSearchOrderDto<UserGetDto>

@{
    ViewData["Title"] = "مدیریت کاربران";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-block">

                <div class="col-lg-3">
                    <h5> مدیریت کاربران </h5>
                </div>

                <div class="col-lg-4"></div>

                <form method="get">
                    <div class="col-lg-4">
                        <div class="input-group">
                            <input type="text"
                                   name="search"
                                   value="@Model.SearchText"
                                   class="form-control"
                                   placeholder="جستجو (نام، نام خانوادگی، گیرنده...)" />

                            <div class="input-group-btn">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-search"></i> جستجو
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="col-lg-1">
                    <a asp-controller="User"
                       asp-action="New"
                       class="btn btn-success">
                        <i class="fa fa-plus-circle"></i> جدید
                    </a>
                </div>

            </div>
        </div>


        <div class="row mt-2">
            <div class="col-lg-12">

                <div class="card">
                    <div class="card-block">

                        <table class="table table-bordered table-striped text-center">
                            <thead>
                                <tr>
                                    <th><a href="?sortField=UserName&sortOrder=@(Model.SortOrder == "asc" ? "desc" : "asc")">نام کاربری</a></th>
                                    <th>نام</th>
                                    <th>نام خانوادگی</th>
                                    <th>تلفن</th>
                                    <th>فکس</th>
                                    <th>گیرنده</th>
                                    <th>شغل</th>
                                    <th>عملیات</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model.Items.Any())
                                {
                                    foreach (var u in Model.Items)
                                    {
                                        <tr>
                                            <td>@u.UserName</td>
                                            <td>@u.FirstName</td>
                                            <td>@u.LastName</td>
                                            <td>@u.Phone1</td>
                                            <td>@u.Phone2</td>
                                            <td>@u.RecipientName</td>
                                            <td>@u.JobName</td>

                                            <td>
                                                <a class="btn btn-primary btn-sm"
                                                   asp-action="New"
                                                   asp-route-id="@u.UserId">
                                                    ویرایش
                                                </a>


                                                <a asp-controller="User"
                                                   asp-action="Delete"
                                                   asp-route-id="@u.UserId"
                                                   class="btn btn-danger btn-sm"
                                                   onclick="return confirm('آیا مطمئن هستید؟');">
                                                    حذف
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-danger">داده‌ای یافت نشد</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <nav>
                            <ul class="pagination">

                                <li class="page-item @(Model.Paging.Page == 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?page=@(Model.Paging.Page - 1)&search=@Model.SearchText">
                                        قبلی
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.Paging.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.Paging.Page ? "active" : "")">
                                        <a class="page-link"
                                           href="?page=@i&search=@Model.SearchText">@i</a>
                                    </li>
                                }

                                <li class="page-item @(Model.Paging.Page == Model.Paging.TotalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?page=@(Model.Paging.Page + 1)&search=@Model.SearchText">
                                        بعدی
                                    </a>
                                </li>

                            </ul>
                        </nav>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>
