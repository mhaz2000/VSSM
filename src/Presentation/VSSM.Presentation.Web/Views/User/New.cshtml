@using VSSM.Presentation.Web.Models.Base
@using VSSM.Presentation.Web.Models.User
@model UserViewModel

@{
    var isNewUser = Model.UserId == null || Model.UserId == 0;
    string formName = isNewUser ? "ثبت کاربر جدید" : "ویرایش کاربر";
    var serverMsg = TempData["ToastMessage"]?.ToString();
    var serverType = TempData["ToastType"]?.ToString();
    TempData.Remove("ToastMessage");
    TempData.Remove("ToastType");
    var recipients = ViewBag.RecipientList as List<SelectListItem>;
}

@section Styles {
    <link href="~/css/components/shared/a-card.css" rel="stylesheet" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" />
    <link href="~/css/components/shared/toast.css" rel="stylesheet" />
    <link href="~/css/components/user/user-form.css" rel="stylesheet" />

    <style>
        .admin-checkbox-wrapper {
            display: flex;
            align-items: center;
            margin: 2.2rem 0px;
            gap: 1rem;
        }

        .password-hint {
            font-size: 12px;
            color: #6b7280;
            margin-top: 4px;
        }

        .text-danger {
            color: #dc2626;
            font-size: 12px;
            display: block;
            margin-top: 4px;
        }

        .field-validation-error {
            color: #dc2626;
            font-size: 12px;
            display: block;
            margin-top: 4px;
        }

        .input-validation-error {
            border-color: #dc2626 !important;
        }

            .input-validation-error:focus {
                border-color: #dc2626 !important;
                box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1) !important;
            }

        .f-group {
            margin-bottom: 0.5rem;
        }
    </style>
}

<div class="user-form-wrap">
    <div id="toastContainer"></div>
    <strong class="user-form-title">@formName</strong>

    <form asp-action="Create" method="post" style="margin-top: 1rem;" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />

        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:1rem;"></div>

        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-user" style="color:#1d6fb8;"></i>
                <h6>اطلاعات کاربری</h6>
            </div>
            <div class="a-card-body">
                <div class="fg-3">
                    <div class="f-group">
                        <label class="f-label">نام کاربری <span class="req-tag">اجباری</span></label>
                        <input asp-for="UserName" class="f-control" />
                        <span asp-validation-for="UserName" class="field-validation-error"></span>
                    </div>
                    <div class="f-group">
                        <label class="f-label">نام <span class="req-tag">اجباری</span></label>
                        <input asp-for="FirstName" class="f-control" />
                        <span asp-validation-for="FirstName" class="field-validation-error"></span>
                    </div>
                    <div class="f-group">
                        <label class="f-label">نام خانوادگی <span class="req-tag">اجباری</span></label>
                        <input asp-for="LastName" class="f-control" />
                        <span asp-validation-for="LastName" class="field-validation-error"></span>
                    </div>
                    <div class="f-group">
                        <label class="f-label">ایمیل</label>
                        <input asp-for="Email" class="f-control" />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-phone" style="color:#16a34a;"></i>
                <h6>اطلاعات تماس</h6>
            </div>
            <div class="a-card-body">
                <div class="fg-3">
                    <div class="f-group">
                        <label class="f-label">تلفن</label>
                        <input asp-for="Phone1" class="f-control" />
                        <span asp-validation-for="Phone1" class="field-validation-error"></span>
                    </div>
                    <div class="f-group">
                        <label class="f-label">فکس</label>
                        <input asp-for="Phone2" class="f-control" />
                        <span asp-validation-for="Phone2" class="field-validation-error"></span>
                    </div>
                    <div class="f-group">
                        <label class="f-label">شماره شناسنامه</label>
                        <input asp-for="Idnumber" class="f-control" />
                        <span asp-validation-for="Idnumber" class="field-validation-error"></span>
                    </div>
                </div>
            </div>
        </div>

        @if (isNewUser)
        {
            <div class="a-card">
                <div class="a-card-header">
                    <i class="fa fa-lock" style="color:#dc2626;"></i>
                    <h6>تنظیمات گذرواژه</h6>
                </div>
                <div class="a-card-body">
                    <div class="fg-3">
                        <div class="f-group">
                            <label class="f-label">گذرواژه <span class="req-tag">اجباری</span></label>
                            <input asp-for="Password" type="password" class="f-control" />
                            <div class="password-hint">
                                <i class="fa fa-info-circle"></i>
                                حداقل ۸ کاراکتر، شامل حروف بزرگ، حروف کوچک، عدد و کاراکتر ویژه
                            </div>
                            <span asp-validation-for="Password" class="field-validation-error"></span>
                        </div>
                        <div class="f-group">
                            <label class="f-label">تکرار گذرواژه <span class="req-tag">اجباری</span></label>
                            <input asp-for="ConfirmPassword" type="password" class="f-control" />
                            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-briefcase" style="color:#8b5cf6;"></i>
                <h6>اطلاعات شغلی و دسترسی</h6>
            </div>
            <div class="a-card-body">
                <div class="fg-3">
                    <div class="f-group">
                        <label class="f-label">گیرنده</label>

                        @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect", new SearchableSelectModel
                        {
                            Id = "RecipientId",
                                                Name = "RecipientId",
                                                DefaultText = "جستجوی گیرنده...",
                                                Label = "",
                                                IsRequired = true,
                                                SelectedValue = Model?.RecipientId?.ToString(),
                                                ValidationMessage = "گیرنده نمی‌تواند خالی باشد.",
                                                Options = recipients.Select(r => new SelectOption
                                                {
                                                    Value = r.Value.ToString(),
                                                    Text = r.Text
                                                }).ToList()
                                                })
                        <span asp-validation-for="RecipientId" class="field-validation-error"></span>
                    </div>
                    <div class="f-group">
                        <label class="f-label">تحصیلات</label>
                        <select asp-for="CodeEdu" class="f-control" asp-items="ViewBag.EduList">
                            <option value="">انتخاب کنید...</option>
                        </select>
                        <span asp-validation-for="CodeEdu" class="field-validation-error"></span>
                    </div>
                    <div class="f-group">
                        <label class="f-label">شغل</label>
                        <select asp-for="CodeJob" class="f-control" asp-items="ViewBag.JobList">
                            <option value="">انتخاب کنید...</option>
                        </select>
                        <span asp-validation-for="CodeJob" class="field-validation-error"></span>
                    </div>
                    <div class="f-group">
                        <label class="f-label">نقش <span class="req-tag">اجباری</span></label>
                        <select asp-for="RoleId" class="f-control" asp-items="ViewBag.Roles">
                            <option value="">انتخاب کنید...</option>
                        </select>
                        <span asp-validation-for="RoleId" class="field-validation-error"></span>
                    </div>
                    <div class="f-group">
                        <label class="f-label">دوره آموزشی</label>
                        <input asp-for="Course" class="f-control" />
                        <span asp-validation-for="Course" class="field-validation-error"></span>
                    </div>
                    <div class="settings-item">
                        <input type="checkbox" asp-for="IsAdmin" id="IsAdmin" />
                        <label for="IsAdmin">مدیر سیستم</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-footer a-card">
            <a asp-action="Index" class="btn-back">
                <i class="fa fa-arrow-right"></i> بازگشت
            </a>
            <button type="submit" class="btn-confirm">
                <i class="fa fa-save"></i> ثبت
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/shared/toast.js"></script>
    <script>
        var serverMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(serverMsg ?? ""));
        var serverType = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(serverType ?? "info"));
        var isNewUser = @(isNewUser ? "true" : "false");

        $(function () {
            if (serverMsg) {
                showToast(serverMsg, serverType);
            }

            function trimOnBlur(selector) {
                $(selector).on('blur', function () {
                    var val = $(this).val();
                    if (val) {
                        $(this).val(val.trim());
                    }
                });
            }

            trimOnBlur('#UserName');
            trimOnBlur('#FirstName');
            trimOnBlur('#LastName');
            trimOnBlur('#Email');
            trimOnBlur('#Phone1');
            trimOnBlur('#Phone2');
            trimOnBlur('#Idnumber');
            trimOnBlur('#Course');

            $('form').on('submit', function () {
                $(this).find('input[type="text"], input[type="email"], input[type="tel"]').each(function () {
                    var val = $(this).val();
                    if (val) {
                        $(this).val(val.trim());
                    }
                });
            });

            $('#UserName, #FirstName, #LastName').on('keypress', function (e) {
                if (e.key === ' ') {
                    var caretPos = this.selectionStart;
                    if (caretPos === 0 || $(this).val().length === 0) {
                        e.preventDefault();
                    }
                }
            });

            if (isNewUser) {
                function validatePassword() {
                    var password = $('#Password').val();
                    var confirm = $('#ConfirmPassword').val();

                    $('#Password, #ConfirmPassword').css('border-color', '');

                    if (password && password.length < 8) {
                        $('#Password').css('border-color', '#dc2626');
                    } else if (password && password.length >= 8) {
                        $('#Password').css('border-color', '#22c55e');
                    }

                    if (confirm && password !== confirm) {
                        $('#ConfirmPassword').css('border-color', '#dc2626');
                    } else if (confirm && password === confirm && password.length >= 8) {
                        $('#ConfirmPassword').css('border-color', '#22c55e');
                    }
                }

                $('#Password, #ConfirmPassword').on('input', validatePassword);

                $('form').on('submit', function (e) {
                    var password = $('#Password').val();
                    var confirm = $('#ConfirmPassword').val();

                    if (!password) {
                        e.preventDefault();
                        showToast('گذرواژه الزامی است.', 'error');
                        return false;
                    }

                    if (password.length < 8) {
                        e.preventDefault();
                        showToast('گذرواژه باید حداقل ۸ کاراکتر باشد.', 'error');
                        return false;
                    }

                    if (password !== confirm) {
                        e.preventDefault();
                        showToast('گذرواژه و تکرار آن مطابقت ندارند.', 'error');
                        return false;
                    }
                });
            }

            $('.field-validation-error').each(function () {
                var parent = $(this).closest('.f-group');
                if ($(this).text().trim() !== '') {
                    parent.find('.f-control, select').addClass('input-validation-error');
                }
            });
        });
    </script>
}