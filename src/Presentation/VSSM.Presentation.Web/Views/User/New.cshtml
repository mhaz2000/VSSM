@model UserViewModel

@{
    string formName = Model.UserId > 0 ? "ویرایش کاربر" : "ثبت کاربر جدید";
}

<style>
    .form-label {
        width: 130px;
        margin-left: 15px;
        text-align: left;
    }

    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
        direction: rtl;
    }

    .form-check {
        margin-right: 30px !important;
    }

    .card {
        direction: rtl;
    }
</style>

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-block">
                <div class="col-lg-3">
                    <h5>@formName</h5>
                </div>
            </div>
        </div>

        <div class="card mt-2">
            <div class="card-block">

                <form asp-action="Create" method="post" class="form-horizontal">

                    <input type="hidden" asp-for="UserId" />

                    <div class="col-lg-6">

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- Username -->
                        <div class="form-group">
                            <label class="form-label">نام کاربری:</label>
                            <input asp-for="UserName" class="form-control bg-warning-subtle" />
                        </div>

                        <!-- Password -->
                        <div class="form-group">
                            <label class="form-label">کلمه عبور:</label>
                            <input asp-for="Password" type="password" class="form-control bg-warning-subtle" />
                        </div>

                        <!-- First Name -->
                        <div class="form-group">
                            <label class="form-label">نام:</label>
                            <input asp-for="FirstName" class="form-control bg-warning-subtle" />
                        </div>

                        <!-- Last Name -->
                        <div class="form-group">
                            <label class="form-label">نام خانوادگی:</label>
                            <input asp-for="LastName" class="form-control bg-warning-subtle" />
                        </div>

                        <!-- Email -->
                        <div class="form-group">
                            <label class="form-label">ایمیل:</label>
                            <input asp-for="Email" class="form-control" />
                        </div>

                        <!-- Phone 1 -->
                        <div class="form-group">
                            <label class="form-label">تلفن:</label>
                            <input asp-for="Phone1" class="form-control" />
                        </div>

                        <!-- Phone 2 -->
                        <div class="form-group">
                            <label class="form-label">فکس:</label>
                            <input asp-for="Phone2" class="form-control" />
                        </div>

                        <!-- Identity Number -->
                        <div class="form-group">
                            <label class="form-label">شماره شناسنامه:</label>
                            <input asp-for="Idnumber" class="form-control" />
                        </div>

                  @*       <!-- Recipient -->
                        <div class="form-group">
                            <label class="form-label">گیرنده:</label>
                            <select asp-for="RecipientId" class="form-select" asp-items="ViewBag.RecipientList"></select>
                        </div> *@

                        <!-- EduType -->
                        <div class="form-group">
                            <label class="form-label">تحصیلات:</label>
                            <select asp-for="CodeEdu" class="form-select" asp-items="ViewBag.EduList"></select>
                        </div>

                        <!-- JobType -->
                        <div class="form-group">
                            <label class="form-label">شغل:</label>
                            <select asp-for="CodeJob" class="form-select" asp-items="ViewBag.JobList"></select>
                        </div>

                        <!-- Permission Level -->
                        <div class="form-group">
                            <label class="form-label">سطح دسترسی:</label>
                            <select asp-for="PermissionLevel" class="form-select" asp-items="ViewBag.PermissionList"></select>
                        </div>

                        <!-- Is Admin -->
                        <div class="form-group">
                            <label class="form-label">مدیر سیستم:</label>
                            <div class="form-check">
                                <input type="checkbox" asp-for="IsAdmin" class="form-check-input" />
                                <label class="form-check-label">فعال</label>
                            </div>
                        </div>

                        <!-- Course -->
                        <div class="form-group">
                            <label class="form-label">دوره آموزشی:</label>
                            <input asp-for="Course" class="form-control" />
                        </div>

                        <!-- Persian Date -->
                        <div class="form-group">
                            <label class="form-label">تاریخ دوره:</label>

                            <select asp-for="CourseDate.EntryYear" class="form-select" style="width: 90px; margin-left:5px;">
                                <option value="">سال</option>
                                @for (int y = 1350; y <= 1410; y++)
                                {
                                    <option value="@y">@y</option>
                                }
                            </select>

                            <select asp-for="CourseDate.EntryMonth" class="form-select" style="width: 80px; margin-left:5px;">
                                <option value="">ماه</option>
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m">@m</option>
                                }
                            </select>

                            <select asp-for="CourseDate.EntryDay" class="form-select" style="width: 80px;">
                                <option value="">روز</option>
                                @for (int d = 1; d <= 31; d++)
                                {
                                    <option value="@d">@d</option>
                                }
                            </select>

                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-success px-5">ثبت</button>
                            <a asp-action="Index" class="btn btn-primary px-5">لیست</a>
                        </div>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

<partial name="_ValidationScriptsPartial" />
