@using VSSM.Presentation.Web.Models.Base
@model UserViewModel

@{
    string formName = Model.UserId > 0 ? "ویرایش کاربر" : "ثبت کاربر جدید";
    var serverMsg = TempData["ToastMessage"]?.ToString();
    var serverType = TempData["ToastType"]?.ToString();
    TempData.Remove("ToastMessage");
    TempData.Remove("ToastType");
    var recipients = ViewBag.RecipientList as List<SelectListItem>;

}

@section Styles {
    <link href="~/css/components/shared/a-card.css" rel="stylesheet" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" />
    <link href="~/css/components/shared/toast.css" rel="stylesheet" />
    <link href="~/css/components/user/user-form.css" rel="stylesheet" />

    <style>
        .admin-checkbox-wrapper {
            display: flex;
            align-items: center;
            margin: 2.2rem 0px;
            gap: 1rem;
        }

    </style>
}



<div class="user-form-wrap">
    <div id="toastContainer"></div>
    <strong class="user-form-title">@formName</strong>

    <form asp-action="Create" method="post" style="margin-top: 1rem;" novalidate>
        <input type="hidden" asp-for="UserId" />

        <!-- اطلاعات کاربری -->
        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-user" style="color:#1d6fb8;"></i>
                <h6>اطلاعات کاربری</h6>
            </div>
            <div class="a-card-body">
                <div class="fg-3">
                    <div class="f-group">
                        <label class="f-label">نام کاربری <span class="req-tag">اجباری</span></label>
                        <input asp-for="UserName" class="f-control" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">نام <span class="req-tag">اجباری</span></label>
                        <input asp-for="FirstName" class="f-control" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">نام خانوادگی <span class="req-tag">اجباری</span></label>
                        <input asp-for="LastName" class="f-control" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">ایمیل</label>
                        <input asp-for="Email" class="f-control" />
                    </div>
                </div>
            </div>
        </div>

        <!-- اطلاعات تماس -->
        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-phone" style="color:#16a34a;"></i>
                <h6>اطلاعات تماس</h6>
            </div>
            <div class="a-card-body">
                <div class="fg-3">
                    <div class="f-group">
                        <label class="f-label">تلفن</label>
                        <input asp-for="Phone1" class="f-control" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">فکس</label>
                        <input asp-for="Phone2" class="f-control" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">شماره شناسنامه</label>
                        <input asp-for="Idnumber" class="f-control" />
                    </div>
                </div>
            </div>
        </div>

        <!-- اطلاعات شغلی و دسترسی -->
        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-briefcase" style="color:#8b5cf6;"></i>
                <h6>اطلاعات شغلی و دسترسی</h6>
            </div>
            <div class="a-card-body">
                <div class="fg-3">
                    <div class="f-group">
                        <label class="f-label">گیرنده</label>

                        @await Html.PartialAsync("Components/SearchableSelect/_SearchableSelect", new SearchableSelectModel
                        {
                            Id = "RecipientId",
                            Name = "RecipientId",
                            DefaultText = "جستجوی گیرنده...",
                            Label = "",
                            IsRequired = true,
                            SelectedValue = Model?.RecipientId?.ToString(),
                            ValidationMessage = "گیرنده نمی‌تواند خالی باشد.",
                            Options = recipients.Select(r => new SelectOption
                            {
                                Value = r.Value.ToString(),
                                Text = r.Text
                            }).ToList()
                        })

                    </div>
                    <div class="f-group">
                        <label class="f-label">تحصیلات</label>
                        <select asp-for="CodeEdu" class="f-control" asp-items="ViewBag.EduList">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label">شغل</label>
                        <select asp-for="CodeJob" class="f-control" asp-items="ViewBag.JobList">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label">نقش <span class="req-tag">اجباری</span></label>
                        <select asp-for="RoleId" class="f-control" asp-items="ViewBag.Roles">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label">دوره آموزشی</label>
                        <input asp-for="Course" class="f-control" />
                    </div>
                    <div class="admin-checkbox-wrapper">
                        <label class="f-label">مدیر سیستم</label>
                        <div>
                            <label class="checkbox-label">
                                <input type="checkbox" asp-for="IsAdmin" />
                                فعال
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- فوتر -->
        <div class="form-footer a-card">
            <a asp-action="Index" class="btn-back">
                <i class="fa fa-arrow-right"></i> بازگشت
            </a>
            <button type="submit" class="btn-confirm">
                <i class="fa fa-save"></i> ثبت
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/shared/toast.js"></script>
    <script>
        var serverMsg  = "@(serverMsg ?? "")";
        var serverType = "@(serverType ?? "info")";

        $(function () {
        if (serverMsg) {
        showToast(serverMsg, serverType);
        }
        });
    </script>
}
