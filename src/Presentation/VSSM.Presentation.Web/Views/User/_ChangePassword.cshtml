@using VSSM.Presentation.Web.Models.User
@model ChangePasswordViewModel

<div class="uid-modal-header">
    <h6><i class="fa fa-key" style="color:#1d6fb8;"></i> تغییر رمز عبور</h6>
    <button type="button" class="uid-modal-close" onclick="closeChangePasswordModal()">✕</button>
</div>

<form asp-action="ChangePassword"
      asp-controller="User"
      method="post">

    <input asp-for="UserId" type="hidden" />

    <div class="uid-modal-body">

        <div class="f-group" style="margin-bottom:14px;">
            <label class="f-label" asp-for="NewPassword">کلمه عبور جدید <span class="req-tag">اجباری</span></label>
            <input asp-for="NewPassword" class="f-control" type="password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="f-group" style="margin-bottom:14px;">
            <label class="f-label" asp-for="ConfirmPassword">تکرار کلمه عبور <span class="req-tag">اجباری</span></label>
            <input asp-for="ConfirmPassword" class="f-control" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

    </div>

    <div class="uid-modal-header" style="justify-content:flex-end;gap:8px;border-top:1px solid #e5e7eb;border-bottom:none;">
        <button type="button" class="btn-back" onclick="closeChangePasswordModal()" style="padding:6px 16px;font-size:13px;">
            انصراف
        </button>
        <button type="submit" class="btn-confirm" style="padding:6px 16px;font-size:13px;">
            <i class="fa fa-save"></i> ذخیره
        </button>
    </div>

</form>

<script>
    function validatePassword(password) {
        return /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z\d]).{8,}$/.test(password);
    }

    $(document).ready(function() {
        $('form').on('submit', function(e) {
            $('.text-danger').empty();
            $('.is-invalid').removeClass('is-invalid');

            var password = $('#NewPassword').val();
            var confirm = $('#ConfirmPassword').val();
            var isValid = true;

            if (!password || password.trim() === '') {
                e.preventDefault();
                isValid = false;
                $('#NewPassword').addClass('is-invalid');
                $('#NewPassword').siblings('.text-danger').text('کلمه عبور جدید نمی‌تواند خالی باشد.');
            } else if (!validatePassword(password)) {
                e.preventDefault();
                isValid = false;
                $('#NewPassword').addClass('is-invalid');
                $('#NewPassword').siblings('.text-danger').text('کلمه عبور باید حداقل ۸ کاراکتر و شامل حروف بزرگ، حروف کوچک، عدد و کاراکتر ویژه باشد.');
            }

            if (!confirm || confirm.trim() === '') {
                e.preventDefault();
                isValid = false;
                $('#ConfirmPassword').addClass('is-invalid');
                $('#ConfirmPassword').siblings('.text-danger').text('تکرار کلمه عبور نمی‌تواند خالی باشد.');
            }

            if (password && confirm && password !== confirm) {
                e.preventDefault();
                isValid = false;
                $('#ConfirmPassword').addClass('is-invalid');
                $('#ConfirmPassword').siblings('.text-danger').text('کلمه عبور و تکرار آن یکسان نیست.');
            }

            return isValid;
        });

        $('#NewPassword, #ConfirmPassword').on('input', function() {
            if ($(this).val() && $(this).val().trim() !== '') {
                $(this).removeClass('is-invalid');
                $(this).siblings('.text-danger').empty();
            }
        });
    });
</script>
