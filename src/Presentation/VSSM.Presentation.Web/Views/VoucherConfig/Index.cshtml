@model VSSM.Application.DTOs.BaseEntities.VoucherConfig.VoucherConfigDto

@{
    ViewData["Title"] = "تنظیمات چاپ ووچر و فاکتور";
}

@section Styles {
    <link href="~/css/components/shared/a-card.css" rel="stylesheet" />
    <link href="~/css/components/shared/f-control.css" rel="stylesheet" />
    <link href="~/css/components/shared/btn.css" rel="stylesheet" />
    <link href="~/css/components/shared/toast.css" rel="stylesheet" />
    <link href="~/css/pages/voucher/voucher-config.css" rel="stylesheet" />
}

<div class="voucher-config-wrap">
    <div class="item-page-title">
        <i class="fa fa-gear" style="color:#1d6fb8;"></i>
        @ViewData["Title"]
    </div>

    <form asp-action="Edit" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div class="a-card">
            <div class="a-card-header">
                <i class="fa fa-sliders-h" style="color:#1d6fb8;"></i>
                <h6>فیلدهای نمایش داده شده در ووچر و فاکتور</h6>
            </div>

            <div class="a-card-body">
                <div class="voucher-info-text">
                    <i class="fa fa-info-circle"></i>
                    فیلدهایی که انتخاب می‌کنید در ووچر و فاکتور نمایش داده می‌شوند.
                    فیلدهای <strong>قرمز</strong> اجباری هستند و قابل تغییر نمی‌باشند.
                </div>

                <div class="voucher-wrapper">
                    <div class="voucher-section-title">
                        <i class="fa fa-header"></i>
                        سربرگ
                    </div>
                    <div class="voucher-grid">
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowRequestNumber" />
                            <label asp-for="ShowRequestNumber">شماره درخواست</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowTransportMode" />
                            <label asp-for="ShowTransportMode">طریقه حمل و نقل</label>
                        </div>
                    </div>

                    <div class="voucher-section-title" style="margin-top: 1.25rem;">
                        <i class="fa fa-box"></i>
                        جزئیات کالاها
                    </div>
                    <div class="voucher-grid">
                        <div class="voucher-item required">
                            <input type="checkbox" asp-for="ShowItem" checked disabled />
                            <input type="hidden" asp-for="ShowItem" value="true" />
                            <label asp-for="ShowItem">کالا</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowManufacturer" />
                            <label asp-for="ShowManufacturer">سازنده</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowItemCode" />
                            <label asp-for="ShowItemCode">کد</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowPresentation" />
                            <label asp-for="ShowPresentation">Presentation Type</label>
                        </div>
                        <div class="voucher-item required">
                            <input type="checkbox" asp-for="ShowBatchNumber" checked disabled />
                            <input type="hidden" asp-for="ShowBatchNumber" value="true" />
                            <label asp-for="ShowBatchNumber">سری ساخت</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowExpiryDate" />
                            <label asp-for="ShowExpiryDate">تاریخ انقضا</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowPackingType" />
                            <label asp-for="ShowPackingType">نوع بسته‌بندی</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowPackageSize" />
                            <label asp-for="ShowPackageSize">سایز بسته‌بندی</label>
                        </div>
                        <div class="voucher-item required">
                            <input type="checkbox" asp-for="ShowQuantity" checked disabled />
                            <input type="hidden" asp-for="ShowQuantity" value="true" />
                            <label asp-for="ShowQuantity">دوز / تعداد</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowDoseVial" />
                            <label asp-for="ShowDoseVial">دوز ویال</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowNumberOfVials" />
                            <label asp-for="ShowNumberOfVials">تعداد ویال</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowStore" />
                            <label asp-for="ShowStore">نام انبار</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowNotesLine" />
                            <label asp-for="ShowNotesLine">ملاحظات (سطر کالا)</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowUnitPrice" />
                            <label asp-for="ShowUnitPrice">مبلغ واحد</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowTotalPriceLine" />
                            <label asp-for="ShowTotalPriceLine">مبلغ کل (سطر کالا)</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowVvmtype" />
                            <label asp-for="ShowVvmtype">نوع VVM</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowVvmstage" />
                            <label asp-for="ShowVvmstage">مرحله VVM</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowStageDelivery" />
                            <label asp-for="ShowStageDelivery">Deliver VVM Stage</label>
                        </div>
                    </div>

                    <div class="voucher-section-title" style="margin-top: 1.25rem;">
                        <i class="fa fa-truck"></i>
                        جزئیات محموله ارسالی
                    </div>
                    <div class="voucher-grid">
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowTotalPrice" />
                            <label asp-for="ShowTotalPrice">مبلغ کل (محموله)</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowTotalWeight" />
                            <label asp-for="ShowTotalWeight">وزن کل</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowTotalVolume" />
                            <label asp-for="ShowTotalVolume">حجم کل</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowTotalExternalSize" />
                            <label asp-for="ShowTotalExternalSize">حجم کل خارجی</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowPacksNumber" />
                            <label asp-for="ShowPacksNumber">تعداد کل بسته‌ها</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowNotes" />
                            <label asp-for="ShowNotes">ملاحظات (محموله)</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowSource" />
                            <label asp-for="ShowSource">منابع</label>
                        </div>
                        <div class="voucher-item">
                            <input type="checkbox" asp-for="ShowIndicator" />
                            <label asp-for="ShowIndicator">Freeze Indicator</label>
                        </div>
                    </div>

                    <div class="voucher-section-title" style="margin-top: 1.25rem;">
                        <i class="fa fa-pen"></i>
                        محل امضا
                    </div>
                    <div class="voucher-grid" style="grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));">
                        <div class="voucher-item" style="grid-column: 1 / -1; padding: 0.5rem 0;">
                            <div class="f-group" style="width: 100%;">
                                <label asp-for="FooterNotes" class="f-label">توضیحات انتهای فاکتور</label>
                                <textarea asp-for="FooterNotes" class="f-control" rows="3" placeholder="متن توضیحات در انتهای فاکتور"></textarea>
                            </div>
                        </div>
                        <div class="voucher-item" style="grid-column: 1 / -1; padding: 0.5rem 0;">
                            <div class="fg-2" style="width: 100%;">
                                <div class="f-group">
                                    <label class="f-label">عنوان جایگاه امضا ۱</label>
                                    <input asp-for="SignPlaceHolder1" class="f-control" placeholder="امضا ۱" />
                                </div>
                                <div class="f-group">
                                    <label class="f-label">عنوان جایگاه امضا ۲</label>
                                    <input asp-for="SignPlaceHolder2" class="f-control" placeholder="امضا ۲" />
                                </div>
                                <div class="f-group">
                                    <label class="f-label">عنوان جایگاه امضا ۳</label>
                                    <input asp-for="SignPlaceHolder3" class="f-control" placeholder="امضا ۳" />
                                </div>
                                <div class="f-group">
                                    <label class="f-label">عنوان جایگاه امضا ۴</label>
                                    <input asp-for="SignPlaceHolder4" class="f-control" placeholder="امضا ۴" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-footer" style="justify-content:flex-end;">
                <button type="submit" class="btn-confirm">
                    <i class="fa fa-save"></i>
                    ذخیره تنظیمات
                </button>
            </div>
        </div>
    </form>
</div>

<div id="toastContainer"></div>

<partial name="_ValidationScriptsPartial" />

@section Scripts {
    <script src="~/js/components/shared/toast.js"></script>
    <script src="~/js/pages/voucher/voucher-config.js"></script>
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            showToast('@TempData["SuccessMessage"]', 'success');
        </script>
    }
}