@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PagingSearchOrderDto<VSSM.Application.DTOs.BaseEntities.Vvmtype.VvmtypeDto>

@{
    ViewData["Title"] = "مدیریت انواع VVM";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="row m-0 card-header align-items-center">
                <div class="col-lg-9">
                    <h5 class="header-title">@ViewData["Title"]</h5>
                </div>

                <div class="col-lg-3 row d-flex align-items-center justify-content-between">
                    <div class="col-lg-9">
                            @await Component.InvokeAsync("SearchBar", new
                            {
                                searchTerm = Model.SearchText,
                                pageSize = Model.Paging.PageSize,
                                sort = Model.SortField,
                                direction = Model.SortOrder
                            })
                        </div>
                    <div class="col-lg-3">
                        <a class="btn btn-success  m-0" asp-controller="Vvmtype" asp-action="New">
                            <i class="fa fa-plus ml-2"></i>افزودن
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-block">
                <table class="table table-bordered table-striped table-condensed text-center mb-0">
                    <thead>
                        <tr>
                            <th>
                                <a href="?sortField=VvmtypeId&sortOrder=@(Model.SortField == "VvmtypeId" && Model.SortOrder == "asc" ? "desc" : "asc")">
                                    شناسه <i class="fa fa-sort"></i>
                                </a>
                            </th>
                            <th>
                                <a href="?sortField=Code&sortOrder=@(Model.SortField == "Code" && Model.SortOrder == "asc" ? "desc" : "asc")">
                                    کد <i class="fa fa-sort"></i>
                                </a>
                            </th>
                            <th>
                                <a href="?sortField=FullName&sortOrder=@(Model.SortField == "FullName" && Model.SortOrder == "asc" ? "desc" : "asc")">
                                    نام کامل <i class="fa fa-sort"></i>
                                </a>
                            </th>
                            <th>
                                <a href="?sortField=CanUserChange&sortOrder=@(Model.SortField == "CanUserChange" && Model.SortOrder == "asc" ? "desc" : "asc")">
                                    قابل تغییر توسط کاربر <i class="fa fa-sort"></i>
                                </a>
                            </th>
                            <th>تاریخ ثبت</th>
                            <th>وضعیت</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.VvmtypeId</td>
                                    <td>@item.Code</td>
                                    <td>@item.FullName</td>
                                    
                                    <td>
                                        <i class="fa @(item.CanUserChange ? "fa-check text-success" : "fa-times text-danger")"></i>
                                    </td>
                                    <td>@item.EntryShamsiDate</td>
                                    <td>
                                                @if (item.IsActive)
                                                    {
                                                        <span class="badge badge-success">فعال</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-danger">غیرفعال</span>
                                                    }
                                            </td>  
                                    <td>
                                        <a class="btn btn-link text-info btn-sm" asp-action="Edit" asp-route-id="@item.VvmtypeId">
                                            <i class="fa fa-edit" style="font-size:18px;"></i>
                                        </a>

                                        <form asp-action="Delete" asp-route-id="@item.VvmtypeId" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-link text-danger btn-sm"
                                                    onclick="return confirm('آیا مطمئن هستید می‌خواهید این نوع VVM را حذف کنید؟');">
                                                <i class="fa fa-trash" style="font-size:18px;"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-danger">داده‌ای یافت نشد</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Pagination -->
                <nav class="mt-2">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.Paging.Page == 1 ? "disabled" : "")">
                            <a class="page-link" href="?search=@Model.SearchText&page=@(Model.Paging.Page - 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">قبلی</a>
                        </li>

                        @for (int i = 1; i <= Model.Paging.TotalPages; i++)
                        {
                            <li class="page-item @(Model.Paging.Page == i ? "active" : "")">
                                <a class="page-link" href="?search=@Model.SearchText&page=@i&sortField=@Model.SortField&sortOrder=@Model.SortOrder">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.Paging.Page == Model.Paging.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="?search=@Model.SearchText&page=@(Model.Paging.Page + 1)&sortField=@Model.SortField&sortOrder=@Model.SortOrder">بعدی</a>
                        </li>
                    </ul>
                </nav>

            </div>
        </div>

    </div>
</div>
