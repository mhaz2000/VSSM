@model VSSM.Presentation.Web.Models.Vvmtype.VvmtypeViewModel

@{
    string formName = Model != null && Model.VvmtypeId > 0 ? "ویرایش" : "ثبت";
}

<div class="container-fluid">
    <div class="animated fadeIn">

        <div class="card">
            <div class="card-header">
                <h5 class="header-title">@formName نوع VVM</h5>
            </div>
            <div class="card-block">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form asp-action="Create" method="post" class="form-horizontal">
                    <input type="hidden" asp-for="VvmtypeId" />

                    <div class="row equal-height mb-4 mx-0">
                        <div class="form-group col-lg-4">
                            <label class="form-label" asp-for="Code">کد</label>
                            <input type="text" asp-for="Code" class="form-control bg-warning-subtle" maxlength="50" required />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>

                        <div class="form-group col-lg-4">
                            <label class="form-label" asp-for="FullName">نام کامل</label>
                            <input type="text" asp-for="FullName" class="form-control bg-warning-subtle" maxlength="200" required />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <!-- CanUserChange -->
                        <div class="form-group col-lg-1"></div>
                        <div class="form-group col-lg-3">
                            <label class="form-label">قابل تغییر توسط کاربر</label>
                            <div class="d-flex">
                                <div class="form-check">
                                    <input type="radio" asp-for="CanUserChange" value="true" class="form-check-input" id="canUserTrue" />
                                    <label class="form-check-label" for="canUserTrue">بله</label>
                                </div>
                                <div class="form-check">
                                    <input type="radio" asp-for="CanUserChange" value="false" class="form-check-input" id="canUserFalse" />
                                    <label class="form-check-label" for="canUserFalse">خیر</label>
                                </div>
                            </div>
                        </div>

                        <!-- IsActive -->
                        <div class="form-group col-lg-2">
                            <label class="form-label">وضعیت</label>
                            <div class="d-flex">
                                <div class="form-check">
                                    <input type="radio" asp-for="IsActive" value="true" class="form-check-input" id="isActiveTrue" />
                                    <label class="form-check-label" for="isActiveTrue">فعال</label>
                                </div>
                                <div class="form-check">
                                    <input type="radio" asp-for="IsActive" value="false" class="form-check-input" id="isActiveFalse" />
                                    <label class="form-check-label" for="isActiveFalse">غیرفعال</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-left">
                        <button type="submit" class="btn btn-success px-5">ثبت</button>
                        <a asp-action="Index" class="btn btn-success-outlet px-5">بازگشت</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
